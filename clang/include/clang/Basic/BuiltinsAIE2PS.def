//
// This file defines the AIE-specific builtin function database.  Users of
// this file must define the BUILTIN macro to make use of this information.
//
//===----------------------------------------------------------------------===//

// The format of this database matches clang/Basic/Builtins.def.
// In addition to the default type specifiers (second argument to the macro),
// we support the following identifiers on AIE:
//  n -> acc32
//  LLn -> acc64
//  g -> accfloat
//  x -> half (_Float16)
//  y -> half (__bf16)

BUILTIN(__builtin_aie2ps_event, "vi", "nc")

//scl2vec::shift-shiftx-shift_bytes
BUILTIN(__builtin_aie2ps_vshift_I512_I512, "V16iV16iV16iii", "nc")
BUILTIN(__builtin_aie2ps_vshift_bf512_bf512, "V32yV32yV32yii", "nc")
//scl2vec::insert
BUILTIN(__builtin_aie2ps_vinsert_bf32_bf512,"V32yV32yiV2y", "nc")
BUILTIN(__builtin_aie2ps_vinsert_bf64_bf512,"V32yV32yiV4y", "nc")
//scl2vec::broadcast:broadcast_zero:broadcast_one
BUILTIN(__builtin_aie2ps_vbroadcast_bf32_bf512, "V32yV2y", "nc")
BUILTIN(__builtin_aie2ps_vbroadcast_bf64_bf512, "V32yV4y", "nc")
//scl2vec::broadcast_elem
BUILTIN(__builtin_aie2ps_vextract_broadcast128_I512, "V16iV16ii", "nc")
//scl2vec::vshuffle
BUILTIN(__builtin_aie2ps_vshuffle,"V16iV16iV16iUi", "nc")
BUILTIN(__builtin_aie2ps_vshuffle_BFP640_BFP640_BFP640, "vV16iV2iV2iV16iV2iV2iiV16i&V2i&V2i&", "nc")
BUILTIN(__builtin_aie2ps_vshuffle_BFP768_BFP768_BFP768, "vV8iV8iV2iV2iiiiiV8iV8iV2iV2iiiiiiV8i&V8i&V2i&V2i&i&i&i&i&", "nc")
//scl2vec::vbcstshfl
BUILTIN(__builtin_aie2ps_vbcst_shuffle8,"V16iiUi", "nc")
BUILTIN(__builtin_aie2ps_vbcst_shuffle16,"V16iiUi", "nc")
BUILTIN(__builtin_aie2ps_vbcst_shuffle32,"V16iiUi", "nc")
BUILTIN(__builtin_aie2ps_vbcst_shuffle64,"V16iV2iUi", "nc")

// Get Core ID
BUILTIN(__builtin_aie2ps_get_coreid, "i", "nc")
//bitcounting
BUILTIN(__builtin_aie2ps_clb, "UiUi", "nc")
//semaphores
BUILTIN(__builtin_aie2ps_acquire, "vUiUi", "nc")
BUILTIN(__builtin_aie2ps_acquire_cond, "vUiUii", "nc")
BUILTIN(__builtin_aie2ps_acquire_ptr, "vvC*UiUi", "nc")
BUILTIN(__builtin_aie2ps_acquire_cond_ptr, "vvC*UiUii", "nc")
BUILTIN(__builtin_aie2ps_release, "vUii", "nc")
BUILTIN(__builtin_aie2ps_release_cond, "vUiii", "nc")
BUILTIN(__builtin_aie2ps_release_ptr, "vv*Uii", "nc")
BUILTIN(__builtin_aie2ps_release_cond_ptr, "vv*Uiii", "nc")
BUILTIN(__builtin_aie2ps_done, "v", "n")
// Scheduling barrier
BUILTIN(__builtin_aie2ps_sched_barrier, "v", "n")
// Read/Write for Tile Memory Map
BUILTIN(__builtin_aie2ps_read_tm, "iv*", "nc")
BUILTIN(__builtin_aie2ps_write_tm, "viv*", "nc")

// flt2fix and fix2flt
BUILTIN(__builtin_aie2ps_fx2flt, "fii", "nc")
BUILTIN(__builtin_aie2ps_flt2fx, "ifi", "nc")
// non-linear fp ops
BUILTIN(__builtin_aie2ps_sqrtf, "ff", "nc")
BUILTIN(__builtin_aie2ps_inv, "ff", "nc")
BUILTIN(__builtin_aie2ps_invsqrt, "ff", "nc")
BUILTIN(__builtin_aie2ps_exp2, "V16yV16g", "nc")
BUILTIN(__builtin_aie2ps_exp2_bf20, "V16gV16g", "nc")
BUILTIN(__builtin_aie2ps_tanh, "V16yV16g", "nc")

//division/mod
BUILTIN(__builtin_aie2ps_divstep, "vUi&Ui&Ui", "nc")

// Mode Settings
// Set Control Registers
BUILTIN(__builtin_aie2ps_set_ctrl_reg, "vUiCUi", "nc")
// Get Control Registers
BUILTIN(__builtin_aie2ps_get_ctrl_reg, "UiUi", "nc")
// Set Status Registers
BUILTIN(__builtin_aie2ps_set_status_reg, "vUiCUi", "nc")
