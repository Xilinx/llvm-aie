# RUN: llc -mtriple=x86_64-- -run-pass=block-placement -force-precise-rotation-cost -o - %s | FileCheck %s

# A conditional branch reading undef EFLAGS cannot be analyzed, so %bb.6 must
# stay in front of %bb.7 and %bb.7 in front of %bb.8. Block placement merges
# these pairs into one chain up front, but loop rotation used to split the
# chain between %bb.7 and %bb.8 and put the outer loop header after %bb.7.

--- |
  define void @nested_exit(i32 %outer, i32 %inner) { ret void }
...
