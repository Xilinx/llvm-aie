  bb.0:
    successors: %bb.8(0x30000000), %bb.1(0x50000000)
    liveins: $edi, $esi
    TEST32rr $edi, $edi, implicit-def $eflags
    JCC_1 %bb.8, 14, implicit $eflags

  bb.1:
    successors: %bb.2
    liveins: $edi, $esi

  bb.2:
    successors: %bb.3
    liveins: $edi, $esi

  bb.3:
    successors: %bb.6(0x40000000), %bb.4(0x40000000)
    liveins: $edi, $esi
