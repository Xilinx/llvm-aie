    %assert:_(s32) = G_ASSERT_SEXT %var, 16
    %trunc:_(s16) = G_TRUNC %assert(s32)
    %sext:_(s32) = G_SEXT %trunc(s16)
    $vgpr0 = COPY %sext(s32)
...

