# RUN: llc -O2 -mtriple=aie2p -run-pass=aie-hardware-loops -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -O2 -mtriple=aie2ps -run-pass=aie-hardware-loops -verify-machineinstrs %s -o - | FileCheck %s

# JNZD loops without a dedicated preheader. Only the ZOL LoopStart search needs
# a preheader: a JNZD is built from its LoopDec and LoopJNZ alone.

--- |
  define void @not_address_taken() {
    ret void
  }

  define void @address_taken() {
    ret void
  }

  define void @address_taken_three_preds() {
    ret void
  }

  declare void @use(ptr)

  define void @ir_block_address() {
  entry:
    br label %loop

  loop:
    call void @use(ptr blockaddress(@ir_block_address, %loop))
    br label %loop
  }
...

# The entry block branches either to the loop or around it. The speculative
# preheader lookup accepts it as the preheader, and the loop is lowered.
---
name:            not_address_taken
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: not_address_taken
  ; CHECK: bb.0 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x50000000), %bb.2(0x30000000)
  ; CHECK-NEXT:   liveins: $p4, $r1, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r1, %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p4, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r13 = PseudoJNZD $r13, $p4, implicit-def $srcarry
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0 (align 16):
    successors: %bb.1(0x50000000), %bb.2(0x30000000)
    liveins: $p4, $r1, $r13

    PseudoJNZ $r1, %bb.2
    PseudoJ_jump_imm %bb.1

  bb.1 (align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p4, $r13

    renamable $r13 = LoopDec $r13, implicit-def $srcarry
    LoopJNZ renamable $r13, renamable $p4
    PseudoJ_jump_imm %bb.2

  bb.2 (align 16):
    PseudoRET implicit $lr
...

# The same loop, with the header marked machine-block-address-taken, as
# instruction selection marks every JNZD target. The speculative preheader
# lookup rejects address-taken headers.
# FIXME: The loop keeps its LoopDec and LoopJNZ pseudos.
---
name:            address_taken
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: address_taken
  ; CHECK: bb.0 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x50000000), %bb.2(0x30000000)
  ; CHECK-NEXT:   liveins: $p4, $r1, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r1, %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (machine-block-address-taken, align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p4, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r13 = LoopDec $r13, implicit-def $srcarry
  ; CHECK-NEXT:   LoopJNZ renamable $r13, renamable $p4
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0 (align 16):
    successors: %bb.1(0x50000000), %bb.2(0x30000000)
    liveins: $p4, $r1, $r13

    PseudoJNZ $r1, %bb.2
    PseudoJ_jump_imm %bb.1

  bb.1 (machine-block-address-taken, align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p4, $r13

    renamable $r13 = LoopDec $r13, implicit-def $srcarry
    LoopJNZ renamable $r13, renamable $p4
    PseudoJ_jump_imm %bb.2

  bb.2 (align 16):
    PseudoRET implicit $lr
...

# An address-taken header entered from two blocks: the entry block and the
# block it otherwise branches to. The speculative preheader lookup needs
# exactly two header predecessors, the latch included.
# FIXME: The loop keeps its LoopDec and LoopJNZ pseudos.
---
name:            address_taken_three_preds
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: address_taken_three_preds
  ; CHECK: bb.0 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $p4, $r1, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r1, %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 16):
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $p4, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (machine-block-address-taken, align 16):
  ; CHECK-NEXT:   successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  ; CHECK-NEXT:   liveins: $p4, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r13 = LoopDec $r13, implicit-def $srcarry
  ; CHECK-NEXT:   LoopJNZ renamable $r13, renamable $p4
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0 (align 16):
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $p4, $r1, $r13

    PseudoJNZ $r1, %bb.2
    PseudoJ_jump_imm %bb.1

  bb.1 (align 16):
    successors: %bb.2(0x80000000)
    liveins: $p4, $r13

    PseudoJ_jump_imm %bb.2

  bb.2 (machine-block-address-taken, align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p4, $r13

    renamable $r13 = LoopDec $r13, implicit-def $srcarry
    LoopJNZ renamable $r13, renamable $p4
    PseudoJ_jump_imm %bb.3

  bb.3 (align 16):
    PseudoRET implicit $lr
...

# A header that is an IR blockaddress. The speculative preheader lookup rejects
# it too.
# FIXME: The loop keeps its LoopDec and LoopJNZ pseudos.
---
name:            ir_block_address
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: ir_block_address
  ; CHECK: bb.0.entry (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x50000000), %bb.2(0x30000000)
  ; CHECK-NEXT:   liveins: $p4, $r1, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r1, %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop (ir-block-address-taken %ir-block.loop, align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p4, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r13 = LoopDec $r13, implicit-def $srcarry
  ; CHECK-NEXT:   LoopJNZ renamable $r13, renamable $p4
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry (align 16):
    successors: %bb.1(0x50000000), %bb.2(0x30000000)
    liveins: $p4, $r1, $r13

    PseudoJNZ $r1, %bb.2
    PseudoJ_jump_imm %bb.1

  bb.1.loop (ir-block-address-taken %ir-block.loop, align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p4, $r13

    renamable $r13 = LoopDec $r13, implicit-def $srcarry
    LoopJNZ renamable $r13, renamable $p4
    PseudoJ_jump_imm %bb.2

  bb.2 (align 16):
    PseudoRET implicit $lr
...
