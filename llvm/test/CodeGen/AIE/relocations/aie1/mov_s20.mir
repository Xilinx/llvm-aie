# RUN: llc %s -debug-only=mc-dump -mtriple=aie --start-before=livedebugvalues --filetype=obj -show-mc-encoding -o %t 2> %t.out
# RUN: cat %t.out | FileCheck %s --check-prefix=FIXUP
# RUN: llvm-readelf -r %t | FileCheck %s --check-prefix=RELOC

# Let's check that the relocation kinds emitted for mov_s20 (AIE) are correct!

--- |
  ; ModuleID = 't.mir'
  @myint = dso_local global i32 0
  define i32 @main_test() {
    ret i32 0
  }

...
---
name:            main_test
body:             |
  bb.0:
    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @0 {{.*}} Kind:4062
      ; RELOC: {{.*}} R_AIE_52
    }

    BUNDLE {
      NOP_ST
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @8 {{.*}} Kind:4061
      ; RELOC: {{.*}} R_AIE_51
    }

    BUNDLE {
      NOP_ALU
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @16 {{.*}} Kind:4061
      ; RELOC: {{.*}} R_AIE_51
    }

    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @24 {{.*}} Kind:4048
      ; RELOC: {{.*}} R_AIE_38
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ST
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @36 {{.*}} Kind:4063
      ; RELOC: {{.*}} R_AIE_53
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ALU
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @48 {{.*}} Kind:4063
      ; RELOC: {{.*}} R_AIE_53
    }

    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @60 {{.*}} Kind:4048
      ; RELOC: {{.*}} R_AIE_38
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ST
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @72 {{.*}} Kind:4047
      ; RELOC: {{.*}} R_AIE_37
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ALU
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @88 {{.*}} Kind:4047
      ; RELOC: {{.*}} R_AIE_37
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ST
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @104 {{.*}} Kind:4047
      ; RELOC: {{.*}} R_AIE_37
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ALU
      renamable $r0 = MOV_S20 target-flags(aie-global) @myint
      ; FIXUP: Fixup @120 {{.*}} Kind:4047
      ; RELOC: {{.*}} R_AIE_37
      NOP_VECM
    }

    PseudoRET implicit $lr, implicit killed $r0
