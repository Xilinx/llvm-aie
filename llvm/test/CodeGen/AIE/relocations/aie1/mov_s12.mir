# RUN: llc %s -debug-only=mc-dump -mtriple=aie --start-before=livedebugvalues --filetype=obj -show-mc-encoding -o %t 2> %t.out
# RUN: cat %t.out | FileCheck %s --check-prefix=FIXUP
# RUN: llvm-readelf -r %t | FileCheck %s --check-prefix=RELOC

# Let's check that the relocation kinds emitted for mov_s12 (AIE) are correct!

--- |
  ; ModuleID = 't.mir'
  @myint = dso_local global i32 0
  define i32 @main_test() {
    ret i32 0
  }

...
---
name:            main_test
body:             |
  bb.0:
    BUNDLE {
      NOP_LDA
      NOP_LDB
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @0 {{.*}} Kind:4024
      ; RELOC: {{.*}} R_AIE_14
    }

    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @8 {{.*}} Kind:4023
      ; RELOC: {{.*}} R_AIE_13
      NOP_ST
    }

    BUNDLE {
      NOP_LDA
      NOP_MV0
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @16 {{.*}} Kind:4024
      ; RELOC: {{.*}} R_AIE_14
    }

    BUNDLE {
      NOP_LDA
      NOP_MV1
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @24 {{.*}} Kind:4024
      ; RELOC: {{.*}} R_AIE_14
    }

    BUNDLE {
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @32 {{.*}} Kind:4026
      ; RELOC: {{.*}} R_AIE_16
      NOP_MV0
    }

    BUNDLE {
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @40 {{.*}} Kind:4026
      ; RELOC: {{.*}} R_AIE_16
      NOP_MV1
    }

    BUNDLE {
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @48 {{.*}} Kind:4025
      ; RELOC: {{.*}} R_AIE_15
      NOP_MV0
      NOP_MV1
    }

    BUNDLE {
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @56 {{.*}} Kind:4025
      ; RELOC: {{.*}} R_AIE_15
      NOP_LNG
    }

    BUNDLE {
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @64 {{.*}} Kind:4025
      ; RELOC: {{.*}} R_AIE_15
      NOP_VECA
    }

    BUNDLE {
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @72 {{.*}} Kind:4025
      ; RELOC: {{.*}} R_AIE_15
      NOP_VECM
    }

    BUNDLE {
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @80 {{.*}} Kind:4030
      ; RELOC: {{.*}} R_AIE_20
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @92 {{.*}} Kind:4028
      ; RELOC: {{.*}} R_AIE_18
      NOP_MV0
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @104 {{.*}} Kind:4029
      ; RELOC: {{.*}} R_AIE_19
      NOP_MV1
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @116 {{.*}} Kind:4034
      ; RELOC: {{.*}} R_AIE_24
      NOP_MV0
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @128 {{.*}} Kind:4027
      ; RELOC: {{.*}} R_AIE_17
      NOP_MV1
    }

    BUNDLE {
      NOP_LDA
      NOP_MV0
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @140 {{.*}} Kind:4027
      ; RELOC: {{.*}} R_AIE_17
      NOP_MV1
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @152 {{.*}} Kind:4032
      ; RELOC: {{.*}} R_AIE_22
      NOP_MV0
      NOP_MV1
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @164 {{.*}} Kind:4032
      ; RELOC: {{.*}} R_AIE_22
      NOP_LNG
    }

    BUNDLE {
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @176 {{.*}} Kind:4030
      ; RELOC: {{.*}} R_AIE_20
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @188 {{.*}} Kind:4028
      ; RELOC: {{.*}} R_AIE_18
      NOP_MV0
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @200 {{.*}} Kind:4029
      ; RELOC: {{.*}} R_AIE_19
      NOP_MV1
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @212 {{.*}} Kind:4031
      ; RELOC: {{.*}} R_AIE_21
      NOP_MV0
      NOP_MV1
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @228 {{.*}} Kind:4031
      ; RELOC: {{.*}} R_AIE_21
      NOP_LNG
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @244 {{.*}} Kind:4021
      ; RELOC: {{.*}} R_AIE_11
      NOP_MV1
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_MV0
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @260 {{.*}} Kind:4021
      ; RELOC: {{.*}} R_AIE_11
      NOP_MV1
      NOP_VECA
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @276 {{.*}} Kind:4031
      ; RELOC: {{.*}} R_AIE_21
      NOP_MV0
      NOP_MV1
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @292 {{.*}} Kind:4031
      ; RELOC: {{.*}} R_AIE_21
      NOP_LNG
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      NOP_LDB
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @308 {{.*}} Kind:4021
      ; RELOC: {{.*}} R_AIE_11
      NOP_MV1
      NOP_VECM
    }

    BUNDLE {
      NOP_LDA
      NOP_MV0
      NOP_ST
      renamable $r0 = MOV_S12 target-flags(aie-global) @myint
      ; FIXUP: Fixup @324 {{.*}} Kind:4021
      ; RELOC: {{.*}} R_AIE_11
      NOP_MV1
      NOP_VECM
    }

    PseudoRET implicit $lr, implicit killed $r0
