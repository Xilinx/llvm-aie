# RUN: llc --mtriple=aie2 -O2 \
# RUN:   --start-before=postmisched \
# RUN:   --aie-postpipeliner-vreg-mode=1 \
# RUN:   --aie-postpipeliner-phys-mode=0 \
# RUN:   --debug-only=aie-reg-liverange \
# RUN:   --aie-test-regdefuse-tracker \
# RUN:   %s -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: asserts

# wh6 is the upper half of the y-stream pair {wl6, wh6}. It is freshly
# loaded by VLD_idx each iteration and used by VCONV_FP32_BF16. The bug
# caused wh6's use to be incorrectly merged into wl6's live range; wl6 is
# defined by a VLD_pstm with a tied pointer update (p1). With the correct
# fix, wh6 has its own separate FINAL live range (def=VLD_idx, use=VCONV).
#
# The bug: without the fix, x10 (= {wl10, wh10}) is split into two separate
# live ranges because the wh10 use (at VMUL) is incorrectly detached from the
# existing x10 range that already covers the wl10 def. A spurious second x10
# range is created that couples the VMOV-initialised wh10 with the VLD-loaded
# wl10, inflating the FINAL live range count to 21. The fix consolidates
# them into one x10 range with three defs and two uses (= 20 total ranges).
#
# CHECK: FINAL LIVE RANGES
# CHECK: Total live ranges: 20
# CHECK: Live Range #{{[0-9]+}} for wh6:
# CHECK-NEXT:   Definitions (1):
# CHECK-NEXT:     [0] Register: wh6 {{.*}} = VLDB_dmw_ldb_ag_idx_imm
# CHECK-NEXT:   Uses (1):
# CHECK-NEXT:     [0] Register: wh6 {{.*}} = VCONV_FP32_BF16
# CHECK: Live Range #{{[0-9]+}} for x10:
# CHECK-NEXT:   Definitions (3):
# CHECK-NEXT:     [0] Register: wl10 {{.*}} = VLDB_dmw_ldb_ag_idx_imm
# CHECK-NEXT:     [1] Register: wh10 {{.*}} = VMOV_mv_w
# CHECK-NEXT:     [2] Register: wl10 {{.*}} = VLDB_dmw_ldb_ag_idx_imm
# CHECK-NEXT:   Uses (2):
# CHECK-NEXT:     [0] Register: x10 {{.*}} = VMUL_F_vmac_bm_core_dense
# CHECK-NEXT:     [1] Register: x10 {{.*}} = VMUL_F_vmac_bm_core_dense

--- |
  define dso_local void @saxpy(ptr addrspace(5) noalias nocapture writeonly %d, ptr addrspace(6) noalias nocapture readonly %s, i32 noundef %n) local_unnamed_addr {
  entry:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.body:
    %p5 = phi ptr addrspace(5) [ %incdec.ptr, %for.body ], [ %d, %entry ]
    %p6 = phi ptr addrspace(6) [ %incdec.ptr1, %for.body ], [ %s, %entry ]
    %0 = load i32, ptr addrspace(6) %p6, align 4
    %add = add nsw i32 %0, 1
    store i32 %add, ptr addrspace(5) %p5, align 4
    %incdec.ptr = getelementptr inbounds i32, ptr addrspace(5) %p5, i20 1
    %incdec.ptr1 = getelementptr inbounds i32, ptr addrspace(6) %p6, i20 1
    %1 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %1, label %for.body, label %for.cond.cleanup, !llvm.loop !0

  for.cond.cleanup:                                 ; preds = %for.body, %entry
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 4}

...
---
name:            saxpy
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry (align 16):
    successors: %bb.1
    liveins: $p0, $p1, $r0

    $lc = ADD_NC $r0, 0
    $ls = MOVXM_lng_cg %bb.1
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd0>

  bb.1.for.body:
    successors: %bb.1, %bb.2
    liveins: $p0, $p1, $p2, $r0, $r1, $x0:0x0000000000000003, $x2:0x0000000000000002, $x4:0x0000000000000003, $wh1

    $wh2 = VLD_idx_imm_3x32_pseudo $p1, 32 :: (load (<16 x s16>) from %ir.p5)
    $wl6, $p1 = VLD_pstm_imm_4x32_pseudo $p1, 64 :: (load (<16 x s16>) from %ir.p5)
    $wh6 = VLD_idx_imm_3x32_pseudo $p1, 32 :: (load (<16 x s16>) from %ir.p5)
    $wl8, $p1 = VLD_pstm_imm_4x32_pseudo $p1, 64 :: (load (<16 x s16>) from %ir.p5)
    $wl10 = VLD_idx_imm_3x32_pseudo $p0, 32 :: (load (<16 x s16>) from %ir.p5)
    $wl1, $p0 = VLD_pstm_imm_4x32_pseudo $p0, 64 :: (load (<16 x s16>) from %ir.p5)
    $bmh0 = VMUL_F_vmac_bm_core_dense $x1, $x0, $r0, implicit-def $srfpflags, implicit $crfpmask
    $wh10 = VMOV_mv_w $wl2
    $bmh1 = VMUL_F_vmac_bm_core_dense $x10, $x4, $r0, implicit-def $srfpflags, implicit $crfpmask
    $wl10 = VLD_idx_imm_3x32_pseudo $p0, 32 :: (load (<16 x s16>) from %ir.p5)
    $wl1, $p0 = VLD_pstm_imm_4x32_pseudo $p0, 64 :: (load (<16 x s16>) from %ir.p5)
    $bmh2 = VMUL_F_vmac_bm_core_dense $x1, $x0, $r0, implicit-def $srfpflags, implicit $crfpmask
    $bmh3 = VMUL_F_vmac_bm_core_dense $x10, $x4, $r0, implicit-def $srfpflags, implicit $crfpmask
    $bmh4 = VCONV_FP32_BF16 $wl6
    $bmh5 = VADD_F $bmh0, $bmh4, $r1, implicit-def $srfpflags, implicit $crfpmask
    $bmh6 = VCONV_FP32_BF16 $wh2
    $bmh7 = VADD_F $bmh1, $bmh6, $r1, implicit-def $srfpflags, implicit $crfpmask
    $bmh8 = VCONV_FP32_BF16 $wl8
    $bml0 = VADD_F $bmh2, $bmh8, $r1, implicit-def $srfpflags, implicit $crfpmask
    $bml1 = VCONV_FP32_BF16 $wh6
    $bml2 = VADD_F $bmh3, $bml1, $r1, implicit-def $srfpflags, implicit $crfpmask
    $wl10 = VCONV_BF16_FP32 $bmh5, implicit-def $srf2fflags, implicit $crf2fmask, implicit $crrnd
    $wh8 = VCONV_BF16_FP32 $bmh7, implicit-def $srf2fflags, implicit $crf2fmask, implicit $crrnd
    $wl1 = VCONV_BF16_FP32 $bml0, implicit-def $srf2fflags, implicit $crf2fmask, implicit $crrnd
    $wh10 = VCONV_BF16_FP32 $bml2, implicit-def $srf2fflags, implicit $crf2fmask, implicit $crrnd
    VST_dmw_sts_w_ag_idx_imm $wh8, $p2, 32 :: (store (<16 x s16>) into %ir.p6)
    $p2 = VST_dmw_sts_w_ag_pstm_nrm_imm $wl10, $p2, 64 :: (store (<16 x s16>) into %ir.p6)
    VST_dmw_sts_w_ag_idx_imm $wh10, $p2, 32 :: (store (<16 x s16>) into %ir.p6)
    $p2 = VST_dmw_sts_w_ag_pstm_nrm_imm $wl1, $p2, 64 :: (store (<16 x s16>) into %ir.p6)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.for.cond.cleanup:
    RET implicit $lr
    DelayedSchedBarrier
...
