# REQUIRES: asserts
# RUN: llc --mtriple=aie2 -O2 --start-before=postmisched \
# RUN:     --debug-only=sched-blocks %s -o /dev/null 2>&1 | FileCheck %s

# When the successor of a block is a postpipelined loop, the bottom scoreboard
# of the block replays the loop's steady-state body once per iteration that is
# guaranteed to run. A two-stage pipeline peels one iteration, so the loop body
# runs at least MinTripCount - 1 times, but never fewer than once.

--- |
  define void @minTC2(ptr addrspace(5) noalias %d, i32 %n) {
  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %for.body.preheader, label %for.cond.cleanup

  for.body.preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.cond.cleanup:
    ret void

  for.body:
    %d.addr = phi ptr addrspace(5) [ %incdec.ptr, %for.body ], [ %d, %for.body.preheader ]
    %0 = phi i32 [ %add, %for.body ], [ 0, %for.body.preheader ]
    %add = add nsw i32 %0, 1
    store i32 %add, ptr addrspace(5) %d.addr, align 4
    %incdec.ptr = getelementptr inbounds i32, ptr addrspace(5) %d.addr, i20 1
    %1 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %1, label %for.body, label %for.cond.cleanup, !llvm.loop !0
  }

  define void @minTC3(ptr addrspace(5) noalias %d, i32 %n) {
  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %for.body.preheader, label %for.cond.cleanup

  for.body.preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.cond.cleanup:
    ret void

  for.body:
    %d.addr = phi ptr addrspace(5) [ %incdec.ptr, %for.body ], [ %d, %for.body.preheader ]
    %0 = phi i32 [ %add, %for.body ], [ 0, %for.body.preheader ]
    %add = add nsw i32 %0, 1
    store i32 %add, ptr addrspace(5) %d.addr, align 4
    %incdec.ptr = getelementptr inbounds i32, ptr addrspace(5) %d.addr, i20 1
    %1 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %1, label %for.body, label %for.cond.cleanup, !llvm.loop !1
  }

  define void @minTC5(ptr addrspace(5) noalias %d, i32 %n) {
  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %for.body.preheader, label %for.cond.cleanup

  for.body.preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.cond.cleanup:
    ret void

  for.body:
    %d.addr = phi ptr addrspace(5) [ %incdec.ptr, %for.body ], [ %d, %for.body.preheader ]
    %0 = phi i32 [ %add, %for.body ], [ 0, %for.body.preheader ]
    %add = add nsw i32 %0, 1
    store i32 %add, ptr addrspace(5) %d.addr, align 4
    %incdec.ptr = getelementptr inbounds i32, ptr addrspace(5) %d.addr, i20 1
    %1 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %1, label %for.body, label %for.cond.cleanup, !llvm.loop !2
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !3}
  !1 = distinct !{!1, !4}
  !2 = distinct !{!2, !5}
  !3 = !{!"llvm.loop.itercount.range", i64 2}
  !4 = !{!"llvm.loop.itercount.range", i64 3}
  !5 = !{!"llvm.loop.itercount.range", i64 5}

...
---
name:            minTC2
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry (align 16):
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $p0, $p1, $r0

    renamable $r1 = MOV_RLC_imm10_pseudo 0
    renamable $r1 = GE killed renamable $r1, renamable $r0
    JNZ killed renamable $r1, %bb.3
    DelayedSchedBarrier

  bb.1.for.body.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $r0
    $r1 = MOVX_alu_cg 0

    $lc = ADD_NC $r0, 0
    $ls = MOVXM_lng_cg %bb.2
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd0>

  bb.2.for.body (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $r1

    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $p0 = ST_dms_sts_pstm_nrm_imm killed renamable $r1, killed renamable $p0, 4 :: (store (s32) into %ir.d.addr)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.for.cond.cleanup (align 16):
    RET implicit $lr
    DelayedSchedBarrier

...
---
name:            minTC3
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry (align 16):
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $p0, $p1, $r0

    renamable $r1 = MOV_RLC_imm10_pseudo 0
    renamable $r1 = GE killed renamable $r1, renamable $r0
    JNZ killed renamable $r1, %bb.3
    DelayedSchedBarrier

  bb.1.for.body.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $r0
    $r1 = MOVX_alu_cg 0

    $lc = ADD_NC $r0, 0
    $ls = MOVXM_lng_cg %bb.2
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd1>

  bb.2.for.body (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $r1

    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $p0 = ST_dms_sts_pstm_nrm_imm killed renamable $r1, killed renamable $p0, 4 :: (store (s32) into %ir.d.addr)
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.2

  bb.3.for.cond.cleanup (align 16):
    RET implicit $lr
    DelayedSchedBarrier

...
---
name:            minTC5
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry (align 16):
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $p0, $p1, $r0

    renamable $r1 = MOV_RLC_imm10_pseudo 0
    renamable $r1 = GE killed renamable $r1, renamable $r0
    JNZ killed renamable $r1, %bb.3
    DelayedSchedBarrier

  bb.1.for.body.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $r0
    $r1 = MOVX_alu_cg 0

    $lc = ADD_NC $r0, 0
    $ls = MOVXM_lng_cg %bb.2
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd2>

  bb.2.for.body (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $r1

    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $p0 = ST_dms_sts_pstm_nrm_imm killed renamable $r1, killed renamable $p0, 4 :: (store (s32) into %ir.d.addr)
    PseudoLoopEnd <mcsymbol .L_LEnd2>, %bb.2

  bb.3.for.cond.cleanup (align 16):
    RET implicit $lr
    DelayedSchedBarrier

...

# CHECK-LABEL: >> enterFunction minTC2
# The loop needs a minimum of two iterations: one is peeled, one remains.
# CHECK: Compute bottom scoreboard of MBB 1
# CHECK: SuccBB 2
# CHECK: Replay iterations: 1

# CHECK-LABEL: >> enterFunction minTC3
# CHECK: Compute bottom scoreboard of MBB 1
# CHECK: SuccBB 2
# CHECK: Replay iterations: 2

# CHECK-LABEL: >> enterFunction minTC5
# CHECK: Compute bottom scoreboard of MBB 1
# CHECK: SuccBB 2
# CHECK: Replay iterations: 4
