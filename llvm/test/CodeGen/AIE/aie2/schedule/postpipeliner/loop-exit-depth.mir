    $le = MOVXM_lng_cg <mcsymbol .L_LEnd1>

  bb.2.for.body (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $r1, $cm0

    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $p0 = ST_dms_sts_pstm_nrm_imm killed renamable $r1, killed renamable $p0, 4 :: (store (s32) into %ir.d.addr)
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.2

  bb.3.for.cond.cleanup (align 16):
    liveins: $cm0, $p1
    VST_dmw_sts_am_ag_idx_imm $amll0, $p1, 0
    RET implicit $lr
    DelayedSchedBarrier

...
---
name:            deadOnSkipPath
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.3(0x40000000), %bb.1(0x40000000)
    liveins: $p0, $p1, $p2, $r0, $r2, $x0, $x1, $cm0

    $wl0 = VLDA_dmw_lda_w_ag_idx_imm $p2, 0
    $cm0 = VMAC_vmac_cm_core_dense $cm0, $x0, $x1, $r0
    renamable $r1 = GE renamable $r0, renamable $r2
    JNZ killed renamable $r1, %bb.3
    DelayedSchedBarrier

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $p0, $r2

    renamable $r2 = ADD_add_r_ri killed renamable $r2, 1, implicit-def dead $srcarry

  bb.2:
    liveins: $p0, $r2

    ST_dms_sts_idx_imm $r2, $p0, 0
    RET implicit $lr
    DelayedSchedBarrier

  bb.3:
    liveins: $cm0, $p1

    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    VST_dmw_sts_am_ag_idx_imm $amll0, $p1, 0
    RET implicit $lr
    DelayedSchedBarrier
...
