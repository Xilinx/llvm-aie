  ; CHECK-NEXT:  // %bb.1: // %for.body.preheader
  ; CHECK-NEXT:    add.nc lc, r0, #-1
  ; CHECK-NEXT:    movxm ls, #.LBB0_2
  ; CHECK-NEXT:    nopb ; nopa ; nops ; movxm le, #.L_LEnd0; nopv
  ; CHECK-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopb ; nopa ; nops ; nopxm ; vmac cm0, cm0, x0, x1, r0
  ; CHECK-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopb ; nopa ; nops ; movx r1, #0; nopm ; nopv
  ; CHECK-NEXT:    nopb ; nopa ; nops ; add r1, r1, #1; nopm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_2: // %for.body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopb ; nopa ; st r1, [p0], #4; add r1, r1, #1; nopm ; nopv
  ; CHECK-NEXT:  // %bb.3: // %for.cond.cleanup
  ; CHECK-NEXT:    nopb ; nopa ; st r1, [p0], #4; nopxm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_4: // %for.cond.cleanup
  ; CHECK-NEXT:    ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    vst amll0, [p1, #0] // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ;
  ; NOEXIT-LABEL: minTC2:
  ; NOEXIT:         .p2align 4
  ; NOEXIT-NEXT:  // %bb.0: // %entry
  ; NOEXIT-NEXT:    nopb ; mova r1, #0; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopa ; ge r1, r1, r0
  ; NOEXIT-NEXT:    jnz r1, #.LBB0_4
  ; NOEXIT-NEXT:    nop // Delay Slot 5
  ; NOEXIT-NEXT:    nop // Delay Slot 4
  ; NOEXIT-NEXT:    nop // Delay Slot 3
  ; NOEXIT-NEXT:    nop // Delay Slot 2
  ; NOEXIT-NEXT:    nop // Delay Slot 1
  ; NOEXIT-NEXT:  // %bb.1: // %for.body.preheader
  ; NOEXIT-NEXT:    add.nc lc, r0, #-1
  ; NOEXIT-NEXT:    movxm ls, #.LBB0_2
  ; NOEXIT-NEXT:    nopb ; nopa ; nops ; movxm le, #.L_LEnd0; nopv
  ; NOEXIT-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopb ; nopa ; nops ; nopxm ; vmac cm0, cm0, x0, x1, r0
  ; NOEXIT-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopb ; nopa ; nops ; movx r1, #0; nopm ; nopv
  ; NOEXIT-NEXT:    nopb ; nopa ; nops ; add r1, r1, #1; nopm ; nopv
  ; NOEXIT-NEXT:    .p2align 4
  ; NOEXIT-NEXT:  .LBB0_2: // %for.body
  ; NOEXIT-NEXT:    // =>This Inner Loop Header: Depth=1
  ; NOEXIT-NEXT:  .L_LEnd0:
  ; NOEXIT-NEXT:    nopb ; nopa ; st r1, [p0], #4; add r1, r1, #1; nopm ; nopv
  ; NOEXIT-NEXT:  // %bb.3: // %for.cond.cleanup
  ; NOEXIT-NEXT:    nopb ; nopa ; st r1, [p0], #4; nopxm ; nopv
  ; NOEXIT-NEXT:    .p2align 4
  ; NOEXIT-NEXT:  .LBB0_4: // %for.cond.cleanup
  ; NOEXIT-NEXT:    ret lr
  ; NOEXIT-NEXT:    nop // Delay Slot 5
  ; NOEXIT-NEXT:    nop // Delay Slot 4
  ; NOEXIT-NEXT:    nop // Delay Slot 3
  ; NOEXIT-NEXT:    vst amll0, [p1, #0] // Delay Slot 2
  ; NOEXIT-NEXT:    nop // Delay Slot 1
  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %for.body.preheader, label %for.cond.cleanup

  for.body.preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.cond.cleanup:
    ret void

  for.body:
    %d.addr = phi ptr addrspace(5) [ %incdec.ptr, %for.body ], [ %d, %for.body.preheader ]
    %0 = phi i32 [ %add, %for.body ], [ 0, %for.body.preheader ]
    %add = add nsw i32 %0, 1
    store i32 %add, ptr addrspace(5) %d.addr, align 4
    %incdec.ptr = getelementptr inbounds i32, ptr addrspace(5) %d.addr, i20 1
    %1 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %1, label %for.body, label %for.cond.cleanup, !llvm.loop !0
  }

