---
name:            minTC2
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry (align 16):
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $p0, $p1, $r0, $x0, $x1, $cm0

    renamable $r1 = MOV_RLC_imm10_pseudo 0
    renamable $r1 = GE killed renamable $r1, renamable $r0
    JNZ killed renamable $r1, %bb.3
    DelayedSchedBarrier

  bb.1.for.body.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $r0, $x0, $x1, $cm0
    $r1 = MOVX_alu_cg 0
    $cm0 = VMAC_vmac_cm_core_dense $cm0, $x0, $x1, $r0

    $lc = ADD_NC $r0, 0
    $ls = MOVXM_lng_cg %bb.2
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd0>

  bb.2.for.body (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $r1, $cm0

    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $p0 = ST_dms_sts_pstm_nrm_imm killed renamable $r1, killed renamable $p0, 4 :: (store (s32) into %ir.d.addr)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.for.cond.cleanup (align 16):
    liveins: $cm0, $p1
    VST_dmw_sts_am_ag_idx_imm $amll0, $p1, 0
    RET implicit $lr
    DelayedSchedBarrier

...
