# RUN: llc --mtriple=aie2 -O2 --start-before=postmisched %s -o - | FileCheck %s

# Distilled from https://github.com/Xilinx/llvm-aie/issues/1012
# This ended up as an NS=1 pipeline that failed to respect the loop carried
# distance between the second and the first ST.S8

--- |
  define dso_local void @test(ptr noalias writeonly captures(none) %out) local_unnamed_addr {
  ; CHECK-LABEL: test:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:    nopb ; nopa ; nops ; movxm ls, #.LBB0_1; nopv
  ; CHECK-NEXT:    mova r1, #32; nopb ; movxm le, #.L_LEnd0
  ; CHECK-NEXT:    mul r2, r1, r1
  ; CHECK-NEXT:    nopb ; mova r0, #0; nops ; nopx ; add.nc lc, r1, #0; nopv
  ; CHECK-NEXT:  .LBB0_1: // %for.body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopb ; nopa ; nops ; add r1, r0, #1; mov dj0, r0; nopv
  ; CHECK-NEXT:    nopb ; st.s8 r2, [p0, dj0]; nops ; add r0, r0, #4; mov dj0, r1; nopv
  ; CHECK-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nopxm ; nops
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    st.s8 r2, [p0, dj0]
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopb ; nopa ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.2: // %for.cond.cleanup
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    call void @llvm.set.loop.iterations.i32(i32 32)
    br label %for.body

  for.cond.cleanup:                                 ; preds = %for.body
    ret void

  for.body:                                         ; preds = %for.body, %entry
    %i.05 = phi i32 [ 0, %entry ], [ %inc.3, %for.body ]
    %mul = mul nuw nsw i32 %i.05, %i.05
    %conv = trunc i32 %mul to i8
    %0 = trunc nuw nsw i32 %i.05 to i20
    %arrayidx = getelementptr inbounds nuw i8, ptr %out, i20 %0
    store i8 %conv, ptr %arrayidx, align 1
    %1 = add i32 %i.05, 1
    %mul.1 = mul nuw nsw i32 %1, %1
    %conv.1 = trunc i32 %mul.1 to i8
    %2 = trunc nuw nsw i32 %1 to i20
    %arrayidx.1 = getelementptr inbounds nuw i8, ptr %out, i20 %2
    store i8 %conv.1, ptr %arrayidx.1, align 1
    %inc.3 = add nuw nsw i32 %i.05, 4
    %7 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %7, label %for.body, label %for.cond.cleanup, !llvm.loop !0
  }

  declare void @llvm.set.loop.iterations.i32(i32) #1

  declare i1 @llvm.loop.decrement.i32(i32) #1

  attributes #1 = { nocallback noduplicate nofree nosync nounwind willreturn }

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i32 32}
...
---
name:            test
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $p0

    $r1 = MOV_RLC_imm10_pseudo 32
    $r0 = MOV_RLC_imm10_pseudo 0
    $lc = ADD_NC $r1, 0
    $ls = MOVXM_lng_cg %bb.1
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd0>
    $r2 = nuw nsw MUL_mul_r_rr $r1, $r1

  bb.1.for.body:
    successors: %bb.1, %bb.2
    liveins: $p0, $r0, $r2

    $dj0 = MOV_mv_scl $r0
    ST_S8_ag_idx $r2, $p0, $dj0 :: (store (s8) into %ir.arrayidx)
    $r1 = ADD_add_r_ri $r0, 1, implicit-def dead $srcarry
    $dj0 = MOV_mv_scl $r1
    ST_S8_ag_idx $r2, $p0, $dj0 :: (store (s8) into %ir.arrayidx.1)
    $r0 = nuw nsw ADD_add_r_ri $r0, 4, implicit-def dead $srcarry
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.for.cond.cleanup:
    RET implicit $lr
    DelayedSchedBarrier
...
