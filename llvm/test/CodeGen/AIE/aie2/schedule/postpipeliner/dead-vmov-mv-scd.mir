---
name:            dead_vmov_mv_scd
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $p0, $r0, $r1

    $lc = ADD_NC $r0, 0
    $ls = MOVXM_lng_cg %bb.1
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd0>
    $crscden = MOVXM_lng_cg 1

  bb.1.loop_body (align 16):
    successors: %bb.1, %bb.2
    liveins: $p0, $r1, $crscden

    dead $x0 = VMOV_mv_scd implicit $crscden
    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $p0 = ST_dms_sts_pstm_nrm_imm killed renamable $r1, killed renamable $p0, 4
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit:
    RET implicit $lr
    DelayedSchedBarrier

