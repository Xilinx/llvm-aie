# Make sure DONE stays in place

---
name:            done
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: done
    ; CHECK: $r0 = LDA_dms_lda_idx_imm killed $p0, 0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: ST_dms_sts_idx_imm $r0, killed $p1, 0
    ; CHECK-NEXT: DONE
    ; CHECK-NEXT: RET implicit $lr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: DelayedSchedBarrier implicit killed $r0
    $r0 = LDA_dms_lda_idx_imm $p0, 0
    ST_dms_sts_idx_imm $r0, $p1, 0
    DONE
    RET implicit $lr
    DelayedSchedBarrier implicit $r0
...

