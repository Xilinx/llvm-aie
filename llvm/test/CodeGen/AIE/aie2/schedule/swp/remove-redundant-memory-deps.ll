; Test that the RemoveRedundantMemoryDeps mutator removes memory dependencies
; when there's already a transitive data dependency path enforcing the
; same ordering.
;
; In this test:
; - We have a loop that loads from an input array, accumulates values, and
;   stores to an output array
; - Memory dependencies exist between stores and loads (conservative aliasing)
; - Data dependencies exist through the accumulator register
; - The memory dependencies are redundant because the data path already
;   enforces the ordering

; Verify the mutator runs when enabled
; WITH-OPT: Computed reachability matrix for {{[0-9]+}} SUnits
; WITH-OPT: RemoveRedundantMemoryDeps: removed {{[0-9]+}} redundant memory edges

; Verify the mutator doesn't run when disabled
; WITHOUT-OPT-NOT: RemoveRedundantMemoryDeps

define void @test_redundant_mem_dep(ptr %arr, i32 %n) {
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  
  ; Load arr[i]
  %ptr1 = getelementptr i32, ptr %arr, i32 %i
  %val1 = load i32, ptr %ptr1, align 4
  
  ; Compute with val1 (creates data dependency)
  %tmp = add i32 %val1, 1
  
  ; Store to arr[i] (may create memory dependency with next load)
  store i32 %tmp, ptr %ptr1, align 4
  
  ; Load arr[i] again (has both memory dep from store AND data dep through tmp)
  %val2 = load i32, ptr %ptr1, align 4
  
  ; Use val2 (extends data dependency chain)
  %result = add i32 %val2, %tmp
  
  ; Store result back
  store i32 %result, ptr %ptr1, align 4
  
  ; Loop control
  %i.next = add i32 %i, 1
  %cond = icmp ult i32 %i.next, %n
  br i1 %cond, label %loop, label %exit, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !1, !2}
!1 = !{!"llvm.loop.mustprogress"}
!2 = !{!"llvm.loop.itercount.range", i64 8}
