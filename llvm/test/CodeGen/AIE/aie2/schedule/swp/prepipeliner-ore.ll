; Verify that the pipeliner remark infrastructure emits optimization remarks
; for prepipelined and non-pipelined loops. Each single-MBB loop gets exactly
; one remark with Pipeliner kind, II, NS, and prologue/epilogue bundle counts.

; Prepipeliner: force the prepipeliner to handle the loop by limiting the
; postpipeliner candidate thresholds.
; RUN: llc -mtriple=aie2 -O2 --aie-postpipeliner-maxii=0 \
; RUN:   --aie-postpipeliner-limit=1 --aie-postpipeliner-cutoff=1 \
; RUN:   -pass-remarks-output=- -pass-remarks-filter=pipeliner \
; RUN:   %s -o /dev/null | FileCheck %s --check-prefix=PRE

; Loop-scheduler: disable both pipeliners.
; RUN: llc -mtriple=aie2 -O2 --enable-pipeliner=0 --aie-postpipeliner-maxii=0 \
; RUN:   -pass-remarks-output=- -pass-remarks-filter=pipeliner \
; RUN:   %s -o /dev/null | FileCheck %s --check-prefix=PLAIN

; A dot-product style loop with enough latency to force multi-stage pipelining.
; The large pointer increments (2044) force padda (not padd pseudo) so the
; prepipeliner can handle them.
define dso_local i32 @dot(ptr addrspace(6) nocapture readonly %a, ptr addrspace(6) nocapture readonly %b, i32 noundef %n) local_unnamed_addr {
; PRE: --- !Analysis
; PRE-NEXT: Pass:            pipeliner
; PRE-NEXT: Name:            schedule
; PRE-NEXT: Function:        dot
; PRE-NEXT: Args:
; PRE-NEXT:   - String:          'Schedule found with Initiation Interval: '
; PRE-NEXT:   - II:              '4'
; PRE-NEXT:   - String:          ', MaxStageCount: '
; PRE-NEXT:   - MaxStageCount:   '2'
; PRE-NEXT:   - NS:              '3'
; PRE-NEXT:   - BasicBlock:      for.body
; PRE-NEXT: ...
; PRE: --- !Passed
; PRE-NEXT: Pass:            pipeliner
; PRE-NEXT: Name:            schedule
; PRE-NEXT: Function:        dot
; PRE-NEXT: Args:
; PRE-NEXT:   - String:          'Pipelined succesfully!'
; PRE-NEXT: ...
; PRE: --- !Passed
; PRE-NEXT: Pass:            pipeliner
; PRE-NEXT: Name:            schedule
; PRE-NEXT: Function:        dot
; PRE-NEXT: Args:
; PRE-NEXT:   - String:          Schedule found
; PRE-NEXT:   - Pipeliner:       prepipeliner
; PRE-NEXT:   - II:              '5'
; PRE-NEXT:   - NS:              '3'
; PRE-NEXT:   - Loop:            bb.2.for.body
; PRE-NEXT:   - Prologue:        bb.1.for.body.preheader
; PRE-NEXT:   - PrologueBundles: '10'
; PRE-NEXT:   - Epilogue:        bb.3
; PRE-NEXT:   - EpilogueBundles: '6'
; PRE-NEXT: ...
; PLAIN: --- !Passed
; PLAIN-NEXT: Pass:            pipeliner
; PLAIN-NEXT: Name:            schedule
; PLAIN-NEXT: Function:        dot
; PLAIN-NEXT: Args:
; PLAIN-NEXT:   - String:          Schedule found
; PLAIN-NEXT:   - Pipeliner:       ''
; PLAIN-NEXT:   - II:              '11'
; PLAIN-NEXT:   - NS:              '1'
; PLAIN-NEXT:   - Loop:            bb.2.for.body
; PLAIN-NEXT:   - Prologue:        bb.1.for.body.preheader
; PLAIN-NEXT:   - PrologueBundles: '4'
; PLAIN-NEXT:   - Epilogue:        bb.3.for.end
; PLAIN-NEXT:   - EpilogueBundles: '6'
; PLAIN-NEXT: ...

entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %for.body.preheader, label %for.end

for.body.preheader:
  call void @llvm.set.loop.iterations.i32(i32 %n)
  br label %for.body

for.body:
  %acc = phi i32 [ %madd, %for.body ], [ 0, %for.body.preheader ]
  %a.addr = phi ptr addrspace(6) [ %a.next, %for.body ], [ %a, %for.body.preheader ]
  %b.addr = phi ptr addrspace(6) [ %b.next, %for.body ], [ %b, %for.body.preheader ]
  %va = load i32, ptr addrspace(6) %a.addr, align 4
  %vb = load i32, ptr addrspace(6) %b.addr, align 4
  %mul = mul nsw i32 %va, %vb
  %madd = add nsw i32 %mul, %acc
  %a.next = getelementptr inbounds i8, ptr addrspace(6) %a.addr, i20 2044
  %b.next = getelementptr inbounds i8, ptr addrspace(6) %b.addr, i20 2044
  %loop.dec = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %loop.dec, label %for.body, label %for.end, !llvm.loop !0

for.end:
  %result = phi i32 [ 0, %entry ], [ %madd, %for.body ]
  ret i32 %result
}

declare void @llvm.set.loop.iterations.i32(i32)
declare i1 @llvm.loop.decrement.i32(i32)

!0 = distinct !{!0, !1, !2}
!1 = !{!"llvm.loop.mustprogress"}
!2 = !{!"llvm.loop.itercount.range", i64 10}
