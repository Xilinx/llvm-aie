# RUN: llc --mtriple=aie2 --run-pass=postmisched %s -o - | FileCheck %s

# Resource conflicts across the back edge of a loop-aware block, caused by a
# resource reserved after the last operand access. VMOV_mv_mcd reads its
# operand in cycle 1 and reserves the semaphore interface for 6 more cycles,
# which conflicts with the ACQ at the top of the loop. The scheduler first
# raises the ExitSU latency cap of the VMOV, which is bounded by the last
# cycle in which it reserves a resource. Past that bound it raises the
# resource margin of the block, which blocks the cycles after the loop for
# every instruction.
#
# In cascadeAfterAcq nothing else uses late resources.
# In cascadeAfterAcqLoads the VLDA, the LDA and the VMUL also use resources
# after their last operand access.

---
name:            cascadeAfterAcq
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: cascadeAfterAcq
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $r1, $bmh1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $r1, $bmh1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ACQ_mLockId_imm 0, $r1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   VMOV_mv_mcd $bmh1, implicit $crmcden
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $r0 = ADD_add_r_ri killed $r0, -1, implicit-def $srcarry
  ; CHECK-NEXT:   PseudoLoopEnd %bb.2, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0:
    successors: %bb.1
    liveins: $p0, $r0, $r1, $bmh1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $p0, $r0, $r1, $bmh1
    ACQ_mLockId_imm 0, $r1
    $r0 = ADD_add_r_ri $r0, -1, implicit-def $srcarry
    VMOV_mv_mcd $bmh1, implicit $crmcden
    PseudoLoopEnd %bb.2, %bb.1

  bb.2:
    RET implicit $lr
    DelayedSchedBarrier
...
---
name:            cascadeAfterAcqLoads
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: cascadeAfterAcqLoads
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r0, $r1, $r2, $bmh1, $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r0, $r1, $r2, $bmh1, $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ACQ_mLockId_imm 0, $r1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   VMOV_mv_mcd $bmh1, implicit $crmcden
  ; CHECK-NEXT:   $wl0 = VLDA_dmw_lda_w_ag_idx_imm $p0, 0
  ; CHECK-NEXT:   $r3 = LDA_dms_lda_idx_imm $p1, 0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   BUNDLE implicit-def $r0, implicit-def $srcarry, implicit-def $cm2, implicit killed $r0, implicit $x0, implicit $x1, implicit $r2 {
  ; CHECK-NEXT:     $r0 = ADD_add_r_ri killed $r0, -1, implicit-def $srcarry
  ; CHECK-NEXT:     $cm2 = VMUL_vmac_cm_core_dense $x0, $x1, $r2
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   PseudoLoopEnd %bb.2, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $cm2, $r3, $wl0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier implicit killed $cm2, implicit killed $r3, implicit killed $wl0
  bb.0:
    successors: %bb.1
    liveins: $p0, $p1, $r0, $r1, $r2, $bmh1, $x0, $x1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $p0, $p1, $r0, $r1, $r2, $bmh1, $x0, $x1
    ACQ_mLockId_imm 0, $r1
    $r0 = ADD_add_r_ri $r0, -1, implicit-def $srcarry
    VMOV_mv_mcd $bmh1, implicit $crmcden
    $cm2 = VMUL_vmac_cm_core_dense $x0, $x1, $r2
    $wl0 = VLDA_dmw_lda_w_ag_idx_imm $p0, 0
    $r3 = LDA_dms_lda_idx_imm $p1, 0
    PseudoLoopEnd %bb.2, %bb.1

  bb.2:
    liveins: $cm2, $r3, $wl0
    RET implicit $lr
    DelayedSchedBarrier implicit $cm2, implicit $r3, implicit $wl0
...
