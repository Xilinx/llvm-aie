# REQUIRES: asserts
# RUN: llc --mtriple=aie2 --issue-limit=6 --run-pass=postmisched \
# RUN:     --debug-only=loop-aware %s -o /dev/null 2>&1 | FileCheck %s

# Safety margin at the start of the epilogue of a loop that isn't pipelined.
# Each loop stores the previous cm0 and ends with a VMAC writing the next one.
# The epilogue bb.2 is a single bundle that falls through into bb.3, so the
# ExitSU of the loop/epilogue DAG of getCyclesToRespectTiming stands for bb.3.
# The epilogue starts with the NOPs needed for latency, raised to those needed
# for resources. The latter reserve every cycle behind the epilogue, which the
# VMAC's write of cm0 four cycles after issue still reaches.
#
# In vmacDead nothing reads cm0 after the loop. In vmacLive bb.3 stores it, in
# vmacRead the epilogue does.

# vmacDead
# CHECK: Timing constraints between loop and epilogue require 3 Nops
# CHECK: Emitting 3 safety nops
# vmacLive
# CHECK: Timing constraints between loop and epilogue require 3 Nops
# CHECK: Emitting 3 safety nops
# vmacRead
# CHECK: Timing constraints between loop and epilogue require 4 Nops
# CHECK: Emitting 4 safety nops

---
name:            vmacDead
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $cm0, $cm1, $p1, $p2, $r0, $r1, $r3, $x0, $x1
  bb.1:
    successors: %bb.2, %bb.1
    liveins: $cm0, $cm1, $p1, $p2, $r0, $r1, $r3, $x0, $x1
    VST_dmw_sts_am_ag_idx_imm $amll0, $p1, 0
    $cm0 = VMAC_vmac_cm_core_dense $cm1, $x0, $x1, $r3
    JNZ $r0, %bb.1
    DelayedSchedBarrier
  bb.2:
    successors: %bb.3
    liveins: $p2, $r1
    $r1 = ADD_add_r_ri $r1, 5, implicit-def $srcarry
  bb.3:
    liveins: $p2, $r1
    $r1 = ADD_add_r_ri $r1, 6, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 7, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 8, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 9, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 10, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 11, implicit-def $srcarry
    RET implicit $lr
    DelayedSchedBarrier implicit $r1
...
---
name:            vmacLive
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $cm0, $cm1, $p1, $p2, $r0, $r1, $r3, $x0, $x1
  bb.1:
    successors: %bb.2, %bb.1
    liveins: $cm0, $cm1, $p1, $p2, $r0, $r1, $r3, $x0, $x1
    VST_dmw_sts_am_ag_idx_imm $amll0, $p1, 0
    $cm0 = VMAC_vmac_cm_core_dense $cm1, $x0, $x1, $r3
    JNZ $r0, %bb.1
    DelayedSchedBarrier
  bb.2:
    successors: %bb.3
    liveins: $cm0, $p2, $r1
    $r1 = ADD_add_r_ri $r1, 5, implicit-def $srcarry
  bb.3:
    liveins: $cm0, $p2, $r1
    $r1 = ADD_add_r_ri $r1, 6, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 7, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 8, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 9, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 10, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 11, implicit-def $srcarry
    VST_dmw_sts_am_ag_idx_imm $amll0, $p2, 0
    RET implicit $lr
    DelayedSchedBarrier implicit $r1
...
---
name:            vmacRead
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $cm0, $cm1, $p1, $p2, $r0, $r1, $r3, $x0, $x1
  bb.1:
    successors: %bb.2, %bb.1
    liveins: $cm0, $cm1, $p1, $p2, $r0, $r1, $r3, $x0, $x1
    VST_dmw_sts_am_ag_idx_imm $amll0, $p1, 0
    $cm0 = VMAC_vmac_cm_core_dense $cm1, $x0, $x1, $r3
    JNZ $r0, %bb.1
    DelayedSchedBarrier
  bb.2:
    successors: %bb.3
    liveins: $cm0, $p2, $r1
    VST_dmw_sts_am_ag_idx_imm $amll0, $p2, 0
    $r1 = ADD_add_r_ri $r1, 5, implicit-def $srcarry
  bb.3:
    liveins: $cm0, $p2, $r1
    $r1 = ADD_add_r_ri $r1, 6, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 7, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 8, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 9, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 10, implicit-def $srcarry
    $r1 = ADD_add_r_ri $r1, 11, implicit-def $srcarry
    RET implicit $lr
    DelayedSchedBarrier implicit $r1
...

