# RUN: llc --mtriple=aie2 --run-pass=postmisched %s -o - | FileCheck %s

# Latency of the ExitSU edges of inter-block DAGs. Each function is a two-block
# loop. Post-order schedules the latch bb.2 before the header bb.1, so the
# scoreboard of the latch only reserves the header's instructions, and the
# ExitSU edge of the bb.2 -> bb.1 DAG decides how close the instruction at the
# end of the latch may get to the branch. The exit bb.3 starts with a delay
# chain, so the bb.2 -> bb.3 edge doesn't constrain it.
#
# In vmacLive the VMAC accumulates onto cm0, which is live around the loop. The
# VMAC writes cm0 in cycle 5, the length of its pipeline.
#
# In acqLatch the latch ends with an ACQ. It has no result and reads its
# operand in cycle 1, but its pipeline is 5 cycles long. In acqLatchAcqHeader
# the header starts with another ACQ, and both hold the semaphore interface in
# cycles 2 to 5, so the ACQ of the latch must leave it before the header
# takes it.

---
name:            vmacLive
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: vmacLive
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r2 = ADD_add_r_ri killed renamable $r2, 1, implicit-def dead $srcarry
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $wl0 = VLDA_dmw_lda_w_ag_idx_imm $p2, 0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $r1 = GE renamable $r0, renamable $r2
  ; CHECK-NEXT:   JNZ killed renamable $r1, %bb.1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $cm0 = VMAC_vmac_cm_core_dense killed $cm0, $x0, $x1, $r0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:   $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:   $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:   $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:   BUNDLE implicit-def $p1, implicit killed $p1, implicit $lr {
  ; CHECK-NEXT:     $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:     RET implicit $lr
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:   $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:   $p1 = PADDB_ldb_ptr_inc_nrm_imm killed $p1, 32
  ; CHECK-NEXT:   VST_dmw_sts_am_ag_idx_imm killed $amll0, killed $p1, 0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0:
    successors: %bb.1
    liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1

  bb.1:
    successors: %bb.2
    liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1
    renamable $r2 = ADD_add_r_ri killed renamable $r2, 1, implicit-def dead $srcarry

  bb.2:
    successors: %bb.1, %bb.3
    liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1
    $wl0 = VLDA_dmw_lda_w_ag_idx_imm $p2, 0
    $cm0 = VMAC_vmac_cm_core_dense $cm0, $x0, $x1, $r0
    renamable $r1 = GE renamable $r0, renamable $r2
    JNZ killed renamable $r1, %bb.1
    DelayedSchedBarrier

  bb.3:
    liveins: $cm0, $p0, $p1, $p2, $p3, $r0, $r2, $x0, $x1, $cm1
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    $p1 = PADD_imm9_pseudo $p1, 32
    VST_dmw_sts_am_ag_idx_imm $amll0, $p1, 0
    RET implicit $lr
    DelayedSchedBarrier
...
