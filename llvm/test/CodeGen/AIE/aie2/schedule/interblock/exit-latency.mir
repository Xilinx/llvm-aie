  ; CHECK-NEXT:   liveins: $r0, $r1, $r2, $r4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r3 = GE renamable $r0, renamable $r2
  ; CHECK-NEXT:   JNZ killed renamable $r3, %bb.1
