  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $r16, $r17

    $p6 = MOV_mv_scl $p0
    $p7 = MOV_mv_scl $p1
    renamable $r0 = MOVXM_lng_cg 1065353216
    renamable $r18 = MOV_RLC_imm10_pseudo 0
    $r29 = MOV_SCL_pseudo $r18
    $r21 = MOV_SCL_pseudo $r18
    renamable $x0 = VINSERT_32 undef renamable $x0, killed renamable $r29, killed renamable $r0
    renamable $r19 = MOV_RLC_imm10_pseudo 2
    $bmh0 = VMOV_mv_x killed $x0
    VST_dmw_sts_am_ag_spill killed renamable $amhl0, -128, implicit $sp :: (store (s256) into %stack.1)
    VST_dmw_sts_am_ag_spill killed renamable $amhh0, -96, implicit $sp :: (store (s256) into %stack.2)
    renamable $r20 = MOV_RLC_imm10_pseudo 28

  bb.2.for.body:
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)
    liveins: $p6, $p7, $r16, $r17, $r18, $r19, $r20, $r21

    renamable $r0 = LSHL renamable $r17, renamable $r19
    $dj0 = MOV_mv_scl $r0
    renamable $r1 = LDA_dms_lda_idx renamable $p6, renamable $dj0 :: (load (s32) from %ir.arrayidx)
    $r22 = MOV_SCL_pseudo $r0
    JL &__floatsisf, implicit-def $lr
    DelayedSchedBarrier csr_aie2, implicit $r1, implicit-def $r0
    $r29 = MOV_SCL_pseudo $r21
    renamable $x0 = VINSERT_32 undef renamable $x0, killed renamable $r29, killed renamable $r0
    $bmh0 = VMOV_mv_x killed $x0
    renamable $amhl1 = VLDA_dmw_lda_am_ag_spill -128, implicit $sp :: (load (s256) from %stack.1)
    renamable $amhh1 = VLDA_dmw_lda_am_ag_spill -96, implicit $sp :: (load (s256) from %stack.2)
    renamable $bmh1 = VADD_F killed renamable $bmh0, killed renamable $bmh1, renamable $r20, implicit-def dead $srfpflags, implicit $crfpmask
    $x2 = VMOV_mv_x killed $bmh1
    renamable $r1 = VEXTRACT_S32 killed renamable $x2, renamable $r18
    JL &__fixsfsi, implicit-def $lr
    DelayedSchedBarrier csr_aie2, implicit $r1, implicit-def $r0
    renamable $r17 = nuw nsw ADD_add_r_ri killed renamable $r17, 1, implicit-def dead $srcarry
    renamable $r1 = EQ renamable $r16, renamable $r17
    $dj0 = MOV_mv_scl killed $r22
    ST_dms_sts_idx killed renamable $r0, renamable $p7, killed renamable $dj0 :: (store (s32) into %ir.arrayidx2)
    JZ killed renamable $r1, %bb.2
    DelayedSchedBarrier

  bb.3.for.cond.cleanup:
    $p7 = LDA_dms_spill -28, implicit $sp :: (load (s32) from %stack.12)
    $p6 = LDA_dms_spill -32, implicit $sp :: (load (s32) from %stack.11)
    $r22 = LDA_dms_spill -36, implicit $sp :: (load (s32) from %stack.10)
    $r21 = LDA_dms_spill -40, implicit $sp :: (load (s32) from %stack.9)
