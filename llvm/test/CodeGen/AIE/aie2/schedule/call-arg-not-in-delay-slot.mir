    $r18 = LDA_dms_spill -52, implicit $sp :: (load (s32) from %stack.6)
    $r17 = LDA_dms_spill -56, implicit $sp :: (load (s32) from %stack.5)
    $r16 = LDA_dms_spill -60, implicit $sp :: (load (s32) from %stack.4)
    $lr = LDA_dms_spill -64, implicit $sp :: (load (s32) from %stack.3)
    frame-destroy PADD_sp_imm_pseudo -128, implicit-def $sp, implicit $sp
    RET implicit $lr
