# RUN: llc --start-before=postmisched -mtriple=aie2 %s -o - | FileCheck %s

# Regression test: a load that defines a call's argument register must not be
# scheduled into that call's delay slots. AIE2 is an in-order exposed-pipeline
# machine with no interlocks; a scalar load has a multi-cycle def latency while
# a jl has only 5 delay slots, so a load in the call's delay shadow leaves the
# argument register stale when the callee reads it (a silent miscompile).
#
# This test feeds the post-RA scheduler (postmisched) directly. The int->float
# kernel calls the soft-float helper __floatsisf, whose integer argument is in
# r1. Verify the r1-defining load is emitted before the call, not in its delay
# slots.

--- |
  ; ModuleID = 'llvm/test/CodeGen/AIE/aie2/schedule/call-arg-not-in-delay-slot.mir'
  source_filename = "llvm/test/CodeGen/AIE/aie2/schedule/call-arg-not-in-delay-slot.mir"
  target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "aie2"

  define void @add_one(ptr %input, ptr %output, i32 %tile_size) {
  ; CHECK-LABEL: add_one:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:    paddb [sp], #128; nopxm
  ; CHECK-NEXT:    st lr, [sp, #-64] // 4-byte Folded Spill
  ; CHECK-NEXT:    st r18, [sp, #-52] // 4-byte Folded Spill
  ; CHECK-NEXT:    st r16, [sp, #-60] // 4-byte Folded Spill
  ; CHECK-NEXT:    mova r17, #0; st r17, [sp, #-56] // 4-byte Folded Spill
  ; CHECK-NEXT:    ge r0, r17, r0; mov r16, r0
  ; CHECK-NEXT:    st r19, [sp, #-48]; jnz r0, #.LBB0_3 // 4-byte Folded Spill
  ; CHECK-NEXT:    st r20, [sp, #-44] // 4-byte Folded Spill Delay Slot 5
  ; CHECK-NEXT:    st r21, [sp, #-40] // 4-byte Folded Spill Delay Slot 4
  ; CHECK-NEXT:    st r22, [sp, #-36] // 4-byte Folded Spill Delay Slot 3
  ; CHECK-NEXT:    st p6, [sp, #-32] // 4-byte Folded Spill Delay Slot 2
  ; CHECK-NEXT:    st p7, [sp, #-28] // 4-byte Folded Spill Delay Slot 1
  ; CHECK-NEXT:  // %bb.1:
  ; CHECK-NEXT:    mova r18, #0; movxm r0, #1065353216
  ; CHECK-NEXT:    mov r29, r18
  ; CHECK-NEXT:    vinsert.32 x0, x0, r29, r0
  ; CHECK-NEXT:    vmov bmh0, x0
  ; CHECK-NEXT:    mov p6, p0
  ; CHECK-NEXT:    vst amhl0, [sp, #-128]; mov p7, p1 // 32-byte Folded Spill
  ; CHECK-NEXT:    mova r20, #28; vst amhh0, [sp, #-96]; movx r19, #2; mov r21, r18 // 32-byte Folded Spill
  ; CHECK-NEXT:  .LBB0_2: // %for.body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; lshl r0, r17, r19
  ; CHECK-NEXT:    mov dj0, r0
  ; CHECK-NEXT:    lda r1, [p6, dj0]
  ; CHECK-NEXT:    jl #__floatsisf
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    mov r22, r0 // Delay Slot 1
  ; CHECK-NEXT:    vlda amhl1, [sp, #-128]; nopb ; nopxm ; nops // 32-byte Folded Reload
  ; CHECK-NEXT:    vlda amhh1, [sp, #-96] // 32-byte Folded Reload
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    mov r29, r21
  ; CHECK-NEXT:    vinsert.32 x0, x0, r29, r0
  ; CHECK-NEXT:    vmov bmh0, x0; vadd.f bmh1, bmh0, bmh1, r20
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    jl #__fixsfsi
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    vmov x2, bmh1 // Delay Slot 3
  ; CHECK-NEXT:    vextract.s32 r1, x2, r18 // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ; CHECK-NEXT:    nopa ; nopb ; add r17, r17, #1
  ; CHECK-NEXT:    eq r1, r16, r17
  ; CHECK-NEXT:    jz r1, #.LBB0_2
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    mov dj0, r22 // Delay Slot 2
  ; CHECK-NEXT:    st r0, [p7, dj0] // Delay Slot 1
  ; CHECK-NEXT:  .LBB0_3: // %for.cond.cleanup
  ; CHECK-NEXT:    lda p7, [sp, #-28]; nopb ; nopxm // 4-byte Folded Reload
  ; CHECK-NEXT:    lda p6, [sp, #-32] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda r22, [sp, #-36] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda lr, [sp, #-64] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda r21, [sp, #-40] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda r20, [sp, #-44] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda r19, [sp, #-48] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda r18, [sp, #-52] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda r17, [sp, #-56] // 4-byte Folded Reload
  ; CHECK-NEXT:    lda r16, [sp, #-60] // 4-byte Folded Reload
  ; CHECK-NEXT:    ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    paddb [sp], #-128 // Delay Slot 1
  entry:
    %cmp6 = icmp sgt i32 %tile_size, 0
    br i1 %cmp6, label %for.body.preheader, label %for.cond.cleanup

  for.body.preheader:                               ; preds = %entry
    br label %for.body

  for.cond.cleanup:                                 ; preds = %for.body, %entry
    ret void

  for.body:                                         ; preds = %for.body.preheader, %for.body
    %i.07 = phi i32 [ %inc, %for.body ], [ 0, %for.body.preheader ]
    %arrayidx = getelementptr inbounds i32, ptr %input, i32 %i.07
    %0 = load i32, ptr %arrayidx, align 4
    %conv = sitofp i32 %0 to float
    %add = fadd float %conv, 1.000000e+00
    %conv1 = fptosi float %add to i32
    %arrayidx2 = getelementptr inbounds i32, ptr %output, i32 %i.07
    store i32 %conv1, ptr %arrayidx2, align 4
    %inc = add nuw nsw i32 %i.07, 1
    %exitcond.not = icmp eq i32 %tile_size, %inc
    br i1 %exitcond.not, label %for.cond.cleanup, label %for.body
  }

