body:             |
  bb.0.entry:
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $p0, $p1, $r0, $r16, $r17, $r18, $r19, $r20, $r21, $r22, $p6, $p7

    frame-setup PADD_sp_imm_pseudo 128, implicit-def $sp, implicit $sp
    ST_dms_spill killed $lr, -64, implicit $sp :: (store (s32) into %stack.3)
    ST_dms_spill killed $r16, -60, implicit $sp :: (store (s32) into %stack.4)
    ST_dms_spill killed $r17, -56, implicit $sp :: (store (s32) into %stack.5)
    ST_dms_spill killed $r18, -52, implicit $sp :: (store (s32) into %stack.6)
    ST_dms_spill killed $r19, -48, implicit $sp :: (store (s32) into %stack.7)
    ST_dms_spill killed $r20, -44, implicit $sp :: (store (s32) into %stack.8)
    ST_dms_spill killed $r21, -40, implicit $sp :: (store (s32) into %stack.9)
