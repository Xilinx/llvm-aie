# RUN: llc --mtriple=aie2 --run-pass=postmisched %s -o - | FileCheck %s
# RUN: llc --mtriple=aie2 --run-pass=postmisched --aie-interblock-latency=false \
# RUN:     %s -o - | FileCheck %s

# Instructions that reserve resources after their last operand access, at the
# end of a region. ACQ reads its operand in cycle 1 and holds the semaphore
# interface in cycles 2 to 5. VMOV_mv_mcd reads its operand in cycle 1 and
# reserves the semaphore interface in cycles 2 to 7.
#
# In acqBeforeBarrier and cascadeBeforeBarrier a SCHED_BARRIER ends the region,
# so the region doesn't connect to the successor blocks.
# In acqBeforeFallthrough the ACQ ends a block whose successor starts with
# another ACQ. Without interblock latencies, the ExitSU edges of a bottom region
# also take the latency MaxLatencyFinder gives the instruction.

---
name:            acqBeforeBarrier
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r4
    ; CHECK-LABEL: name: acqBeforeBarrier
    ; CHECK: liveins: $r0, $r1, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ACQ_mLockId_imm 0, killed $r1
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $r0 = ADD_add_r_ri killed $r0, 1, implicit-def $srcarry
    ; CHECK-NEXT: SCHED_BARRIER
    ; CHECK-NEXT: RET implicit $lr
    ; CHECK-NEXT: ACQ_mLockId_imm 1, killed $r4
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: DelayedSchedBarrier
    ACQ_mLockId_imm 0, $r1
    $r0 = ADD_add_r_ri $r0, 1, implicit-def $srcarry
    SCHED_BARRIER
    ACQ_mLockId_imm 1, $r4
    RET implicit $lr
    DelayedSchedBarrier
...
---
name:            cascadeBeforeBarrier
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $bmh1
    ; CHECK-LABEL: name: cascadeBeforeBarrier
    ; CHECK: liveins: $r0, $r1, $bmh1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: VMOV_mv_mcd killed $bmh1, implicit $crmcden
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $r0 = ADD_add_r_ri killed $r0, 1, implicit-def $srcarry
    ; CHECK-NEXT: SCHED_BARRIER
    ; CHECK-NEXT: RET implicit $lr
    ; CHECK-NEXT: ACQ_mLockId_imm 0, killed $r1
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: DelayedSchedBarrier
    VMOV_mv_mcd $bmh1, implicit $crmcden
    $r0 = ADD_add_r_ri $r0, 1, implicit-def $srcarry
    SCHED_BARRIER
    ACQ_mLockId_imm 0, $r1
    RET implicit $lr
    DelayedSchedBarrier
...
---
name:            acqBeforeFallthrough
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: acqBeforeFallthrough
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $r1, $r4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ACQ_mLockId_imm 0, killed $r1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $r0 = ADD_add_r_ri killed $r0, 1, implicit-def $srcarry
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $r0, $r4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   ACQ_mLockId_imm 1, killed $r4
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $r0 = ADD_add_r_ri killed $r0, 1, implicit-def $srcarry
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0:
    successors: %bb.1
    liveins: $r0, $r1, $r4
    $r0 = ADD_add_r_ri $r0, 1, implicit-def $srcarry
    ACQ_mLockId_imm 0, $r1

  bb.1:
    liveins: $r0, $r4
    ACQ_mLockId_imm 1, $r4
    $r0 = ADD_add_r_ri $r0, 1, implicit-def $srcarry
    RET implicit $lr
    DelayedSchedBarrier
...
