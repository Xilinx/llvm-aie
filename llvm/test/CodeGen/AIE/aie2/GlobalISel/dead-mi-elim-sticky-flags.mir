# An instruction that sets a sticky status flag ORs into it: an earlier
# instruction that sets the flag stays live across it, even if its result is
# unused.

---
name:            unused_srs_before_srs
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bml0, $p0, $r0
