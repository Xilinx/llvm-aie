# Negative: 512-bit concat store is below AIE2 threshold (1024).
name:            no_split_concat_store_512
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0, $wl0, $wl2
    ; CHECK-LABEL: name: no_split_concat_store_512
    ; CHECK: liveins: $p0, $wl0, $wl2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<8 x s32>) = COPY $wl0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(<8 x s32>) = COPY $wl2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(<8 x s32>) = COPY [[COPY1]](<8 x s32>)
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:_(<8 x s32>) = COPY [[COPY2]](<8 x s32>)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 32
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C]](s20)
    ; CHECK-NEXT: G_STORE [[COPY4]](<8 x s32>), [[PTR_ADD]](p0) :: (store (<8 x s32>) into unknown-address + 32)
    ; CHECK-NEXT: G_STORE [[COPY3]](<8 x s32>), [[COPY]](p0) :: (store (<8 x s32>), align 64)
    %0:_(p0) = COPY $p0
    %1:_(<8 x s32>) = COPY $wl0
    %2:_(<8 x s32>) = COPY $wl2
