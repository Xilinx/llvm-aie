# RUN: llc -mtriple aie2 -run-pass=aie-postlegalizer-custom-combiner -verify-machineinstrs -o - %s | FileCheck %s

# AIE2 maxVecBitSize=1024: split 1024-bit concat+stores into two 512-bit stores.

---
name:            split_concat_store_1024
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0, $x0, $x2
    ; CHECK-LABEL: name: split_concat_store_1024
    ; CHECK: liveins: $p0, $x0, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<16 x s32>) = COPY $x0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(<16 x s32>) = COPY $x2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 64
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C]](s20)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<8 x s32>), [[UV1:%[0-9]+]]:_(<8 x s32>) = G_UNMERGE_VALUES [[COPY2]](<16 x s32>)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s20) = G_CONSTANT i20 32
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(s20) = G_CONSTANT i20 96
    ; CHECK-NEXT: [[PTR_ADD1:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C2]](s20)
    ; CHECK-NEXT: G_STORE [[UV1]](<8 x s32>), [[PTR_ADD1]](p0) :: (store (<8 x s32>) into unknown-address + 96)
    ; CHECK-NEXT: G_STORE [[UV]](<8 x s32>), [[PTR_ADD]](p0) :: (store (<8 x s32>) into unknown-address + 64, align 64)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(<8 x s32>), [[UV3:%[0-9]+]]:_(<8 x s32>) = G_UNMERGE_VALUES [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: [[PTR_ADD2:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C1]](s20)
    ; CHECK-NEXT: G_STORE [[UV3]](<8 x s32>), [[PTR_ADD2]](p0) :: (store (<8 x s32>) into unknown-address + 32)
    ; CHECK-NEXT: G_STORE [[UV2]](<8 x s32>), [[COPY]](p0) :: (store (<8 x s32>), align 128)
    %0:_(p0) = COPY $p0
    %1:_(<16 x s32>) = COPY $x0
    %2:_(<16 x s32>) = COPY $x2
    %3:_(<32 x s32>) = G_CONCAT_VECTORS %1(<16 x s32>), %2(<16 x s32>)
    G_STORE %3(<32 x s32>), %0(p0) :: (store (<32 x s32>), align 128)
...
