# RUN: llc -mtriple aie2 -run-pass=instruction-select %s -verify-machineinstrs -o - | FileCheck %s

# The source operand of a VUNPACK can be produced by an instruction that is not
# a memory load. Generic AIE intrinsic pseudos (here an SRS intrinsic) are
# conservatively marked mayLoad but carry no memory operand, so the load+unpack
# combine must not fire for them; instead a plain VUNPACK is selected. This used
# to crash instruction selection by querying the (non-existent) memory-operand
# size of the SRS instruction.
---
name:            unpack_src_is_srs_not_load
alignment:       16
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $cm0, $r0, $r1
    ; CHECK-LABEL: name: unpack_src_is_srs_not_load
    ; CHECK: liveins: $cm0, $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:acc1024 = COPY $cm0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:mss = COPY [[COPY1]]
    ; CHECK-NEXT: [[VSRS_S8_S32_mv_w_srs:%[0-9]+]]:vec256 = VSRS_S8_S32_mv_w_srs [[COPY]], [[COPY2]], implicit-def dead $srsrs_of, implicit $crsat, implicit $crrnd
    ; CHECK-NEXT: $crunpacksign = COPY [[COPY1]]
    ; CHECK-NEXT: [[VUNPACK_D16_D8_:%[0-9]+]]:vec512 = VUNPACK_D16_D8 [[VSRS_S8_S32_mv_w_srs]], implicit $crunpacksign
    ; CHECK-NEXT: $crunpacksign = MOV_scalar_imm10_pseudo 0
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VUNPACK_D16_D8_]]
    %1:accregbank(<16 x s64>) = COPY $cm0
    %2:gprregbank(s32) = COPY $r0
    %3:gprregbank(s32) = G_CONSTANT i32 1
    %0:vregbank(<32 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2.I256.v32.acc32.srs), %1(<16 x s64>), %2(s32), %3(s32)
    %4:vregbank(<32 x s16>) = G_INTRINSIC intrinsic(@llvm.aie2.unpack.I16.I8), %0(<32 x s8>), %2(s32)
    PseudoRET implicit $lr, implicit %4
...
