; End-to-end counterpart of inner-loop-versioning-swp.ll for a stated
; threshold. A hint of 4 states the guard threshold and declares the same 4 as
; the high-trip-count copy's minimum iteration count, which is what lets the
; loop be pipelined at all: with no minimum to peel stages against it is
; refused, and only a filled-in guard would supply one. That is the
; placeholder case inner-loop-versioning-swp.ll covers.
;
; A stated threshold is authoritative, so both runs below must show the same
; #4 in the guard. That is the point of the second one: it steers the loop to
; the other pipeliner, which owns the placeholder and would have overwritten
; the guard with its own stage count had the threshold been deferred.
;
; The correctness coupling is the same either way: the guard admits only
; count >= 4, so peeling NStages-1 stages keeps lc = count-(NStages-1) >= 1 as
; long as NStages <= 4. A declared minimum of 4 is what bounds NStages, and
; both pipeliners honour it. They settle on different schedules, NStages 3 and
; 2, hence the two peels below.
;
; What only this test covers is the composition. inner-loop-versioning-
; threshold.ll pins the metadata, and the swp tests pin a declared minimum
; being honoured, but nothing else says that a stated threshold reaches the
; guard and stays there once the loop is pipelined. Kept hand-written for that
; reason: autogenerated checks would bury those few facts in a schedule that
; churns for unrelated reasons.
;
; RUN: llc -mtriple=aie2 -O2 %s -o - | FileCheck %s
; RUN: llc -mtriple=aie2 -O2 -aie-force-postpipeliner %s -o - \
; RUN:   | FileCheck %s --check-prefix=POST

; CHECK-LABEL: stated_threshold:
; POST-LABEL: stated_threshold:
; The guard holds the stated threshold verbatim, whoever pipelines the loop.
; CHECK: mova [[THR:r[0-9]+]], #4
; CHECK: ltu r{{[0-9]+}}, r{{[0-9]+}}, [[THR]]
; POST: mova [[PTHR:r[0-9]+]], #4
; POST: ltu r{{[0-9]+}}, r{{[0-9]+}}, [[PTHR]]
; The low-trip-count (fallback) copy runs verbatim, with an unpeeled ZOL count.
; CHECK-LABEL: %loop.ph
; CHECK: add.nc lc, r{{[0-9]+}}, #0
; CHECK-LABEL: %loop
; The high-trip-count copy is modulo scheduled: its ZOL count loses the peeled
; stages, and the prologue that replaces them precedes the kernel block. The
; peel must stay within the threshold, i.e. no further than #-3 here.
; CHECK-LABEL: %loop.ph.lver.high
; CHECK: add.nc lc, r{{[0-9]+}}, #-2
; CHECK-LABEL: %loop.lver.high
; POST-LABEL: %loop.ph.lver.high
; POST: add.nc lc, r{{[0-9]+}}, #-1
; POST-LABEL: %loop.lver.high

define void @stated_threshold(ptr noalias %a, ptr noalias %b, i32 %n) {
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %pa = getelementptr i32, ptr %a, i32 %i
  %x = load i32, ptr %pa, align 4
  %m1 = mul i32 %x, %x
  %m2 = mul i32 %m1, %x
  %m3 = add i32 %m2, %m1
  %m4 = xor i32 %m3, %x
  %pb = getelementptr i32, ptr %b, i32 %i
  store i32 %m4, ptr %pb, align 4
  %i.next = add i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit, !llvm.loop !0
exit:
  ret void
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.hint.aie-loop-versioning", i64 4}
