# Unit tests for AIEStackSlotMinimization pass (AIE2 target).

# RUN: llc -mtriple=aie2 --verify-machineinstrs \
# RUN:     -run-pass=none -o - %s | FileCheck %s

# RUN: llc -mtriple=aie2 --verify-machineinstrs \
# RUN:     -run-pass=none,prologepilog -o - %s | \
