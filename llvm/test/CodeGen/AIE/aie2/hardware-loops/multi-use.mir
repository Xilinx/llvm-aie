# The store gets the counter from an explicit decrement, which the latch undoes
# before the JNZD.
---
name:            multi_use
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: multi_use
  ; CHECK: bb.0 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $p1 = MOVXM_lng_cg %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = ADD_NC killed renamable $r0, -1
  ; CHECK-NEXT:   ST_dms_sts_idx_imm renamable $r0, renamable $p0, 0 :: (store (s32))
  ; CHECK-NEXT:   $r0 = ADD_NC $r0, 1
  ; CHECK-NEXT:   $r0 = PseudoJNZD $r0, $p1, implicit-def $srcarry
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0 (align 16):
    successors: %bb.1(0x80000000)
    liveins: $p0, $r0
    renamable $p1 = MOVXM_lng_cg %bb.1

  bb.1 (align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p0, $p1, $r0

    renamable $r0 = LoopDec killed renamable $r0, implicit-def $srcarry
    ST_dms_sts_idx_imm renamable $r0, renamable $p0, 0 :: (store (s32))
    LoopJNZ renamable $r0, killed renamable $p1
    PseudoJ_jump_imm %bb.2

  bb.2 (align 16):
    PseudoRET implicit $lr
