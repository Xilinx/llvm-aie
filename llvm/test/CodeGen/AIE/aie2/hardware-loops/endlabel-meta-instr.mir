# RUN: llc -mtriple aie2 -start-after=aie-machine-alignment \
# RUN:   %s -verify-machineinstrs -o - | FileCheck %s
# CHECK: .AnyLabelDefinedHere:
# CHECK:         lda	r1, [p0], #4;		nopx
# CHECK:         // implicit-def: $wh1

# Check that asmprinter emits the last-bundle label from PseudoLoopEnd, implicit $ls, implicit $le
# in the right position

---
name:            lastBundleLabel
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1
  bb.1:
    successors: %bb.2, %bb.1
    liveins: $p0
    BUNDLE {
      $r1, $p0 = LDA_dms_lda_pstm_nrm_imm $p0, 4
      NOPX
    }
    dead renamable $wh1 = IMPLICIT_DEF
    PseudoLoopEnd <mcsymbol .AnyLabelDefinedHere>, %bb.1, implicit $ls, implicit $le

  bb.2:
    PseudoRET implicit $lr
...

## NOTE: These prefixes are unused and the list is autogenerated. Do not add tests below this line:
# CHECK: {{.*}}
