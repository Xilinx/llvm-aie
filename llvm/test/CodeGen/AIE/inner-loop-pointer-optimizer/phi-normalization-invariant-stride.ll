; CHECK-NEXT:    movs dn2, m0; add r2, r1, #1; addm.nc r1, r0, #-1
; CHECK-NEXT:    movs dn3, m0; mov dc3, m0
; CHECK-NEXT:    padda [p1], #192; movs m2, m0; mov dc6, m0
; CHECK-NEXT:    movs p1, p0; mov m4, p1
; CHECK-NEXT:    movs dc4, m0; vldb x2, [p0, #192]; or r3, r8, r8; mov dj4, m0
; CHECK-NEXT:    padda [p0], #128; vldb x4, [p1], m4; movx r8, #0; mov dc0, m0; movs dn4, m0
; CHECK-NEXT:    movs dj3, m0; vldb.3d x6, [p0], d0; mov s0, r8
; CHECK-NEXT:    movs dj1, dj2; mov m1, m0; vclr dm0
; CHECK-NEXT:    movs dj5, m0; movx crsrsmode, #0; mov dn5, m0
; CHECK-NEXT:  .LBB8_1: // %steady.stage1.top
; CHECK-NEXT:    // =>This Loop Header: Depth=1
; CHECK-NEXT:    // Child Loop BB8_2 Depth 2
; CHECK-NEXT:    nopa ; nopb ; nopx ; vmov.d dm2, dm0
; CHECK-NEXT:    vmov.d dm3, dm0
; CHECK-NEXT:    vmov.d dm1, dm0
; CHECK-NEXT:    vaddmac dm3, dm3, dm0, x4, x0, r8
; CHECK-NEXT:    add.nc ls, pc, #.LBB8_2; vaddmac dm2, dm2, dm0, x6, x0, r8
; CHECK-NEXT:    nopa ; nopb ; nops ; add.nc lc, r2, #0; addm.nc le, pc, #.L_LEnd9; vaddmac dm1, dm1, dm0, x2, x0, r8
; CHECK-NEXT:  .LBB8_2: // %steady.stage1.inner.inner
; CHECK-NEXT:    // Parent Loop BB8_1 Depth=1
; CHECK-NEXT:    // => This Inner Loop Header: Depth=2
; CHECK-NEXT:    nopa ; vldb x2, [p1], m3; movs dc1, dc3; nopx ; mov dc5, dc6; nopv
; CHECK-NEXT:    nopa ; vldb.3d x4, [p0], d1; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nopx
; CHECK-NEXT:    vmac dm1, dm1, x0, x0, r8
; CHECK-NEXT:    vmac dm2, dm2, x2, x0, r8
; CHECK-NEXT:  .L_LEnd9:
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac dm3, dm3, x4, x0, r8
; CHECK-NEXT:  // %bb.3: // %steady.stage1.bottom.and.stage0.top
; CHECK-NEXT:    // in Loop: Header=BB8_1 Depth=1
; CHECK-NEXT:    nopa ; nopb ; jnzd r1, r1, p2
; CHECK-NEXT:    vldb x2, [p0, #192]; mov p1, p0 // Delay Slot 5
; CHECK-NEXT:    padda [p0], #128; vldb x4, [p1], m4; movs dc0, m0; mov dc4, m0 // Delay Slot 4
; CHECK-NEXT:    vldb.3d x6, [p0], d0 // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    vsrs.4x x8, dm1, s0, srssign0 // Delay Slot 1
; CHECK-NEXT:  // %bb.4: // %lastiter.stage1.top
; CHECK-NEXT:    vmov.d dm2, dm0
; CHECK-NEXT:    movs dn4, dn2; vmov.d dm3, dm0
; CHECK-NEXT:    movs dn1, dn0; vmov.d dm1, dm0
; CHECK-NEXT:    movs dj1, dj0; add.nc lc, r2, #0; mov m1, m0; vaddmac dm3, dm3, dm0, x4, x0, r8
; CHECK-NEXT:    movs dj5, dj4; add.nc ls, pc, #.LBB8_5; mov dn5, dn2; vaddmac dm2, dm2, dm0, x6, x0, r8
; CHECK-NEXT:    nopa ; nopb ; movs dc4, dc2; add.nc le, pc, #.L_LEnd8; mov dc0, dc2; vaddmac dm1, dm1, dm0, x2, x0, r8
; CHECK-NEXT:  .LBB8_5: // %lastiter.stage1.inner.inner
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nopa ; vldb x2, [p1], m3; movs dc1, dc0; nopx ; mov dc5, dc4; nopv
; CHECK-NEXT:    nopa ; vldb.3d x4, [p0], d1; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nopx
; CHECK-NEXT:    vmac dm1, dm1, x0, x0, r8
; CHECK-NEXT:    vmac dm2, dm2, x2, x0, r8
; CHECK-NEXT:  .L_LEnd8:
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac dm3, dm3, x4, x0, r8
; CHECK-NEXT:  // %bb.6: // %lastiter.stage1.bottom
; CHECK-NEXT:    nopa ; nopxm
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    movx crsrsmode, #0; mov s0, r8 // Delay Slot 5
; CHECK-NEXT:    vsrs.4x x0, dm1, s0, srssign0 // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    or r8, r3, r3 // Delay Slot 1
entry:
  br label %outer

outer:
  %j = phi i32 [ 0, %entry ], [ %j.next, %outer.latch ]
  %pa = phi ptr addrspace(5) [ %a, %entry ], [ %pa.inner.next, %outer.latch ]
  %pa.flat = addrspacecast ptr addrspace(5) %pa to ptr
  %pa2.init = getelementptr i8, ptr %pa.flat, i20 192
  %pa2.init.as = addrspacecast ptr %pa2.init to ptr addrspace(5)
  %x0 = load <32 x i16>, ptr addrspace(5) %pa, align 64
  %pa.128 = getelementptr i8, ptr %pa.flat, i20 128
  %pa.128.as = addrspacecast ptr %pa.128 to ptr addrspace(5)
  %x2 = load <32 x i16>, ptr addrspace(5) %pa.128.as, align 64
  %pa.3d = tail call { ptr, i20, i20 } @llvm.aie2ps.add.3d(ptr %pa.128, i20 0, i20 %d1, i20 0, i20 %d2, i20 0, i20 0, i20 0)
  %x3 = load <32 x i16>, ptr addrspace(5) %pa2.init.as, align 64
  %acc0 = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.addmac.conf(<32 x i16> %x0, <32 x i16> %w, <64 x i32> zeroinitializer, <64 x i32> zeroinitializer, i32 0)
  %acc2 = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.addmac.conf(<32 x i16> %x2, <32 x i16> %w, <64 x i32> zeroinitializer, <64 x i32> zeroinitializer, i32 0)
  %acc3 = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.addmac.conf(<32 x i16> %x3, <32 x i16> %w, <64 x i32> zeroinitializer, <64 x i32> zeroinitializer, i32 0)
  %pa.next.flat = extractvalue { ptr, i20, i20 } %pa.3d, 0
  %pa.next = addrspacecast ptr %pa.next.flat to ptr addrspace(5)
  br label %inner

inner:
  %pa.i = phi ptr addrspace(5) [ %pa.next, %outer ], [ %pa.inner.next, %inner ]
  %i = phi i32 [ 0, %outer ], [ %i.next, %inner ]
  %q = phi ptr [ %pa2.init, %outer ], [ %q.next, %inner ]
  %c3 = phi <64 x i32> [ %acc3, %outer ], [ %c3.next, %inner ]
  %c2 = phi <64 x i32> [ %acc2, %outer ], [ %c2.next, %inner ]
  %c0 = phi <64 x i32> [ %acc0, %outer ], [ %c0.next, %inner ]
  %q.next = getelementptr i8, ptr %q, i20 %stride
  %q.next.as = addrspacecast ptr %q.next to ptr addrspace(5)
  %y0 = load <32 x i16>, ptr addrspace(5) %pa.i, align 64
  %pa.i.flat = addrspacecast ptr addrspace(5) %pa.i to ptr
  %pa.i.3d = tail call { ptr, i20, i20 } @llvm.aie2ps.add.3d(ptr %pa.i.flat, i20 0, i20 %d1, i20 0, i20 %d2, i20 0, i20 0, i20 0)
  %y3 = load <32 x i16>, ptr addrspace(5) %q.next.as, align 64
  %c0.next = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16> %y0, <32 x i16> %w, <64 x i32> %c0, i32 0)
  %c2.next = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16> %y3, <32 x i16> %w, <64 x i32> %c2, i32 0)
  %c3.next = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16> %w, <32 x i16> %w, <64 x i32> %c3, i32 0)
  %i.next = add i32 %i, 1
  %pa.i.next.flat = extractvalue { ptr, i20, i20 } %pa.i.3d, 0
  %pa.inner.next = addrspacecast ptr %pa.i.next.flat to ptr addrspace(5)
  %inner.done = icmp eq i32 %i, %n
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %r0 = tail call <64 x i8> @llvm.aie2ps.I512.v64.acc32.srs(<64 x i32> %c0.next, i32 0, i32 0)
  %r2 = tail call <64 x i8> @llvm.aie2ps.I512.v64.acc32.srs(<64 x i32> %c2.next, i32 0, i32 0)
  %r3 = tail call <64 x i8> @llvm.aie2ps.I512.v64.acc32.srs(<64 x i32> %c3.next, i32 0, i32 0)
  %j.next = add i32 %j, 1
  %outer.done = icmp eq i32 %j.next, %m
  br i1 %outer.done, label %exit, label %outer, !llvm.loop !0

exit:
  ret void
}

; Five inner pointers start at %base + C and share a stride that is invariant
; in the outer loop. Each folded C + %s stays live across the outer loop.
define void @many_pointers_folded_shift(ptr %a, ptr %out, i32 %stride, i32 %n, i32 %m) {
; CHECK-LABEL: many_pointers_folded_shift:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    paddxm [sp], #64; nopb ; movx r4, #64; nopm
; CHECK-NEXT:    mova r6, #128; st p6, [sp, #-64]; add r4, r0, r4; mov m0, r0 // 4-byte Folded Spill
; CHECK-NEXT:    mova r16, #192; movs m1, r4; add r6, r0, r6
; CHECK-NEXT:    mova r18, #256; movs m2, r6; add r16, r0, r16
; CHECK-NEXT:    mova r20, #320; movs m3, r16; add r18, r0, r18
; CHECK-NEXT:    movs m4, r18; add r20, r0, r20
; CHECK-NEXT:    movs m5, r20
; CHECK-NEXT:  .LBB9_1: // %outer
; CHECK-NEXT:    // =>This Loop Header: Depth=1
; CHECK-NEXT:    // Child Loop BB9_2 Depth 2
; CHECK-NEXT:    movs p4, p0; nopb ; nopx
; CHECK-NEXT:    movs p3, p0; add.nc lc, r1, #0; mov p2, p0
; CHECK-NEXT:    padda [p3], m2; paddb [p2], m1; add.nc ls, pc, #.LBB9_2; mov p5, p0; movs p6, p0
; CHECK-NEXT:    padda [p6], m5; paddb [p5], m4; padds [p4], m3; add.nc le, pc, #.L_LEnd10; mov r0, #0; nopv
; CHECK-NEXT:  .LBB9_2: // %inner
; CHECK-NEXT:    // Parent Loop BB9_1 Depth=1
; CHECK-NEXT:    // => This Inner Loop Header: Depth=2
; CHECK-NEXT:    lda r16, [p4], m0; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    lda r4, [p2], m0; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    lda r6, [p3], m0; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    lda r18, [p5], m0; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopx
; CHECK-NEXT:    lda r20, [p6], m0
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    add r4, r4, r6
; CHECK-NEXT:    add r6, r16, r18
; CHECK-NEXT:    add r4, r4, r6
; CHECK-NEXT:    add r4, r4, r20
; CHECK-NEXT:  .L_LEnd10:
; CHECK-NEXT:    nopa ; nopb ; nops ; add r0, r0, r4; nopm ; nopv
; CHECK-NEXT:  // %bb.3: // %outer.latch
; CHECK-NEXT:    // in Loop: Header=BB9_1 Depth=1
; CHECK-NEXT:    nopa ; nopb ; add r2, r2, #-1
; CHECK-NEXT:    jnz r2, #.LBB9_1
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    padda [p0], #64; st r0, [p1, #0] // Delay Slot 1
; CHECK-NEXT:  // %bb.4: // %exit
; CHECK-NEXT:    lda p6, [sp, #-64] // 4-byte Folded Reload
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    paddxm [sp], #-64 // Delay Slot 1
entry:
  %s = trunc i32 %stride to i20
  br label %outer

outer:
  %base = phi ptr [ %a, %entry ], [ %base.next, %outer.latch ]
  %j = phi i32 [ %m, %entry ], [ %j.dec, %outer.latch ]
  %init0 = getelementptr inbounds i8, ptr %base, i20 64
  %init1 = getelementptr inbounds i8, ptr %base, i20 128
  %init2 = getelementptr inbounds i8, ptr %base, i20 192
  %init3 = getelementptr inbounds i8, ptr %base, i20 256
  %init4 = getelementptr inbounds i8, ptr %base, i20 320
  br label %inner

inner:
  %p0 = phi ptr [ %init0, %outer ], [ %p0.next, %inner ]
  %p1 = phi ptr [ %init1, %outer ], [ %p1.next, %inner ]
  %p2 = phi ptr [ %init2, %outer ], [ %p2.next, %inner ]
  %p3 = phi ptr [ %init3, %outer ], [ %p3.next, %inner ]
  %p4 = phi ptr [ %init4, %outer ], [ %p4.next, %inner ]
  %acc = phi i32 [ 0, %outer ], [ %acc.next, %inner ]
  %i = phi i32 [ %n, %outer ], [ %i.dec, %inner ]
  %p0.next = getelementptr inbounds i8, ptr %p0, i20 %s
  %p1.next = getelementptr inbounds i8, ptr %p1, i20 %s
  %p2.next = getelementptr inbounds i8, ptr %p2, i20 %s
  %p3.next = getelementptr inbounds i8, ptr %p3, i20 %s
  %p4.next = getelementptr inbounds i8, ptr %p4, i20 %s
  %v0 = load i32, ptr %p0.next
  %v1 = load i32, ptr %p1.next
  %v2 = load i32, ptr %p2.next
  %v3 = load i32, ptr %p3.next
  %v4 = load i32, ptr %p4.next
  %s01 = add i32 %v0, %v1
  %s23 = add i32 %v2, %v3
  %s0123 = add i32 %s01, %s23
  %sum = add i32 %s0123, %v4
  %acc.next = add i32 %acc, %sum
  %i.dec = add i32 %i, -1
  %cond = icmp ne i32 %i.dec, 0
  br i1 %cond, label %inner, label %outer.latch

outer.latch:
  store i32 %acc.next, ptr %out
  %base.next = getelementptr inbounds i8, ptr %base, i20 64
  %j.dec = add i32 %j, -1
  %outer.cond = icmp ne i32 %j.dec, 0
  br i1 %outer.cond, label %outer, label %exit

exit:
  ret void
}

; The inner loop is guarded and may not run in a given outer iteration.
define void @inner_loop_may_be_skipped(ptr %a, ptr %out, i32 %stride, i32 %n, i32 %m) {
; CHECK-LABEL: inner_loop_may_be_skipped:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mova r4, #192; nopx
; CHECK-NEXT:    add r4, r0, r4; mov m0, r0
; CHECK-NEXT:    mov m1, r4
; CHECK-NEXT:  .LBB10_1: // %outer
; CHECK-NEXT:    // =>This Loop Header: Depth=1
; CHECK-NEXT:    // Child Loop BB10_3 Depth 2
; CHECK-NEXT:    nopa ; nopb ; jz r1, #.LBB10_4; nops
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    mova r0, #0 // Delay Slot 1
; CHECK-NEXT:  // %bb.2: // %inner.ph
; CHECK-NEXT:    // in Loop: Header=BB10_1 Depth=1
; CHECK-NEXT:    movs p2, p0; add.nc lc, r1, #0
; CHECK-NEXT:    padda [p2], m1; nopb ; nops ; add.nc ls, pc, #.LBB10_3; addm.nc le, pc, #.L_LEnd11; nopv
; CHECK-NEXT:  .LBB10_3: // %inner
; CHECK-NEXT:    // Parent Loop BB10_1 Depth=1
; CHECK-NEXT:    // => This Inner Loop Header: Depth=2
; CHECK-NEXT:    lda r4, [p2], m0; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nopxm ; nops
; CHECK-NEXT:    nop
; CHECK-NEXT:  .L_LEnd11:
; CHECK-NEXT:    nopa ; nopb ; nops ; add r0, r0, r4; nopm ; nopv
; CHECK-NEXT:  .LBB10_4: // %outer.latch
; CHECK-NEXT:    // in Loop: Header=BB10_1 Depth=1
; CHECK-NEXT:    nopa ; nopb ; add r2, r2, #-1; nopm ; nops
; CHECK-NEXT:    jnz r2, #.LBB10_1
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    padda [p0], #64; st r0, [p1, #0] // Delay Slot 1
; CHECK-NEXT:  // %bb.5: // %exit
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
  %s = trunc i32 %stride to i20
  %skip = icmp eq i32 %n, 0
  br label %outer

outer:
  %base = phi ptr [ %a, %entry ], [ %base.next, %outer.latch ]
  %j = phi i32 [ %m, %entry ], [ %j.dec, %outer.latch ]
  %init = getelementptr inbounds i8, ptr %base, i20 192
  br i1 %skip, label %outer.latch, label %inner.ph

inner.ph:
  br label %inner

inner:
  %ptr = phi ptr [ %init, %inner.ph ], [ %ptr.next, %inner ]
  %acc = phi i32 [ 0, %inner.ph ], [ %acc.next, %inner ]
  %i = phi i32 [ %n, %inner.ph ], [ %i.dec, %inner ]
  %ptr.next = getelementptr inbounds i8, ptr %ptr, i20 %s
  %v = load i32, ptr %ptr.next
  %acc.next = add i32 %acc, %v
  %i.dec = add i32 %i, -1
  %cond = icmp ne i32 %i.dec, 0
  br i1 %cond, label %inner, label %outer.latch

outer.latch:
  %res = phi i32 [ 0, %outer ], [ %acc.next, %inner ]
  store i32 %res, ptr %out
  %base.next = getelementptr inbounds i8, ptr %base, i20 64
  %j.dec = add i32 %j, -1
  %outer.cond = icmp ne i32 %j.dec, 0
  br i1 %outer.cond, label %outer, label %exit

exit:
  ret void
}

; The back-edge pointer also feeds the exit compare.
define void @exit_on_pointer_compare(ptr %p, ptr %end, ptr %out, i32 %stride) {
; CHECK-LABEL: exit_on_pointer_compare:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; mov m0, r0; nopv
; CHECK-NEXT:    padda [p0], m0; nopx
; CHECK-NEXT:    mova r0, #0; movs p1, p0; mov r2, p1
; CHECK-NEXT:  .LBB11_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lda r4, [p1], m0; mov r6, p0
; CHECK-NEXT:    nopa ; ne r6, r6, r2
; CHECK-NEXT:    jnz r6, #.LBB11_1
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    add r0, r0, r4; mov p0, p1 // Delay Slot 1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    st r0, [p2, #0] // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
  %s = trunc i32 %stride to i20
  br label %loop

loop:
  %ptr = phi ptr [ %p, %entry ], [ %ptr.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %ptr.next = getelementptr inbounds i8, ptr %ptr, i20 %s
  %v = load i32, ptr %ptr.next
  %acc.next = add i32 %acc, %v
  %done = icmp eq ptr %ptr.next, %end
  br i1 %done, label %exit, label %loop

exit:
  store i32 %acc.next, ptr %out
  ret void
}

; Like olp_second_pointer_from_first, with two pointers derived from the
; first one, at +192 and +256.
define void @olp_two_pointers_from_first(ptr addrspace(5) %a, i20 %stride, i20 %d1, i20 %d2, <32 x i16> %w, i32 %m, i32 %n) {
; CHECK-LABEL: olp_two_pointers_from_first:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; mov dj0, p2; nopv
; CHECK-NEXT:    movs p2, p1; mov m3, p1
; CHECK-NEXT:    movs p4, p0; mov dn0, p3
; CHECK-NEXT:    mova m0, #0; movs dn6, p3; movxm p3, #.LBB12_1
; CHECK-NEXT:    movs dn2, m0; add r0, r0, #-1; mov dc2, m0
; CHECK-NEXT:    movs dc3, m0; add r2, r1, #1; addm.nc r1, r0, #-1
; CHECK-NEXT:    movs dc6, m0; mov dn3, m0
; CHECK-NEXT:    mova r8, #0; movs dj2, dj0; or r3, r8, r8; mov m2, m0
; CHECK-NEXT:    movs dj4, m0; mov s0, r8
; CHECK-NEXT:    padda [p1], #256; movs dc0, m0; mov dc4, m0
; CHECK-NEXT:    vlda x2, [p0, #192]; paddb [p2], #192; movs p1, p0; mov m5, p1
; CHECK-NEXT:    padda [p4], #128; vldb x4, [p1], m5; movs m4, p2; mov dn4, m0
; CHECK-NEXT:    movs dj3, m0; vldb.3d x8, [p4], d0; mov dn1, dn6
; CHECK-NEXT:    movs dj1, dj0; vldb x6, [p0, #256]; mov m1, m0; vclr dm0
; CHECK-NEXT:    movs dj5, m0; paddb [p0], m4; movx crsrsmode, #0; mov dn5, m0
; CHECK-NEXT:  .LBB12_1: // %steady.stage1.top
; CHECK-NEXT:    // =>This Loop Header: Depth=1
; CHECK-NEXT:    // Child Loop BB12_2 Depth 2
; CHECK-NEXT:    nopa ; nopb ; nopx ; vmov.d dm2, dm0
; CHECK-NEXT:    vmov.d dm3, dm0
; CHECK-NEXT:    vmov.d dm1, dm0
; CHECK-NEXT:    vaddmac dm3, dm3, dm0, x4, x0, r8
; CHECK-NEXT:    add.nc ls, pc, #.LBB12_2; vaddmac dm2, dm2, dm0, x8, x0, r8
; CHECK-NEXT:    nopa ; nopb ; movs p2, p4; add.nc lc, r2, #0; addm.nc le, pc, #.L_LEnd13; vaddmac dm1, dm1, dm0, x2, x6, r8
; CHECK-NEXT:  .LBB12_2: // %steady.stage1.inner.inner
; CHECK-NEXT:    // Parent Loop BB12_1 Depth=1
; CHECK-NEXT:    // => This Inner Loop Header: Depth=2
; CHECK-NEXT:    nopa ; vldb x4, [p0], m3; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p1], m3; movs dc1, dc3; nopx ; mov dc5, dc6; nopv
; CHECK-NEXT:    nopa ; vldb.3d x6, [p2], d1; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopx
; CHECK-NEXT:    nop
; CHECK-NEXT:    vmac dm2, dm2, x4, x0, r8
; CHECK-NEXT:    vmac dm1, dm1, x2, x0, r8
; CHECK-NEXT:  .L_LEnd13:
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac dm3, dm3, x6, x0, r8
; CHECK-NEXT:  // %bb.3: // %steady.stage1.bottom.and.stage0.top
; CHECK-NEXT:    // in Loop: Header=BB12_1 Depth=1
; CHECK-NEXT:    nopa ; nopb ; jnzd r1, r1, p3; nopm
; CHECK-NEXT:    movs p4, p2; vldb x2, [p2, #192]; mov p1, p2 // Delay Slot 5
; CHECK-NEXT:    padda [p4], #128; vldb x4, [p1], m5; movs dc0, m0; mov dc4, m0 // Delay Slot 4
; CHECK-NEXT:    vldb.3d x8, [p4], d0 // Delay Slot 3
; CHECK-NEXT:    vldb x6, [p2, #256]; mov p0, p2 // Delay Slot 2
; CHECK-NEXT:    padda [p0], m4; vsrs.4x x10, dm1, s0, srssign0 // Delay Slot 1
; CHECK-NEXT:  // %bb.4: // %lastiter.stage1.top
; CHECK-NEXT:    vmov.d dm2, dm0
; CHECK-NEXT:    movs dn4, dn2; vmov.d dm3, dm0
; CHECK-NEXT:    movs dn1, dn0; mov dj1, dj0; vmov.d dm1, dm0
; CHECK-NEXT:    movs dn5, dn2; add.nc lc, r2, #0; mov m1, m0; vaddmac dm3, dm3, dm0, x4, x0, r8
; CHECK-NEXT:    movs dc0, dc2; add.nc ls, pc, #.LBB12_5; mov dj5, dj4; vaddmac dm2, dm2, dm0, x8, x0, r8
; CHECK-NEXT:    nopa ; nopb ; movs p2, p4; add.nc le, pc, #.L_LEnd12; mov dc4, dc2; vaddmac dm1, dm1, dm0, x2, x6, r8
; CHECK-NEXT:  .LBB12_5: // %lastiter.stage1.inner.inner
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nopa ; vldb x4, [p0], m3; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p1], m3; movs dc1, dc0; nopx ; mov dc5, dc4; nopv
; CHECK-NEXT:    nopa ; vldb.3d x6, [p2], d1; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopx
; CHECK-NEXT:    nop
; CHECK-NEXT:    vmac dm2, dm2, x4, x0, r8
; CHECK-NEXT:    vmac dm1, dm1, x2, x0, r8
; CHECK-NEXT:  .L_LEnd12:
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac dm3, dm3, x6, x0, r8
; CHECK-NEXT:  // %bb.6: // %lastiter.stage1.bottom
; CHECK-NEXT:    nopa ; nopb ; nopx
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    movx crsrsmode, #0; mov s0, r8 // Delay Slot 5
; CHECK-NEXT:    vsrs.4x x0, dm1, s0, srssign0 // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    or r8, r3, r3 // Delay Slot 1
entry:
  br label %outer

outer:
  %j = phi i32 [ 0, %entry ], [ %j.next, %outer.latch ]
  %pa = phi ptr addrspace(5) [ %a, %entry ], [ %pa.inner.next, %outer.latch ]
  %pa.flat = addrspacecast ptr addrspace(5) %pa to ptr
  %pa2.init = getelementptr i8, ptr %pa.flat, i20 192
  %pa2.init.as = addrspacecast ptr %pa2.init to ptr addrspace(5)
  %pa3.init = getelementptr i8, ptr %pa.flat, i20 256
  %pa3.init.as = addrspacecast ptr %pa3.init to ptr addrspace(5)
  %x0 = load <32 x i16>, ptr addrspace(5) %pa, align 64
  %pa.128 = getelementptr i8, ptr %pa.flat, i20 128
  %pa.128.as = addrspacecast ptr %pa.128 to ptr addrspace(5)
  %x2 = load <32 x i16>, ptr addrspace(5) %pa.128.as, align 64
  %pa.3d = tail call { ptr, i20, i20 } @llvm.aie2ps.add.3d(ptr %pa.128, i20 0, i20 %d1, i20 0, i20 %d2, i20 0, i20 0, i20 0)
  %x3 = load <32 x i16>, ptr addrspace(5) %pa2.init.as, align 64
  %x4 = load <32 x i16>, ptr addrspace(5) %pa3.init.as, align 64
  %acc0 = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.addmac.conf(<32 x i16> %x0, <32 x i16> %w, <64 x i32> zeroinitializer, <64 x i32> zeroinitializer, i32 0)
  %acc2 = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.addmac.conf(<32 x i16> %x2, <32 x i16> %w, <64 x i32> zeroinitializer, <64 x i32> zeroinitializer, i32 0)
  %acc3 = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.addmac.conf(<32 x i16> %x3, <32 x i16> %x4, <64 x i32> zeroinitializer, <64 x i32> zeroinitializer, i32 0)
  %pa.next.flat = extractvalue { ptr, i20, i20 } %pa.3d, 0
  %pa.next = addrspacecast ptr %pa.next.flat to ptr addrspace(5)
  br label %inner

inner:
  %pa.i = phi ptr addrspace(5) [ %pa.next, %outer ], [ %pa.inner.next, %inner ]
  %i = phi i32 [ 0, %outer ], [ %i.next, %inner ]
  %q = phi ptr [ %pa2.init, %outer ], [ %q.next, %inner ]
  %r = phi ptr [ %pa3.init, %outer ], [ %r.next, %inner ]
  %c3 = phi <64 x i32> [ %acc3, %outer ], [ %c3.next, %inner ]
  %c2 = phi <64 x i32> [ %acc2, %outer ], [ %c2.next, %inner ]
  %c0 = phi <64 x i32> [ %acc0, %outer ], [ %c0.next, %inner ]
  %q.next = getelementptr i8, ptr %q, i20 %stride
  %q.next.as = addrspacecast ptr %q.next to ptr addrspace(5)
  %r.next = getelementptr i8, ptr %r, i20 %stride
  %r.next.as = addrspacecast ptr %r.next to ptr addrspace(5)
  %y0 = load <32 x i16>, ptr addrspace(5) %pa.i, align 64
  %pa.i.flat = addrspacecast ptr addrspace(5) %pa.i to ptr
  %pa.i.3d = tail call { ptr, i20, i20 } @llvm.aie2ps.add.3d(ptr %pa.i.flat, i20 0, i20 %d1, i20 0, i20 %d2, i20 0, i20 0, i20 0)
  %y3 = load <32 x i16>, ptr addrspace(5) %q.next.as, align 64
  %y4 = load <32 x i16>, ptr addrspace(5) %r.next.as, align 64
  %c0.next = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16> %y0, <32 x i16> %w, <64 x i32> %c0, i32 0)
  %c2.next = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16> %y3, <32 x i16> %w, <64 x i32> %c2, i32 0)
  %c3.next = tail call <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16> %y4, <32 x i16> %w, <64 x i32> %c3, i32 0)
  %i.next = add i32 %i, 1
  %pa.i.next.flat = extractvalue { ptr, i20, i20 } %pa.i.3d, 0
  %pa.inner.next = addrspacecast ptr %pa.i.next.flat to ptr addrspace(5)
  %inner.done = icmp eq i32 %i, %n
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %r0 = tail call <64 x i8> @llvm.aie2ps.I512.v64.acc32.srs(<64 x i32> %c0.next, i32 0, i32 0)
  %r2 = tail call <64 x i8> @llvm.aie2ps.I512.v64.acc32.srs(<64 x i32> %c2.next, i32 0, i32 0)
  %r3 = tail call <64 x i8> @llvm.aie2ps.I512.v64.acc32.srs(<64 x i32> %c3.next, i32 0, i32 0)
  %j.next = add i32 %j, 1
  %outer.done = icmp eq i32 %j.next, %m
  br i1 %outer.done, label %exit, label %outer, !llvm.loop !4

exit:
  ret void
}

declare { ptr, i20, i20 } @llvm.aie2ps.add.3d(ptr, i20, i20, i20, i20, i20, i20, i20)
declare <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.addmac.conf(<32 x i16>, <32 x i16>, <64 x i32>, <64 x i32>, i32)
declare <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16>, <32 x i16>, <64 x i32>, i32)
declare <64 x i8> @llvm.aie2ps.I512.v64.acc32.srs(<64 x i32>, i32, i32)

!0 = distinct !{!0, !1, !2, !3}
!1 = !{!"llvm.loop.mustprogress"}
!2 = !{!"llvm.loop.itercount.range", i64 2}
!3 = !{!"llvm.loop.hint.aie-enable-outer-loop-pipelining", i64 1}
!4 = distinct !{!4, !1, !2, !3}
