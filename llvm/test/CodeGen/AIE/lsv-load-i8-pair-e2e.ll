; AIE2PS-LABEL: load_v2i8_extract_add_store:
; AIE2PS:       // %bb.0: // %entry
; AIE2PS-NEXT:    lda.s16 r0, [p0, #0]; nopb ; nops ; nopxm ; nopv
; AIE2PS-NEXT:    nopx
