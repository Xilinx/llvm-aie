    successors: %bb.1(0x80000000)
    liveins: $p0, $p1, $r0, $r1

    renamable $r2 = MOV_RLC_imm10_pseudo -5
    renamable $r3 = MOV_RLC_imm10_pseudo 0
    renamable $r1 = LSHL killed renamable $r1, killed renamable $r2
    renamable $x0 = VBCST_16 killed renamable $r0
    renamable $r0 = MOV_RLC_imm11_pseudo 824
    EVENT 0
    $lc = ADD_NC $r1, 0
    $ls = MOVXM_lng_cg %bb.1
    $le = MOVXM_lng_cg <mcsymbol .L_LEnd0>
    $s0 = MOV_mv_scl killed $r3

  bb.1.for.body (align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p0, $p1, $r0, $s0, $x0

    renamable $wh2 = VLD_idx_imm_3x32_pseudo renamable $p0, 32 :: (load (<32 x s8>) from %ir.pA1.06 + 32, !tbaa !2, !noalias !5)
    renamable $wl2, renamable $p0 = VLD_pstm_imm_4x32_pseudo killed renamable $p0, 64 :: (load (<32 x s8>) from %ir.pA1.06, !tbaa !2, !noalias !5)
    renamable $cm0 = VMUL_vmac_cm_core_dense killed renamable $x2, renamable $x0, renamable $r0
    VST_SRS_S16_S32_ag_idx_imm renamable $p1, 32, renamable $bmh0, renamable $s0, implicit-def $srsrs_of, implicit $crsat, implicit $crrnd :: (store (<16 x s16>) into %ir.pC1.05 + 32, !tbaa !2)
    renamable $p1 = VST_SRS_S16_S32_ag_pstm_nrm_imm killed renamable $p1, 64, killed renamable $bml0, renamable $s0, implicit-def $srsrs_of, implicit $crsat, implicit $crrnd :: (store (<16 x s16>) into %ir.pC1.05, !tbaa !2)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.for.cond.cleanup:
