; Test that i32 loads are NOT vectorized on AIE2PS when all users ultimately
; truncate to i20, even through PHI chains. The prelegalizer combiner
; (matchNarrowTruncLoad) can narrow these to s20 loads that go directly to
; pointer/modifier registers, which is more profitable than a 64-bit vector
; load followed by extraction.

; RUN: opt -mtriple=aie2ps -passes=load-store-vectorizer -S < %s | FileCheck %s

define void @load_i32_trunc_i20(ptr noalias %src, ptr noalias %dst) {
; CHECK-LABEL: @load_i32_trunc_i20(
; CHECK-NOT:     load <2 x i32>
; CHECK:         load i32
; CHECK:         load i32
;
entry:
  %v0 = load i32, ptr %src, align 8
  %p1 = getelementptr inbounds i32, ptr %src, i20 1
  %v1 = load i32, ptr %p1, align 4
  %t0 = trunc i32 %v0 to i20
  %t1 = trunc i32 %v1 to i20
  store i20 %t0, ptr %dst, align 4
  %d1 = getelementptr inbounds i20, ptr %dst, i20 1
  store i20 %t1, ptr %d1, align 4
  ret void
}

; Test that the i20 trunc guard also works through PHI chains.
; The load feeds a PHI which then truncates to i20.
define void @load_i32_trunc_i20_phi_chain(ptr noalias %src, ptr noalias %dst, i1 %cond) {
; CHECK-LABEL: @load_i32_trunc_i20_phi_chain(
; CHECK-NOT:     load <2 x i32>
; CHECK:         load i32
; CHECK:         load i32
;
entry:
  %v0 = load i32, ptr %src, align 8
  %p1 = getelementptr inbounds i32, ptr %src, i20 1
  %v1 = load i32, ptr %p1, align 4
  br i1 %cond, label %left, label %right

left:
  br label %merge

right:
  br label %merge

merge:
  %phi0 = phi i32 [ %v0, %left ], [ %v0, %right ]
  %phi1 = phi i32 [ %v1, %left ], [ %v1, %right ]
  %t0 = trunc i32 %phi0 to i20
  %t1 = trunc i32 %phi1 to i20
  store i20 %t0, ptr %dst, align 4
  %d1 = getelementptr inbounds i20, ptr %dst, i20 1
  store i20 %t1, ptr %d1, align 4
  ret void
}
