; Test that two consecutive i8 stores are merged into a single <2 x i8> store.
; The isLegalToVectorizeStoreChain TTI hook returns true for chains >= 2 bytes,
; allowing two adjacent i8 stores to be combined into a 16-bit store. This is
; beneficial because part-word stores are LMS (load-modify-store) operations
; that are more expensive than word-aligned stores.

; RUN: opt -mtriple=aie2 -passes=load-store-vectorizer -S < %s | FileCheck %s
; RUN: opt -mtriple=aie2p -passes=load-store-vectorizer -S < %s | FileCheck %s
; RUN: opt -mtriple=aie2ps -passes=load-store-vectorizer -S < %s | FileCheck %s

define void @store_i8_pair(i8 %a, i8 %b, ptr noalias %dst) {
; CHECK-LABEL: @store_i8_pair(
; CHECK:         store <2 x i8>
;
entry:
  store i8 %a, ptr %dst, align 2
  %d1 = getelementptr inbounds i8, ptr %dst, i20 1
  store i8 %b, ptr %d1, align 1
  ret void
}
