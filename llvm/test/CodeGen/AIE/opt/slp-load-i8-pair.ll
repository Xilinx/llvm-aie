; Test that two consecutive i8 loads are merged into a single <2 x i8> load.
; The getLoadVectorFactor TTI hook returns 2 for 8-bit loads, allowing the
; load-store-vectorizer to combine pairs of adjacent i8 loads into 16-bit
; loads. This is profitable because extraction from <2 x i8> only needs
; one shift and one extend per element.

; RUN: opt -mtriple=aie2 -passes=load-store-vectorizer -S < %s | FileCheck %s
; RUN: opt -mtriple=aie2p -passes=load-store-vectorizer -S < %s | FileCheck %s
; RUN: opt -mtriple=aie2ps -passes=load-store-vectorizer -S < %s | FileCheck %s

define void @load_i8_pair(ptr noalias %src, ptr noalias %dst) {
; CHECK-LABEL: @load_i8_pair(
; CHECK:         [[VEC:%.*]] = load <2 x i8>, ptr %src, align 2
; CHECK:         [[V0:%.*]] = extractelement <2 x i8> [[VEC]], i32 0
; CHECK:         [[V1:%.*]] = extractelement <2 x i8> [[VEC]], i32 1
;
entry:
  %v0 = load i8, ptr %src, align 2
  %p1 = getelementptr inbounds i8, ptr %src, i20 1
  %v1 = load i8, ptr %p1, align 1
  %d0 = getelementptr inbounds i8, ptr %dst, i20 0
  %d1 = getelementptr inbounds i8, ptr %dst, i20 1
  store i8 %v0, ptr %d0, align 2
  store i8 %v1, ptr %d1, align 1
  ret void
}
