; RUN: opt -mtriple=aie2p -passes=loop-reduce -S %s | FileCheck %s

; Handle shifts within SCEV expressions

define void @trunc_shl_gep(ptr %base, i32 %n) {
; CHECK-LABEL: define void @trunc_shl_gep(
; CHECK-SAME: ptr [[BASE:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LSR_IV1:%.*]] = phi ptr [ [[SCEVGEP:%.*]], %[[LOOP]] ], [ [[BASE]], %[[ENTRY]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[LOOP]] ], [ [[N]], %[[ENTRY]] ]
; CHECK-NEXT:    store i8 0, ptr [[LSR_IV1]], align 1
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV]], -1
; CHECK-NEXT:    [[SCEVGEP]] = getelementptr i8, ptr [[LSR_IV1]], i20 2
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[LSR_IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;

entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %next, %loop ]
  %idx = trunc i32 %iv to i20
  %byte.idx = shl i20 %idx, 1
  %ptr = getelementptr inbounds i8, ptr %base, i20 %byte.idx
  store i8 0, ptr %ptr, align 1
  %next = add nuw nsw i32 %iv, 1
  %done = icmp eq i32 %next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}
