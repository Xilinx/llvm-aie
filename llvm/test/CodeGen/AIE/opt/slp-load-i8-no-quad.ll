; Test that four consecutive i8 loads are NOT merged into a single <4 x i8>
; load. The getLoadVectorFactor TTI hook limits load vectorization to 2
; elements for 8-bit loads. With 4 elements, each extraction would need a
; different shift amount plus an extend, making it more expensive than four
; individual part-word loads with implicit sign extension.
; The LSV may still create two <2 x i8> loads (pairs), but never <4 x i8>.

; RUN: opt -mtriple=aie2 -passes=load-store-vectorizer -S < %s | FileCheck %s
; RUN: opt -mtriple=aie2p -passes=load-store-vectorizer -S < %s | FileCheck %s
; RUN: opt -mtriple=aie2ps -passes=load-store-vectorizer -S < %s | FileCheck %s

define void @load_i8_no_quad(ptr noalias %src, ptr noalias %dst) {
; CHECK-LABEL: @load_i8_no_quad(
; CHECK-NOT:     load <4 x i8>
; CHECK:         load <2 x i8>
;
entry:
  %v0 = load i8, ptr %src, align 4
  %p1 = getelementptr inbounds i8, ptr %src, i20 1
  %v1 = load i8, ptr %p1, align 1
  %p2 = getelementptr inbounds i8, ptr %src, i20 2
  %v2 = load i8, ptr %p2, align 1
  %p3 = getelementptr inbounds i8, ptr %src, i20 3
  %v3 = load i8, ptr %p3, align 1
  store i8 %v0, ptr %dst, align 4
  %d1 = getelementptr inbounds i8, ptr %dst, i20 1
  store i8 %v1, ptr %d1, align 1
  %d2 = getelementptr inbounds i8, ptr %dst, i20 2
  store i8 %v2, ptr %d2, align 1
  %d3 = getelementptr inbounds i8, ptr %dst, i20 3
  store i8 %v3, ptr %d3, align 1
  ret void
}
