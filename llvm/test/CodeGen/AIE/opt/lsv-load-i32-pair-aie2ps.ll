; Test that two consecutive i32 loads are merged into a single <2 x i32> load
; on AIE2PS only. AIE2PS has a 64-bit scalar LDA instruction
; (LDA_dml_lda_scalar_L) that loads into eL registers, making this legal.
; AIE2 and AIE2P do not have this instruction and must NOT vectorize i32
; load pairs.

; RUN: opt -mtriple=aie2ps -passes=load-store-vectorizer -S < %s | FileCheck --check-prefix=AIE2PS %s
; RUN: opt -mtriple=aie2 -passes=load-store-vectorizer -S < %s | FileCheck --check-prefix=AIE2 %s
; RUN: opt -mtriple=aie2p -passes=load-store-vectorizer -S < %s | FileCheck --check-prefix=AIE2P %s

define void @load_i32_pair(ptr noalias %src, ptr noalias %dst) {
; AIE2PS-LABEL: @load_i32_pair(
; AIE2PS:         load <2 x i32>
;
; AIE2-LABEL: @load_i32_pair(
; AIE2-NOT:     load <2 x i32>
; AIE2:         load i32
;
; AIE2P-LABEL: @load_i32_pair(
; AIE2P-NOT:    load <2 x i32>
; AIE2P:        load i32
;
entry:
  %v0 = load i32, ptr %src, align 8
  %p1 = getelementptr inbounds i32, ptr %src, i20 1
  %v1 = load i32, ptr %p1, align 4
  store i32 %v0, ptr %dst, align 8
  %d1 = getelementptr inbounds i32, ptr %dst, i20 1
  store i32 %v1, ptr %d1, align 4
  ret void
}
