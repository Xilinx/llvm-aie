# RUN: not --crash llc -mtriple=aie2 -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=aie2p -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=AIE2P

# This test ensures that the Machine Verifier detects illegal G_<S/Z>EXT_EXTRACT_VECTOR_ELT

---
name:            ok
alignment:       16
body:             |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    ; AIE2P-NOT: Bad machine code
    %0:_(<32 x s16>) = COPY $x0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s32) = G_AIE_SEXT_EXTRACT_VECTOR_ELT %0(<32 x s16>), %1(s32)
    %3:_(s32) = G_AIE_ZEXT_EXTRACT_VECTOR_ELT %0(<32 x s16>), %1(s32)
...

---
name:            nok_dst
legalized: true
alignment:       16
body:             |
  bb.0 (align 16):
    ; CHECK-COUNT-4: Bad machine code: Expected 32bit scalar destination
    ; CHECK-COUNT-2: Bad machine code: Operation is only legal for 512-bit vector sources
    ; CHECK-NOT: Bad machine code
    ; AIE2P-COUNT-4: Bad machine code: Expected 32/64bit scalar destination
    ; AIE2P-COUNT-2: Bad machine code: Operation is only legal for 512-bit vector sources
    ; AIE2P-NOT: Bad machine code
    %0:_(<32 x s16>) = COPY $x0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s16) = G_AIE_SEXT_EXTRACT_VECTOR_ELT %0(<32 x s16>), %1(s32)
    %3:_(s16) = G_AIE_ZEXT_EXTRACT_VECTOR_ELT %0(<32 x s16>), %1(s32)
    %4:_(<64 x s8>) = COPY $x0
    %5:_(s8) = G_AIE_SEXT_EXTRACT_VECTOR_ELT %4(<64 x s8>), %1(s32)
    %6:_(s8) = G_AIE_ZEXT_EXTRACT_VECTOR_ELT %4(<64 x s8>), %1(s32)
    %7:_(<16 x s16>) = COPY $wl0
    %8:_(s32) = G_AIE_SEXT_EXTRACT_VECTOR_ELT %7(<16 x s16>), %1(s32)
    %9:_(s32) = G_AIE_ZEXT_EXTRACT_VECTOR_ELT %7(<16 x s16>), %1(s32)
...
