    ; CHECK-NEXT: renamable $wl0 = VLDA_dmw_lda_w_ld_idx_imm killed renamable $p0, 0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: BUNDLE implicit-def $dm0, implicit $lr, implicit killed $dm0, implicit $x0, implicit killed $x1, implicit killed $r8 {
    ; CHECK-NEXT:   RET implicit $lr
    ; CHECK-NEXT:   renamable $dm0 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm0, renamable $x0, killed renamable $x1, killed renamable $r8
    ; CHECK-NEXT: }
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: VST_dmw_sts_w_st_idx_imm killed renamable $wl0, killed renamable $p1, 0
    ; CHECK-NEXT: NOP
