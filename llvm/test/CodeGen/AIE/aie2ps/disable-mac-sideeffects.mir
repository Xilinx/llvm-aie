    renamable $dm0 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm0, killed renamable $x0, killed renamable $x1, killed renamable $r8
    renamable $wl0 = VLDA_dmw_lda_w_ld_idx_imm renamable killed $p0, 0
    VST_dmw_sts_w_st_idx_imm killed renamable $wl0, renamable killed $p1, 0
    RET implicit $lr
