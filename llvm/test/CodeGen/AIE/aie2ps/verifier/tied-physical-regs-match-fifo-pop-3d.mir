# RUN: not --crash llc -mtriple=aie2ps -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    $x0, $p0, $lf0, $r24, $dc0, $dc4 = VLDA_POP_3D_dmx_lda_fifo_x $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc1, $dc5 = VLDA_POP_3D_dmx_lda_fifo_ex_bfp16 $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc2, $dc6 = VLDA_POP_3D_dmx_lda_fifo_fex_bfp13 $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
    $x0, $p1, $lf1, $r25, $dc3, $dc7 = VLDB_POP_3D_dmx_ldb_fifo_x $p1, $lf1, $r25, $d3_3d, implicit-def $srfifo_uf
    $ex0, $p0, $lf0, $r24, $dc0, $dc4 = VLDB_POP_3D_dmx_ldb_fifo_ex_bfp16 $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $fex0, $p1, $lf1, $r25, $dc1, $dc5 = VLDB_POP_3D_dmx_ldb_fifo_fex_bfp13 $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $x0, $p0, $lf0, $r24, $dc2, $dc6 = VLD_POP_512_3D_pseudo $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc3, $dc7 = VLD_POP_640_3D_pseudo $p1, $lf1, $r25, $d3_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc0, $dc4 = VLD_POP_768_3D_pseudo $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc1, $dc5 = VLDA_POP_s_3D $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $ex0, $p0, $lf0, $r24, $dc2, $dc6 = VLDB_POP_s_3D $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc3, $dc7 = VLD_POP_s_3D_pseudo $p1, $lf1, $r25, $d3_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc0, $dc4 = VLDA_POP_mx4_3D $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $fex0, $p1, $lf1, $r25, $dc1, $dc5 = VLDB_POP_mx4_3D $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc2, $dc6 = VLD_POP_mx4_3D_pseudo $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
...

---
name:      virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:eps = COPY $p0
    %1:eldfiforeg = COPY $lf0
    %2:mref2a = COPY $r24
    %3:eds = COPY $d0_3d
    $x0, %10:eps, %11:eldfiforeg, %12:mref2a, %13:edcl, %14:edch = VLDA_POP_3D_dmx_lda_fifo_x %0, %1, %2, %3, implicit-def $srfifo_uf
...

---
name:      tied_nok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-COUNT-15: *** Bad machine code: Tied physical registers must match ***
    $x0, $p0, $lf0, $r24, $dc7, $dc3 = VLDA_POP_3D_dmx_lda_fifo_x $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc0, $dc4 = VLDA_POP_3D_dmx_lda_fifo_ex_bfp16 $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc1, $dc5 = VLDA_POP_3D_dmx_lda_fifo_fex_bfp13 $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
    $x0, $p1, $lf1, $r25, $dc2, $dc6 = VLDB_POP_3D_dmx_ldb_fifo_x $p1, $lf1, $r25, $d3_3d, implicit-def $srfifo_uf
    $ex0, $p0, $lf0, $r24, $dc3, $dc7 = VLDB_POP_3D_dmx_ldb_fifo_ex_bfp16 $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $fex0, $p1, $lf1, $r25, $dc4, $dc0 = VLDB_POP_3D_dmx_ldb_fifo_fex_bfp13 $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $x0, $p0, $lf0, $r24, $dc5, $dc1 = VLD_POP_512_3D_pseudo $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc6, $dc2 = VLD_POP_640_3D_pseudo $p1, $lf1, $r25, $d3_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc7, $dc3 = VLD_POP_768_3D_pseudo $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc0, $dc4 = VLDA_POP_s_3D $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $ex0, $p0, $lf0, $r24, $dc1, $dc5 = VLDB_POP_s_3D $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25, $dc2, $dc6 = VLD_POP_s_3D_pseudo $p1, $lf1, $r25, $d3_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc3, $dc7 = VLDA_POP_mx4_3D $p0, $lf0, $r24, $d0_3d, implicit-def $srfifo_uf
    $fex0, $p1, $lf1, $r25, $dc4, $dc0 = VLDB_POP_mx4_3D $p1, $lf1, $r25, $d1_3d, implicit-def $srfifo_uf
    $fex0, $p0, $lf0, $r24, $dc5, $dc1 = VLD_POP_mx4_3D_pseudo $p0, $lf0, $r24, $d2_3d, implicit-def $srfifo_uf
...
