# RUN: not --crash llc -mtriple=aie2ps -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s

---
name:      fillx_tied_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    $p0, $lf0, $r24 = VLDB_FILLX $r30, $r30, $p0, $lf0, $r24, implicit-def $lfe, implicit $lfe
...

---
name:      fillx_virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:eps = COPY $p0
    %1:eldfiforeg = COPY $lf0
    %2:mref2b = COPY $r24
    %3:eps, %4:eldfiforeg, %5:mref2b = VLDB_FILLX $r30, $r30, %0, %1, %2, implicit-def $lfe, implicit $lfe
...

---
name:      tied_nok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-COUNT-2: *** Bad machine code: Tied physical registers must match ***
    $p0, $lf0, $r24 = VLDB_FILLX $r30, $r30, $p1, $lf0, $r24, implicit-def $lfe, implicit $lfe
    $x0, $p0, $lf0, $r24 = VLDB_POPX $r30, $r30, $p1, $lf0, $r24, implicit-def $lfe, implicit-def $srfifo_uf, implicit $lfe
...
