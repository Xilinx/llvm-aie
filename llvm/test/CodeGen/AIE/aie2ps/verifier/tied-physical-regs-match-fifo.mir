# RUN: not --crash llc -mtriple=aie2ps -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s

---
name:      fill_tied_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    $p0, $lf0, $r24 = VLDA_FILL $p0, $lf0, $r24
    $p1, $lf1, $r25 = VLDB_FILL $p1, $lf1, $r25
    $p0, $lf0, $r24 = VLD_FILL_512_pseudo $p0, $lf0, $r24

...

---
name:      fill_tied_nok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-COUNT-3: *** Bad machine code: Tied physical registers must match ***
    $p0, $lf0, $r24 = VLDA_FILL $p1, $lf0, $r24
    $p1, $lf1, $r25 = VLDB_FILL $p1, $lf0, $r25
    $p0, $lf0, $r24 = VLD_FILL_512_pseudo $p0, $lf1, $r24

...

---
name:      pop_normal_tied_ok
alignment:    16
body:      |
  bb.0 (align 16):
    $x0, $p0, $lf0, $r24 = VLDA_POP_dmx_lda_fifo_x_normal_pop $p0, $lf0, $r24, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25 = VLDB_POP_dmx_ldb_fifo_ex_bfp16_normal_pop $p1, $lf1, $r25, implicit-def $srfifo_uf
    $ex0, $p0, $lf0, $r24 = VLD_POP_640_normal_pop_pseudo $p0, $lf0, $r24, implicit-def $srfifo_uf

...

---
name:      pop_fifo_1d_tied_ok
alignment:    16
body:      |
  bb.0 (align 16):
    $x0, $p0, $lf0, $r24 = VLDA_POP_dmx_lda_fifo_x_fifo_1d_pop $p0, $lf0, $r24, $m0, implicit-def $srfifo_uf
    $ex0, $p1, $lf1, $r25 = VLDB_POP_dmx_ldb_fifo_fex_bfp13_fifo_1d_pop $p1, $lf1, $r25, $m1, implicit-def $srfifo_uf
    $x0, $p0, $lf0, $r24 = VLD_POP_512_fifo_1d_pop_pseudo $p0, $lf0, $r24, $m0, implicit-def $srfifo_uf

...
