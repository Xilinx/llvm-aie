# RUN: not --crash llc -mtriple=aie2ps -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s
#
# This test ensures that the Machine Verifier detects tied physical registers
# that don't match.

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    $p2, $dc1 = PADDA_2D $p2, $d1
    $p3, $dc2 = PADDB_2D $p3, $d2
    $p4, $dc3 = PADDS_2D $p4, $d3
    $p1, $dc0 = PADD_2D_pseudo $p1, $d0

    $p5, $dc0, $dc4 = PADDA_3D $p5, $d0_3d
    $p6, $dc1, $dc5 = PADDB_3D $p6, $d1_3d
    $p7, $dc2, $dc6 = PADDS_3D $p7, $d2_3d
    $p0, $dc3, $dc7 = PADD_3D_pseudo $p0, $d3_3d

    ; The renamable attributes below should trigger no verification error.
    renamable $p2, renamable $dc1 = PADDA_2D renamable $p2, renamable $d1
    renamable $p3, renamable $dc2 = PADDB_2D renamable $p3, renamable $d2
    renamable $p4, renamable $dc3 = PADDS_2D renamable $p4, renamable $d3
    renamable $p1, renamable $dc0 = PADD_2D_pseudo renamable $p1, renamable $d0
    renamable $p0, renamable $dc3, renamable $dc7 = PADD_3D_pseudo renamable $p0, renamable $d3_3d
...

---
name:      virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:ep = COPY $p0
    %10:ed = COPY $d0
    %20:eds = COPY $d0_3d
    %30:ep, %31:edc = PADDA_2D %0, %10
    %40:ep, %41:edc = PADDB_2D %0, %10
    %50:ep, %51:edc = PADDS_2D %0, %10
    %55:ep, %56:edc = PADD_2D_pseudo %0, %10

    %60:ep, %61:edcl, %62:edch = PADDA_3D %0, %20
    %70:ep, %71:edcl, %72:edch = PADDB_3D %0, %20
    %80:ep, %81:edcl, %82:edch = PADDS_3D %0, %20
    %85:ep, %86:edcl, %87:edch = PADD_3D_pseudo %0, %20
...

---
name:      tied_nok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-COUNT-8: Bad machine code: Tied physical registers must match
    $p2, $dc7 = PADDA_2D $p2, $d1
    $p3, $dc1 = PADDB_2D $p3, $d2
    $p4, $dc2 = PADDS_2D $p4, $d3
    $p1, $dc4 = PADD_2D_pseudo $p1, $d0

    $p5, $dc3, $dc4 = PADDA_3D $p5, $d0_3d
    $p6, $dc0, $dc5 = PADDB_3D $p6, $d1_3d
    $p7, $dc1, $dc6 = PADDS_3D $p7, $d2_3d
    $p0, $dc0, $dc1 = PADD_3D_pseudo $p0, $d3_3d
...
