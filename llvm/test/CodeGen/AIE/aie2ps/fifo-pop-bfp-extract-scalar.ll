; RUN: llc -verify-machineinstrs -mtriple=aie2ps %s -o - | FileCheck %s

; Reading the scalar sub-tile or exponent fields of a popped block vector used
; to fail instruction selection, because the users were selected first and
; constrained the results to register classes the pop cannot define. The
; values are now copied out of the E/G registers.

define void @bfp640_pop_exp(ptr noalias %o, ptr noalias %i) {
; CHECK-LABEL: bfp640_pop_exp:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mova r25, #0; nopb ; nopxm
; CHECK-NEXT:    vldb.fill [p1, lf1, r25]
; CHECK-NEXT:    vlda.pop ex0, [p1, lf1, r25]
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    mov r0, el0 // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    st r0, [p0, #0] // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
  %fill = tail call { ptr, <32 x i32>, i32 } @llvm.aie2ps.fifo.ld.fill.p0.p0(ptr %i, <32 x i32> poison, i32 0)
  %p = extractvalue { ptr, <32 x i32>, i32 } %fill, 0
  %f = extractvalue { ptr, <32 x i32>, i32 } %fill, 1
  %a = extractvalue { ptr, <32 x i32>, i32 } %fill, 2
  %pop = tail call { ptr, <32 x i32>, i32, <16 x i32>, <2 x i32>, <2 x i32> } @llvm.aie2ps.fifo.ld.pop.BFP640.p0.p0(ptr %p, <32 x i32> %f, i32 %a)
  %exp = extractvalue { ptr, <32 x i32>, i32, <16 x i32>, <2 x i32>, <2 x i32> } %pop, 5
  %e0 = extractelement <2 x i32> %exp, i64 0
  store i32 %e0, ptr %o, align 4
  ret void
}

