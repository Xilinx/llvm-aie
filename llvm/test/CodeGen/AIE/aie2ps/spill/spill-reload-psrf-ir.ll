; End-to-end (IR -> assembly) test for ePSRFLdF (plfr) register spill/reload
; across a function call. The fifo state {ptr, fifo_buf, avail_count} must
; survive the call, which forces a spill of the whole plfr composite:
;   - the 1024-bit FIFO buffer (lf0) is bounced through x and stored with two
;     64-byte vst at offsets -192 and -128,
;   - the 32-bit availability count (r24) is stored at offset -64,
;   - the 20-bit pointer (p0) is stored at offset -60,
; and reloaded symmetrically after the call.

declare void @clobber()
declare { ptr, <32 x i32>, i32 } @llvm.aie2ps.fifo.ld.fill.p0.p0(ptr, <32 x i32>, i32)

define { ptr, <32 x i32>, i32 } @test_plfr_spill_across_call(ptr %base, <32 x i32> %fifo_buf, i32 %avail) {
; CHECK-LABEL: test_plfr_spill_across_call:
; CHECK:       // %bb.0:
; CHECK-NEXT:    or r24, r1, r1; mov p0, p1
; CHECK-NEXT:    vldb.fill [p0, lf0, r24]; nopx
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    vmov lfl0, x6
; CHECK-NEXT:    vmov lfh0, x7
; CHECK-NEXT:    paddxm [sp], #192
; CHECK-NEXT:    st lr, [sp, #-56]; jl #clobber // 4-byte Folded Spill
; CHECK-NEXT:    st r24, [sp, #-64]; vmov x0, lfl0 // 4-byte Folded Spill Delay Slot 5
; CHECK-NEXT:    st p0, [sp, #-60]; vmov x1, lfh0 // 4-byte Folded Spill Delay Slot 4
; CHECK-NEXT:    vst x0, [sp, #-192] // 64-byte Folded Spill Delay Slot 3
; CHECK-NEXT:    vst x1, [sp, #-128] // 64-byte Folded Spill Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
; CHECK-NEXT:    lda lr, [sp, #-56]; nopx // 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    vlda x0, [sp, #-192] // 64-byte Folded Reload
; CHECK-NEXT:    vlda x1, [sp, #-128] // 64-byte Folded Reload
; CHECK-NEXT:    lda r24, [sp, #-64] // 4-byte Folded Reload
; CHECK-NEXT:    lda p0, [sp, #-60] // 4-byte Folded Reload
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    vmov x4, x0 // Delay Slot 3
; CHECK-NEXT:    vmov x5, x1 // Delay Slot 2
; CHECK-NEXT:    paddxm [sp], #-192; mov r0, r24 // Delay Slot 1
; Spill: bounce the FIFO buffer through x, store the scalars, then store both
; FIFO-buffer halves (the vst land in the call's delay slots).
; Reload: load both FIFO-buffer halves and the scalars back.
  %state = call { ptr, <32 x i32>, i32 } @llvm.aie2ps.fifo.ld.fill.p0.p0(ptr %base, <32 x i32> %fifo_buf, i32 %avail)
  call void @clobber()
  ret { ptr, <32 x i32>, i32 } %state
}
