    VST_PLFR_SPILL killed renamable $y0, $r24, $p0, %stack.0, implicit $sp :: (store (s1088) into %stack.0, align 64)
    PseudoJL 32, csr_aie2ps, implicit-def $lr
    dead renamable $y0, renamable $plfr0 = VLDA_PLFR_SPILL %stack.0, implicit $sp :: (load (s1088) from %stack.0, align 64)
