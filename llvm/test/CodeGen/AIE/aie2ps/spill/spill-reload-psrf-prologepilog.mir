    ; CHECK-NEXT: $p0 = LDA_dms_lda_scalar_ld_idx killed $p0, killed $dj0 :: (load (s32) from %stack.0 + 132, basealign 64)
    ; CHECK-NEXT: $lf0 = COPY killed $y0
