    ; CHECK-NEXT: $dj0 = MOVXM_lng_cg -49984
    ; CHECK-NEXT: $x1 = VLDA_dmx_lda_x_ld_idx killed $p0, killed $dj0 :: (load (s512) from %stack.0 + 64)
    ; CHECK-NEXT: $p0 = MOV_alu_mv_mv_mv_scl $sp
