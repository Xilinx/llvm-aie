    ; CHECK-NEXT: $r24 = LDA_dms_lda_scalar_ld_idx killed $p0, killed $dj0 :: (load (s32) from %stack.0 + 128, align 64)
    ; CHECK-NEXT: $p0 = MOV_alu_mv_mv_mv_scl $sp
