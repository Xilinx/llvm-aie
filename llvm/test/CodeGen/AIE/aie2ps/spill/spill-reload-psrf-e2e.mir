# RUN: llc -mtriple=aie2ps -run-pass=greedy -run-pass=virtregrewriter -run-pass=prologepilog --verify-machineinstrs %s -o - | FileCheck %s

# End-to-end test for ePSRFLdF spill/reload: verify that the VST_PLFR_SPILL
# and VLDA_PLFR_SPILL pseudos are correctly expanded into individual
# store/load instructions during prologepilog (eliminateFrameIndex).

---
name:            test_epsrfldf_e2e
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $plfr0
    ; CHECK-LABEL: name: test_epsrfldf_e2e
    ; CHECK: liveins: $plfr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: frame-setup PADDXM_pstm_sp_imm 192, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: ST_dms_sts_scalar_spill killed $lr, -56, implicit $sp :: (store (s32) into %stack.1)
    ; CHECK-NEXT: renamable $y0 = COPY $lf0
    ; CHECK-NEXT: VST_dmx_sts_x_spill $x0, -192, implicit $sp :: (store (s512) into %stack.0)
    ; CHECK-NEXT: VST_dmx_sts_x_spill $x1, -128, implicit $sp :: (store (s512) into %stack.0 + 64)
    ; CHECK-NEXT: ST_dms_sts_scalar_spill $r24, -64, implicit $sp :: (store (s32) into %stack.0 + 128, align 64)
    ; CHECK-NEXT: ST_dms_sts_scalar_spill $p0, -60, implicit $sp :: (store (s32) into %stack.0 + 132, basealign 64)
    ; CHECK-NEXT: PseudoJL 32, csr_aie2ps, implicit-def $lr
    ; CHECK-NEXT: $x0 = VLDA_dmx_lda_x_spill -192, implicit $sp :: (load (s512) from %stack.0)
    ; CHECK-NEXT: $x1 = VLDA_dmx_lda_x_spill -128, implicit $sp :: (load (s512) from %stack.0 + 64)
    ; CHECK-NEXT: $r24 = LDA_dms_lda_scalar_spill -64, implicit $sp :: (load (s32) from %stack.0 + 128, align 64)
    ; CHECK-NEXT: $p0 = LDA_dms_lda_scalar_spill -60, implicit $sp :: (load (s32) from %stack.0 + 132, basealign 64)
    ; CHECK-NEXT: $lf0 = COPY killed $y0
    ; CHECK-NEXT: $lr = LDA_dms_lda_scalar_spill -56, implicit $sp :: (load (s32) from %stack.1)
    ; CHECK-NEXT: frame-destroy PADDXM_pstm_sp_imm -192, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $plfr0
    %0:epsrfldf = COPY $plfr0
    PseudoJL 32, csr_aie2ps, implicit-def $lr
    PseudoRET implicit $lr, implicit %0
...
