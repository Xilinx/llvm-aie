    ; CHECK-NEXT: renamable $bmll0 = VLDA_BM_SPILL %stack.0, implicit $sp :: (load (s512) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $bmll0
    %0:acc512 = COPY $bmll0
    PseudoJL 32, csr_aie2ps, implicit-def $lr
