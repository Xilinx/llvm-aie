# There is only one BM register available, it will then be used for the %0
# virtual register. Here we test that it is properly spilled and then reloaded.
---
name:            test_512_scarce_regs
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $x0, $r0, $p0, $bmll1, $bmll2, $bmll3, $bmll4, $bmll5, $bmll6, $bmll7, $bmlh0, $bmlh1, $bmlh2, $bmlh3, $bmlh4, $bmlh5, $bmlh6, $bmlh7, $bmhh0, $bmhh1, $bmhh2, $bmhh3, $bmhh4, $bmhh5, $bmhh6, $bmhh7, $bmhl0, $bmhl1, $bmhl2, $bmhl3, $bmhl4, $bmhl5, $bmhl6, $bmhl7

    ; CHECK-LABEL: name: test_512_scarce_regs
    ; CHECK: liveins: $bmhh0, $bmhh1, $bmhh2, $bmhh3, $bmhh4, $bmhh5, $bmhh6, $bmhh7, $bmhl0, $bmhl1, $bmhl2, $bmhl3, $bmhl4, $bmhl5, $bmhl6, $bmhl7, $bmlh0, $bmlh1, $bmlh2, $bmlh3, $bmlh4, $bmlh5, $bmlh6, $bmlh7, $bmll1, $bmll2, $bmll3, $bmll4, $bmll5, $bmll6, $bmll7, $p0, $r0, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $bmll0 = COPY $x0
    ; CHECK-NEXT: VST_BM_SPILL killed renamable $bmll0, %stack.0, implicit $sp :: (store (s512) into %stack.0)
    ; CHECK-NEXT: $bmll0 = COPY $bmll1
    ; CHECK-NEXT: ST_dms_sts_scalar_st_idx_imm $r0, $p0, 0, implicit $bmll0, implicit $bmll1, implicit $bmll2, implicit $bmll3, implicit $bmll4, implicit $bmll5, implicit $bmll6, implicit $bmll7, implicit $bmlh0, implicit $bmlh1, implicit $bmlh2, implicit $bmlh3, implicit $bmlh4, implicit $bmlh5, implicit $bmlh6, implicit $bmlh7, implicit $bmhh0, implicit $bmhh1, implicit $bmhh2, implicit $bmhh3, implicit $bmhh4, implicit $bmhh5, implicit $bmhh6, implicit $bmhh7, implicit $bmhl0, implicit $bmhl1, implicit $bmhl2, implicit $bmhl3, implicit $bmhl4, implicit $bmhl5, implicit $bmhl6, implicit $bmhl7
    ; CHECK-NEXT: renamable $bmll0 = VLDA_BM_SPILL %stack.0, implicit $sp :: (load (s512) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $bmll0
    %0:acc512 = COPY $x0 ; -> only $bmll0 is available

    $bmll0 = COPY $bmll1
    ST_dms_sts_scalar_st_idx_imm $r0, $p0, 0, implicit $bmll0, implicit $bmll1, implicit $bmll2, implicit $bmll3, implicit $bmll4, implicit $bmll5, implicit $bmll6, implicit $bmll7, implicit $bmlh0, implicit $bmlh1, implicit $bmlh2, implicit $bmlh3, implicit $bmlh4, implicit $bmlh5, implicit $bmlh6, implicit $bmlh7, implicit $bmhh0, implicit $bmhh1, implicit $bmhh2, implicit $bmhh3, implicit $bmhh4, implicit $bmhh5, implicit $bmhh6, implicit $bmhh7, implicit $bmhl0, implicit $bmhl1, implicit $bmhl2, implicit $bmhl3, implicit $bmhl4, implicit $bmhl5, implicit $bmhl6, implicit $bmhl7

    PseudoRET implicit $lr, implicit %0
...

---
name:            test_512_caller_saved
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $bmll0

    ; CHECK-LABEL: name: test_512_caller_saved
    ; CHECK: liveins: $bmll0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: VST_BM_SPILL $bmll0, %stack.0, implicit $sp :: (store (s512) into %stack.0)
