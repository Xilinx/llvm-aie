# RUN: llc -mtriple=aie2ps --verify-machineinstrs -run-pass=greedy -run-pass=virtregrewriter %s -o - | FileCheck %s

# There is only one register available, it will then be used for the %0
# virtual register. Here we test that it is properly spilled and then reloaded.

---
name:            test_e_scarce_regs
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $el0, $r0, $p0, $e1, $e2, $e3, $e4, $e5, $e6, $e7, $e8, $e9, $e10, $e11

    ; CHECK-LABEL: name: test_e_scarce_regs
    ; CHECK: liveins: $e1, $e2, $e3, $e4, $e5, $e6, $e7, $e8, $e9, $e10, $e11, $el0, $p0, $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: VST_E_SPILL $el0, %stack.0, implicit $sp :: (store (s32) into %stack.0)
    ; CHECK-NEXT: $e0 = COPY $e1
    ; CHECK-NEXT: ST_dms_sts_scalar_st_idx_imm $r0, $p0, 0, implicit $e0, implicit $e1, implicit $e2, implicit $e3, implicit $e4, implicit $e5, implicit $e6, implicit $e7, implicit $e8, implicit $e9, implicit $e10, implicit $e11
    ; CHECK-NEXT: renamable $el0 = VLDA_E_SPILL %stack.0, implicit $sp :: (load (s32) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $el0
    %0:mes = COPY $el0 ; -> only $e0 is available

    $e0 = COPY $e1
    ST_dms_sts_scalar_st_idx_imm $r0, $p0, 0, implicit $e0, implicit $e1, implicit $e2, implicit $e3, implicit $e4, implicit $e5, implicit $e6, implicit $e7, implicit $e8, implicit $e9, implicit $e10, implicit $e11

    PseudoRET implicit $lr, implicit %0
...

---
name:            test_e_caller_saved
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $e0

    ; CHECK-LABEL: name: test_e_caller_saved
    ; CHECK: liveins: $e0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $el0 = COPY $e0
    ; CHECK-NEXT: VST_E_SPILL killed renamable $el0, %stack.0, implicit $sp :: (store (s32) into %stack.0)
    ; CHECK-NEXT: PseudoJL 32, csr_aie2ps, implicit-def $lr
    ; CHECK-NEXT: renamable $el0 = VLDA_E_SPILL %stack.0, implicit $sp :: (load (s32) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $el0
    %0:mes = COPY $e0
    PseudoJL 32, csr_aie2ps, implicit-def $lr
    PseudoRET implicit $lr, implicit %0
...

