      isImmutable: true, isAliased: false, callee-saved-register: '' }
body:             |
  bb.1.entry:
    liveins: $l0, $l4, $l6, $l7, $r11, $l1, $l2, $l3, $l9, $l10, $l11, $l12, $l13, $l14, $l15

    ; CHECK-LABEL: name: test_l_no_call
    ; CHECK: liveins: $l0, $l1, $l2, $l3, $l4, $l6, $l7, $l9, $l10, $l11, $l12, $l13, $l14, $l15, $r11, $r8, $r9
