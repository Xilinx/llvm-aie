; CHECK-NEXT:    vldb x2, [p0], #128; add.nc lc, r0, #-9
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; add.nc ls, pc, #.LBB1_1; addm.nc le, pc, #.L_LEnd1; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopx ; vadd.32 x4, x2, x0; nopv
