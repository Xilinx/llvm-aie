; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0 // Delay Slot 5
; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0 // Delay Slot 4
; CHECK-NEXT:    vst x4, [p1], #128 // Delay Slot 3
; CHECK-NEXT:    vst x4, [p1], #128 // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
