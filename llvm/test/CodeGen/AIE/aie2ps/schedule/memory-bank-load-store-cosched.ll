loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ps = phi ptr addrspace(5) [ %buf, %entry ], [ %ps.next, %loop ]
  %pd = phi ptr addrspace(5) [ %buf, %entry ], [ %pd.next, %loop ]
  %v = load <16 x i32>, ptr addrspace(5) %ps, align 64
  %a = add <16 x i32> %v, %inc
  store <16 x i32> %a, ptr addrspace(5) %pd, align 64
  %ps.next = getelementptr i8, ptr addrspace(5) %ps, i20 128
  %pd.next = getelementptr i8, ptr addrspace(5) %pd, i20 128
  %i.next = add i32 %i, 1
  %c = icmp eq i32 %i.next, %n
