; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    nopa ; nopb ; vst x4, [p1], #128; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:    nopa ; vst x4, [p1], #128; nopx ; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0
