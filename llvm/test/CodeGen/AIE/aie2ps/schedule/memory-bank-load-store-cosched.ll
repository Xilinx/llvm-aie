; RUN: llc -O2 %s -o - | FileCheck %s

; Reproducer for the memory bank model not matching the hardware.
;
; Each user visible data memory bank (addrspace 5/6/7/8) is built from two
; physical banks, interleaved on 64 byte words: the 64 byte word at address A
; lives in physical bank (A / 64) % 2 of its user visible bank. The scoreboard
; only knows the user visible bank, so it cannot tell which of the two
; physical banks a load and a store hit.
;
; Currently, a store never occupies a bank in the scoreboard, so the
; post-pipeliner is free to schedule a load and a store to the same user visible
; bank in the same bundle. Whether this stalls on hardware depends on the
; physical banks:
;
;   - The load and the store of the same bundle hit the same physical bank:
;     the hardware stalls. Not co-scheduling them would be better, even at the
;     cost of a higher II.
;   - They hit different physical banks: no stall. Co-scheduling them is
;     optimal and gives II=1.
;
; Both loops below are identical except for the 64 byte offset of the store
; relative to the load. Each iteration loads and stores one 64 byte vector and
; advances both pointers by 128 bytes, so the bundle that holds the load of
; iteration i + k and the store of iteration i always has an address difference
; of (store_base - load_base) mod 128, independent of the pipeline depth k:
;
;   @other_physical_bank: difference is 64, banks differ, no stall on HW.
;   @same_physical_bank:  difference is 0, banks are the same, stalls on HW.
;
; Both get the same II=1 schedule with a vldb and a vst in the loop bundle.
; Reinserting the store into the scoreboard (mayLoad() || mayStore() in
; AIEHazardRecognizer::getMemoryBanks) changes both loops to II=2 with the vst
; and the vldb in separate bundles. That fixes @same_physical_bank but
; regresses @other_physical_bank by 2x. Properly modelling the physical banks
; would keep II=1 for the second and get a conflict free schedule for the
; first one.

target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
target triple = "aie2ps-none-unknown-elf"

; The store address is 64 bytes above the load address: the other physical bank.
define void @other_physical_bank(ptr addrspace(5) noalias %buf, <16 x i32> %inc, i32 %n) {
; CHECK-LABEL: other_physical_bank:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    movs p1, p0; vldb x2, [p0], #128; nopm
; CHECK-NEXT:    vldb x2, [p0], #128; add.nc lc, r0, #-9
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; add.nc ls, pc, #.LBB0_1; addm.nc le, pc, #.L_LEnd0; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; nops ; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:    padda [p1], #64; vldb x2, [p0], #128; nops ; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:  .L_LEnd0:
; CHECK-NEXT:    nopa ; vldb x2, [p0], #128; vst x4, [p1], #128; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    nopa ; nopb ; vst x4, [p1], #128; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:    nopa ; vst x4, [p1], #128; nopx ; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #128; ret lr; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0 // Delay Slot 5
; CHECK-NEXT:    vst x4, [p1], #128; vadd.32 x4, x2, x0 // Delay Slot 4
; CHECK-NEXT:    vst x4, [p1], #128 // Delay Slot 3
; CHECK-NEXT:    vst x4, [p1], #128 // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
  %dst0 = getelementptr i8, ptr addrspace(5) %buf, i20 64
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ps = phi ptr addrspace(5) [ %buf, %entry ], [ %ps.next, %loop ]
  %pd = phi ptr addrspace(5) [ %dst0, %entry ], [ %pd.next, %loop ]
  %v = load <16 x i32>, ptr addrspace(5) %ps, align 64
  %a = add <16 x i32> %v, %inc
  store <16 x i32> %a, ptr addrspace(5) %pd, align 64
  %ps.next = getelementptr i8, ptr addrspace(5) %ps, i20 128
  %pd.next = getelementptr i8, ptr addrspace(5) %pd, i20 128
  %i.next = add i32 %i, 1
  %c = icmp eq i32 %i.next, %n
  br i1 %c, label %exit, label %loop, !llvm.loop !0

exit:
  ret void
}

; The store writes the word that was loaded k iterations earlier, so every
; co-scheduled load/store pair hits the same physical bank.
