# An instruction reading a register defined in a predecessor block has depth 0,
# because the edge from the region's entry node carries no latency. The
# bottom-up heuristics then rank it as pure slack and schedule it last, which
# places it at the top of the block and forces the predecessor to pad the
# definition's latency with NOPs.
#
# Biasing the depth of such nodes by the latency they inherit from the
# predecessor lets them sink to the bottom instead, so the load latency is
# covered by the successor's own instructions.

---
# The use of $r6 competes against four independent ADDs. All five have depth 0,
# so the ranking is decided by the incoming latency alone: with the bias the use
# sinks to the end of bb.1 and bb.0 needs a single NOP instead of five.
name:            live_in_use_sinks
alignment:       16
tracksRegLiveness: true
body:             |
  ; BIAS-LABEL: name: live_in_use_sinks
  ; BIAS: bb.0:
  ; BIAS-NEXT:   successors: %bb.1(0x80000000)
  ; BIAS-NEXT:   liveins: $p1
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT:   $r6 = LDA_dms_lda_scalar_ld_idx_imm killed $p1, 4
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   DelayedSchedBarrier
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT: bb.1:
  ; BIAS-NEXT:   liveins: $r6, $r1, $r2, $r3, $r4
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT:   RET implicit $lr
  ; BIAS-NEXT:   $r11 = ADD_add_r_ri killed $r1, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r12 = ADD_add_r_ri killed $r2, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r13 = ADD_add_r_ri killed $r3, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r14 = ADD_add_r_ri killed $r4, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r10 = ADD_add_r_ri killed $r6, 4, implicit-def $srcarry
  ; BIAS-NEXT:   DelayedSchedBarrier
  ;
  ; NOBIAS-LABEL: name: live_in_use_sinks
  ; NOBIAS: bb.0:
  ; NOBIAS-NEXT:   successors: %bb.1(0x80000000)
  ; NOBIAS-NEXT:   liveins: $p1
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT:   $r6 = LDA_dms_lda_scalar_ld_idx_imm killed $p1, 4
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   DelayedSchedBarrier
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT: bb.1:
  ; NOBIAS-NEXT:   liveins: $r6, $r1, $r2, $r3, $r4
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT:   RET implicit $lr
  ; NOBIAS-NEXT:   $r10 = ADD_add_r_ri killed $r6, 4, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r11 = ADD_add_r_ri killed $r1, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r12 = ADD_add_r_ri killed $r2, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r13 = ADD_add_r_ri killed $r3, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r14 = ADD_add_r_ri killed $r4, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   DelayedSchedBarrier
  bb.0:
    successors: %bb.1
    liveins: $p1
    $r6 = LDA_dms_lda_scalar_ld_idx_imm $p1, 4
    DelayedSchedBarrier

  bb.1:
    liveins: $r6, $r1, $r2, $r3, $r4
    $r10 = ADD_add_r_ri $r6, 4, implicit-def $srcarry
    $r11 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
    $r12 = ADD_add_r_ri $r2, 1, implicit-def $srcarry
    $r13 = ADD_add_r_ri $r3, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r4, 1, implicit-def $srcarry
    RET implicit $lr
    DelayedSchedBarrier
...

---
# $r6 reaches bb.3 from two predecessors defining it with very different
# latencies. The use still sinks, so the load in bb.1 rather than the ADD in
# bb.2 is what drives the bias.
name:            max_over_preds
alignment:       16
tracksRegLiveness: true
body:             |
  ; BIAS-LABEL: name: max_over_preds
  ; BIAS: bb.0:
  ; BIAS-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; BIAS-NEXT:   liveins: $p1, $r1, $r5
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT:   JNZ killed $r5, %bb.2
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   DelayedSchedBarrier
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT: bb.1:
  ; BIAS-NEXT:   successors: %bb.3(0x80000000)
  ; BIAS-NEXT:   liveins: $p1
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT:   J_lng %bb.3
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   $r6 = LDA_dms_lda_scalar_ld_idx_imm killed $p1, 4
  ; BIAS-NEXT:   NOP
  ; BIAS-NEXT:   DelayedSchedBarrier
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT: bb.2:
  ; BIAS-NEXT:   successors: %bb.3(0x80000000)
  ; BIAS-NEXT:   liveins: $r1
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT:   $r6 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
  ; BIAS-NEXT:   DelayedSchedBarrier
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT: bb.3:
  ; BIAS-NEXT:   liveins: $r6, $r1, $r2, $r3, $r4
  ; BIAS-NEXT: {{  $}}
  ; BIAS-NEXT:   RET implicit $lr
  ; BIAS-NEXT:   $r11 = ADD_add_r_ri killed $r1, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r12 = ADD_add_r_ri killed $r2, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r13 = ADD_add_r_ri killed $r3, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r14 = ADD_add_r_ri killed $r4, 1, implicit-def $srcarry
  ; BIAS-NEXT:   $r10 = ADD_add_r_ri killed $r6, 4, implicit-def $srcarry
  ; BIAS-NEXT:   DelayedSchedBarrier
  ;
  ; NOBIAS-LABEL: name: max_over_preds
  ; NOBIAS: bb.0:
  ; NOBIAS-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NOBIAS-NEXT:   liveins: $p1, $r1, $r5
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT:   JNZ killed $r5, %bb.2
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   DelayedSchedBarrier
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT: bb.1:
  ; NOBIAS-NEXT:   successors: %bb.3(0x80000000)
  ; NOBIAS-NEXT:   liveins: $p1
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT:   BUNDLE implicit-def $r6, implicit killed $p1 {
  ; NOBIAS-NEXT:     $r6 = LDA_dms_lda_scalar_ld_idx_imm killed $p1, 4
  ; NOBIAS-NEXT:     J_lng %bb.3
  ; NOBIAS-NEXT:   }
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   NOP
  ; NOBIAS-NEXT:   DelayedSchedBarrier
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT: bb.2:
  ; NOBIAS-NEXT:   successors: %bb.3(0x80000000)
  ; NOBIAS-NEXT:   liveins: $r1
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT:   $r6 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   DelayedSchedBarrier
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT: bb.3:
  ; NOBIAS-NEXT:   liveins: $r6, $r1, $r2, $r3, $r4
  ; NOBIAS-NEXT: {{  $}}
  ; NOBIAS-NEXT:   RET implicit $lr
  ; NOBIAS-NEXT:   $r10 = ADD_add_r_ri killed $r6, 4, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r11 = ADD_add_r_ri killed $r1, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r12 = ADD_add_r_ri killed $r2, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r13 = ADD_add_r_ri killed $r3, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   $r14 = ADD_add_r_ri killed $r4, 1, implicit-def $srcarry
  ; NOBIAS-NEXT:   DelayedSchedBarrier
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $p1, $r1, $r5
    JNZ $r5, %bb.2
    DelayedSchedBarrier

  bb.1:
    successors: %bb.3
    liveins: $p1
    $r6 = LDA_dms_lda_scalar_ld_idx_imm $p1, 4
    J_lng %bb.3
    DelayedSchedBarrier

  bb.2:
    successors: %bb.3
    liveins: $r1
    $r6 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
    DelayedSchedBarrier

  bb.3:
    liveins: $r6, $r1, $r2, $r3, $r4
    $r10 = ADD_add_r_ri $r6, 4, implicit-def $srcarry
    $r11 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
    $r12 = ADD_add_r_ri $r2, 1, implicit-def $srcarry
    $r13 = ADD_add_r_ri $r3, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r4, 1, implicit-def $srcarry
    RET implicit $lr
    DelayedSchedBarrier
...

---
# Negative control: the load is in the same block as its use, so the dependence
# is an ordinary edge that already gives the use a non-zero depth. The bias must
# not apply and both runs must agree.
name:            def_in_same_block
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p1, $r1, $r2, $r3, $r4
    ; CHECK-LABEL: name: def_in_same_block
    ; CHECK: liveins: $p1, $r1, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r6 = LDA_dms_lda_scalar_ld_idx_imm killed $p1, 4
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: RET implicit $lr
    ; CHECK-NEXT: $r11 = ADD_add_r_ri killed $r1, 1, implicit-def $srcarry
    ; CHECK-NEXT: $r12 = ADD_add_r_ri killed $r2, 1, implicit-def $srcarry
    ; CHECK-NEXT: $r13 = ADD_add_r_ri killed $r3, 1, implicit-def $srcarry
    ; CHECK-NEXT: $r14 = ADD_add_r_ri killed $r4, 1, implicit-def $srcarry
    ; CHECK-NEXT: $r10 = ADD_add_r_ri killed $r6, 4, implicit-def $srcarry
    ; CHECK-NEXT: DelayedSchedBarrier
    $r6 = LDA_dms_lda_scalar_ld_idx_imm $p1, 4
    $r10 = ADD_add_r_ri $r6, 4, implicit-def $srcarry
    $r11 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
    $r12 = ADD_add_r_ri $r2, 1, implicit-def $srcarry
    $r13 = ADD_add_r_ri $r3, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r4, 1, implicit-def $srcarry
    RET implicit $lr
    DelayedSchedBarrier
...
