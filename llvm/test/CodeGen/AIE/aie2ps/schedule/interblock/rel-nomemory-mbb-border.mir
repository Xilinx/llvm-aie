# RUN: llc -mtriple=aie2ps %topdown-multi -run-pass=postmisched %s -o - \
# RUN:   | FileCheck %s

# The lock's core-resume window only governs memory ops. Each function follows
# the REL with five non-memory scalar ops: these pack tightly against the REL
# (and into the RET delay slots) with no spacing, confirming the lock does not
# interfere with non-memory instructions.

#
# The *_rev_* functions cover the reverse direction: a non-memory op in the
# predecessor and the REL alone in the successor. No memory op means no
# backward stall window, so the lock packs against the predecessor with no
# spacing across the border.
---
name:            rel_nomemory_same_mbb
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1
    ; CHECK-LABEL: name: rel_nomemory_same_mbb
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r6 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
    ; CHECK-NEXT: RET implicit $lr
    ; CHECK-NEXT: $r7 = ADD_add_r_ri $r1, 2, implicit-def $srcarry
    ; CHECK-NEXT: REL_mLockId_imm 0, killed $r0
    ; CHECK-NEXT: $r8 = ADD_add_r_ri $r1, 3, implicit-def $srcarry
    ; CHECK-NEXT: $r9 = ADD_add_r_ri $r1, 4, implicit-def $srcarry
    ; CHECK-NEXT: $r10 = ADD_add_r_ri killed $r1, 5, implicit-def $srcarry
    ; CHECK-NEXT: DelayedSchedBarrier
    REL_mLockId_imm 0, $r0
    $r6 = ADD_add_r_ri $r1, 1, implicit-def $srcarry
    $r7 = ADD_add_r_ri $r1, 2, implicit-def $srcarry
    $r8 = ADD_add_r_ri $r1, 3, implicit-def $srcarry
    $r9 = ADD_add_r_ri $r1, 4, implicit-def $srcarry
    $r10 = ADD_add_r_ri $r1, 5, implicit-def $srcarry
    RET implicit $lr
    DelayedSchedBarrier
...

