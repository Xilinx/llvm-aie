# RUN: llc --mtriple=aie2ps --run-pass=postmisched %s -o - | FileCheck %s

# Latency of the ExitSU edges of inter-block DAGs. Each function is a two-block
# loop. Post-order schedules the latch bb.2 before the header bb.1, so the
# scoreboard of the latch only reserves the header's instructions, and the
# ExitSU edge of the bb.2 -> bb.1 DAG decides how close the VMAC at the end of
# the latch may get to the branch. The exit bb.3 reads dm0 after a delay chain,
# so the bb.2 -> bb.3 edge doesn't constrain it.
#
# In vmacIntLive and vmacBf16Live the VMAC accumulates onto dm0, which is live
# around the loop. The integer VMAC writes dm0 in cycle 6 and has 6 stages. The
# bf16 VMAC writes its flags and reads its mask control register in cycle 8,
# the length of its pipeline.

---
name:            vmacIntLive
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: vmacIntLive
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r2 = ADD_add_r_ri killed $r2, 1, implicit-def $srcarry
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r7 = ADD_add_r_ri killed $r7, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r7 = ADD_add_r_ri killed $r7, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r7 = ADD_add_r_ri killed $r7, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r7 = ADD_add_r_ri killed $r7, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r7 = ADD_add_r_ri killed $r7, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r7 = ADD_add_r_ri killed $r7, 1, implicit-def $srcarry
  ; CHECK-NEXT:   JNZ $r0, %bb.1
  ; CHECK-NEXT:   $dm0 = VMAC_vmac_vmul_cm_core_X_R killed $dm0, $x7, $r7, $r11
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   $r14 = ADD_add_r_ri killed $r14, 1, implicit-def $srcarry
  ; CHECK-NEXT:   BUNDLE implicit-def $dm2, implicit $lr, implicit killed $dm0, implicit killed $x7, implicit killed $r14, implicit killed $r11 {
  ; CHECK-NEXT:     RET implicit $lr
  ; CHECK-NEXT:     $dm2 = VMAC_vmac_vmul_cm_core_X_R killed $dm0, killed $x7, killed $r14, killed $r11
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier implicit killed $dm2
  bb.0:
    successors: %bb.1
    liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0

  bb.1:
    successors: %bb.2
    liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0
    $r2 = ADD_add_r_ri $r2, 1, implicit-def $srcarry

  bb.2:
    successors: %bb.1, %bb.3
    liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0
    $r7 = ADD_add_r_ri $r7, 1, implicit-def $srcarry
    $r7 = ADD_add_r_ri $r7, 1, implicit-def $srcarry
    $r7 = ADD_add_r_ri $r7, 1, implicit-def $srcarry
    $r7 = ADD_add_r_ri $r7, 1, implicit-def $srcarry
    $r7 = ADD_add_r_ri $r7, 1, implicit-def $srcarry
    $r7 = ADD_add_r_ri $r7, 1, implicit-def $srcarry
    $dm0 = VMAC_vmac_vmul_cm_core_X_R $dm0, $x7, $r7, $r11
    JNZ $r0, %bb.1
    DelayedSchedBarrier

  bb.3:
    liveins: $dm0, $dm1, $p0, $r0, $r2, $r7, $r11, $r14, $x7, $y0
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $r14 = ADD_add_r_ri $r14, 1, implicit-def $srcarry
    $dm2 = VMAC_vmac_vmul_cm_core_X_R $dm0, $x7, $r14, $r11
    RET implicit $lr
    DelayedSchedBarrier implicit $dm2
...
