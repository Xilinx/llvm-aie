# RUN: llc -mtriple=aie2ps -run-pass=postmisched %s -o - | FileCheck %s

# We are testing whether maxlatencyfinder deals with unscheduled blocks
# to reduce MaxLatency by looking at the possible edges
# We use a multi block loop, whose latch will find the header unscheduled
# The block holds the interesting case of a multi-output instruction, one
# with a short latency, one with a long one. The consumers are given depth
# by dependence chains

---
name:            test
alignment:       16
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: test
  ; CHECK: bb.0.entry:
