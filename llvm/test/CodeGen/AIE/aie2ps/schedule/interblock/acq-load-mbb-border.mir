# RUN: llc -mtriple=aie2ps -run-pass=postmisched %s -o - \
# RUN:   | FileCheck %s

# An ACQ followed by a load must keep the load outside the lock's core-resume
# window. Each function issues the same ACQ and the same load, once in a single
# block and once split by an MBB border, so the ACQ-to-load distance can be
# compared across the border.

#
# The *_rev_* functions cover the reverse direction: a memory op in the
# predecessor and the ACQ alone in the successor (isolated so it anchors at
# the successor's first cycle). The backward stall window is carried across
# the border, so the memory op is held back from the lock.
#
# The *_diamond function (where present) branches to two successors, one with a
# load and one without, so the lock's exit spacing is the max over successors.
# The *_reg_load_* function uses the register-localID lock form.
---
name:            acq_load_same_mbb
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p1, $r0
    ; CHECK-LABEL: name: acq_load_same_mbb
    ; CHECK: liveins: $p1, $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ACQ_mLockId_imm 0, killed $r0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $r6 = LDA_dms_lda_scalar_ld_idx_imm killed $p1, 4
    ; CHECK-NEXT: RET implicit $lr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: DelayedSchedBarrier
    ACQ_mLockId_imm 0, $r0
    $r6 = LDA_dms_lda_scalar_ld_idx_imm $p1, 4
    RET implicit $lr
    DelayedSchedBarrier
...

