# RUN: llc -mtriple=aie2ps --start-before=postmisched -verify-machineinstrs \
# RUN:     -debug-only=sched-blocks -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=DBG
# RUN: llc -mtriple=aie2ps --start-before=postmisched -verify-machineinstrs \
# RUN:     --stop-after=postmisched -o - %s 2>/dev/null \
# RUN:   | FileCheck %s --check-prefix=MIR
# RUN: llc -mtriple=aie2ps --start-before=postmisched -verify-machineinstrs \
# RUN:     --aie-optimize-sibling-loops=false \
# RUN:     -debug-only=sched-blocks -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=DISABLED
# REQUIRES: asserts
#
# Test sibling loop optimization: partial merge limited by scheduling slack.
#
# Generated from gemm_int8_outerloop_pipelined.ll with:
#   llc -mtriple=aie2ps -O2 -stop-before=postmisched
#
# OLP structure (bb numbers after OLP transformation):
#   bb.0 (OuterPreheader) -> bb.1 (SteadyTop/Prologue) -> bb.2 (SteadyInner)
#   -> bb.3 (SteadyBottom/Epilogue/Latch) -> bb.4 (PeeledIterTop)
#   -> bb.5 (PeeledIterInner) -> bb.6 (PeeledIterBottom)
#
# Slack analysis:
#   The epilogue (bb.3) has 20 bundles, the prologue (bb.1) has 12 bundles.
#   The tightest cross-boundary edge has:
#     Height=5 Depth=0 Lat=3 Slack=2
#   This is a 3-cycle latency dependency between an epilogue VST_SRS
#   instruction at Height=5 (5 cycles from the end of bb.3) and the
#   first prologue instruction at Depth=0 (the start of bb.1). With only
#   5 cycles of distance but 3 cycles of required latency, the slack is
#   5 + 0 - 3 = 2. This means only 2 bundles can safely overlap.
#
# Resource analysis:
#   With MaxMerge capped at min(7 matching, 2 slack, 2 slack) = 2,
#   the resource check tries MergeCount=2: the first 2 prologue bundles
#   can overlay the last 2 epilogue bundles without functional unit
#   conflicts. The check passes on the first try.
#
# Result: 2 of 7 matching bundles are merged into the epilogue and
# transferred to the preheader.
#
# Verify the optimizer finds 7 matching bundles between prologues.
# DBG: optimizeSiblingLoops: Processing outer loop latch
# DBG: Found 7 matching bundles
#
# Verify slack computation limits the merge to 2 bundles.
# DBG: Slack (Epilogue->SteadyPrologue): 2 cycles
# DBG: Slack (Epilogue->LastIterPrologue): 2 cycles
#
# Verify resource mergeability check passes with 2 bundles.
# DBG: Resource mergeability check passed with 2 bundles
# DBG: Can merge 2 bundles into epilogue
# DBG: Sibling loop optimization complete: moved 2 bundles
#
# Verify the epilogue (bb.3) contains merged prologue instructions
# (VMUL and VADDMAC from the first 2 prologue bundles).
# MIR-LABEL: bb.3.for.cond.cleanup99:
# MIR:       VMUL_vmul_vmul_cm_core_X_X
# MIR:       VADDMAC_vaddmac_vmul_cm_core_X_X
# MIR:       VADDMAC_vaddmac_vmul_cm_core_X_X
# MIR:       VMUL_vmul_vmul_cm_core_X_X
# MIR:       VADDMAC_vaddmac_vmul_cm_core_X_X
# MIR:       VADDMAC_vaddmac_vmul_cm_core_X_X
#
# Also verify the optimization is disabled with the flag.
# DISABLED-NOT: optimizeSiblingLoops
# DISABLED-NOT: Sibling loop optimization complete
--- |
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
