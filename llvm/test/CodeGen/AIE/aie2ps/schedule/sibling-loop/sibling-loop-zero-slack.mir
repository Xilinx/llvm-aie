    renamable $m2, renamable $p5 = LDA_dms_lda_scalar_ld_pstm_nrm_imm killed renamable $p5, -4 :: (invariant load (s20) from %fixed-stack.5, align 8)
    renamable $dj2, renamable $p5 = LDA_dms_lda_scalar_ld_pstm_nrm_imm killed renamable $p5, -4 :: (invariant load (s20) from %fixed-stack.4, align 4)
    renamable $dn2, renamable $p5 = LDA_dms_lda_scalar_ld_pstm_nrm_imm killed renamable $p5, -4 :: (invariant load (s20) from %fixed-stack.3, align 16)
    renamable $m3, renamable $p5 = LDA_dms_lda_scalar_ld_pstm_nrm_imm killed renamable $p5, -4 :: (invariant load (s20) from %fixed-stack.2, align 4)
