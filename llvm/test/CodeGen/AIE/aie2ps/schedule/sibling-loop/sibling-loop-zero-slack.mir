# RUN: llc -mtriple=aie2ps --start-before=postmisched -verify-machineinstrs \
# RUN:     -debug-only=sched-blocks -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=DBG
# REQUIRES: asserts
#
# Test sibling loop optimization: no merge due to zero scheduling slack.
#
# Generated from gemm_int8_outerloop_blocks.ll with:
#   llc -mtriple=aie2ps -O2 --aie-enable-outer-loop-pipelining -stop-before=postmisched
#
# OLP structure (bb numbers after OLP transformation):
#   bb.0 (OuterPreheader) -> bb.1 (SteadyTop/Prologue) -> bb.2 (SteadyInner)
#   -> bb.3 (SteadyBottom/Epilogue/Latch) -> bb.4 (PeeledIterTop)
#   -> bb.5 (PeeledIterInner) -> bb.6 (PeeledIterBottom)
#
# Slack analysis:
#   The epilogue (bb.3) has 16 bundles, the prologue (bb.1) has 12 bundles.
#   Multiple cross-boundary edges have negative slack. The tightest is:
#     Height=1 Depth=0 Lat=3 Slack=-2
#   This is a 3-cycle latency dependency between the JNZD branch at the
#   very end of the epilogue (Height=1, the last bundle of bb.3) and the
#   first prologue instruction at Depth=0 (the start of bb.1). With only
#   1 cycle of distance but 3 cycles of required latency, the slack is
#   1 + 0 - 3 = -2. After clamping to max(0, -2) = 0, no overlap is
#   possible.
#
# Result: No merge possible. The optimizer bails out immediately after
# computing zero slack for the Epilogue->SteadyPrologue path without
# even checking the LastIterPrologue or resource mergeability.
#
# Verify the optimizer finds 7 matching bundles.
# DBG: optimizeSiblingLoops: Processing outer loop latch
# DBG: Found 7 matching bundles
#
# Verify the slack computation yields 0 (clamped from -2).
# DBG: Computed slack: -2
# DBG: Slack (Epilogue->SteadyPrologue): 0 cycles
#
# Verify the optimizer bails out due to zero slack.
# DBG: No slack to steady prologue, skipping
--- |
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare { ptr, i20 } @llvm.aie2ps.add.2d(ptr, i20, i20, i20, i20) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare <16 x i32> @llvm.aie2ps.vshuffle(<16 x i32>, <16 x i32>, i32) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare <32 x i64> @llvm.aie2ps.ACC2048.add.conf(<32 x i64>, <32 x i64>, i32) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare { ptr, i20, i20 } @llvm.aie2ps.add.3d(ptr, i20, i20, i20, i20, i20, i20, i20) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(inaccessiblemem: read)
  declare <32 x i32> @llvm.aie2ps.acc32.v32.I512.ups(<32 x i16>, i32, i32) #1
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mac.conf(<32 x i16>, <32 x i16>, <64 x i32>, i32) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare <64 x i32> @llvm.aie2ps.I512.I512.ACC2048.mul.conf(<64 x i8>, <64 x i8>, i32) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(inaccessiblemem: read)
