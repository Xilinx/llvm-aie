body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.8(0x40000000)
    liveins: $p0, $p1, $p2, $r0, $r1
  
    renamable $r2 = MOV_RLC_imm11_pseudo 1
    renamable $r2 = GE killed renamable $r2, renamable $r0
    JNZ killed renamable $r2, %bb.8
    DelayedSchedBarrier
  
  bb.1.outer.header.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $p2, $r0, $r1
  
    renamable $r4 = MOV_RLC_imm11_pseudo 0
    renamable $r2 = LDA_dms_lda_idx_imm renamable $p0, 0 :: (load (s32) from %ir.a)
    renamable $r3 = LDA_dms_lda_idx_imm renamable $p1, 0 :: (load (s32) from %ir.b)
    renamable $r2 = MUL killed renamable $r2, renamable $r3
    renamable $r0 = ADD_add_r_ri killed renamable $r0, -1, implicit-def dead $srcarry
    $p4 = MOV_scalar_pseudo $p0
    $p5 = MOV_scalar_pseudo $p1
    $p3 = MOV_scalar_pseudo $p2
    renamable $m0 = MOV_PD_imm11_pseudo 4
  
  bb.2.steady.stage1.top:
    successors: %bb.3(0x80000000)
    liveins: $m0, $p0, $p1, $p2, $p3, $p4, $p5, $r0, $r1, $r2, $r3, $r4
  
    renamable $p4 = nuw nusw inbounds PADD_mod_pseudo killed renamable $p4, renamable $m0
    renamable $p5 = nuw nusw inbounds PADD_mod_pseudo killed renamable $p5, renamable $m0
    renamable $p3 = nuw nusw inbounds PADD_mod_pseudo killed renamable $p3, renamable $m0
    $lc = ADD_NC_mv_add_ri $r1, 0
    $ls = MOVXM %bb.3
    $le = MOVXM <mcsymbol .L_LEnd3>
  
  bb.3.steady.stage1.inner.inner.header:
    successors: %bb.3(0x7c000000), %bb.4(0x04000000)
    liveins: $m0, $p0, $p1, $p2, $p3, $p4, $p5, $r0, $r1, $r2, $r3, $r4
  
    renamable $r2 = MAC killed renamable $r2, renamable $r2, renamable $r3
    PseudoLoopEnd <mcsymbol .L_LEnd3>, %bb.3
  
  bb.4.steady.stage1.bottom.and.stage0.top:
    successors: %bb.2(0x7c000000), %bb.5(0x04000000)
    liveins: $m0, $p0, $p1, $p2, $p3, $p4, $p5, $r0, $r1, $r2, $r4
  
    renamable $r5 = LDA_dms_lda_idx_imm killed renamable $p0, 4 :: (load (s32) from %ir.a.ptr.next.steady)
    renamable $r3 = LDA_dms_lda_idx_imm killed renamable $p1, 4 :: (load (s32) from %ir.b.ptr.next.steady)
    renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
    renamable $r6 = LT renamable $r4, renamable $r0
    ST_dms_sts_idx_imm killed renamable $r2, killed renamable $p2, 0 :: (store (s32) into %ir.c.ptr.steady)
    renamable $r2 = MUL killed renamable $r5, renamable $r3
    $p0 = MOV_scalar_pseudo $p4
    $p1 = MOV_scalar_pseudo $p5
    $p2 = MOV_scalar_pseudo $p3
    JNZ killed renamable $r6, %bb.2
    DelayedSchedBarrier
  
  bb.5.lastiter.stage1.top:
    successors: %bb.6(0x80000000)
    liveins: $p3, $r1, $r2, $r3
  
    $lc = ADD_NC_mv_add_ri $r1, 0
    $ls = MOVXM %bb.6
    $le = MOVXM <mcsymbol .L_LEnd2>
  
  bb.6.lastiter.stage1.inner.inner.header:
    successors: %bb.6(0x7c000000), %bb.7(0x04000000)
    liveins: $p3, $r2, $r3
  
    renamable $r2 = MAC killed renamable $r2, renamable $r2, renamable $r3
    PseudoLoopEnd <mcsymbol .L_LEnd2>, %bb.6
  
  bb.7.lastiter.stage1.bottom:
    successors: %bb.8(0x80000000)
    liveins: $p3, $r2
  
    ST_dms_sts_idx_imm killed renamable $r2, killed renamable $p3, 0 :: (store (s32) into %ir.c.ptr.next.steady)
  
  bb.8.exit:
    RET implicit $lr
    DelayedSchedBarrier
...
