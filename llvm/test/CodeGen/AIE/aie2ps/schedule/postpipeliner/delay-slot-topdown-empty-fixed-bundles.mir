# RUN: llc --mtriple=aie2ps -O2 --run-pass=postmisched %s -o - | FileCheck %s

# The loop is pipelined with II=4 (the MUL chain is a 4-cycle recurrence), so
# the SWP epilogue in %bb.2 consists of three empty fixed bundles followed by
# the drained VSHIFT at cycle 3. %bb.2 also ends with a conditional branch, so
# the region is scheduled top-down and the branch is moved afterwards by
# fixupDelaySlotPosition. The branch has to move to bundle 2, but bundles 0-2
# contain no instruction to anchor it to, and it is spliced to the end of the
# block, past its DelayedSchedBarrier. The JNZ then has no delay slots within
# %bb.2: the code of the fall-through block %bb.3 executes in them, and the
# fixed VSHIFT is emitted at cycle 2 instead of cycle 3.

--- |
  target triple = "aie2ps"

  define void @delay_slot_topdown_empty_fixed_bundles(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 16}
...
