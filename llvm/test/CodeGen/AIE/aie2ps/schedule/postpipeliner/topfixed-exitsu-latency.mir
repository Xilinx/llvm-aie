# The epilogue drain is a mul whose result is used only in the successor, after
# ret and three adds. That depth covers the mul, so the epilogue ends on the
# mul. The itinerary fallback still inserts a nop after it.
# dedicated_exit's use block has two predecessors, so the drain is moved into a
# new block and that block's PerSuccEdges are rebuilt after emitInterBlockTop.

# RUN: llc --mtriple=aie2ps -O2 --start-before=postmisched %s -o - \
# RUN:   | FileCheck %s --check-prefix=REMAIN
# RUN: llc --mtriple=aie2ps -O2 --start-before=postmisched \
# RUN:   --aie-interblock-latency=false %s -o - \
# RUN:   | FileCheck %s --check-prefix=ITIN

--- |
  target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "aie2ps"

  define dso_local i32 @drain_in_block(ptr addrspace(6) nocapture readonly %s, i32 %n, i32 %acc) local_unnamed_addr {
  ; REMAIN-LABEL: drain_in_block:
  ; REMAIN:       // %bb.0: // %entry
  ; REMAIN-NEXT:    mova r2, #0; nopb ; nopxm ; nops
  ; REMAIN-NEXT:    ge r2, r2, r0
  ; REMAIN-NEXT:    jnz r2, #.LBB0_4
  ; REMAIN-NEXT:    nop // Delay Slot 5
  ; REMAIN-NEXT:    nop // Delay Slot 4
  ; REMAIN-NEXT:    nop // Delay Slot 3
  ; REMAIN-NEXT:    nop // Delay Slot 2
  ; REMAIN-NEXT:    nop // Delay Slot 1
  ; REMAIN-NEXT:  // %bb.1: // %preheader
  ; REMAIN-NEXT:    add.nc lc, r0, #-2
  ; REMAIN-NEXT:    lda r2, [p0], #4; movxm ls, #.LBB0_2
  ; REMAIN-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; nopv
  ; REMAIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; REMAIN-NEXT:    lda r2, [p0], #4; nopb ; nops ; nopxm ; nopv
  ; REMAIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; REMAIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; REMAIN-NEXT:    .p2align 4
  ; REMAIN-NEXT:  .LBB0_2: // %loop
  ; REMAIN-NEXT:    // =>This Inner Loop Header: Depth=1
  ; REMAIN-NEXT:    lda r2, [p0], #4; nopb ; nops ; nopxm ; nopv
  ; REMAIN-NEXT:    nopa ; nopb ; nops ; mul r2, r2, r1; nopm ; nopv
  ; REMAIN-NEXT:  .L_LEnd0:
  ; REMAIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; REMAIN-NEXT:  // %bb.3: // %shell
  ; REMAIN-NEXT:    nopx
  ; REMAIN-NEXT:    mul r2, r2, r1
  ; REMAIN-NEXT:    nop
  ; REMAIN-NEXT:    nop
  ; REMAIN-NEXT:    mul r2, r2, r1
  ; REMAIN-NEXT:  .LBB0_4: // %use
  ; REMAIN-NEXT:    nopa ; nopb ; ret lr; nopm
  ; REMAIN-NEXT:    add r1, r1, #1 // Delay Slot 5
  ; REMAIN-NEXT:    add r1, r1, #1 // Delay Slot 4
  ; REMAIN-NEXT:    add r1, r1, #1 // Delay Slot 3
  ; REMAIN-NEXT:    add r2, r2, r1 // Delay Slot 2
  ; REMAIN-NEXT:    mov r0, r2 // Delay Slot 1
  ;
  ; ITIN-LABEL: drain_in_block:
  ; ITIN:       // %bb.0: // %entry
  ; ITIN-NEXT:    mova r2, #0; nopb ; nopxm ; nops
  ; ITIN-NEXT:    ge r2, r2, r0
  ; ITIN-NEXT:    jnz r2, #.LBB0_4
  ; ITIN-NEXT:    nop // Delay Slot 5
  ; ITIN-NEXT:    nop // Delay Slot 4
  ; ITIN-NEXT:    nop // Delay Slot 3
  ; ITIN-NEXT:    nop // Delay Slot 2
  ; ITIN-NEXT:    nop // Delay Slot 1
  ; ITIN-NEXT:  // %bb.1: // %preheader
  ; ITIN-NEXT:    add.nc lc, r0, #-2
  ; ITIN-NEXT:    lda r2, [p0], #4; movxm ls, #.LBB0_2
  ; ITIN-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; nopv
  ; ITIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; ITIN-NEXT:    lda r2, [p0], #4; nopb ; nops ; nopxm ; nopv
  ; ITIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; ITIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; ITIN-NEXT:    .p2align 4
  ; ITIN-NEXT:  .LBB0_2: // %loop
  ; ITIN-NEXT:    // =>This Inner Loop Header: Depth=1
  ; ITIN-NEXT:    lda r2, [p0], #4; nopb ; nops ; nopxm ; nopv
  ; ITIN-NEXT:    nopa ; nopb ; nops ; mul r2, r2, r1; nopm ; nopv
  ; ITIN-NEXT:  .L_LEnd0:
  ; ITIN-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; ITIN-NEXT:  // %bb.3: // %shell
  ; ITIN-NEXT:    nop
  ; ITIN-NEXT:    mul r2, r2, r1
  ; ITIN-NEXT:    nop
  ; ITIN-NEXT:    nop
  ; ITIN-NEXT:    mul r2, r2, r1
  ; ITIN-NEXT:    nop
  ; ITIN-NEXT:  .LBB0_4: // %use
  ; ITIN-NEXT:    nopa ; nopb ; ret lr; nopm
  ; ITIN-NEXT:    add r1, r1, #1 // Delay Slot 5
  ; ITIN-NEXT:    add r1, r1, #1 // Delay Slot 4
  ; ITIN-NEXT:    add r1, r1, #1 // Delay Slot 3
  ; ITIN-NEXT:    add r2, r2, r1 // Delay Slot 2
  ; ITIN-NEXT:    mov r0, r2 // Delay Slot 1
  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %preheader, label %use

  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop

  loop:
    %p = phi ptr addrspace(6) [ %s, %preheader ], [ %p.next, %loop ]
    %v = load i32, ptr addrspace(6) %p, align 4
    %p.next = getelementptr inbounds i32, ptr addrspace(6) %p, i20 1
    %cont = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %cont, label %loop, label %shell, !llvm.loop !0

  shell:
    %bump = add nsw i32 %acc, 1
    br label %use

  use:
    %live = phi i32 [ 0, %entry ], [ %v, %shell ]
    %acc1 = phi i32 [ %acc, %entry ], [ %bump, %shell ]
    %a = add nsw i32 %acc1, 1
    %b = add nsw i32 %a, 1
    %c = add nsw i32 %b, 1
    %sum = add nsw i32 %live, %c
    ret i32 %sum
  }

