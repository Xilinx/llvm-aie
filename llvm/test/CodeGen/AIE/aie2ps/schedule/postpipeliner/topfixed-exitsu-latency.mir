  use:
    %live = phi i32 [ 0, %entry ], [ %v, %loop ]
    %a = add nsw i32 %acc, 1
    %b = add nsw i32 %a, 1
    %c = add nsw i32 %b, 1
    %sum = add nsw i32 %live, %c
    ret i32 %sum
