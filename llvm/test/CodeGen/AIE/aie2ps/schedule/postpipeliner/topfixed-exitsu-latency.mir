---
name:            drain_in_block
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1(0x50000000), %bb.4(0x30000000)
    liveins: $p0, $r0, $r1

    renamable $r2 = MOV_RLC_imm11_pseudo 0
    renamable $r2 = GE killed renamable $r2, renamable $r0
    JNZ killed renamable $r2, %bb.4
    DelayedSchedBarrier

  bb.1.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $r0, $r1

    $lc = ADD_NC_add_lc_ri $r0, 0
    MOVXM_lng_cg_ls_abs %bb.2, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.2.loop (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $r1

    renamable $r2, renamable $p0 = LDA_dms_lda_scalar_ld_pstm_nrm_imm killed renamable $p0, 4
    renamable $r2 = MUL killed renamable $r2, renamable $r1
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.shell:
    successors: %bb.4(0x80000000)
    liveins: $r1, $r2

  bb.4.use:
    liveins: $r1, $r2

    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    renamable $r2 = ADD_alu_r_rr killed renamable $r2, killed renamable $r1, implicit-def dead $srcarry
    $r0 = MOV_alu_mv_mv_mv_scl killed $r2
    RET implicit $lr
    DelayedSchedBarrier implicit killed $r0

...
