  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %preheader, label %use

  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop

  loop:
    %p = phi ptr addrspace(6) [ %s, %preheader ], [ %p.next, %loop ]
    %v = load i32, ptr addrspace(6) %p, align 4
    %p.next = getelementptr inbounds i32, ptr addrspace(6) %p, i20 1
    %cont = call i1 @llvm.loop.decrement.i32(i32 1)
