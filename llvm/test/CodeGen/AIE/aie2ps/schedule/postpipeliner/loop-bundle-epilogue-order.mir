# RUN: llc -verify-machineinstrs --mtriple=aie2ps -O2 \
# RUN:   --start-before=postmisched %s \
# RUN:   --aie-postpipeliner-phys-mode=1 \
# RUN:   --aie-postpipeliner-vreg-mode=0 \
# RUN:   -o - | FileCheck %s

# The post-pipeliner runs in physical mode only. In the loop body the VMIN_GE
# and then the VLD write x10, and the VLD value is live out. The VLD is in
# stage 0, so its last instance is in the loop bundles. The VMIN_GE is in
# stage 2, so its last instance is an epilogue clone. The VLD issues earlier
# but lands later. The exit block's VMAX_LT must read x10 after the last VLD
# lands, but the VMIN_GE clone stands in for the VLD, so it only waits for the
# VMIN_GE.

--- |
  define void @loop_liveout(ptr %buf, i32 %n) {
  ; CHECK-LABEL: loop_liveout:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:    mova r2, #0; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vbcst.32 x6, r2
  ; CHECK-NEXT:    vmov bmll0, x6
  ; CHECK-NEXT:    vmov bmlh0, x6
  ; CHECK-NEXT:    add.nc lc, r0, #-3
  ; CHECK-NEXT:    mova p1, #0; nopb ; vconv.bf16.fp32 x4, cml0; add.nc le, pc, #.L_LEnd0; addm.nc ls, pc, #.LBB0_1; nopv
  ; CHECK-NEXT:    nopa ; vldb x10, [p1, #0]; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; vconv.bf16.fp32 x4, cml0; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; vldb x10, [p1, #0]; nops ; nopx ; vbcst.16 x0, r2; nopv
  ; CHECK-NEXT:    nopa ; nopb ; vconv.bf16.fp32 x4, cml0; nopx ; vmax_lt.bf16 x6, r16, x0, x4; nopv
  ; CHECK-NEXT:    mova p2, #64; vldb x10, [p1, #0]; nops ; nopx ; vmin_ge.bf16 x10, r16, x6, x0; nopv
  ; CHECK-NEXT:  .LBB0_1: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; nopb ; vconv.bf16.fp32 x4, cml0; nopx ; vmax_lt.bf16 x6, r16, x0, x4; nopv
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; vldb x10, [p1, #0]; vst x10, [p0, #0]; nopx ; vmin_ge.bf16 x10, r16, x6, x0; nopv
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; nopb ; nopx ; vmax_lt.bf16 x6, r16, x0, x4
  ; CHECK-NEXT:    vst x10, [p0, #0]; vmin_ge.bf16 x10, r16, x6, x0
  ; CHECK-NEXT:    ret lr; vmax_lt.bf16 x6, r16, x0, x4
  ; CHECK-NEXT:    vst x10, [p0, #0]; vmin_ge.bf16 x10, r16, x6, x0 // Delay Slot 5
  ; CHECK-NEXT:    vmax_lt.bf16 x2, r16, x0, x10 // Delay Slot 4
  ; CHECK-NEXT:    vst x10, [p0, #0] // Delay Slot 3
  ; CHECK-NEXT:    vst x2, [p0, #0] // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop

  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 6}
...
---
name:            loop_liveout
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $p0, $r0

    renamable $r2 = MOV_RLC_imm11_pseudo 0
    renamable $x0 = VBCST_16 renamable $r2
    renamable $x6 = VBCST_32 renamable $r2
    $bmll0 = VMOV_alu_mv_mv_mv_x $x6
    $bmlh0 = VMOV_alu_mv_mv_mv_x $x6
    renamable $p1 = MOV_PD_imm11_pseudo 0
    renamable $p2 = MOV_PD_imm11_pseudo 64
    $lc = ADD_NC_add_lc_ri $r0, 0
    SET_LS_REL_pseudo %bb.1, implicit-def $ls, implicit $pc
    SET_LE_REL_pseudo <mcsymbol .L_LEnd0>, implicit-def $le, implicit $pc

  bb.1.loop:
    successors: %bb.1, %bb.2
    liveins: $cml0, $p0, $p1, $p2, $x0

    renamable $x4 = VCONV_bf16_fp32_mv_conv_mv_x_srs_bf16 renamable $cml0, implicit-def dead $srf2fflags, implicit $crf2fmask, implicit $crfpconvsat, implicit $crrnd
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, killed renamable $x4, implicit $crbf8conf, implicit $crfp8conf
    renamable $x10, dead renamable $r16 = VMIN_GE_bf16 killed renamable $x6, renamable $x0, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm killed renamable $x10, renamable $p0, 0 :: (store (<32 x s16>) into %ir.buf)
    renamable $x10 = VLD_x_idx_imm_pseudo renamable $p1, 0 :: (load (<32 x s16>) from `ptr null`)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit:
    liveins: $p0, $x0, $x10

    renamable $x2, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, killed renamable $x10, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm killed renamable $x2, renamable $p0, 0 :: (store (<32 x s16>) into %ir.buf)
    RET implicit $lr
    DelayedSchedBarrier
...
