# RUN: llc -mtriple=aie2ps -O2 --start-before=postmisched %s \
# RUN:   -aie-postpipeliner-phys-mode=false -aie-postpipeliner-minii=5 \
# RUN:   -verify-machineinstrs -o - | FileCheck %s

# A single-stage pipeline in virtual register mode has no prologue or
# epilogue. After PipeliningDone the preheader->loop edge is rebuilt with
# post-rename registers and the kernel as TopFixed, so the preheader's dead
# vldb into x8 keeps a WAW to the kernel vmax_lt.bf16 that writes x8. That
# vldb issues six cycles before the conflicting write.

--- |
  define void @f(ptr noalias %a, ptr noalias %b, ptr noalias %c, ptr noalias %d, ptr noalias %e, ptr noalias %f, ptr noalias %g, ptr noalias %h, ptr noalias %z, ptr noalias %y, i32 %n, i32 %skip) {
  ; CHECK-LABEL: f:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:  .LBB0_1: // %preheader
  ; CHECK-NEXT:    nopa ; vldb x8, [p5, #0]; nopx
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    add.nc lc, r0, #0
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add.nc le, pc, #.L_LEnd0; addm.nc ls, pc, #.LBB0_2; nopv
  ; CHECK-NEXT:  .LBB0_2: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; vldb x6, [p2, #0]; nops ; nopx ; vmax_lt.bf16 x6, r16, x0, x0; nopv
  ; CHECK-NEXT:    vlda x8, [p3, #0]; nopb ; nops ; nopx ; vmax_lt.bf16 x8, r16, x0, x6; nopv
  ; CHECK-NEXT:    nopa ; vldb x8, [p3, #0]; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmax_lt.bf16 x6, r16, x0, x8; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nopx ; vst x6, [p7, #0]
  ; CHECK-NEXT:    vst x8, [p7, #0]
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.3: // %exit
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    br label %preheader
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop
  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }
  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 32}
...
---
name:            f
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $p0, $p1, $p2, $p3, $p4, $p5, $p6, $p7, $r0, $r1, $x0

  bb.1.preheader:
    successors: %bb.2
    liveins: $p0, $p1, $p2, $p3, $p4, $p5, $p6, $p7, $r0, $x0

    dead $x8 = VLD_x_idx_imm_pseudo $p5, 0 :: (load (<32 x s16>) from %ir.z)
    $lc = ADD_NC_add_lc_ri $r0, 0
    SET_LS_REL_pseudo %bb.2, implicit-def $ls, implicit $pc
    SET_LE_REL_pseudo <mcsymbol .L_LEnd0>, implicit-def $le, implicit $pc

  bb.2.loop:
    successors: %bb.2, %bb.3
    liveins: $p0, $p1, $p2, $p3, $p4, $p6, $p7, $x0

    renamable $x8 = VLD_x_idx_imm_pseudo renamable $p2, 0 :: (load (<32 x s16>) from %ir.a)
    renamable $x8, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x0, implicit $crbf8conf, implicit $crfp8conf
    renamable $x8, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x8, implicit $crbf8conf, implicit $crfp8conf
    renamable $x6 = VLD_x_idx_imm_pseudo renamable $p3, 0 :: (load (<32 x s16>) from %ir.a)
    renamable $x6 = VLD_x_idx_imm_pseudo renamable $p3, 0 :: (load (<32 x s16>) from %ir.a)
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x8, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm renamable $x6, renamable $p7, 0 :: (store (<32 x s16>) into %ir.h)
    VST_dmx_sts_x_st_idx_imm renamable $x8, renamable $p7, 0 :: (store (<32 x s16>) into %ir.h)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.exit:
    RET implicit $lr
    DelayedSchedBarrier
...
