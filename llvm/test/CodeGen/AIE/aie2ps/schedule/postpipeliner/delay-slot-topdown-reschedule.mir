    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = LDA_dms_lda_scalar_ld_idx_imm renamable $p1, 0 :: (load (s32) from %ir.in, addrspace 5)
