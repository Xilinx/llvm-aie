  ; CHECK-NEXT:     renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $r13 = MOV_alu_mv_mv_mv_scl killed renamable $r12
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def $r5, implicit-def dead $srcarry, implicit-def $r14, implicit killed $r5, implicit killed $r13 {
  ; CHECK-NEXT:     renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $r14 = MOV_alu_mv_mv_mv_scl killed renamable $r13
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r15 = MOV_alu_mv_mv_mv_scl killed renamable $r14
