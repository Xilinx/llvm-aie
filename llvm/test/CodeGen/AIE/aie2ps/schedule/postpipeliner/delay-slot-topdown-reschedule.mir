  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi2, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r10 = ADD_add_r_ri renamable $r1, 5, implicit-def dead $srcarry
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi2, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r11 = ADD_add_r_ri renamable $r1, 6, implicit-def dead $srcarry
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.loop2:
  ; CHECK-NEXT:   successors: %bb.3(0x7c000000), %bb.4(0x04000000)
  ; CHECK-NEXT:   liveins: $p5, $p6, $r0, $r1, $r7, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi2, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $x1 = VSHIFT killed $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.exit:
  ; CHECK-NEXT:   liveins: $r7, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   BUNDLE implicit-def $x1, implicit $lr, implicit $x3, implicit $x0, implicit $r1 {
  ; CHECK-NEXT:     RET implicit $lr
  ; CHECK-NEXT:     renamable $x1 = VSHIFT $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $x1 = VSHIFT $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $x1 = VSHIFT killed $x3, killed renamable $x0, killed renamable $r1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0.preheader:
    successors: %bb.1(0x80000000)
    liveins: $p5, $p6, $r0, $r1, $r2, $r7, $x0

    $lc = ADD_NC_add_lc_ri $r2, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p5, $p6, $r0, $r1, $r2, $r7, $x0

    renamable $x3, renamable $p5 = VLD_x_pstm_nrm_imm_pseudo killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
    renamable $x1 = VSHIFT killed renamable $x3, renamable $x0, renamable $r1
    renamable $r7 = MUL killed renamable $r7, renamable $r1
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.mid:
    successors: %bb.3(0x80000000)
    liveins: $p5, $p6, $r0, $r1, $r2, $x0, $x1

    renamable $x2 = VSHIFT killed renamable $x1, renamable $x0, renamable $r1
    renamable $p6 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x2, killed renamable $p6, 64 :: (store (<16 x s32>), addrspace 6)
    renamable $r4 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    JL_lng 32, implicit-def $lr
    DelayedSchedBarrier
    $lc = ADD_NC_add_lc_ri $r2, 0
    MOVXM_lng_cg_ls_abs %bb.3, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd1>, implicit-def $le
    renamable $r5 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
    renamable $r6 = ADD_add_r_ri renamable $r1, 2, implicit-def dead $srcarry
    renamable $r8 = ADD_add_r_ri renamable $r1, 3, implicit-def dead $srcarry
    renamable $r9 = ADD_add_r_ri renamable $r1, 4, implicit-def dead $srcarry
    renamable $r10 = ADD_add_r_ri renamable $r1, 5, implicit-def dead $srcarry
    renamable $r11 = ADD_add_r_ri renamable $r1, 6, implicit-def dead $srcarry

  bb.3.loop2:
    successors: %bb.3(0x7c000000), %bb.4(0x04000000)
    liveins: $p5, $p6, $r0, $r1, $r7, $x0

    renamable $x3, renamable $p5 = VLD_x_pstm_nrm_imm_pseudo killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi2, addrspace 5)
    renamable $x1 = VSHIFT killed renamable $x3, renamable $x0, renamable $r1
    renamable $r7 = MUL killed renamable $r7, renamable $r1
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.3

  bb.4.exit:
    liveins: $r7, $x1

    RET implicit $lr
    DelayedSchedBarrier
...

# As epilogue_call_prologue, with a second call adding a region in between.
