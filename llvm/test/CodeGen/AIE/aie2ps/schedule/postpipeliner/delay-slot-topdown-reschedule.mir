    renamable $x2 = VSHIFT killed renamable $x1, renamable $x0, renamable $r1
    renamable $p6 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x2, killed renamable $p6, 64 :: (store (<16 x s32>), addrspace 6)
    renamable $r4 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    JL_lng 32, implicit-def $lr
    DelayedSchedBarrier
    renamable $r12 = ADD_add_r_ri renamable $r1, 7, implicit-def dead $srcarry
    JL_lng 64, implicit-def $lr
    DelayedSchedBarrier
    $lc = ADD_NC_add_lc_ri $r2, 0
    MOVXM_lng_cg_ls_abs %bb.3, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd1>, implicit-def $le
    renamable $r5 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
    renamable $r6 = ADD_add_r_ri renamable $r1, 2, implicit-def dead $srcarry
    renamable $r8 = ADD_add_r_ri renamable $r1, 3, implicit-def dead $srcarry
    renamable $r9 = ADD_add_r_ri renamable $r1, 4, implicit-def dead $srcarry
    renamable $r10 = ADD_add_r_ri renamable $r1, 5, implicit-def dead $srcarry
    renamable $r11 = ADD_add_r_ri renamable $r1, 6, implicit-def dead $srcarry

  bb.3.loop2:
    successors: %bb.3(0x7c000000), %bb.4(0x04000000)
    liveins: $p5, $p6, $r0, $r1, $r7, $x0

    renamable $x3, renamable $p5 = VLD_x_pstm_nrm_imm_pseudo killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi2, addrspace 5)
    renamable $x1 = VSHIFT killed renamable $x3, renamable $x0, renamable $r1
    renamable $r7 = MUL killed renamable $r7, renamable $r1
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.3

  bb.4.exit:
    liveins: $r7, $x1

    RET implicit $lr
    DelayedSchedBarrier
...

# A call in an epilogue that also ends in a jump: two regions, each with a
# delay slot instruction.
---
name:            epilogue_call_jump
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: epilogue_call_jump
  ; CHECK: bb.0.preheader:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p5, $p6, $r0, $r1, $r2, $r7, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $lc = ADD_NC_add_lc_ri killed $r2, -3
  ; CHECK-NEXT:   MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
  ; CHECK-NEXT:   MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p5, $p6, $r0, $r1, $r7, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $x1 = VSHIFT killed $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.mid:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $p6, $r0, $r1, $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r4 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   BUNDLE implicit-def $r4, implicit-def dead $srcarry, implicit-def $x1, implicit killed $r4, implicit $x3, implicit $x0, implicit $r1 {
  ; CHECK-NEXT:     renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $x1 = VSHIFT $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   BUNDLE implicit-def $r4, implicit-def dead $srcarry, implicit-def $x1, implicit killed $r4, implicit $x3, implicit $x0, implicit $r1 {
  ; CHECK-NEXT:     renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $x1 = VSHIFT $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   BUNDLE implicit-def $r4, implicit-def dead $srcarry, implicit-def $x1, implicit killed $r4, implicit killed $x3, implicit $x0, implicit $r1 {
  ; CHECK-NEXT:     renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $x1 = VSHIFT killed $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   JL_lng 32, implicit-def $lr
  ; CHECK-NEXT:   BUNDLE implicit-def $r4, implicit-def dead $srcarry, implicit-def $x2, implicit killed $r4, implicit killed $x1, implicit killed $x0, implicit $r1 {
  ; CHECK-NEXT:     renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $x2 = VSHIFT killed renamable $x1, killed renamable $x0, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   BUNDLE implicit-def $p6, implicit-def $r4, implicit-def dead $srcarry, implicit killed $x2, implicit killed $p6, implicit killed $r4 {
  ; CHECK-NEXT:     renamable $p6 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x2, killed renamable $p6, 64 :: (store (<16 x s32>), addrspace 6)
  ; CHECK-NEXT:     renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r4 = ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT:   JNZ killed $r0, %bb.4
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   renamable $r6 = ADD_add_r_ri renamable $r1, 2, implicit-def dead $srcarry
  ; CHECK-NEXT:   renamable $r8 = ADD_add_r_ri killed renamable $r1, 3, implicit-def dead $srcarry
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $r0 = MOVA 1
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0.preheader:
    successors: %bb.1(0x80000000)
    liveins: $p5, $p6, $r0, $r1, $r2, $r7, $x0

    $lc = ADD_NC_add_lc_ri $r2, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p5, $p6, $r0, $r1, $r7, $x0

    renamable $x3, renamable $p5 = VLD_x_pstm_nrm_imm_pseudo killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
    renamable $x1 = VSHIFT killed renamable $x3, renamable $x0, renamable $r1
    renamable $r7 = MUL killed renamable $r7, renamable $r1
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.mid:
    successors: %bb.3(0x40000000), %bb.4(0x40000000)
    liveins: $p6, $r0, $r1, $x0, $x1

    renamable $x2 = VSHIFT killed renamable $x1, renamable $x0, renamable $r1
    renamable $p6 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x2, killed renamable $p6, 64 :: (store (<16 x s32>), addrspace 6)
    renamable $r4 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    renamable $r4 = ADD_add_r_ri renamable $r4, 1, implicit-def dead $srcarry
    JL_lng 32, implicit-def $lr
    DelayedSchedBarrier
    renamable $r5 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
    renamable $r6 = ADD_add_r_ri renamable $r1, 2, implicit-def dead $srcarry
    renamable $r8 = ADD_add_r_ri renamable $r1, 3, implicit-def dead $srcarry
    JNZ $r0, %bb.4
    DelayedSchedBarrier

  bb.3:
    successors: %bb.4(0x80000000)

    renamable $r0 = MOVA 1
    RET implicit $lr
    DelayedSchedBarrier

  bb.4:
    RET implicit $lr
    DelayedSchedBarrier
