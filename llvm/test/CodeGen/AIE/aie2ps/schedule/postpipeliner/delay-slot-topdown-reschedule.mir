    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    JNZ $r0, %bb.4
    DelayedSchedBarrier

  bb.3:
    renamable $r0 = MOVA 1
    RET implicit $lr
    DelayedSchedBarrier

  bb.4:
    RET implicit $lr
    DelayedSchedBarrier
...

