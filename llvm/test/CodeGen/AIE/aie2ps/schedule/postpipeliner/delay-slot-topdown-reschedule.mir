# RUN: llc --mtriple=aie2ps -O2 --run-pass=postmisched %s -o - | FileCheck %s

# The epilogue is rescheduled with the JNZ held back one cycle at a time until
# at most five bundles follow it, instead of padding the end with NOPs.

--- |
  target triple = "aie2ps"

  define void @jnz_after_fixed(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @jnz_in_fixed(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @jnz_past_chain(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @moves_fill_delay_slots(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @neg_latency_tight(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @neg_latency_slack(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @port_conflict(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @epilogue_call_prologue(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop1
  loop1:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop1 ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop1, label %mid, !llvm.loop !0
  mid:
    call void @callee()
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop2
  loop2:
    %in.phi2 = phi ptr addrspace(5) [ %in, %mid ], [ %in.phi2, %loop2 ]
    %dec2 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec2, label %loop2, label %exit, !llvm.loop !2
  exit:
    ret void
  }

  define void @epilogue_two_calls_prologue(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop1
  loop1:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop1 ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop1, label %mid, !llvm.loop !0
  mid:
    call void @callee()
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop2
  loop2:
    %in.phi2 = phi ptr addrspace(5) [ %in, %mid ], [ %in.phi2, %loop2 ]
    %dec2 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec2, label %loop2, label %exit, !llvm.loop !2
  exit:
    ret void
  }

  define void @epilogue_call_jump(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop1
  loop1:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop1 ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop1, label %mid, !llvm.loop !0
  mid:
    call void @callee()
    ret void
  }

  declare void @callee()

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 16}
  !2 = distinct !{!2, !1}
...

# Ten ADDs: the JNZ ends up after the fixed epilogue.
---
name:            jnz_after_fixed
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: jnz_after_fixed
  ; CHECK: bb.0.preheader:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p5, $p6, $r0, $r1, $r2, $r7, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $lc = ADD_NC_add_lc_ri killed $r2, -1
  ; CHECK-NEXT:   MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
  ; CHECK-NEXT:   MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop_body:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p5, $p6, $r0, $r1, $r7, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $x3, implicit-def $p5, implicit-def $r7, implicit killed $p5, implicit killed $r7, implicit $r1 {
  ; CHECK-NEXT:     $x3, renamable $p5 = VLDB_dmx_ldb_x_pstm_nrm_imm killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
  ; CHECK-NEXT:     renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $r7 = MUL killed renamable $r7, renamable $r1
  ; CHECK-NEXT:   renamable $x1 = VSHIFT killed $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.exit:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $p6, $r0, $r1, $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   BUNDLE implicit-def $r5, implicit-def dead $srcarry, implicit-def $x1, implicit killed $r5, implicit killed $x3, implicit $x0, implicit $r1 {
  ; CHECK-NEXT:     renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $x1 = VSHIFT killed $x3, renamable $x0, renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def $r5, implicit-def dead $srcarry, implicit-def $x2, implicit killed $r5, implicit killed $x1, implicit killed $x0, implicit killed $r1 {
  ; CHECK-NEXT:     renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:     renamable $x2 = VSHIFT killed renamable $x1, killed renamable $x0, killed renamable $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   JNZ killed $r0, %bb.4
  ; CHECK-NEXT:   BUNDLE implicit-def $p6, implicit-def $r5, implicit-def dead $srcarry, implicit killed $x2, implicit killed $p6, implicit killed $r5 {
  ; CHECK-NEXT:     renamable $p6 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x2, killed renamable $p6, 64 :: (store (<16 x s32>), addrspace 6)
  ; CHECK-NEXT:     renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   renamable $r5 = ADD_add_r_ri killed renamable $r5, 1, implicit-def dead $srcarry
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $r5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   renamable $r0 = MOVA 1
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   liveins: $r5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0.preheader:
    successors: %bb.1(0x80000000)
    liveins: $p5, $p6, $r0, $r1, $r2, $r7, $x0

    $lc = ADD_NC_add_lc_ri $r2, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop_body:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p5, $p6, $r0, $r1, $r7, $x0

    renamable $x3, renamable $p5 = VLD_x_pstm_nrm_imm_pseudo killed renamable $p5, 64 :: (load (<16 x s32>) from %ir.in.phi, addrspace 5)
    renamable $x1 = VSHIFT killed renamable $x3, renamable $x0, renamable $r1
    renamable $r7 = MUL killed renamable $r7, renamable $r1
    renamable $r7 = MUL killed renamable $r7, renamable $r1
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit:
    successors: %bb.3(0x40000000), %bb.4(0x40000000)
    liveins: $p6, $r0, $r1, $x0, $x1

    renamable $x2 = VSHIFT killed renamable $x1, renamable $x0, renamable $r1
    renamable $p6 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x2, killed renamable $p6, 64 :: (store (<16 x s32>), addrspace 6)
    renamable $r5 = ADD_add_r_ri renamable $r1, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    renamable $r5 = ADD_add_r_ri renamable $r5, 1, implicit-def dead $srcarry
    JNZ $r0, %bb.4
    DelayedSchedBarrier

  bb.3:
    liveins: $r5

    renamable $r0 = MOVA 1
    RET implicit $lr
    DelayedSchedBarrier

  bb.4:
    liveins: $r5

    RET implicit $lr
    DelayedSchedBarrier
...

