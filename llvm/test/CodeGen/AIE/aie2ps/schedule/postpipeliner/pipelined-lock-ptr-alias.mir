# RUN: llc --mtriple=aie2ps -O2 --run-pass=postmisched --aie-loop-min-tripcount=16 %s -o - | FileCheck %s

# Exercises lock spacing in AIERegMemEventTracker via EmitFixedSUnits for pipelined
# prologue/epilogue scheduling. CHECK expectations document pre-alias-aware
# conservative scheduling.

--- |
  target triple = "aie2ps"

  define void @epilogue_release_ptr_same_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @epilogue_release_ptr_disjoint_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @prologue_acquire_ptr_same_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @prologue_acquire_ptr_disjoint_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

