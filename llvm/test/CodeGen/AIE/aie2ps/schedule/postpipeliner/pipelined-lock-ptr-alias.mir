  ; CHECK-NEXT:     $x0, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm killed $p0, 64
  ; CHECK-NEXT:     $lc = ADD_NC_add_lc_ri $r0, -2
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   MOVXM_lng_cg_ls_abs %bb.2, implicit-def $ls
  ; CHECK-NEXT:   MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r0, $m0, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VADD_16 killed $x0, $x0, implicit $crbf8conf, implicit $crfp8conf
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $p1 = VST_dmx_sts_x_st_pstm_nrm_imm $x0, killed $p1, 64 :: (store (s32) into %ir.store_buf)
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $p0, $p1, $r18, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   REL_mLockId_imm 49, killed renamable $r18 :: (load unknown-size from %ir.store_buf, align 1)
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $p1 = VST_dmx_sts_x_st_pstm_nrm_imm $x0, killed $p1, 64 :: (store (s32) into %ir.store_buf)
  ; CHECK-NEXT:   $p1 = VST_dmx_sts_x_st_pstm_nrm_imm killed $x0, killed $p1, 64 :: (store (s32) into %ir.store_buf)
  ; CHECK-NEXT:   NOP
