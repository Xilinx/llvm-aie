# RUN: llc -mtriple=aie2ps -O2 --start-before=postmisched %s -o - | FileCheck %s

# establishSafeFreeSUToPrologueDistances() keeps the free instructions of a
# preheader a safe distance from the pipelined loop below it. For a free load
# that distance comes from getMaxAliasingMemCycle(..., IsStore=true), which must
# report "no aliasing store" as INT_MIN rather than as cycle 0; cycle 0 is a
# legitimate answer and checkMemoryDependency() filters on INT_MIN.
#
# Both loops below carry eight a-slot loads so that the ZOL setup distance is
# absorbed by the loop body. Without that the preheader ends in enough padding
# to hide the bogus distance, and neither function would be able to fail.

--- |
  target triple = "aie2ps"

  ; Nothing below the probe loads stores, so there is nothing to order them
  ; against and the last one may sit in the final preheader bundle. Reporting
  ; cycle 0 for "no aliasing store" instead of INT_MIN pushes them up by the
  ; load's memory cycle, which stretches this preheader from 4 to 9 bundles.
  define void @no_store_in_loop(ptr addrspace(5) noalias %data, ptr addrspace(6) noalias %probe, i32 %n) {
  ; CHECK-LABEL: no_store_in_loop:
  ; CHECK:       // %bb.0: // %preheader
  ; CHECK-NEXT:    vlda x2, [p1, #0]; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x3, [p1, #64]; add.nc lc, r2, #0
  ; CHECK-NEXT:    vlda x4, [p1, #128]; movxm ls, #.LBB0_1
  ; CHECK-NEXT:    vlda x5, [p1, #192]; nopb ; nops ; movxm le, #.L_LEnd0; nopv
  ; CHECK-NEXT:  .LBB0_1: // %loop_body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    vlda x0, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x1, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x6, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x7, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x8, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x9, [p0], #64; nopb ; nopxm
  ; CHECK-NEXT:    vlda x10, [p0], #64
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    vlda x11, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %data.phi = phi ptr addrspace(5) [ %data, %preheader ], [ %data.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  ; Same shape, but the loop stores into the probed buffer. The store still may
  ; not push the probe loads up: a load issued in the last preheader bundle
  ; reaches memory at its last memory cycle, one cycle before a store issued in
  ; the first loop bundle reaches memory at its first memory cycle, so the two
  ; provably cannot overlap. computeUseDefBackward() encodes that by offsetting
  ; separate-region events by the loop length, and the preheader is expected to
  ; stay identical to the function above.
  define void @aliasing_store_in_loop(ptr addrspace(5) noalias %data, ptr addrspace(6) noalias %probe, i32 %n) {
  ; CHECK-LABEL: aliasing_store_in_loop:
  ; CHECK:       // %bb.0: // %preheader
  ; CHECK-NEXT:    vlda x2, [p1, #0]; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x3, [p1, #64]; add.nc lc, r2, #0
  ; CHECK-NEXT:    vlda x4, [p1, #128]; movxm ls, #.LBB1_1
  ; CHECK-NEXT:    vlda x5, [p1, #192]; nopb ; nops ; movxm le, #.L_LEnd1; nopv
  ; CHECK-NEXT:  .LBB1_1: // %loop_body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    vlda x0, [p0], #64; nopb ; vst x1, [p5, #0]; nopxm ; nopv
  ; CHECK-NEXT:    vlda x6, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x7, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x8, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x9, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    vlda x10, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  .L_LEnd1:
  ; CHECK-NEXT:    vlda x11, [p0], #64; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %data.phi = phi ptr addrspace(5) [ %data, %preheader ], [ %data.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 4}
...
---
name:            no_store_in_loop
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $p0, $p1, $r2

    $x2 = VLDA_dmx_lda_x_ld_idx_imm $p1, 0 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $x3 = VLDA_dmx_lda_x_ld_idx_imm $p1, 64 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $x4 = VLDA_dmx_lda_x_ld_idx_imm $p1, 128 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $x5 = VLDA_dmx_lda_x_ld_idx_imm $p1, 192 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $lc = ADD_NC_add_lc_ri $r2, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop_body:
    successors: %bb.1, %bb.2
    liveins: $p0, $x2, $x3, $x4, $x5

    $x0, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x1, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x6, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x7, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x8, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x9, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x10, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x11, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit:
    liveins: $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11

    RET implicit $lr
    DelayedSchedBarrier
...
---
name:            aliasing_store_in_loop
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $p0, $p1, $p5, $r2, $x1

    $x2 = VLDA_dmx_lda_x_ld_idx_imm $p1, 0 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $x3 = VLDA_dmx_lda_x_ld_idx_imm $p1, 64 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $x4 = VLDA_dmx_lda_x_ld_idx_imm $p1, 128 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $x5 = VLDA_dmx_lda_x_ld_idx_imm $p1, 192 :: (load (<8 x s32>) from %ir.probe, addrspace 6)
    $lc = ADD_NC_add_lc_ri $r2, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd1>, implicit-def $le

  bb.1.loop_body:
    successors: %bb.1, %bb.2
    liveins: $p0, $p5, $x1, $x2, $x3, $x4, $x5

    VST_dmx_sts_x_st_idx_imm $x1, $p5, 0 :: (store (<8 x s32>) into %ir.probe, addrspace 6)
    $x0, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x6, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x7, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x8, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x9, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x10, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    $x11, $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm $p0, 64 :: (load (<8 x s32>) from %ir.data.phi, addrspace 5)
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.1

  bb.2.exit:
    liveins: $x0, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11

    RET implicit $lr
    DelayedSchedBarrier
...
