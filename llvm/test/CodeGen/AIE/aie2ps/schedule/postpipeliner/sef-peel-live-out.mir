# RUN: llc -mtriple=aie2ps -O2 --start-before=postmisched %s -o - | FileCheck %s

--- |
  target triple = "aie2ps"

  define i32 @sef_live_out(ptr noalias %lcp, ptr noalias %ports, ptr noalias %args, i32 %n) {
  ; CHECK-LABEL: sef_live_out:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:    nopa ; movxm ls, #.LBB0_1
  ; CHECK-NEXT:    movxm le, #.L_LEnd0
  ; CHECK-NEXT:    mova r4, #0; nopb ; nops ; add.nc lc, r0, #0; mov r16, #10; nopv
  ; CHECK-NEXT:  .LBB0_1: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    mul r3, r4, r24; mov r6, r16
  ; CHECK-NEXT:    lshl r16, r16, r20; mov p0, p3
  ; CHECK-NEXT:    add r3, r16, #-12; mov m0, r3
  ; CHECK-NEXT:    nopa ; paddb [p0], m0; add r3, r16, #-4; mov dj0, r3
  ; CHECK-NEXT:    lda p1, [p7, dj0]; add r3, r16, #-8; mov dj0, r3
  ; CHECK-NEXT:    lda p1, [p7, dj0]; lshl r3, r4, r20; mov dj0, r3
  ; CHECK-NEXT:    lda r3, [p7, dj0]; add r4, r4, #1; mov dj0, r16
  ; CHECK-NEXT:    lda r18, [p7, dj0]; add r16, r6, #4; mov dj0, r3
  ; CHECK-NEXT:    st p0, [p6, dj0]
  ; CHECK-NEXT:    st p2, [p0], #4
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    st p1, [p0], #4
  ; CHECK-NEXT:    st p1, [p0], #4
  ; CHECK-NEXT:    st r22, [p0], #4
  ; CHECK-NEXT:    st r3, [p0, #0]
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; st r18, [p0, #4]; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add r0, r6, #1; nopm ; nopv
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    br label %loop
  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0
  exit:
    ret i32 0
  }

  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 1, i64 4}
...
---
name:            sef_live_out
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $p2, $p3, $p6, $p7, $r0, $r20, $r22, $r24

    $lc = ADD_NC_add_lc_ri $r0, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le
    renamable $r16 = MOV_RLC_imm11_pseudo 10
    renamable $r4 = MOV_RLC_imm11_pseudo 0

  bb.1.loop:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p2, $p3, $p6, $p7, $r4, $r16, $r20, $r22, $r24

    $r6 = MOV_OR_pseudo $r16
    renamable $r16 = LSHL $r16, renamable $r20
    renamable $r18 = ADD_add_r_ri renamable $r16, -12, implicit-def dead $srcarry
    $dj0 = MOV_scalar_pseudo killed $r18
    renamable $p1 = LDA_dms_lda_scalar_ld_idx renamable $p7, killed renamable $dj0 :: (load (p0) from %ir.lcp)
    renamable $r18 = nuw nsw MUL renamable $r4, renamable $r24
    $p0 = MOV_scalar_pseudo $p3
    $m0 = MOV_scalar_pseudo killed $r18
    renamable $p0 = nuw nusw inbounds PADD_mod_pseudo killed renamable $p0, killed renamable $m0
    renamable $r18 = nuw nsw LSHL renamable $r4, renamable $r20
    $dj0 = MOV_scalar_pseudo killed $r18
    ST_dms_sts_scalar_st_idx renamable $p0, renamable $p6, killed renamable $dj0 :: (store (p0) into %ir.args)
    renamable $r18 = ADD_add_r_ri renamable $r16, -4, implicit-def dead $srcarry
    renamable $p0 = ST_dms_sts_scalar_st_pstm_nrm_imm renamable $p2, killed renamable $p0, 4 :: (store (p0) into %ir.ports)
    $dj0 = MOV_scalar_pseudo killed $r18
    renamable $p0 = ST_dms_sts_scalar_st_pstm_nrm_imm killed renamable $p1, killed renamable $p0, 4 :: (store (p0) into %ir.ports)
    renamable $p1 = LDA_dms_lda_scalar_ld_idx renamable $p7, killed renamable $dj0 :: (load (p0) from %ir.lcp)
    renamable $r18 = ADD_add_r_ri renamable $r16, -8, implicit-def dead $srcarry
    $dj0 = MOV_scalar_pseudo killed $r18
    renamable $r1 = LDA_dms_lda_scalar_ld_idx renamable $p7, killed renamable $dj0 :: (load (s32) from %ir.lcp)
    $dj0 = MOV_scalar_pseudo killed $r16
    renamable $r3 = LDA_dms_lda_scalar_ld_idx renamable $p7, killed renamable $dj0 :: (load (s32) from %ir.lcp)
    renamable $p0 = ST_dms_sts_scalar_st_pstm_nrm_imm killed renamable $p1, killed renamable $p0, 4 :: (store (p0) into %ir.ports)
    renamable $p0 = ST_dms_sts_scalar_st_pstm_nrm_imm renamable $r22, killed renamable $p0, 4 :: (store (s32) into %ir.ports)
    renamable $r4 = nuw nsw ADD_add_r_ri killed renamable $r4, 1, implicit-def dead $srcarry
    ST_dms_sts_scalar_st_idx_imm killed renamable $r1, renamable $p0, 0 :: (store (s32) into %ir.ports)
    renamable $r16 = ADD_add_r_ri renamable $r6, 4, implicit-def dead $srcarry
    ST_dms_sts_scalar_st_idx_imm killed renamable $r3, killed renamable $p0, 4 :: (store (s32) into %ir.ports)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit:
    liveins: $r6

    $r0 = ADD_add_r_ri killed $r6, 1, implicit-def dead $srcarry
    RET implicit $lr, implicit $r0
    DelayedSchedBarrier
...
