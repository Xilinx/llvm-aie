    renamable $x2 = VSHIFT killed renamable $x1, renamable $x0, renamable $r1
    renamable $p6 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x2, killed renamable $p6, 64 :: (store (<16 x s32>), addrspace 6)
    renamable $r5 = MUL renamable $r0, renamable $r1
    renamable $r5 = MUL renamable $r5, renamable $r1
    JNZ $r5, %bb.4
    DelayedSchedBarrier

  bb.3:
    renamable $r0 = MOVA 1
    RET implicit $lr
    DelayedSchedBarrier

  bb.4:
    RET implicit $lr
    DelayedSchedBarrier
