# RUN: llc --mtriple=aie2ps -O2 --run-pass=postmisched %s -o - | FileCheck %s

# In both functions the loop is pipelined with II=4, so %bb.2 starts with the
# SWP epilogue (three empty fixed bundles and a VSHIFT at cycle 3) and its
# region is scheduled top-down. The JNZ condition is produced by a MUL chain,
# which places the branch late in the region:
# - branch_before_last_bundle: the JNZ issues at cycle 4 with three bundles
#   after it; two NOPs complete its delay slots.
# - branch_after_last_instr: the JNZ issues after the last instruction of the
#   region; five NOPs form its delay slots.
# In both cases the JNZ must stay before its DelayedSchedBarrier.

--- |
  target triple = "aie2ps"

  define void @branch_before_last_bundle(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  define void @branch_after_last_instr(ptr addrspace(5) noalias %in, ptr addrspace(6) noalias %out, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body
  loop_body:
    %in.phi = phi ptr addrspace(5) [ %in, %preheader ], [ %in.phi, %loop_body ]
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 16}
...
