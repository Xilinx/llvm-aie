# RUN: llc -mtriple=aie2ps -O2 --start-before=postmisched %s --verify-machineinstrs -o - | FileCheck %s

# The post-pipeliner assigns the prologue clones' registers in cycle order.
# Here the VMIN_GE and the VLD of the loop body both write x10. The VLD clone
# issues first, but the VMIN_GE comes first in the loop body. The entry block's
# VBCST x10 and the VST that reads it must complete before the VLD clone writes
# x10. The dependences to the clones are built in loop-body order, so the
# VMIN_GE clone must not stand in for the VLD clone.

--- |
  define void @prologue_clone_order(ptr %buf, i32 %n) {
  ; CHECK-LABEL: prologue_clone_order:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:    mova p1, #0; nopb ; nopx
  ; CHECK-NEXT:    vldb x10, [p1, #0]
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vldb x10, [p1, #0]; movxm r2, #16256
  ; CHECK-NEXT:    vbcst.16 x10, r2
  ; CHECK-NEXT:    mova r2, #0
  ; CHECK-NEXT:    mova r9, #60; vldb x10, [p1, #0]; vst x10, [p0, #0]; vbcst.32 x6, r2
  ; CHECK-NEXT:    vmov bmll0, x6; vmac.f cml0, cml0, x10, r2, r9
  ; CHECK-NEXT:    vmov bmlh0, x6
  ; CHECK-NEXT:    vldb x10, [p1, #0]
  ; CHECK-NEXT:    vmac.f cml0, cml0, x10, r2, r9
  ; CHECK-NEXT:    vconv.bf16.fp32 x10, cml0
  ; CHECK-NEXT:    vldb x10, [p1, #0]; add.nc lc, r0, #-5; addm.nc ls, pc, #.LBB0_1
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add.nc le, pc, #.L_LEnd0; vbcst.16 x0, r2; vmac.f cml0, cml0, x10, r2, r9
  ; CHECK-NEXT:    nopa ; nopb ; vconv.bf16.fp32 x10, cml0; nopx ; vmax_lt.bf16 x4, r16, x0, x10; nopv
  ; CHECK-NEXT:    nopa ; vldb x10, [p1, #0]; nops ; nopx ; vmin_ge.bf16 x6, r16, x4, x0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac.f cml0, cml0, x10, r2, r9
  ; CHECK-NEXT:    nopa ; nopb ; vconv.bf16.fp32 x10, cml0; nopx ; vmax_lt.bf16 x4, r16, x0, x10; nopv
  ; CHECK-NEXT:  .LBB0_1: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; vldb x10, [p1, #0]; vst x6, [p0, #0]; nopx ; vmin_ge.bf16 x6, r16, x4, x0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac.f cml0, cml0, x10, r2, r9
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; vconv.bf16.fp32 x10, cml0; nopx ; vmax_lt.bf16 x4, r16, x0, x10; nopv
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; nopb ; vst x6, [p0, #0]; nopx ; vmin_ge.bf16 x6, r16, x4, x0; nopv
  ; CHECK-NEXT:    vmac.f cml0, cml0, x10, r2, r9
  ; CHECK-NEXT:    vconv.bf16.fp32 x10, cml0; vmax_lt.bf16 x4, r16, x0, x10
  ; CHECK-NEXT:    vst x6, [p0, #0]; vmin_ge.bf16 x6, r16, x4, x0
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vconv.bf16.fp32 x10, cml0; vmax_lt.bf16 x4, r16, x0, x10
  ; CHECK-NEXT:    vst x6, [p0, #0]; vmin_ge.bf16 x6, r16, x4, x0
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    ret lr; vmax_lt.bf16 x4, r16, x0, x10
  ; CHECK-NEXT:    vst x6, [p0, #0]; vmin_ge.bf16 x6, r16, x4, x0 // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    vst x6, [p0, #0] // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    store <32 x bfloat> splat (bfloat 0xR3F80), ptr %buf, align 64
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop

  loop:
    %acc = phi <32 x float> [ zeroinitializer, %entry ], [ %mac, %loop ]
    %bf = tail call <32 x bfloat> @llvm.aie2ps.v32accfloat.to.v32bf16(<32 x float> %acc)
    %max = tail call { <32 x bfloat>, i32 } @llvm.aie2ps.vmax.ltbfloat16(<32 x bfloat> zeroinitializer, <32 x bfloat> %bf)
    %max.v = extractvalue { <32 x bfloat>, i32 } %max, 0
    %min = tail call { <32 x bfloat>, i32 } @llvm.aie2ps.vmin.gebfloat16(<32 x bfloat> %max.v, <32 x bfloat> zeroinitializer)
    %min.v = extractvalue { <32 x bfloat>, i32 } %min, 0
    store <32 x bfloat> %min.v, ptr %buf, align 64
    %ld = load <32 x bfloat>, ptr null, align 64
    %mac = tail call <32 x float> @llvm.aie2ps.bf16.I512.bf16.ACC1024.bf.mac.conf(<32 x bfloat> %ld, bfloat 0xR0000, <32 x float> %acc, i32 60)
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare <32 x float> @llvm.aie2ps.bf16.I512.bf16.ACC1024.bf.mac.conf(<32 x bfloat>, bfloat, <32 x float>, i32)
  declare <32 x bfloat> @llvm.aie2ps.v32accfloat.to.v32bf16(<32 x float>)
  declare { <32 x bfloat>, i32 } @llvm.aie2ps.vmax.ltbfloat16(<32 x bfloat>, <32 x bfloat>)
  declare { <32 x bfloat>, i32 } @llvm.aie2ps.vmin.gebfloat16(<32 x bfloat>, <32 x bfloat>)
  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 6}
...
---
name:            prologue_clone_order
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $p0, $r0

    renamable $r2 = MOVXM_lng_cg 16256
    renamable $x10 = VBCST_16 killed renamable $r2
    renamable $r2 = MOV_RLC_imm11_pseudo 0
    renamable $x0 = VBCST_16 renamable $r2
    renamable $x6 = VBCST_32 renamable $r2
    $bmll0 = VMOV_alu_mv_mv_mv_x $x6
    $bmlh0 = VMOV_alu_mv_mv_mv_x $x6
    renamable $p1 = MOV_PD_imm11_pseudo 0
    renamable $r9 = MOV_RLC_imm11_pseudo 60
    VST_dmx_sts_x_st_idx_imm killed renamable $x10, renamable $p0, 0 :: (store (<32 x s16>) into %ir.buf)
    $lc = ADD_NC_add_lc_ri $r0, 0
    SET_LS_REL_pseudo %bb.1, implicit-def $ls, implicit $pc
    SET_LE_REL_pseudo <mcsymbol .L_LEnd0>, implicit-def $le, implicit $pc

  bb.1.loop:
    successors: %bb.1, %bb.2
    liveins: $cml0, $p0, $p1, $r2, $r9, $x0

    renamable $x4 = VCONV_bf16_fp32_mv_conv_mv_x_srs_bf16 renamable $cml0, implicit-def dead $srf2fflags, implicit $crf2fmask, implicit $crfpconvsat, implicit $crrnd
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, killed renamable $x4, implicit $crbf8conf, implicit $crfp8conf
    renamable $x10, dead renamable $r16 = VMIN_GE_bf16 killed renamable $x6, renamable $x0, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm killed renamable $x10, renamable $p0, 0 :: (store (<32 x s16>) into %ir.buf)
    renamable $x10 = VLD_x_idx_imm_pseudo renamable $p1, 0 :: (load (<32 x s16>) from `ptr null`)
    $cml0 = VMAC_f_vmac_bf_half_vmul_bf_core_X_R killed $cml0, killed $x10, $r2, $r9, implicit-def dead $srfpflags, implicit $crbf8conf, implicit $crfp8conf, implicit $crfpmask
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit:
    RET implicit $lr
    DelayedSchedBarrier
...
