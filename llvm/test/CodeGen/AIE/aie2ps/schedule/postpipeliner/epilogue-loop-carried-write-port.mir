# RUN: llc --mtriple=aie2ps -O2 --run-pass=postmisched --aie-loop-min-tripcount=16 %s -o - | FileCheck %s

# LDA_s16_idx books the scalar write-A port five cycles after issue, which is
# more than the II=2 of this pipelined loop. Its reservations therefore reach
# the epilogue from iterations older than the last one: the loads of the two
# final iterations book the port in epilogue cycles 3 and 1.
#
# MOVA books the same port in its first cycle, so it cannot be packed into the
# first epilogue bundle. It goes into the second one instead, next to the
# drained ADD_alu_r_rr, which requires the top scoreboard of the epilogue to
# replay the loop body more than once.

--- |
  target triple = "aie2ps"

  define void @epilogue_loop_carried_write_port() {
  entry:
    unreachable
  }
...
---
name:            epilogue_loop_carried_write_port
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: epilogue_loop_carried_write_port
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $dj0, $p2, $p4, $r0, $r2, $r6, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $lc = ADD_NC_add_lc_ri killed $r6, -1
  ; CHECK-NEXT:   MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
  ; CHECK-NEXT:   MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   BUNDLE implicit-def $r26, implicit-def $r20, implicit $p4, implicit $dj0, implicit $r0, implicit $r2 {
  ; CHECK-NEXT:     renamable $r26 = LDA_s16_idx renamable $p4, renamable $dj0 :: (load (s16))
  ; CHECK-NEXT:     renamable $r20 = MUL renamable $r0, renamable $r2
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $p2 = VST_dmx_sts_x_st_pstm_nrm_imm renamable $x0, killed renamable $p2, 64 :: (store (<32 x s16>))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $dj0, $p2, $p4, $r0, $r2, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $r26, implicit-def $r20, implicit $p4, implicit $dj0, implicit $r0, implicit $r2 {
  ; CHECK-NEXT:     renamable $r26 = LDA_s16_idx renamable $p4, renamable $dj0 :: (load (s16))
  ; CHECK-NEXT:     renamable $r20 = MUL renamable $r0, renamable $r2
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def $p2, implicit-def $r28, implicit-def dead $srcarry, implicit $x0, implicit killed $p2, implicit killed $r20, implicit $r0 {
  ; CHECK-NEXT:     renamable $p2 = VST_dmx_sts_x_st_pstm_nrm_imm renamable $x0, killed renamable $p2, 64 :: (store (<32 x s16>))
  ; CHECK-NEXT:     renamable $r28 = ADD_alu_r_rr killed renamable $r20, renamable $r0, implicit-def dead $srcarry
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $r0, $r26, $r28
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   BUNDLE implicit-def $r24, implicit-def $r28, implicit-def dead $srcarry, implicit killed $r20, implicit $r0 {
  ; CHECK-NEXT:     renamable $r24 = MOVA -31
  ; CHECK-NEXT:     renamable $r28 = ADD_alu_r_rr killed renamable $r20, renamable $r0, implicit-def dead $srcarry
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $r24 = ASHL killed renamable $r0, killed renamable $r24
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier csr_aie2ps
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $dj0, $p2, $p4, $r0, $r2, $r6, $x0

    $lc = ADD_NC_add_lc_ri $r6, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $dj0, $p2, $p4, $r0, $r2, $x0

    renamable $r26 = LDA_s16_idx renamable $p4, renamable $dj0 :: (load (s16))
    renamable $r20 = MUL renamable $r0, renamable $r2
    renamable $r28 = ADD_alu_r_rr killed renamable $r20, renamable $r0, implicit-def dead $srcarry
    renamable $p2 = VST_dmx_sts_x_st_pstm_nrm_imm renamable $x0, killed renamable $p2, 64 :: (store (<32 x s16>))
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2:
    liveins: $r0, $r26, $r28

    renamable $r24 = MOVA -31
    renamable $r24 = ASHL renamable $r0, killed renamable $r24
    RET implicit $lr
    DelayedSchedBarrier csr_aie2ps
...
