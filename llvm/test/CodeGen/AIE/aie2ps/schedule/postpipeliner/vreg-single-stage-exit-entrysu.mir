# RUN: llc -mtriple=aie2ps -O2 --start-before=postmisched %s \
# RUN:   -aie-postpipeliner-phys-mode=true -aie-postpipeliner-vreg-mode=false \
# RUN:   -aie-postpipeliner-minii=5 -aie-postpipeliner-force-stagecount=1 \
# RUN:   -verify-machineinstrs -o - | FileCheck %s

# A forced one-stage physical postpipeliner schedule has no epilogue
# TopInsert. After PipeliningDone rebuilds loop->exit with AddLoopTail
# PreDepths, RegionStartEdges still runs and gives the exit vmax an
# EntrySU latency of 4. The store to p7 keeps the live-out vlda near the
# end of the II; two nops pad before ret so the delay-slot vmax covers
# the VLDA latency of 7.

--- |
  define void @f(ptr noalias %a, ptr noalias %g, ptr %h, i32 %n) {
  ; CHECK-LABEL: f:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:  .LBB0_1: // %preheader
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add.nc lc, r0, #0; nopm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add.nc le, pc, #.L_LEnd0; addm.nc ls, pc, #.LBB0_2; nopv
  ; CHECK-NEXT:  .LBB0_2: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; vldb x6, [p0, #0]; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopx
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vmax_lt.bf16 x6, r16, x0, x6
  ; CHECK-NEXT:    vmax_lt.bf16 x6, r16, x0, x6
  ; CHECK-NEXT:    vmax_lt.bf16 x6, r16, x0, x6
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vst x6, [p7, #0]
  ; CHECK-NEXT:    vlda x8, [p7, #0]
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.3: // %exit
  ; CHECK-NEXT:    nopa ; nopb ; nopxm
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    vmax_lt.bf16 x2, r16, x0, x8 // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    vst x2, [p1, #0] // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    br label %preheader
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop
  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }
  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 32}
...
---
name:            f
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $p0, $p1, $p7, $r0, $x0

  bb.1.preheader:
    successors: %bb.2
    liveins: $p0, $p1, $p7, $r0, $x0

    $lc = ADD_NC_add_lc_ri $r0, 0
    SET_LS_REL_pseudo %bb.2, implicit-def $ls, implicit $pc
    SET_LE_REL_pseudo <mcsymbol .L_LEnd0>, implicit-def $le, implicit $pc

  bb.2.loop:
    successors: %bb.2, %bb.3
    liveins: $p0, $p1, $p7, $x0

    renamable $x6 = VLD_x_idx_imm_pseudo renamable $p0, 0 :: (load (<32 x s16>) from %ir.a)
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x6, implicit $crbf8conf, implicit $crfp8conf
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x6, implicit $crbf8conf, implicit $crfp8conf
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x6, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm renamable $x6, renamable $p7, 0 :: (store (<32 x s16>) into %ir.h)
    renamable $x8 = VLD_x_idx_imm_pseudo renamable $p7, 0 :: (load (<32 x s16>) from %ir.h)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.exit:
    liveins: $p1, $x0, $x8
    renamable $x2, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, killed renamable $x8, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm killed renamable $x2, renamable $p1, 0 :: (store (<32 x s16>) into %ir.g)
    RET implicit $lr
    DelayedSchedBarrier
...
