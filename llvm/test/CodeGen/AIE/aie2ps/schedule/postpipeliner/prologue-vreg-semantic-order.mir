# RUN: llc -mtriple=aie2ps -O2 --start-before=postmisched %s \
# RUN:   -aie-postpipeliner-phys-mode=false -aie-postpipeliner-minii=8 \
# RUN:   -verify-machineinstrs -o - | FileCheck %s

# With register virtualization in the post-pipeliner, the semantic order of
# the prologue clones no longer matches their register accesses. The vldb into
# x8 in bb.0 must land before the prologue's vmax_lt.bf16 into x8, so that the
# vst to [p7] stores the vmax_lt.bf16 value. The prologue clones are fixed, so
# they keep all their x8 dependences instead of standing in for each other.

--- |
  define void @f(ptr noalias %a, ptr noalias %b, ptr noalias %c, ptr noalias %d, ptr noalias %e, ptr noalias %f, ptr noalias %g, ptr noalias %h, ptr noalias %z, ptr noalias %y, i32 %n, i32 %skip) {
  ; CHECK-LABEL: f:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:    nopa ; vldb x8, [p5, #0]; jnz r1, #.LBB0_4; nops
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ; CHECK-NEXT:  // %bb.1: // %preheader
  ; CHECK-NEXT:    vlda x8, [p2, #0]; vldb x6, [p1, #0]; vmax_lt.bf16 x8, r16, x0, x0
  ; CHECK-NEXT:    vldb x2, [p4, #0]; vmax_lt.bf16 x2, r16, x8, x0
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vst x2, [p6, #0]; vmax_lt.bf16 x4, r16, x0, x0
  ; CHECK-NEXT:    vst x2, [p7, #0]
  ; CHECK-NEXT:    vst x4, [p0, #0]
  ; CHECK-NEXT:    add.nc lc, r0, #-1; addm.nc ls, pc, #.LBB0_2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add.nc le, pc, #.L_LEnd0; vmax_lt.bf16 x2, r16, x8, x8; nopv
  ; CHECK-NEXT:  .LBB0_2: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    vlda x8, [p2, #0]; vldb x6, [p1, #0]; vst x2, [p3, #0]; nopx ; vmax_lt.bf16 x8, r16, x0, x0; nopv
  ; CHECK-NEXT:    nopa ; vldb x2, [p4, #0]; nops ; nopx ; vmax_lt.bf16 x2, r16, x8, x0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmin_ge.bf16 x6, r16, x6, x4; nopv
  ; CHECK-NEXT:    nopa ; nopb ; vst x2, [p6, #0]; nopx ; vmax_lt.bf16 x4, r16, x0, x0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; vst x2, [p7, #0]; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nopxm ; vst x4, [p0, #0]
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmax_lt.bf16 x2, r16, x8, x8; nopv
  ; CHECK-NEXT:  // %bb.3: // %exit
  ; CHECK-NEXT:    nopa ; nopb ; vst x2, [p3, #0]; ret lr; nopm ; nopv
  ; CHECK-NEXT:    nopa ; nopx // Delay Slot 5
  ; CHECK-NEXT:    vmin_ge.bf16 x6, r16, x6, x4 // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ; CHECK-NEXT:  .LBB0_4: // %skipbb
  ; CHECK-NEXT:    vldb x2, [p6, #0]; nopx
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    vmax_lt.bf16 x4, r16, x2, x8 // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    vst x4, [p7, #0] // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    %c0 = icmp ne i32 %skip, 0
    br i1 %c0, label %skipbb, label %preheader
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop
  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  skipbb:
    ret void
  }
  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 32}
...
---
name:            f
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.4
    liveins: $p0, $p1, $p2, $p3, $p4, $p5, $p6, $p7, $r0, $r1, $x0

    renamable $x8 = VLD_x_idx_imm_pseudo renamable $p5, 0 :: (load (<32 x s16>) from %ir.z)
    JNZ $r1, %bb.4
    DelayedSchedBarrier

  bb.1.preheader:
    successors: %bb.2
    liveins: $p0, $p1, $p2, $p3, $p4, $p6, $p7, $r0, $x0

    $lc = ADD_NC_add_lc_ri $r0, 0
    SET_LS_REL_pseudo %bb.2, implicit-def $ls, implicit $pc
    SET_LE_REL_pseudo <mcsymbol .L_LEnd0>, implicit-def $le, implicit $pc

  bb.2.loop:
    successors: %bb.2, %bb.3
    liveins: $p0, $p1, $p2, $p3, $p4, $p6, $p7, $x0

    renamable $x8 = VLD_x_idx_imm_pseudo renamable $p1, 0 :: (load (<32 x s16>) from %ir.a)
    renamable $x6 = VLD_x_idx_imm_pseudo renamable $p2, 0 :: (load (<32 x s16>) from %ir.b)
    renamable $x2, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x0, implicit $crbf8conf, implicit $crfp8conf
    renamable $x4 = VLD_x_idx_imm_pseudo renamable $p4, 0 :: (load (<32 x s16>) from %ir.c)
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x6, renamable $x6, implicit $crbf8conf, implicit $crfp8conf
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x0, renamable $x0, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm renamable $x6, renamable $p0, 0 :: (store (<32 x s16>) into %ir.e)
    renamable $x6, dead renamable $r16 = VMIN_GE_bf16 renamable $x8, renamable $x6, implicit $crbf8conf, implicit $crfp8conf
    renamable $x6, dead renamable $r16 = VMAX_LT_bf16 renamable $x2, renamable $x0, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm renamable $x4, renamable $p3, 0 :: (store (<32 x s16>) into %ir.f)
    VST_dmx_sts_x_st_idx_imm renamable $x6, renamable $p6, 0 :: (store (<32 x s16>) into %ir.g)
    VST_dmx_sts_x_st_idx_imm renamable $x6, renamable $p7, 0 :: (store (<32 x s16>) into %ir.h)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.exit:
    RET implicit $lr
    DelayedSchedBarrier

  bb.4.skipbb:
    liveins: $p6, $p7, $x8

    renamable $x2 = VLD_x_idx_imm_pseudo renamable $p6, 0 :: (load (<32 x s16>) from %ir.y)
    renamable $x4, dead renamable $r16 = VMAX_LT_bf16 killed renamable $x2, killed renamable $x8, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm killed renamable $x4, renamable $p7, 0 :: (store (<32 x s16>) into %ir.y)
    RET implicit $lr
    DelayedSchedBarrier
...
