# FIXME: A dead e destination still writes MV_Bypass one cycle before the
# register-file write. The next mov reads el through that bypass. mEEa and
# mEla share no register: e4 overlaps el4 only because el4 is its low half, so
# the admissible regunit sets overlap without being equal. Skipping that
# partial overlap lets post-regalloc place the el read on el4, so the mov
# observes the dead vmov instead of its own source.
#
# The CHECKs below capture the current buggy schedule:
#   mov el4, el1
#   vmov e4, e0
#   mov el6, el4   ; source is the low half of the previous dest
#
# Contrast dead-bypass-alias-read.mir, where both sides are mXm and the overlap
# is the same register.

# RUN: llc -verify-machineinstrs --mtriple=aie2ps -O2 \
# RUN:     --start-before=postmisched %s \
# RUN:     --aie-postpipeliner-vreg-mode=1 \
# RUN:     --aie-postpipeliner-phys-mode=0 \
# RUN:     -o - | FileCheck %s

--- |
  target triple = "aie2ps"

  define void @dead_bypass_subreg_overlap(i32 %n) {
  ; CHECK-LABEL: dead_bypass_subreg_overlap:
  ; CHECK:       // %bb.0: // %preheader
  ; CHECK-NEXT:    nopa ; add.nc lc, r1, #0; nopm
  ; CHECK-NEXT:    movxm ls, #.LBB0_1
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_1: // %loop_body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; mov el4, el1; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmov e4, e0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; mov el6, el4; nopv
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; mov el5, el6; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 16}
...
---
name:            dead_bypass_subreg_overlap
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $r1, $e0, $e1, $e8, $e9, $e10, $e11

    $lc = ADD_NC_add_lc_ri $r1, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop_body (align 16):
    successors: %bb.1, %bb.2
    liveins: $e0, $e1, $e8, $e9, $e10, $e11

    ; el5 is produced just before the dead e write and consumed just after, so
    ; it is live on the bypass-publish cycle. e0 stays fixed, and e8-e11 stay
    ; live, leaving e4 as the dead destination. el4 is that destination's low
    ; half. The CHECKs currently allow the el read to land there.
    $el5 = MOV_alu_mv_mv_mv_e_mv_el_to_el $el1
    dead $e4 = VMOV_alu_mv_mv_mv_ee $e0
    $el6 = MOV_alu_mv_mv_mv_e_mv_el_to_el killed $el5
    dead $el6 = MOV_alu_mv_mv_mv_e_mv_el_to_el killed $el6

    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):
    liveins: $e0, $e1, $e8, $e9, $e10, $e11
    RET implicit $lr
    DelayedSchedBarrier
...
