# RUN: llc -verify-machineinstrs --mtriple=aie2ps -O2 \
# RUN:     --start-before=postmisched %s \
# RUN:     --aie-postpipeliner-vreg-mode=1 \
# RUN:     --aie-postpipeliner-phys-mode=0 \
# RUN:     -pass-remarks-output=- -pass-remarks-filter=pipeliner \
# RUN:     -o /dev/null 2>/dev/null \
# RUN:   | FileCheck %s

# This example demonstrates the effect of unused results from an instruction.
# Postregalloc would include the bypass write in the live range of that
# register. Two such liveranges competing for a single register would require
# four cycles to accommodate those live ranges.
# By recognising that the bypass is not used for these dead definitions we can
# bring that back to II=2.
# We use a minimal setup with the real-life instructions suffering from this
# effect, VMIN and VMAX. They compute the comparison result as a side-effect of
# computing the vectorvalue result in a singleton register class.
# We feed both off a load without further data dependences.
# This should fit in NS=4 x II=2 if we ignore the bypass write.


--- |
  target triple = "aie2ps"

  define void @minmax_deadrange(ptr addrspace(6) noalias %data, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 5}
...
---
name:            minmax_deadrange
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK: --- !Passed
  ; CHECK-NEXT: Pass:            pipeliner
  ; CHECK-NEXT: Name:            schedule
  ; CHECK-NEXT: Function:        minmax_deadrange
  ; CHECK-NEXT: Args:
  ; CHECK-NEXT:   - String:          Schedule found
  ; CHECK-NEXT:   - Pipeliner:       postpipeliner
  ; CHECK-NEXT:   - II:              '2'
  ; CHECK-NEXT:   - NS:              '5'
  ; CHECK-NEXT:   - Loop:            bb.1.loop_body
  ; CHECK-NEXT:   - Prologue:        bb.0.preheader
  ; CHECK-NEXT:   - PrologueBundles: '8'
  ; CHECK-NEXT:   - Epilogue:        bb.2.exit
  ; CHECK-NEXT:   - EpilogueBundles: '8'
  ; CHECK-NEXT:   - VregMode:        Virtual
  ; CHECK-NEXT:   - SchedHeuristic:  Config_10_1_0_NodeNum
  ; CHECK-NEXT:   - AllocHeuristic:  scarce register class scoring
  ; CHECK-NEXT: ...
  bb.0.preheader:
    successors: %bb.1
    liveins: $p0, $r1, $x3, $x4

    $lc = ADD_NC_add_lc_ri $r1, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop_body (align 16):
    successors: %bb.1, %bb.2
    liveins: $p0, $x3, $x4

    ; Load a vector; the output $x1 has a 7-cycle latency.
    $x1, $p0 = VLDB_UNPACK_dmw_ldb_unpack_pstm_nrm_imm_unpackSign1 $p0, 32, implicit $crunpacksize, implicit $unpacksign1

    ; Clip to minimum: reads $x1 and bound $x3 independently.
    ; The comparison result $r16 is dead (unused).
    dead $x5, dead $r16 = VMIN_GE_16_vaddSign1 $x1, $x3, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1

    ; Clip to maximum: reads $x1 and bound $x4 independently.
    ; The comparison result $r16 is dead (unused).
    dead $x6, dead $r16 = VMAX_LT_16_vaddSign1 $x1, $x4, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1

    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):
    RET implicit $lr
    DelayedSchedBarrier
...
