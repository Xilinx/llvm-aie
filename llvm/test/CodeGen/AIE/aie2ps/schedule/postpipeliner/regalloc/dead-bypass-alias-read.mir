# FIXME: A dead VMIN/VMAX vector destination still writes the MV_Bypass one
# cycle before the register-file write. The next instruction's vector source
# is read through that same bypass on the RF-write cycle. Skipping the dead
# bypass lane lets post-regalloc place both on one x register, so the second
# instruction sees the previous clip result instead of its own source.
#
# The CHECKs below capture the current buggy schedule:
#   vmin_ge.16 x5, r16, x7, x8
#   vmax_lt.16 x6, r16, x5, x9   ; source is previous dest
#   vmin_ge.16 x4, r16, x6, x10  ; source is previous dest
#
# Contrast minmax-deadrange.mir: both r16 defs are dead and nothing reads
# r16, so skipping those bypass lanes is correct and II=2 stays legal.

# RUN: llc -verify-machineinstrs --mtriple=aie2ps -O2 \
# RUN:     --start-before=postmisched %s \
# RUN:     --aie-postpipeliner-vreg-mode=1 \
# RUN:     --aie-postpipeliner-phys-mode=0 \
# RUN:     -o - | FileCheck %s

--- |
  target triple = "aie2ps"

  define void @dead_bypass_alias_read(i32 %n) {
  ; CHECK-LABEL: dead_bypass_alias_read:
  ; CHECK:       // %bb.0: // %preheader
  ; CHECK-NEXT:    nopa ; add.nc lc, r1, #0; nopm
  ; CHECK-NEXT:    movxm ls, #.LBB0_1
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_1: // %loop_body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vadd.16 x7, x0, x0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vadd.16 x5, x1, x1; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vadd.16 x6, x2, x2; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vadd.16 x4, x3, x3; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmin_ge.16 x5, r16, x7, x8, vaddsign1; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nopx ; vmax_lt.16 x6, r16, x5, x9, vaddsign1
  ; CHECK-NEXT:    vmin_ge.16 x4, r16, x6, x10, vaddsign1
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmax_lt.16 x4, r16, x4, x11, vaddsign1; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 16}
...
---
name:            dead_bypass_alias_read
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $r1, $x0, $x1, $x2, $x3, $x8, $x9, $x10, $x11

    $lc = ADD_NC_add_lc_ri $r1, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop_body (align 16):
    successors: %bb.1, %bb.2
    liveins: $x0, $x1, $x2, $x3, $x8, $x9, $x10, $x11

    ; Short-lived VADD results feed dead-dest VMIN/VMAX clips, matching the
    ; VMAC -> dead VEXP2_ADDR_f pattern. x8-x11 stay live so mXm is scarce.
    $x4 = VADD_16 $x0, $x0, implicit $crbf8conf, implicit $crfp8conf
    dead $x4, dead $r16 = VMIN_GE_16_vaddSign1 killed $x4, $x8, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1
    $x5 = VADD_16 $x1, $x1, implicit $crbf8conf, implicit $crfp8conf
    dead $x5, dead $r16 = VMAX_LT_16_vaddSign1 killed $x5, $x9, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1
    $x6 = VADD_16 $x2, $x2, implicit $crbf8conf, implicit $crfp8conf
    dead $x6, dead $r16 = VMIN_GE_16_vaddSign1 killed $x6, $x10, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1
    $x7 = VADD_16 $x3, $x3, implicit $crbf8conf, implicit $crfp8conf
    dead $x7, dead $r16 = VMAX_LT_16_vaddSign1 killed $x7, $x11, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1

    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):
    liveins: $x0, $x1, $x2, $x3, $x8, $x9, $x10, $x11
    RET implicit $lr
    DelayedSchedBarrier
...
