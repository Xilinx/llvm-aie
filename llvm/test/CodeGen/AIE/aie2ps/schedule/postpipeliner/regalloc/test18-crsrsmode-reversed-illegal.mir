# RUN: llc -verify-machineinstrs --mtriple=aie2ps -O2 \
# RUN:   --start-before=postmisched %s \
# RUN:   --aie-postpipeliner-vreg-mode=1 \
# RUN:   --aie-postpipeliner-phys-mode=0 \
# RUN:   --aie-simplify-reserved-regs \
# RUN:   --aie-postpipeliner-minii=2 \
# RUN:   --aie-postpipeliner-maxii=2 \
# RUN:   --debug-only=postpipeliner \
# RUN:   -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: asserts

# Test 18: crSRSMode reversed schedule - illegal ordering rejected by PostRegAlloc.
#
# Same loop body as test17 (VUPS depth on first SRS group, VSRS_2x writes
# to x1).  Forcing II=2, the pipeliner's initial scheduling order places
# MOVX0 at cycle 0 and VSRS_2x at cycle 3 (crSRSMode=0 window [0, 3]),
# while MOVX1 lands at cycle 1 inside that window.  PostRegAlloc detects
# the resulting crSRSMode conflict and rejects the schedule.
#
# Because the VSRS results are in x0/x1 (different registers), register
# allocation cannot fail on those live ranges; any rejection must be due
# to the crSRSMode implicit-use live range conflict.
#
# CHECK: PostPipeliner: Register allocation failed

--- |
  target triple = "aie2ps"

  define void @test_crsrsmode_reversed_illegal(ptr addrspace(5) noalias %in, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop
  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 4}
...
---
name:            test_crsrsmode_reversed_illegal
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $r1, $x10, $s0, $s1, $dm5, $s2

    $lc = ADD_NC_add_lc_ri $r1, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop (align 16):
    successors: %bb.1, %bb.2
    liveins: $x10, $s0, $s1, $dm5, $s2

    ; VUPS creates depth on the first crSRSMode group, enticing reversal.
    $cml0 = VUPS_2x_mv_ups_x2c_upsSign1 $x10, $s0, implicit-def dead $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1

    ; First crSRSMode live range.  Result goes to x1 to isolate crSRSMode
    ; as the only source of potential interference.
    $crsrsmode = MOVX_mvx_cr_imm 0
    $x1 = VSRS_2x_mv_x_srs_cm_srsSign1 $cml0, $s1, implicit-def dead $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1

    ; Second crSRSMode live range.
    $crsrsmode = MOVX_mvx_cr_imm 1
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign1 $dm5, $s2, implicit-def dead $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1

    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):

    RET implicit $lr
    DelayedSchedBarrier

...
