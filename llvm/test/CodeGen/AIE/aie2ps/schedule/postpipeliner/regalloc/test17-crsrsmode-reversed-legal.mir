# RUN: llc -verify-machineinstrs --mtriple=aie2ps -O2 \
# RUN:   --start-before=postmisched %s \
# RUN:   --aie-postpipeliner-vreg-mode=1 \
# RUN:   --aie-postpipeliner-phys-mode=0 \
# RUN:   --aie-simplify-reserved-regs \
# RUN:   -o - | FileCheck %s

# Test 17: crSRSMode reversed schedule - PostRegAlloc accepts.
#
# A VUPS before the first SRS creates depth on the first crSRSMode live
# range (MOVX0 -> VSRS_2x), enticing the pipeliner to schedule the second
# crSRSMode group first.  The VSRS_2x result is routed to x1 (not x0) so
# that register allocation cannot fail on the SRS output registers; the
# only potential conflict is crSRSMode itself.
#
# The pipeliner (II=2) finds the reversed schedule:
#   Bundle 0: vsrs.4x (uses crSRSMode=1 from prev iter), movx crsrsmode,#0, vups.2x
#   Bundle 1: vsrs.2x (uses crSRSMode=0 from bundle 0), movx crsrsmode,#1
#
# PostRegAlloc accepts this because the two crSRSMode windows:
#   LR1 [cycle 2, cycle 3]  (MOVX0 at 2, VSRS_2x at 3)
#   LR2 [cycle 1, cycle 2]  (MOVX1 at 1, VSRS_4x at 2)
# share only a boundary cycle (2) where VLIW same-cycle read-before-write
# semantics keep them non-conflicting.
#

--- |
  target triple = "aie2ps"

  define void @test_crsrsmode_reversed_legal(ptr addrspace(5) noalias %in, i32 %n) {
  ; CHECK-LABEL: test_crsrsmode_reversed_legal:
  ; CHECK:       // %bb.0: // %preheader
  ; CHECK-NEXT:    nopa ; add.nc lc, r1, #-1; nopm
  ; CHECK-NEXT:    movxm ls, #.LBB0_1
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vups.2x cml0, x10, s0, upssign1; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movx crsrsmode, #1; nopm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_1: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; nopb ; vsrs.4x x1, dm5, s2, srssign1; movx crsrsmode, #0; vups.2x cml0, x10, s0, upssign1; nopv
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; vsrs.2x x1, cml0, s1, srssign1; movx crsrsmode, #1; nopm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; nopb ; vsrs.4x x1, dm5, s2, srssign1; movx crsrsmode, #0; nopm ; nopv
  ; CHECK-NEXT:    vsrs.2x x1, cml0, s1, srssign1; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop
  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 4}
...
---
name:            test_crsrsmode_reversed_legal
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $r1, $x10, $s0, $s1, $dm5, $s2

    $lc = ADD_NC_add_lc_ri $r1, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop (align 16):
    successors: %bb.1, %bb.2
    liveins: $x10, $s0, $s1, $dm5, $s2

    ; VUPS creates depth on the first crSRSMode group, enticing reversal.
    $cml0 = VUPS_2x_mv_ups_x2c_upsSign1 $x10, $s0, implicit-def dead $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1

    ; First crSRSMode live range.  Result goes to x1 to isolate crSRSMode
    ; as the only source of potential interference.
    $crsrsmode = MOVX_mvx_cr_imm 0
    $x1 = VSRS_2x_mv_x_srs_cm_srsSign1 $cml0, $s1, implicit-def dead $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1

    ; Second crSRSMode live range.
    $crsrsmode = MOVX_mvx_cr_imm 1
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign1 $dm5, $s2, implicit-def dead $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1

    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):

    RET implicit $lr
    DelayedSchedBarrier

...
