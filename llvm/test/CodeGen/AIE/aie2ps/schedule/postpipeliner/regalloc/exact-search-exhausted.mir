# y0 is loaded twice. This loop can use only three 1024-bit registers, y0-y2.
# One scheduling attempt overlaps both y0 values with y1 and y2. The exact
# search tries every order of the virtual ranges and finds none. That takes
# 32256 nodes.
# REQUIRES: asserts

# RUN: llc -verify-machineinstrs --mtriple=aie2ps -O2 \
# RUN:   --start-before=postmisched %s \
# RUN:   --aie-postpipeliner-vreg-mode=1 \
# RUN:   --aie-postpipeliner-phys-mode=0 \
# RUN:   --aie-postpipeliner-heuristic=0 \
# RUN:   --aie-postpipeliner-maxtry-ii=1 \
# RUN:   --aie-postregalloc-exact-budget=100000 \
# RUN:   --debug-only=aie-postregalloc \
# RUN:   -o /dev/null 2>&1 \
# RUN:   | FileCheck %s

# CHECK: Exact: infeasible nodes=32256

--- |
  target triple = "aie2ps"

  define void @exact_search_exhausted(ptr addrspace(6) noalias %data, i32 %n) {
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 5}
...
---
name:            exact_search_exhausted
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $p0, $r1, $r8

    $lc = ADD_NC_add_lc_ri $r1, 0
    MOVXM_lng_cg_ls_abs %bb.1, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.1.loop_body (align 16):
    successors: %bb.1, %bb.2
    liveins: $p0, $r8

    $y0, $p0 = VLDB_UNPACK_dmx_ldb_unpack_pstm_nrm_imm_unpackSign1 $p0, 32, implicit $crunpacksize, implicit $unpacksign1
    $y1, $p0 = VLDB_UNPACK_dmx_ldb_unpack_pstm_nrm_imm_unpackSign1 $p0, 32, implicit $crunpacksize, implicit $unpacksign1
    $y2, $p0 = VLDB_UNPACK_dmx_ldb_unpack_pstm_nrm_imm_unpackSign1 $p0, 32, implicit $crunpacksize, implicit $unpacksign1
    $dm0 = VMUL_vmul_vmul_cm_core_Y_Y $y0, $y2, $r8
    $dm1 = VMUL_vmul_vmul_cm_core_Y_Y $y1, $y2, $r8
    $y0, $p0 = VLDB_UNPACK_dmx_ldb_unpack_pstm_nrm_imm_unpackSign1 $p0, 32, implicit $crunpacksize, implicit $unpacksign1
    $dm2 = VMUL_vmul_vmul_cm_core_Y_Y $y0, $y0, $r8

    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):
    RET implicit $lr
    DelayedSchedBarrier

...
