# RUN: llc -mtriple=aie2ps -O2 --start-before=postmisched %s \
# RUN:   -aie-postpipeliner-phys-mode=false -verify-machineinstrs -o - \
# RUN:   | FileCheck %s

# With register virtualization in the post-pipeliner, the loop body's
# instruction order no longer matches its register accesses. The loop has two
# stages. The second vmax_lt.bf16 is reallocated to x8, sits in the last stage
# and so has no prologue clone, and issues in kernel cycle 1. The first
# vmax_lt.bf16 writes x8 later in the kernel but comes first in the loop body.
# On the preheader->loop edge the kernel nodes are free, so the first one
# stands in for the second, and the preheader's dead vldb into x8 gets no WAW
# edge to the second one.
# The checks show the miscompile: the vldb into x8 issues three cycles before
# the loop and lands after the kernel's vmax_lt.bf16 into x8 at cycle 1, so in
# the first iteration the vst to [p7] stores the [p5] data.

--- |
  define void @f(ptr noalias %a, ptr noalias %b, ptr noalias %c, ptr noalias %d, ptr noalias %e, ptr noalias %f, ptr noalias %g, ptr noalias %h, ptr noalias %z, ptr noalias %y, i32 %n, i32 %skip) {
  ; CHECK-LABEL: f:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:  .LBB0_1: // %preheader
  ; CHECK-NEXT:    vldb x4, [p4, #0]; nopx
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vldb x8, [p5, #0]; add.nc lc, r0, #-1
  ; CHECK-NEXT:    vlda x8, [p2, #0]; nopb ; nops ; add.nc le, pc, #.L_LEnd0; addm.nc ls, pc, #.LBB0_2; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  .LBB0_2: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; vldb x4, [p4, #0]; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmax_lt.bf16 x8, r16, x4, x0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; vst x8, [p7, #0]; nopxm ; nopv
  ; CHECK-NEXT:    vlda x8, [p2, #0]; nopb ; vst x8, [p7, #0]; nopxm ; nopv
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; vst x8, [p7, #0]; nopx ; vmax_lt.bf16 x8, r16, x4, x4; nopv
  ; CHECK-NEXT:  // %bb.3: // %exit
  ; CHECK-NEXT:    nopa ; nopx
  ; CHECK-NEXT:    ret lr; vmax_lt.bf16 x8, r16, x4, x0
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    vst x8, [p7, #0] // Delay Slot 4
  ; CHECK-NEXT:    vst x8, [p7, #0] // Delay Slot 3
  ; CHECK-NEXT:    vst x8, [p7, #0]; vmax_lt.bf16 x8, r16, x4, x4 // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    br label %preheader
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop
  loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }
  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 32}
...
---
name:            f
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $p0, $p1, $p2, $p3, $p4, $p5, $p6, $p7, $r0, $r1, $x0

  bb.1.preheader:
    successors: %bb.2
    liveins: $p0, $p1, $p2, $p3, $p4, $p5, $p6, $p7, $r0, $x0

    dead $x8 = VLD_x_idx_imm_pseudo $p5, 0 :: (load (<32 x s16>) from %ir.z)
    $lc = ADD_NC_add_lc_ri $r0, 0
    SET_LS_REL_pseudo %bb.2, implicit-def $ls, implicit $pc
    SET_LE_REL_pseudo <mcsymbol .L_LEnd0>, implicit-def $le, implicit $pc

  bb.2.loop:
    successors: %bb.2, %bb.3
    liveins: $p0, $p1, $p2, $p3, $p4, $p6, $p7, $x0

    renamable $x4 = VLD_x_idx_imm_pseudo renamable $p4, 0 :: (load (<32 x s16>) from %ir.a)
    renamable $x8, dead renamable $r16 = VMAX_LT_bf16 renamable $x4, renamable $x4, implicit $crbf8conf, implicit $crfp8conf
    renamable $x4, dead renamable $r16 = VMAX_LT_bf16 renamable $x4, renamable $x0, implicit $crbf8conf, implicit $crfp8conf
    VST_dmx_sts_x_st_idx_imm renamable $x4, renamable $p7, 0 :: (store (<32 x s16>) into %ir.g)
    renamable $x8 = VLD_x_idx_imm_pseudo renamable $p2, 0 :: (load (<32 x s16>) from %ir.a)
    VST_dmx_sts_x_st_idx_imm renamable $x4, renamable $p7, 0 :: (store (<32 x s16>) into %ir.h)
    VST_dmx_sts_x_st_idx_imm renamable $x8, renamable $p7, 0 :: (store (<32 x s16>) into %ir.h)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.exit:
    RET implicit $lr
    DelayedSchedBarrier
...
