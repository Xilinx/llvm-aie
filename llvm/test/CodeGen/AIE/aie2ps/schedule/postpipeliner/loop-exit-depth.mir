# RUN: llc --mtriple=aie2ps -O2 --start-before=postmisched %s -o - | FileCheck %s
# RUN: llc --mtriple=aie2ps -O2 --start-before=postmisched \
# RUN:     --aie-interblock-loop-exit-depth=false %s -o - | \
# RUN:     FileCheck --check-prefix=NOEXIT %s

# The preheader ends with a VMAC whose accumulator is only consumed after the
# loop. The loop body runs at least MinTripCount - 1 times, so the VMAC doesn't
# need to complete when the loop is entered. With a minimum trip count of 5 it
# is scheduled closer to the loop; with a minimum trip count of 2 the loop is
# only guaranteed to run once and the schedule doesn't change.

--- |
  define void @minTC2(ptr addrspace(5) noalias %d, i32 %n) {
  ;
  ; CHECK-LABEL: minTC2:
  ; CHECK:         .p2align 4
  ; CHECK-NEXT:  // %bb.0: // %entry
  ; CHECK-NEXT:    mova r1, #0; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; ge r1, r1, r0
  ; CHECK-NEXT:    jnz r1, #.LBB0_4
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ; CHECK-NEXT:  // %bb.1: // %for.body.preheader
  ; CHECK-NEXT:    add.nc lc, r0, #-1
  ; CHECK-NEXT:    movxm ls, #.LBB0_2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; vmac.f cml0, cml0, x0, y5, r8
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    mova r1, #0; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add r1, r1, #1; nopm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_2: // %for.body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; st r1, [p0, #0]; add r1, r1, #1; nopm ; nopv
  ; CHECK-NEXT:  // %bb.3: // %for.cond.cleanup
  ; CHECK-NEXT:    nopa ; nopb ; st r1, [p0, #0]; nopxm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_4: // %for.cond.cleanup
  ; CHECK-NEXT:    ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    vsrs.2x x5, cml0, s0, srssign0 // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ;
  ; NOEXIT-LABEL: minTC2:
  ; NOEXIT:         .p2align 4
  ; NOEXIT-NEXT:  // %bb.0: // %entry
  ; NOEXIT-NEXT:    mova r1, #0; nopb ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopa ; ge r1, r1, r0
  ; NOEXIT-NEXT:    jnz r1, #.LBB0_4
  ; NOEXIT-NEXT:    nop // Delay Slot 5
  ; NOEXIT-NEXT:    nop // Delay Slot 4
  ; NOEXIT-NEXT:    nop // Delay Slot 3
  ; NOEXIT-NEXT:    nop // Delay Slot 2
  ; NOEXIT-NEXT:    nop // Delay Slot 1
  ; NOEXIT-NEXT:  // %bb.1: // %for.body.preheader
  ; NOEXIT-NEXT:    add.nc lc, r0, #-1
  ; NOEXIT-NEXT:    movxm ls, #.LBB0_2
  ; NOEXIT-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; vmac.f cml0, cml0, x0, y5, r8
  ; NOEXIT-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    mova r1, #0; nopb ; nops ; nopxm ; nopv
  ; NOEXIT-NEXT:    nopa ; nopb ; nops ; add r1, r1, #1; nopm ; nopv
  ; NOEXIT-NEXT:    .p2align 4
  ; NOEXIT-NEXT:  .LBB0_2: // %for.body
  ; NOEXIT-NEXT:    // =>This Inner Loop Header: Depth=1
  ; NOEXIT-NEXT:  .L_LEnd0:
  ; NOEXIT-NEXT:    nopa ; nopb ; st r1, [p0, #0]; add r1, r1, #1; nopm ; nopv
  ; NOEXIT-NEXT:  // %bb.3: // %for.cond.cleanup
  ; NOEXIT-NEXT:    nopa ; nopb ; st r1, [p0, #0]; nopxm ; nopv
  ; NOEXIT-NEXT:    .p2align 4
  ; NOEXIT-NEXT:  .LBB0_4: // %for.cond.cleanup
  ; NOEXIT-NEXT:    ret lr
  ; NOEXIT-NEXT:    nop // Delay Slot 5
  ; NOEXIT-NEXT:    vsrs.2x x5, cml0, s0, srssign0 // Delay Slot 4
  ; NOEXIT-NEXT:    nop // Delay Slot 3
  ; NOEXIT-NEXT:    nop // Delay Slot 2
  ; NOEXIT-NEXT:    nop // Delay Slot 1
  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %for.body.preheader, label %for.cond.cleanup

  for.body.preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.cond.cleanup:
    ret void

  for.body:
    %d.addr = phi ptr addrspace(5) [ %incdec.ptr, %for.body ], [ %d, %for.body.preheader ]
    %0 = phi i32 [ %add, %for.body ], [ 0, %for.body.preheader ]
    %add = add nsw i32 %0, 1
    store i32 %add, ptr addrspace(5) %d.addr, align 4
    %incdec.ptr = getelementptr inbounds i32, ptr addrspace(5) %d.addr, i20 1
    %1 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %1, label %for.body, label %for.cond.cleanup, !llvm.loop !0
  }

