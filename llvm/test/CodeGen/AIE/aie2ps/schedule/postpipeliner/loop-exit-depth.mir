---
name:            minTC2
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry (align 16):
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $p0, $p1, $r0, $x0, $y5, $cml0, $r8, $s0

    renamable $r1 = MOVA 0
    renamable $r1 = GE killed renamable $r1, renamable $r0
    JNZ killed renamable $r1, %bb.3
    DelayedSchedBarrier

  bb.1.for.body.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $r0, $x0, $y5, $cml0, $r8, $s0
    $r1 = MOVA 0
    $cml0 = VMAC_f_vmac_bf_half_vmul_bf_core_X_Y $cml0, $x0, $y5, $r8, implicit-def dead $srfpflags, implicit $crbf8conf, implicit $crfp8conf, implicit $crfpmask

    $lc = ADD_NC_add_lc_ri $r0, 0
    MOVXM_lng_cg_ls_abs %bb.2, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.2.for.body (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $r1, $cml0, $s0

    renamable $r1 = nsw ADD_add_r_ri killed renamable $r1, 1, implicit-def dead $srcarry
    ST_dms_sts_scalar_st_idx_imm killed renamable $r1, renamable $p0, 0 :: (store (s32) into %ir.d.addr)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.for.cond.cleanup (align 16):
    liveins: $cml0, $p1, $s0
    $x5 = VSRS_2x_mv_x_srs_cm_srsSign0 $cml0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    RET implicit $lr
    DelayedSchedBarrier

...
