# The first loop's epilogue and the second loop's prologue share %between.
# The free add reads r2 before the second loop's prologue load overwrites it,
# and defines r4 before a prologue mul uses it. The BotFixed dependencies keep
# the add no later than the load's issue cycle, before its result is available.

# RUN: llc --mtriple=aie2ps -O2 --start-before=postmisched \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "aie2ps"

  define void @two_loops(ptr addrspace(6) %s, ptr addrspace(6) %t, i32 %n) {
  ; CHECK-LABEL: two_loops:
  ; CHECK:       // %bb.0: // %entry
  ; CHECK-NEXT:    mova r2, #0; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.1: // %preheader
  ; CHECK-NEXT:    nopa ; add.nc lc, r0, #-2
  ; CHECK-NEXT:    lda r2, [p0], #4; movxm ls, #.LBB0_2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    lda r2, [p0], #4; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_2: // %loop
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    lda r2, [p0], #4; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; mul r2, r2, r1; nopm ; nopv
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.3: // %between
  ; CHECK-NEXT:    nopa ; add.nc lc, r0, #-4
  ; CHECK-NEXT:    mul r2, r2, r1
  ; CHECK-NEXT:    movxm ls, #.LBB0_4
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd1; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; mul r2, r2, r1; nopm ; nopv
  ; CHECK-NEXT:    lda r2, [p1], #4; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    lda r2, [p1], #4; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    lda r2, [p1], #4
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    lda r2, [p1], #4; add r4, r2, #1
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_4: // %loop2
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    lda r2, [p1], #4; nopb ; nops ; mul r3, r2, r4; nopm ; nopv
  ; CHECK-NEXT:  .L_LEnd1:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.5: // %exit
  ; CHECK-NEXT:    nopa ; nopb ; nops ; mul r3, r2, r4; nopm ; nopv
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    mul r3, r2, r4
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    mul r3, r2, r4
  ; CHECK-NEXT:    ret lr
  ; CHECK-NEXT:    mul r3, r2, r4 // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    add r0, r3, r4 // Delay Slot 3
  ; CHECK-NEXT:    mov r0, r0 // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    br label %preheader

  preheader:
    br label %loop

  loop:
    br i1 false, label %loop, label %between, !llvm.loop !0

  between:
    br label %loop2

  loop2:
    br i1 false, label %loop2, label %exit, !llvm.loop !4

  exit:
    ret void
  }

  !0 = distinct !{!0, !1, !2, !3}
  !1 = !{!"llvm.loop.mustprogress"}
  !2 = !{!"llvm.loop.itercount.range", i64 16}
  !3 = !{!"llvm.loop.itercount.range", i64 16}
  !4 = distinct !{!4, !1, !2}
...
---
name:            two_loops
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $p0, $p1, $r0, $r1

    renamable $r2 = MOV_RLC_imm11_pseudo 0

  bb.1.preheader:
    successors: %bb.2(0x80000000)
    liveins: $p0, $p1, $r0, $r1

    $lc = ADD_NC_add_lc_ri $r0, 0
    MOVXM_lng_cg_ls_abs %bb.2, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd0>, implicit-def $le

  bb.2.loop (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $p1, $r0, $r1

    renamable $r2, renamable $p0 = LDA_dms_lda_scalar_ld_pstm_nrm_imm killed renamable $p0, 4
    renamable $r2 = MUL killed renamable $r2, renamable $r1
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.between:
    successors: %bb.4(0x80000000)
    liveins: $p1, $r0, $r1, $r2

    $lc = ADD_NC_add_lc_ri $r0, 0
    MOVXM_lng_cg_ls_abs %bb.4, implicit-def $ls
    MOVXM_lng_cg_le_abs <mcsymbol .L_LEnd1>, implicit-def $le
    renamable $r4 = ADD_add_r_ri renamable $r2, 1, implicit-def dead $srcarry

  bb.4.loop2 (align 16):
    successors: %bb.4(0x7c000000), %bb.5(0x04000000)
    liveins: $p1, $r2, $r4

    renamable $r2, renamable $p1 = LDA_dms_lda_scalar_ld_pstm_nrm_imm killed renamable $p1, 4
    renamable $r3 = MUL killed renamable $r2, renamable $r4
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.4

  bb.5.exit:
    liveins: $r3, $r4

    renamable $r0 = ADD_alu_r_rr killed renamable $r3, killed renamable $r4, implicit-def dead $srcarry
    $r0 = MOV_alu_mv_mv_mv_scl killed $r0
    RET implicit $lr
    DelayedSchedBarrier implicit killed $r0
