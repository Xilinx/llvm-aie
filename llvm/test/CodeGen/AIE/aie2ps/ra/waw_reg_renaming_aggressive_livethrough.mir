# See https://llvm.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
#
# (c) Copyright 2026 Advanced Micro Devices, Inc. or its affiliates

# RUN: llc -mtriple=aie2ps -start-before=greedy --stop-after=virtregrewriter \
# RUN:   --aie-aggressive-realloc -aie-gpr-realloc %s -o - | FileCheck %s

---
name:            waw_livethrough_crash
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         false
registers:
  - { id: 0, class: mlockid_reg }
  - { id: 1, class: ep }
  - { id: 2, class: vec512 }
  - { id: 3, class: vec512 }
  - { id: 4, class: mlockid_reg }
  - { id: 5, class: vec512 }
body:             |
  ; CHECK-LABEL: name: waw_livethrough_crash
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r0 = MOV_RLC_imm11_pseudo 0
  ; CHECK-NEXT:   renamable $x2 = VBCST_32 killed renamable $r0
  ; CHECK-NEXT:   renamable $p0 = MOV_PD_imm11_pseudo 0
  ; CHECK-NEXT:   renamable $wl4 = COPY renamable $wl2
  ; CHECK-NEXT:   renamable $r0 = MOV_RLC_imm11_pseudo 1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $x2:0x0000000000000003, $x4:0x0000000000000002
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $x2:0x0000000000000003, $x4:0x0000000000000002
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $x2:0x0000000000000003, $x4:0x0000000000000002
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $wh4 = VLD_w_idx_imm_pseudo renamable $p0, 0
  ; CHECK-NEXT:   renamable $x0 = VSHIFT renamable $x4, renamable $x2, renamable $r0
  ; CHECK-NEXT:   VST_dmw_sts_w_st_idx_imm killed renamable $wl0, renamable $p0, 0
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.3
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1

    %0:mlockid_reg = MOV_RLC_imm11_pseudo 0
    %2:vec512 = VBCST_32 %0
    %1:ep = MOV_PD_imm11_pseudo 0
    undef %3.sub_256_lo:vec512 = COPY %2.sub_256_lo
    %4:mlockid_reg = MOV_RLC_imm11_pseudo 1

  bb.1:
    successors: %bb.1, %bb.2

    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.1
    PseudoJ_jump_imm %bb.2

  bb.2:
    successors: %bb.3

  bb.3:
    successors: %bb.3, %bb.4

    %3.sub_256_hi:vec512 = VLD_w_idx_imm_pseudo %1, 0
    %5:vec512 = VSHIFT %3, %2, %4
    VST_dmw_sts_w_st_idx_imm %5.sub_256_lo, %1, 0
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.3
    PseudoJ_jump_imm %bb.4

  bb.4:
    PseudoRET implicit $lr
...
