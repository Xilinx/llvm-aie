# Per-loop WAW option overrides via llvm.loop metadata.
# The loop has metadata enabling aie-gpr-realloc and aie-realloc-loopaware.
# With aie-gpr-realloc the GPR candidates (%31, %7) get reallocated.
# With aie-realloc-loopaware the LRU queue is primed so allocations wrap
# around the loop boundary (odd x registers instead of even).
# Extracted from MaxPool2dVariant_aie2_int8_3 for.body67.

# The DISABLED run verifies that --aie-ignore-loop-hints
# suppresses all per-loop overrides, producing the default allocation.

# The third run verifies that explicit command-line flags take precedence
# over per-loop metadata overrides, producing the same default allocation.

# RUN: llc -mtriple=aie2ps -verify-machineinstrs --aie-reg-rewrite-mode=basic \
# RUN:   --start-before=greedy --stop-after=virtregrewriter \
# RUN:   %s -o - | FileCheck %s --check-prefix=ENABLED

# RUN: llc -mtriple=aie2ps -verify-machineinstrs --aie-reg-rewrite-mode=basic \
# RUN:   --aie-ignore-loop-hints=true \
# RUN:   --start-before=greedy --stop-after=virtregrewriter \
# RUN:   %s -o - | FileCheck %s --check-prefix=DISABLED

# RUN: llc -mtriple=aie2ps -verify-machineinstrs --aie-reg-rewrite-mode=basic \
# RUN:   --aie-gpr-realloc=false --aie-realloc-loopaware=false \
# RUN:   --start-before=greedy --stop-after=virtregrewriter \
# RUN:   %s -o - | FileCheck %s --check-prefix=DISABLED

--- |
  target triple = "aie2ps"

  define void @maxpool_inner_loop(ptr addrspace(5) %in, ptr addrspace(6) %ofm_ld, ptr addrspace(6) %ofm_wr) {
  entry:
  br label %loop_body

  loop_body:
  %0 = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %0, label %loop_body, label %exit, !llvm.loop !0

  exit:
  ret void
  }

  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1, !2, !3}
  !1 = !{!"llvm.loop.mustprogress"}
  !2 = !{!"llvm.loop.hint.aie-gpr-realloc", i64 1}
  !3 = !{!"llvm.loop.hint.aie-realloc-loopaware", i64 1}
...
