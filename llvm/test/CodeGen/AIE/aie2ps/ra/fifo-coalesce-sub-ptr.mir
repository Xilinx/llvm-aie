# RUN: llc -mtriple=aie2ps -verify-machineinstrs --start-before=register-coalescer --stop-after=register-coalescer %s -o - | FileCheck %s

# Verify that the register coalescer does NOT coalesce a small sub-register
# (sub_ptr or sub_avail) of the ePSRFLdF composite FIFO load-state register
# into its source.  Allowing such coalescing would extend the ePSRFLdF
# register's live range back to the definition of the source, causing the
# register allocator to spill the 1024-bit sub_fifo unnecessarily.
# The sub_fifo sub-register is always allowed to coalesce.

---
name:  fifo_no_coalesce_sub_ptr
alignment: 16
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0.entry:
    ; CHECK-LABEL: name: fifo_no_coalesce_sub_ptr
    ; CHECK: %ptr:eps = IMPLICIT_DEF
    ; CHECK-NEXT: %avail:mrf2a = IMPLICIT_DEF
    ; CHECK-NEXT: undef %state.sub_ptr:epsrfldf = COPY %ptr
    ; CHECK-NEXT: %state.sub_avail:epsrfldf = COPY %avail
    ; CHECK-NEXT: %state.sub_ptr:epsrfldf, %state.sub_fifo:epsrfldf, %state.sub_avail:epsrfldf = VLD_FILL_512_pseudo %state.sub_ptr, undef %state.sub_fifo, %state.sub_avail :: (load unknown-size, align 1, addrspace 5)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit %state
    %ptr:eps = IMPLICIT_DEF
    %fifo:eldfiforeg = IMPLICIT_DEF
    %avail:mrf2a = IMPLICIT_DEF
    undef %state.sub_ptr:epsrfldf = COPY %ptr:eps
    %state.sub_fifo:epsrfldf = COPY %fifo:eldfiforeg
    %state.sub_avail:epsrfldf = COPY %avail:mrf2a
    %state.sub_ptr:epsrfldf, %state.sub_fifo:epsrfldf, %state.sub_avail:epsrfldf = VLD_FILL_512_pseudo %state.sub_ptr:epsrfldf, %state.sub_fifo:epsrfldf, %state.sub_avail:epsrfldf :: (load unknown-size, align 1, addrspace 5)
    PseudoRET implicit $lr, implicit %state
...


