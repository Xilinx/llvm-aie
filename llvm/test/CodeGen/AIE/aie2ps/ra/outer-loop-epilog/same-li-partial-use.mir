# Outer-loop pipeliner epilog shape -- same-LI WAR where the read is
# on a sub-register of the livein accumulator and the same-vreg redef
# writes the full register. Exercises the matcher's sub-register
# overlap handling on the same-LI branch.

# RUN: llc -mtriple=aie2ps -verify-machineinstrs --aie-reg-rewrite-mode=basic \
# RUN:   --start-before=greedy --stop-after=virtregrewriter \
# RUN:   %s -o - | FileCheck %s

--- |
  target triple = "aie2ps"

  define void @same_li_partial_use(ptr addrspace(5) %p_in, ptr %p_chain, ptr addrspace(6) %p_out) {
  entry:
    br label %inner.loop

  inner.loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %inner.loop, label %outer.epilog

  outer.epilog:
    br label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1, !2}
  !1 = !{!"llvm.loop.hint.aie_outerloop_pipeliner_success", i64 1}
  !2 = !{!"llvm.loop.hint.aie-outer-loop-epilog", i64 1}
...
---
name:            same_li_partial_use
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
