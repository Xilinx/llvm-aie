  ; CHECK-NEXT:   renamable $dm1 = IMPLICIT_DEF
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.inner.loop:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $dm1:0x000000030000000C, $p1, $r0, $r8, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r0 = nsw ADD_add_r_ri killed renamable $r0, -1, implicit-def dead $srcarry
  ; CHECK-NEXT:   PseudoJNZ renamable $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.outer.epilog:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $dm1:0x000000030000000C, $p1, $r8, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   VST_SRS_2x_dm_sts_srs_cm_idx_imm_srsSign0 renamable $cml1, undef renamable $s0, killed renamable $p1, 64, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   dead renamable $dm2 = VMAC_vmac_vmul_cm_core_X_X renamable $dm1, renamable $x0, renamable $x0, renamable $r8
  ; CHECK-NEXT:   renamable $dm1 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm1, killed renamable $x0, renamable $x0, killed renamable $r8
  ; CHECK-NEXT:   dead renamable $dm0 = COPY killed renamable $dm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.exit:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry:
    successors: %bb.1
    liveins: $p1, $p2, $r0, $r8, $x0

    %1:ep_as_32bit = COPY $p1
    %2:ep_as_32bit = COPY $p2
    %3:mlockid_reg = COPY $r0
    %4:vec512 = COPY $x0
    %5:mrv8 = COPY $r8
    %6:acc2048 = IMPLICIT_DEF

  bb.1.inner.loop:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)

    %3:mlockid_reg = nsw ADD_add_r_ri %3, -1, implicit-def dead $srcarry
    PseudoJNZ %3, %bb.1
    PseudoJ_jump_imm %bb.2

  bb.2.outer.epilog:
    successors: %bb.3

    $srssign0 = MOVX_mvx_cr_imm 0
    VST_SRS_2x_dm_sts_srs_cm_idx_imm_srsSign0 %6.sub_1024_acc_lo, undef %20:es, %1, 64, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0

    %6:acc2048 = VMAC_vmac_vmul_cm_core_X_X %6, %4, %4, %5
    %6:acc2048 = VMAC_vmac_vmul_cm_core_X_X %6, %4, %4, %5

