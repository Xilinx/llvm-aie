# Cost gate, full-coverage collapse: a same-LI acc2048 vreg whose four
# touched sub-reg VLDA defs together cover the whole register. Because
# the touched lanes cover the full register class, the glue-COPY plan
# collapses to a single full-class COPY (cost 1, not 4 per-lane COPYs),
# which fits the slack budget, so the rename is admitted. Verifies the
# CoversFull path of the cost gate: full-lane coverage costs one COPY.

# RUN: llc -mtriple=aie2ps -verify-machineinstrs --aie-reg-rewrite-mode=basic \
# RUN:   --start-before=greedy --stop-after=virtregrewriter \
# RUN:   %s -o - | FileCheck %s

--- |
  target triple = "aie2ps"

  define void @cost_gate_partial(ptr addrspace(5) %p_in, ptr %p_chain, ptr addrspace(6) %p_out) {
  entry:
    br label %inner.loop

  inner.loop:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %inner.loop, label %outer.epilog

  outer.epilog:
    br label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1, !2}
  !1 = !{!"llvm.loop.hint.aie_outerloop_pipeliner_success", i64 1}
  !2 = !{!"llvm.loop.hint.aie_outerloop_epilog", i64 1}
...
---
name:            cost_gate_partial
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: cost_gate_partial
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p1, $p2, $r0, $r8, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $dm1 = IMPLICIT_DEF
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.inner.loop:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $dm1, $p1, $p2, $r0, $r8, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r0 = nsw ADD_add_r_ri killed renamable $r0, -1, implicit-def dead $srcarry
  ; CHECK-NEXT:   PseudoJNZ renamable $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.outer.epilog:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $dm1, $p1, $p2, $r8, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   dead renamable $p1 = VST_SRS_4x_dmx_sts_srs_dm_pstm_nrm_imm_srsSign0 renamable $dm1, undef renamable $s0, killed renamable $p1, 64, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   renamable $bmll2, renamable $p2 = VLDA_dmx_lda_bm_ld_pstm_nrm_imm killed renamable $p2, 64
  ; CHECK-NEXT:   renamable $bmlh2, renamable $p2 = VLDA_dmx_lda_bm_ld_pstm_nrm_imm killed renamable $p2, 64
  ; CHECK-NEXT:   renamable $bmhl2, renamable $p2 = VLDA_dmx_lda_bm_ld_pstm_nrm_imm killed renamable $p2, 64
  ; CHECK-NEXT:   dead renamable $bmhh2, dead renamable $p2 = VLDA_dmx_lda_bm_ld_pstm_nrm_imm killed renamable $p2, 64
  ; CHECK-NEXT:   dead renamable $dm2 = VMAC_vmac_vmul_cm_core_X_X renamable $dm1, renamable $x0, renamable $x0, renamable $r8
  ; CHECK-NEXT:   renamable $dm1 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm1, killed renamable $x0, renamable $x0, killed renamable $r8
  ; CHECK-NEXT:   dead renamable $dm0 = COPY killed renamable $dm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.exit:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry:
    successors: %bb.1
    liveins: $p1, $p2, $r0, $r8, $x0

    %1:ep_as_32bit = COPY $p1
    %2:ep_as_32bit = COPY $p2
    %3:mlockid_reg = COPY $r0
    %4:vec512 = COPY $x0
    %5:mrv8 = COPY $r8
    %6:acc2048 = IMPLICIT_DEF

  bb.1.inner.loop:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)

    %3:mlockid_reg = nsw ADD_add_r_ri %3, -1, implicit-def dead $srcarry
    PseudoJNZ %3, %bb.1
    PseudoJ_jump_imm %bb.2

  bb.2.outer.epilog:
    successors: %bb.3

    $srssign0 = MOVX_mvx_cr_imm 0
    %1:ep_as_32bit = VST_SRS_4x_dmx_sts_srs_dm_pstm_nrm_imm_srsSign0 %6, undef %20:es, %1, 64, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0

    %6.sub_512_acc_lo:acc2048, %2:ep_as_32bit = VLDA_dmx_lda_bm_ld_pstm_nrm_imm %2, 64
    %6.sub_512_acc_hi:acc2048, %2:ep_as_32bit = VLDA_dmx_lda_bm_ld_pstm_nrm_imm %2, 64
    %6.sub_1024_acc_hi_then_sub_512_acc_lo:acc2048, %2:ep_as_32bit = VLDA_dmx_lda_bm_ld_pstm_nrm_imm %2, 64
    %6.sub_1024_acc_hi_then_sub_512_acc_hi:acc2048, %2:ep_as_32bit = VLDA_dmx_lda_bm_ld_pstm_nrm_imm %2, 64

    %6:acc2048 = VMAC_vmac_vmul_cm_core_X_X %6, %4, %4, %5
    %6:acc2048 = VMAC_vmac_vmul_cm_core_X_X %6, %4, %4, %5

  bb.3.exit:
    PseudoRET implicit $lr
