  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:ep = COPY killed [[COPY1]]
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.hot:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOVXM_lng_cg:%[0-9]+]]:em_as_32bit = MOVXM_lng_cg 1024
  ; CHECK-NEXT:   [[VLD_x_pstm_nrm_pseudo:%[0-9]+]]:vec512, [[VLD_x_pstm_nrm_pseudo1:%[0-9]+]]:ep = VLD_x_pstm_nrm_pseudo killed [[COPY1]], killed [[MOVXM_lng_cg]] :: (load (<16 x s32>) from %ir.p, addrspace 6)
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:ep = COPY killed [[VLD_x_pstm_nrm_pseudo1]]
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vec512 = COPY killed [[VLD_x_pstm_nrm_pseudo]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.join:
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vec512 = COPY killed [[DEF]]
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:ep = COPY killed [[COPY2]]
  ; CHECK-NEXT:   [[VLD_x_idx_imm_pseudo:%[0-9]+]]:vec512 = VLD_x_idx_imm_pseudo killed [[COPY4]], 0 :: (load (<16 x s32>) from %ir.ptr, addrspace 6)
  ; CHECK-NEXT:   [[VADD_32_:%[0-9]+]]:vec512 = VADD_32 killed [[COPY3]], killed [[VLD_x_idx_imm_pseudo]], implicit $crbf8conf, implicit $crfp8conf
