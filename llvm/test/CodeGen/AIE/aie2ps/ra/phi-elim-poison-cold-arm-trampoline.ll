entry:
  br i1 %cond, label %hot, label %join

hot:
  %loaded = load <16 x i32>, ptr addrspace(6) %p
  %p_hot = getelementptr i8, ptr addrspace(6) %p, i32 1024
  br label %join

join:
  %ptr = phi ptr addrspace(6) [ %p, %entry ], [ %p_hot, %hot ]
  %acc = phi <16 x i32> [ poison, %entry ], [ %loaded, %hot ]
  %tail = load <16 x i32>, ptr addrspace(6) %ptr
  %res = add <16 x i32> %acc, %tail
  ret <16 x i32> %res
}

