  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1
    %0:vec512 = IMPLICIT_DEF
    %1:vec512 = IMPLICIT_DEF
    %2:mrv8 = IMPLICIT_DEF
    %3:acc2048 = IMPLICIT_DEF
    %4:acc2048 = IMPLICIT_DEF
    %5:acc2048 = IMPLICIT_DEF
    %6:er = IMPLICIT_DEF
    %7:er = IMPLICIT_DEF
    %8:er = IMPLICIT_DEF
    %9:er = IMPLICIT_DEF
    PseudoJ_jump_imm %bb.1

  ; First OLP prologue.
  bb.1:
    successors: %bb.2
    PseudoJ_jump_imm %bb.2

  ; First OLP steady state.
  bb.2:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    PseudoJNZ %6, %bb.2
    PseudoJ_jump_imm %bb.3

  ; First OLP epilogue.
  bb.3:
    successors: %bb.1(0x7c000000), %bb.4(0x04000000)
    dead %10:acc2048 = VMAC_vmac_vmul_cm_core_X_X %3, %0, %1, %2
    %3:acc2048 = VMAC_vmac_vmul_cm_core_X_X %4, %0, %1, %2
    PseudoJNZ %8, %bb.1
    PseudoJ_jump_imm %bb.4

  ; Second OLP prologue.
  bb.4:
    successors: %bb.5
    PseudoJ_jump_imm %bb.5

  ; Second OLP steady state.
  bb.5:
    successors: %bb.5(0x7c000000), %bb.6(0x04000000)
    PseudoJNZ %7, %bb.5
    PseudoJ_jump_imm %bb.6

  ; Second OLP epilogue.
  bb.6:
    successors: %bb.4(0x7c000000), %bb.7(0x04000000)
    dead %11:acc2048 = VMAC_vmac_vmul_cm_core_X_X %5, %0, %1, %2
    %5:acc2048 = VMAC_vmac_vmul_cm_core_X_X %4, %0, %1, %2
    PseudoJNZ %9, %bb.4
    PseudoJ_jump_imm %bb.7

  bb.7:
    dead %12:acc2048 = VMAC_vmac_vmul_cm_core_X_X %3, %0, %1, %2
    dead %13:acc2048 = VMAC_vmac_vmul_cm_core_X_X %5, %0, %1, %2
    dead %14:acc2048 = VMAC_vmac_vmul_cm_core_X_X %4, %0, %1, %2
    PseudoRET implicit $lr
