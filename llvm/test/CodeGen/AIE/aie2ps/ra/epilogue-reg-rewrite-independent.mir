# Independent OLP epilogues may reuse a replacement physical register when
# their candidate live ranges do not overlap.
# RUN: llc -mtriple=aie2ps --aie-olp-war-rename \
# RUN:   --aie-enable-epilogue-reg-rewrite --start-before=greedy \
# RUN:   --stop-after=virtregrewriter %s -o - | FileCheck %s

---
name:            independent_olp_epilogues
alignment:       16
legalized:       true
isSSA:           false
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: independent_olp_epilogues
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x0 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $x2 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $r8 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $dm1 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $dm0 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $dm2 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $r5 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $r1 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $r7 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $r3 = IMPLICIT_DEF
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $r1, $r3, $r5, $r7, $r8, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $r1, $r3, $r5, $r7, $r8, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ renamable $r5, %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.4(0x04000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $r1, $r3, $r5, $r7, $r8, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead renamable $dm1 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm1, renamable $x0, renamable $x2, renamable $r8
  ; CHECK-NEXT:   renamable $dm3 = VMAC_vmac_vmul_cm_core_X_X renamable $dm0, renamable $x0, renamable $x2, renamable $r8
  ; CHECK-NEXT:   renamable $dm1 = COPY killed renamable $dm3
  ; CHECK-NEXT:   PseudoJNZ renamable $r7, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $r1, $r3, $r8, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.5(0x7c000000), %bb.6(0x04000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $r1, $r3, $r8, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ renamable $r1, %bb.5
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.4(0x7c000000), %bb.7(0x04000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $r1, $r3, $r8, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead renamable $dm2 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm2, renamable $x0, renamable $x2, renamable $r8
  ; CHECK-NEXT:   renamable $dm3 = VMAC_vmac_vmul_cm_core_X_X renamable $dm0, renamable $x0, renamable $x2, renamable $r8
  ; CHECK-NEXT:   renamable $dm2 = COPY killed renamable $dm3
  ; CHECK-NEXT:   PseudoJNZ renamable $r3, %bb.4
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.7:
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $r8, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead renamable $dm1 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm1, renamable $x0, renamable $x2, renamable $r8
  ; CHECK-NEXT:   dead renamable $dm1 = VMAC_vmac_vmul_cm_core_X_X killed renamable $dm2, renamable $x0, renamable $x2, renamable $r8
