    $bmhh0, dead $p0, dead $dc1 = VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_split $s0, killed $p0, $m1, $dn1, $dj1, $dc1, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0

