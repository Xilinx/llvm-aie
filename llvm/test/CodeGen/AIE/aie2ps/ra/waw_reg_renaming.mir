# Make sure the four bfp13 few conversions get four different FEW registers.
# Exercises the bfp13 few vector class (mFEWa/384) and the eDM accumulators.
# Without renaming the four VCONVs collapse to one FEW register, serializing
# them through a WAW chain.
---
name:            bfp13_few
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: bfp13_few
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sf, $dm0, $dm1, $dm2, $dm3, $p2, $r0, $r26
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   LoopStart $r0, 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sf, $dm0, $dm1, $dm2, $dm3, $p2, $r26
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $fewl0 = VCONV_mx6_fp32 renamable $dm0, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
  ; CHECK-NEXT:   renamable $sf, renamable $p2, renamable $r26 = VST_PUSH_384 killed renamable $sf, killed renamable $fewl0, killed renamable $p2, killed renamable $r26, implicit-def dead $srfifo_of
  ; CHECK-NEXT:   renamable $fewl2 = VCONV_mx6_fp32 renamable $dm1, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
  ; CHECK-NEXT:   renamable $sf, renamable $p2, renamable $r26 = VST_PUSH_384 killed renamable $sf, killed renamable $fewl2, killed renamable $p2, killed renamable $r26, implicit-def dead $srfifo_of
  ; CHECK-NEXT:   renamable $fewl4 = VCONV_mx6_fp32 renamable $dm2, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
  ; CHECK-NEXT:   renamable $sf, renamable $p2, renamable $r26 = VST_PUSH_384 killed renamable $sf, killed renamable $fewl4, killed renamable $p2, killed renamable $r26, implicit-def dead $srfifo_of
  ; CHECK-NEXT:   renamable $fewl6 = VCONV_mx6_fp32 renamable $dm3, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
  ; CHECK-NEXT:   renamable $sf, renamable $p2, renamable $r26 = VST_PUSH_384 killed renamable $sf, killed renamable $fewl6, killed renamable $p2, killed renamable $r26, implicit-def dead $srfifo_of
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry:
  successors: %bb.1
  liveins: $r0, $dm0, $dm1, $dm2, $dm3, $sf, $p2, $r26
    %6:edm = COPY $dm0
    %7:edm = COPY $dm1
    %8:edm = COPY $dm2
    %9:edm = COPY $dm3
    %20:mstfifo = COPY $sf
    %21:mpfs = COPY $p2
    %22:mr26_fifo_st = COPY $r26
    LoopStart $r0, 0
  bb.1:
    successors: %bb.1, %bb.2
    %50:mfewa = VCONV_mx6_fp32 %6, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
    %20:mstfifo, %21:mpfs, %22:mr26_fifo_st = VST_PUSH_384 %20, %50, %21, %22, implicit-def dead $srfifo_of
    %51:mfewa = VCONV_mx6_fp32 %7, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
    %20:mstfifo, %21:mpfs, %22:mr26_fifo_st = VST_PUSH_384 %20, %51, %21, %22, implicit-def dead $srfifo_of
    %52:mfewa = VCONV_mx6_fp32 %8, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
    %20:mstfifo, %21:mpfs, %22:mr26_fifo_st = VST_PUSH_384 %20, %52, %21, %22, implicit-def dead $srfifo_of
    %53:mfewa = VCONV_mx6_fp32 %9, implicit-def dead $srf2bflags, implicit $crf2bmask, implicit $crrnd
    %20:mstfifo, %21:mpfs, %22:mr26_fifo_st = VST_PUSH_384 %20, %53, %21, %22, implicit-def dead $srfifo_of
    PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  bb.2:
    PseudoRET implicit $lr
...

# Make sure the four fey spill reloads get four different FEY registers.
# Covers the mFEYw (bfp13 1536-bit) rung.
---
name:            fey
alignment:       16
legalized:       true
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 192, alignment: 32 }
  - { id: 1, type: spill-slot, size: 192, alignment: 32 }
  - { id: 2, type: spill-slot, size: 192, alignment: 32 }
  - { id: 3, type: spill-slot, size: 192, alignment: 32 }
body:             |
  ; CHECK-LABEL: name: fey
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   LoopStart $r0, 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $fey3 = VLDA_FEY_SPILL %stack.0, implicit $sp
  ; CHECK-NEXT:   VST_FEY_SPILL killed renamable $fey3, %stack.0, implicit $sp
  ; CHECK-NEXT:   renamable $fey2 = VLDA_FEY_SPILL %stack.1, implicit $sp
  ; CHECK-NEXT:   VST_FEY_SPILL killed renamable $fey2, %stack.1, implicit $sp
  ; CHECK-NEXT:   renamable $fey1 = VLDA_FEY_SPILL %stack.2, implicit $sp
  ; CHECK-NEXT:   VST_FEY_SPILL killed renamable $fey1, %stack.2, implicit $sp
  ; CHECK-NEXT:   renamable $fey0 = VLDA_FEY_SPILL %stack.3, implicit $sp
  ; CHECK-NEXT:   VST_FEY_SPILL killed renamable $fey0, %stack.3, implicit $sp
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry:
  successors: %bb.1
  liveins: $r0
    LoopStart $r0, 0
  bb.1:
    successors: %bb.1, %bb.2
    %50:mfeyw = VLDA_FEY_SPILL %stack.0, implicit $sp
    VST_FEY_SPILL %50, %stack.0, implicit $sp
    %51:mfeyw = VLDA_FEY_SPILL %stack.1, implicit $sp
    VST_FEY_SPILL %51, %stack.1, implicit $sp
    %52:mfeyw = VLDA_FEY_SPILL %stack.2, implicit $sp
    VST_FEY_SPILL %52, %stack.2, implicit $sp
    %53:mfeyw = VLDA_FEY_SPILL %stack.3, implicit $sp
    VST_FEY_SPILL %53, %stack.3, implicit $sp
    PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  bb.2:
    PseudoRET implicit $lr
...
