# Basic test for the WAW register renaming pass. Check AIE2 tests for more coverage.

# RUN: llc -mtriple=aie2ps -verify-machineinstrs --start-before=greedy --stop-after=virtregrewriter %s -o - | FileCheck %s

# Make sure VLD and VMAX define different X registers.
---
name:            simple_waw_replacement
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: simple_waw_replacement
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r0, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ST_R_SPILL $p0, %stack.0, implicit $sp :: (store (s32) into %stack.0)
  ; CHECK-NEXT:   VST_X_SPILL $x0, %stack.1, implicit $sp :: (store (s512) into %stack.1)
  ; CHECK-NEXT:   ST_R_SPILL $p1, %stack.2, implicit $sp :: (store (s32) into %stack.2)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $d0, $d2, $p0, $p1, $p2, $d1_3d
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $p0 = LDA_R_SPILL %stack.0, implicit $sp :: (load (s32) from %stack.0)
  ; CHECK-NEXT:   renamable $x0, renamable $p0 = VLDA_dmx_lda_x_ld_pstm_nrm_imm killed renamable $p0, 64
  ; CHECK-NEXT:   ST_R_SPILL killed renamable $p0, %stack.0, implicit $sp :: (store (s32) into %stack.0)
  ; CHECK-NEXT:   renamable $x2 = VLDA_X_SPILL %stack.1, implicit $sp :: (load (s512) from %stack.1)
  ; CHECK-NEXT:   renamable $x0, $r16 = VMAX_LT_16_vaddSign1 killed renamable $x0, killed renamable $x2, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1
  ; CHECK-NEXT:   renamable $p0 = LDA_R_SPILL %stack.2, implicit $sp :: (load (s32) from %stack.2)
  ; CHECK-NEXT:   renamable $p0 = VST_dmx_sts_x_st_pstm_nrm_imm killed renamable $x0, killed renamable $p0, 64
  ; CHECK-NEXT:   ST_R_SPILL killed renamable $p0, %stack.2, implicit $sp :: (store (s32) into %stack.2)
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry:
  successors: %bb.1
  liveins: $r0, $p0, $p1, $x0
    %0:ep = COPY $p0
    %1:vec512 = COPY $x0
    %2:ep = COPY $p1
  bb.1:
    successors: %bb.1
    liveins: $p0, $p1, $p2, $d0, $d1_3d, $d2
    %10:vec512, %0:ep = VLDA_dmx_lda_x_ld_pstm_nrm_imm %0, 64
    %11:vec512, $r16 = VMAX_LT_16_vaddSign1 %10, %1, implicit $crbf8conf, implicit $crfp8conf, implicit $vaddsign1
    %2:ep = VST_dmx_sts_x_st_pstm_nrm_imm %11, %2, 64
    PseudoRET implicit $lr
...

# Make sure the four bfp16 VSHUFFLEs get four different EX registers.
# This is modeled on the innermost loop of GEMM mx9 and exercises the bfp16
# vector (mexa/640, mewm/320 via the sub_bfp320 halves) and accumulator
# (acc2048) register classes.
---
name:            bfp16
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: bfp16
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm2, $ex0, $ex2, $ex4, $ex6, $ey0, $ey1, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ex8 = COPY $ex0
  ; CHECK-NEXT:   renamable $ex10 = COPY $ex2
  ; CHECK-NEXT:   renamable $r2 = MOV_RLC_imm11_pseudo 106
  ; CHECK-NEXT:   renamable $r8 = MOV_RLC_imm11_pseudo 972
  ; CHECK-NEXT:   renamable $dm3 = COPY $dm0
  ; CHECK-NEXT:   renamable $dm1 = COPY $dm0
  ; CHECK-NEXT:   renamable $dm0 = COPY $dm2
  ; CHECK-NEXT:   LoopStart $r0, 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $dm3, $ex4, $ex6, $ex8, $ex10, $ey0, $ey1, $r2, $r8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ex5 = VSHUFFLE_vec_shuffle_egx renamable $ex8, undef renamable $ex0, renamable $r2
  ; CHECK-NEXT:   $dm3 = VMAC_f_vmac_bfp16 killed $dm3, killed $ewl5, $ey0, $ey1, $ewh5, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   renamable $ex7 = VSHUFFLE_vec_shuffle_egx renamable $ex10, undef renamable $ex0, renamable $r2
  ; CHECK-NEXT:   $dm2 = VMAC_f_vmac_bfp16 killed $dm2, killed $ewl7, $ey0, $ey1, $ewh7, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   renamable $ex9 = VSHUFFLE_vec_shuffle_egx renamable $ex4, undef renamable $ex0, renamable $r2
  ; CHECK-NEXT:   $dm1 = VMAC_f_vmac_bfp16 killed $dm1, killed $ewl9, $ey0, $ey1, $ewh9, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   renamable $ex11 = VSHUFFLE_vec_shuffle_egx renamable $ex6, undef renamable $ex0, renamable $r2
  ; CHECK-NEXT:   $dm0 = VMAC_f_vmac_bfp16 killed $dm0, killed $ewl11, $ey0, $ey1, $ewh11, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $dm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit killed renamable $dm3, implicit killed renamable $dm2, implicit killed renamable $dm1, implicit killed renamable $dm0
  bb.0.entry:
  successors: %bb.1
  liveins: $r0, $ex0, $ex2, $ex4, $ex6, $ey0, $ey1, $dm0, $dm2
    %20:mexa = COPY $ex0
    %21:mexa = COPY $ex2
    %22:mexa = COPY $ex4
    %23:mexa = COPY $ex6
    %30:eeys = COPY $ey0
    %31:eeys = COPY $ey1
    %40:mlockid_reg = MOV_RLC_imm11_pseudo 106
    %41:mrv8 = MOV_RLC_imm11_pseudo 972
    %6:acc2048 = COPY $dm0
    %7:acc2048 = COPY $dm2
    %8:acc2048 = COPY $dm0
    %9:acc2048 = COPY $dm2
    LoopStart $r0, 0
  bb.1:
    successors: %bb.1, %bb.2
    %50:mexa = VSHUFFLE_vec_shuffle_egx %20, undef %60:mexa, %40
    %6:acc2048 = VMAC_f_vmac_bfp16 %6, %50.sub_bfp320_lo, %30, %31, %50.sub_bfp320_hi, %41, implicit-def dead $srfpflags, implicit $crfpmask
    %51:mexa = VSHUFFLE_vec_shuffle_egx %21, undef %60:mexa, %40
    %7:acc2048 = VMAC_f_vmac_bfp16 %7, %51.sub_bfp320_lo, %30, %31, %51.sub_bfp320_hi, %41, implicit-def dead $srfpflags, implicit $crfpmask
    %52:mexa = VSHUFFLE_vec_shuffle_egx %22, undef %60:mexa, %40
    %8:acc2048 = VMAC_f_vmac_bfp16 %8, %52.sub_bfp320_lo, %30, %31, %52.sub_bfp320_hi, %41, implicit-def dead $srfpflags, implicit $crfpmask
    %53:mexa = VSHUFFLE_vec_shuffle_egx %23, undef %60:mexa, %40
    %9:acc2048 = VMAC_f_vmac_bfp16 %9, %53.sub_bfp320_lo, %30, %31, %53.sub_bfp320_hi, %41, implicit-def dead $srfpflags, implicit $crfpmask
    PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  bb.2:
    PseudoRET implicit $lr, implicit %6, implicit %7, implicit %8, implicit %9
...

# Make sure the four bfp13 VSHUFFLEs get four different FEX registers.
# This is modeled on the biased_conv mx6 inner loop and exercises the bfp13
# vector (mFEXm/768) and accumulator (eDM/2048) register classes. The
# loop-carried WAR on the FIFO-popped fex reg is what the WAW rewriter breaks.
---
name:            bfp13
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: bfp13
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm2, $fex0, $fex2, $fex4, $fex6, $fey0, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $fey4 = COPY $fey0
  ; CHECK-NEXT:   renamable $r2 = MOV_RLC_imm11_pseudo 106
  ; CHECK-NEXT:   renamable $r8 = MOV_RLC_imm11_pseudo 972
  ; CHECK-NEXT:   renamable $dm3 = COPY $dm0
  ; CHECK-NEXT:   renamable $dm1 = COPY $dm0
  ; CHECK-NEXT:   renamable $dm0 = COPY $dm2
  ; CHECK-NEXT:   LoopStart $r0, 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $dm3, $fex0, $fex2, $fex4, $fex6, $fey4, $r2, $r8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $fex10 = VSHUFFLE_vec_shuffle_fex renamable $fex0, undef renamable $fex0, renamable $r2
  ; CHECK-NEXT:   $dm3 = VMAC_f_vmac_bfp13 killed $dm3, killed $fex10, $fey4, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   renamable $fex1 = VSHUFFLE_vec_shuffle_fex renamable $fex2, undef renamable $fex0, renamable $r2
  ; CHECK-NEXT:   $dm2 = VMAC_f_vmac_bfp13 killed $dm2, killed $fex1, $fey4, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   renamable $fex3 = VSHUFFLE_vec_shuffle_fex renamable $fex4, undef renamable $fex0, renamable $r2
  ; CHECK-NEXT:   $dm1 = VMAC_f_vmac_bfp13 killed $dm1, killed $fex3, $fey4, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   renamable $fex5 = VSHUFFLE_vec_shuffle_fex renamable $fex6, undef renamable $fex0, renamable $r2
  ; CHECK-NEXT:   $dm0 = VMAC_f_vmac_bfp13 killed $dm0, killed $fex5, $fey4, $r8, implicit-def dead $srfpflags, implicit $crfpmask
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $dm0, $dm1, $dm2, $dm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit killed renamable $dm3, implicit killed renamable $dm2, implicit killed renamable $dm1, implicit killed renamable $dm0
  bb.0.entry:
  successors: %bb.1
  liveins: $r0, $fex0, $fex2, $fex4, $fex6, $fey0, $dm0, $dm2
    %20:mfexm = COPY $fex0
    %21:mfexm = COPY $fex2
    %22:mfexm = COPY $fex4
    %23:mfexm = COPY $fex6
    %30:efey = COPY $fey0
    %40:mlockid_reg = MOV_RLC_imm11_pseudo 106
    %41:mrv8 = MOV_RLC_imm11_pseudo 972
    %6:edm = COPY $dm0
    %7:edm = COPY $dm2
    %8:edm = COPY $dm0
    %9:edm = COPY $dm2
    LoopStart $r0, 0
  bb.1:
    successors: %bb.1, %bb.2
    %50:mfexm = VSHUFFLE_vec_shuffle_fex %20, undef %60:mfexn, %40
    %6:edm = VMAC_f_vmac_bfp13 %6, %50, %30, %41, implicit-def dead $srfpflags, implicit $crfpmask
    %51:mfexm = VSHUFFLE_vec_shuffle_fex %21, undef %60:mfexn, %40
    %7:edm = VMAC_f_vmac_bfp13 %7, %51, %30, %41, implicit-def dead $srfpflags, implicit $crfpmask
    %52:mfexm = VSHUFFLE_vec_shuffle_fex %22, undef %60:mfexn, %40
    %8:edm = VMAC_f_vmac_bfp13 %8, %52, %30, %41, implicit-def dead $srfpflags, implicit $crfpmask
    %53:mfexm = VSHUFFLE_vec_shuffle_fex %23, undef %60:mfexn, %40
    %9:edm = VMAC_f_vmac_bfp13 %9, %53, %30, %41, implicit-def dead $srfpflags, implicit $crfpmask
    PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  bb.2:
    PseudoRET implicit $lr, implicit %6, implicit %7, implicit %8, implicit %9
...

# Make sure the four bfp13 feg loads get four different FEG registers.
# Exercises the bfp13 feg vector class (mFEGa/128). Without renaming the four
# loads collapse to one FEG register, serializing them through a WAW chain.
---
name:            bfp13_feg
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: bfp13_feg
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $dj0, $p0, $p1, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   LoopStart $r0, 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $dj0, $p0, $p1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $fegl0 = LDA_dmv_lda_feg_ld_idx renamable $p0, renamable $dj0
  ; CHECK-NEXT:   VST_128_dmv_sts_feg_st_idx killed renamable $fegl0, renamable $p1, renamable $dj0
  ; CHECK-NEXT:   renamable $fegl2 = LDA_dmv_lda_feg_ld_idx renamable $p0, renamable $dj0
  ; CHECK-NEXT:   VST_128_dmv_sts_feg_st_idx killed renamable $fegl2, renamable $p1, renamable $dj0
  ; CHECK-NEXT:   renamable $fegl4 = LDA_dmv_lda_feg_ld_idx renamable $p0, renamable $dj0
  ; CHECK-NEXT:   VST_128_dmv_sts_feg_st_idx killed renamable $fegl4, renamable $p1, renamable $dj0
  ; CHECK-NEXT:   renamable $fegl6 = LDA_dmv_lda_feg_ld_idx renamable $p0, renamable $dj0
  ; CHECK-NEXT:   VST_128_dmv_sts_feg_st_idx killed renamable $fegl6, renamable $p1, renamable $dj0
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry:
  successors: %bb.1
  liveins: $r0, $p0, $p1, $dj0
    %10:ep = COPY $p0
    %11:ep = COPY $p1
    %12:edj = COPY $dj0
    LoopStart $r0, 0
  bb.1:
    successors: %bb.1, %bb.2
    %50:mfega = LDA_dmv_lda_feg_ld_idx %10, %12
    VST_128_dmv_sts_feg_st_idx %50, %11, %12
    %51:mfega = LDA_dmv_lda_feg_ld_idx %10, %12
    VST_128_dmv_sts_feg_st_idx %51, %11, %12
    %52:mfega = LDA_dmv_lda_feg_ld_idx %10, %12
    VST_128_dmv_sts_feg_st_idx %52, %11, %12
    %53:mfega = LDA_dmv_lda_feg_ld_idx %10, %12
    VST_128_dmv_sts_feg_st_idx %53, %11, %12
    PseudoLoopEnd <mcsymbol .L_1120>, %bb.1
  bb.2:
    PseudoRET implicit $lr
...

