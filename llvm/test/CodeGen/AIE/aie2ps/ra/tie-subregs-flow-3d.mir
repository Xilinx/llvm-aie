    %301:ep, %302:edcl, %303:edch = PADDA_3D %101, %300
  bb.3:
    %10:edcl = PHI %202, %bb.1, %302, %bb.2
    %11:ep = PHI %201, %bb.1, %301, %bb.2
    %12:edch = PHI %203, %bb.1, %303, %bb.2
    PseudoRET implicit $lr, implicit %10, implicit %11, implicit %12
...
