# Standard loop where the pointer is incremented using PADDA_3D at each
# iteration. Each iteration uses the incremented counter from the previous one.
# After PHI elimination and reg alloc, we should see a simple `PADDA_3D p0 [d0_3d]`
# in the loop body.
---
name:            test_padd_loop
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: test_padd_loop
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $m0 = MOV_alu_mv_mv_mv_scl killed $r0
  ; CHECK-NEXT:   renamable $r0 = MOVA 0
  ; CHECK-NEXT:   renamable $r16 = GE renamable $r0, renamable $r8
  ; CHECK-NEXT:   JNZ killed renamable $r16, %bb.3
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $m0, $p0, $r0, $r1, $r2, $r3, $r5, $r6, $r7, $r8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $dn0 = MOV_alu_mv_mv_mv_scl killed $r1
  ; CHECK-NEXT:   $dj0 = MOV_alu_mv_mv_mv_scl killed $r2
  ; CHECK-NEXT:   $dc0 = MOV_alu_mv_mv_mv_scl killed $r3
  ; CHECK-NEXT:   $dn4 = MOV_alu_mv_mv_mv_scl killed $r5
  ; CHECK-NEXT:   $dj4 = MOV_alu_mv_mv_mv_scl killed $r6
  ; CHECK-NEXT:   $dc4 = MOV_alu_mv_mv_mv_scl killed $r7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $dc0, $dc4, $dj0, $dj4, $dn0, $dn4, $m0, $p0, $r0, $r8, $d0_3d:0x3800000040001C00
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx_imm renamable $r0, renamable $p0, 0 :: (store (s32))
  ; CHECK-NEXT:   renamable $r0 = nuw nsw ADD_add_r_ri killed renamable $r0, 1, implicit-def $srcarry
  ; CHECK-NEXT:   renamable $r2 = EQ renamable $r8, renamable $r0
  ; CHECK-NEXT:   JZ killed renamable $r2, %bb.2
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $p0, $dc0, dead $dc4 = PADDA_3D killed $p0, $d0_3d
  ; CHECK-NEXT:   $dc4 = MOV_alu_mv_mv_mv_scl $dc0
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0.entry:
    liveins: $p0, $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    %0:em =  COPY $r0
    %1:edn = COPY $r1
    %2:edj = COPY $r2
    %3:edc = COPY $r3
    %4:em =  COPY $r4
    %5:edn = COPY $r5
    %6:edj = COPY $r6
    %7:edc = COPY $r7
    %8:ep = COPY killed $p0
    %9:mry = COPY killed $r8
    %24:mry = MOVA 0
    %25:mry = GE %24, %9
    PseudoJNZ killed %25, %bb.2
  bb.1:
    PseudoJ_jump_imm %bb.3
  bb.2:
    PseudoRET implicit $lr
  bb.3:
    %60:mry = PHI %24, %bb.1, %13, %bb.3
    %70:ep = PHI %8, %bb.1, %10, %bb.3
    %100:edc = PHI %3, %bb.1, %102, %bb.3
    %200:edc = PHI %7, %bb.1, %102, %bb.3
    ST_dms_sts_scalar_st_idx_imm %60, %70, 0 :: (store (s32))
    %101:eds = REG_SEQUENCE %0, %subreg.sub_mod, %1, %subreg.sub_dim_size, %2, %subreg.sub_dim_stride, %100, %subreg.sub_dim_count, %4, %subreg.sub_hi_dim_then_sub_mod, %5, %subreg.sub_hi_dim_then_sub_dim_size, %6, %subreg.sub_hi_dim_then_sub_dim_stride, %200, %subreg.sub_hi_dim_then_sub_dim_count
    %10:ep, %102:edcl, %202:edch = PADDA_3D %70, %101
    %13:mry = nuw nsw ADD_add_r_ri killed %60, 1, implicit-def $srcarry
    %19:mry = EQ %9, %13
    PseudoJNZ killed %19, %bb.2
    PseudoJ_jump_imm %bb.3
...

# PADDA_3D conditionally followed by another PADDA_3D using the incremented
# counter. We'd like to see the two PADDA_3D use the same d0_3d register.
---
name:            test_padd_conditional
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: test_padd_conditional
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $m0 = MOV_alu_mv_mv_mv_scl killed $r0
  ; CHECK-NEXT:   $dn0 = MOV_alu_mv_mv_mv_scl killed $r1
  ; CHECK-NEXT:   $dj0 = MOV_alu_mv_mv_mv_scl killed $r2
  ; CHECK-NEXT:   $dc0 = MOV_alu_mv_mv_mv_scl killed $r3
  ; CHECK-NEXT:   JNZ renamable $r8, %bb.2
  ; CHECK-NEXT:   $dn4 = MOV_alu_mv_mv_mv_scl killed $r5
  ; CHECK-NEXT:   $dj4 = MOV_alu_mv_mv_mv_scl killed $r6
  ; CHECK-NEXT:   $dc4 = MOV_alu_mv_mv_mv_scl killed $r7
  ; CHECK-NEXT:   $p0, $dc0, $dc4 = PADDA_3D killed $p0, $d0_3d
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $dc0, $dc4, $dj0, $dj4, $dn0, $dn4, $m0, $p0, $d0_3d:0x3800000040001C00
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $p0, $dc0, dead $dc4 = PADDA_3D killed $p0, killed $d0_3d
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $dc0, $p0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier implicit killed renamable $dc0, implicit killed renamable $p0
  bb.0.entry:
    liveins: $p0, $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8

    %0:em =  COPY $r0
    %1:edn = COPY $r1
    %2:edj = COPY $r2
    %3:edc = COPY $r3
    %4:em =  COPY $r4
    %5:edn = COPY $r5
    %6:edj = COPY $r6
    %7:edc = COPY $r7
    %8:ep = COPY killed $p0
    %9:er = COPY killed $r8
    %100:eds = REG_SEQUENCE %0, %subreg.sub_mod, %1, %subreg.sub_dim_size, %2, %subreg.sub_dim_stride, %3, %subreg.sub_dim_count, %4, %subreg.sub_hi_dim_then_sub_mod, %5, %subreg.sub_hi_dim_then_sub_dim_size, %6, %subreg.sub_hi_dim_then_sub_dim_stride, %7, %subreg.sub_hi_dim_then_sub_dim_count
    %101:ep, %102:edcl, %103:edch = PADDA_3D %8, %100
    PseudoJNZ killed %9, %bb.2
  bb.1:
    %200:eds = REG_SEQUENCE %0, %subreg.sub_mod, %1, %subreg.sub_dim_size, %2, %subreg.sub_dim_stride, %102, %subreg.sub_dim_count, %4, %subreg.sub_hi_dim_then_sub_mod, %5, %subreg.sub_hi_dim_then_sub_dim_size, %6, %subreg.sub_hi_dim_then_sub_dim_stride, %103, %subreg.sub_hi_dim_then_sub_dim_count
    %201:ep, %202:edcl, %203:edch = PADDA_3D %101, %200
  bb.2:
    %10:edcl = PHI %202, %bb.1, %102, %bb.0
    %11:ep = PHI %201, %bb.1, %101, %bb.0
    PseudoRET implicit $lr, implicit %10, implicit %11
...

# Diamond pattern where one branch uses the incremented counter from the
# dominating PADDA_3D, and the other ones uses a value coming from r9.
# What we want to see is a conditional copy from r9 to dc0.
---
name:            test_padd_diamond
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: test_padd_diamond
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $m0 = MOV_alu_mv_mv_mv_scl killed $r0
  ; CHECK-NEXT:   $dn0 = MOV_alu_mv_mv_mv_scl killed $r1
  ; CHECK-NEXT:   $dj0 = MOV_alu_mv_mv_mv_scl killed $r2
  ; CHECK-NEXT:   $dc0 = MOV_alu_mv_mv_mv_scl killed $r3
  ; CHECK-NEXT:   JZ renamable $r8, %bb.1
  ; CHECK-NEXT:   $dn4 = MOV_alu_mv_mv_mv_scl killed $r5
  ; CHECK-NEXT:   $dj4 = MOV_alu_mv_mv_mv_scl killed $r6
  ; CHECK-NEXT:   $dc4 = MOV_alu_mv_mv_mv_scl killed $r7
  ; CHECK-NEXT:   $p0, $dc0, $dc4 = PADDA_3D killed $p0, $d0_3d
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors:
  ; CHECK-NEXT:   liveins: $dc4, $dj0, $dj4, $dn0, $dn4, $m0, $p0, $r9, $d0_3d:0x3800000040001800
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $dc0 = MOV_alu_mv_mv_mv_scl $r9
  ; CHECK-NEXT:   $p0, $dc0, $dc4 = PADDA_3D killed $p0, killed $d0_3d
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier implicit killed renamable $dc0, implicit killed renamable $p0, implicit killed renamable $dc4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $dc0, $dc4, $dj0, $dj4, $dn0, $dn4, $m0, $p0, $d0_3d:0x3800000040001C00
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $p0, $dc0, $dc4 = PADDA_3D killed $p0, killed $d0_3d
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier implicit killed renamable $dc0, implicit killed renamable $p0, implicit killed renamable $dc4
  bb.0.entry:
    liveins: $p0, $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9

    %0:em =  COPY $r0
    %1:edn = COPY $r1
    %2:edj = COPY $r2
    %3:edc = COPY $r3
    %4:em =  COPY $r4
    %5:edn = COPY $r5
    %6:edj = COPY $r6
    %7:edc = COPY $r7
    %8:ep = COPY killed $p0
    %9:er = COPY killed $r8
    %30:edc = COPY $r9
    %100:eds = REG_SEQUENCE %0, %subreg.sub_mod, %1, %subreg.sub_dim_size, %2, %subreg.sub_dim_stride, %3, %subreg.sub_dim_count, %4, %subreg.sub_hi_dim_then_sub_mod, %5, %subreg.sub_hi_dim_then_sub_dim_size, %6, %subreg.sub_hi_dim_then_sub_dim_stride, %7, %subreg.sub_hi_dim_then_sub_dim_count
    %101:ep, %102:edcl, %103:edch = PADDA_3D %8, %100
    PseudoJNZ killed %9, %bb.2
  bb.1:
    %200:eds = REG_SEQUENCE %0, %subreg.sub_mod, %1, %subreg.sub_dim_size, %2, %subreg.sub_dim_stride, %102, %subreg.sub_dim_count, %4, %subreg.sub_hi_dim_then_sub_mod, %5, %subreg.sub_hi_dim_then_sub_dim_size, %6, %subreg.sub_hi_dim_then_sub_dim_stride, %103, %subreg.sub_hi_dim_then_sub_dim_count
    %201:ep, %202:edcl, %203:edch = PADDA_3D %101, %200
    PseudoJ_jump_imm %bb.3
  bb.2:
