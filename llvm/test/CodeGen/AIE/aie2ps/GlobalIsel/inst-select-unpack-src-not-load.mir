# RUN: llc -mtriple aie2ps -run-pass=instruction-select %s -verify-machineinstrs -o - | FileCheck %s

# The source operand of a VUNPACK can be produced by an instruction that is not
# a memory load. Generic AIE intrinsic pseudos (here an SRS intrinsic) are
# conservatively marked mayLoad but carry no memory operand, so the load+unpack
# combine must not fire for them; instead a plain VUNPACK is selected. This used
# to crash instruction selection by querying the (non-existent) memory-operand
# size of the SRS instruction.
---
name:            unpack_src_is_srs_not_load
alignment:       16
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $cml0, $r0, $r1
    ; CHECK-LABEL: name: unpack_src_is_srs_not_load
    ; CHECK: liveins: $cml0, $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:acc1024 = COPY $cml0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:er = COPY $r1
    ; CHECK-NEXT: $crsrsmode = MOVX_mvx_cr_imm 0
    ; CHECK-NEXT: $srssign0 = COPY [[COPY2]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:es = COPY [[COPY1]]
    ; CHECK-NEXT: [[VSRS_4x_mv_w_srs_cm_srsSign0_:%[0-9]+]]:vec256 = VSRS_4x_mv_w_srs_cm_srsSign0 [[COPY]], [[COPY3]], implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    ; CHECK-NEXT: $srssign0 = MOVX_mvx_cr_imm 0
    ; CHECK-NEXT: $unpacksign0 = COPY [[COPY1]]
    ; CHECK-NEXT: $crunpacksize = MOVX_mvx_cr_imm 0
    ; CHECK-NEXT: [[VUNPACK_mv_unpack_w_unpackSign0_:%[0-9]+]]:vec512 = VUNPACK_mv_unpack_w_unpackSign0 [[VSRS_4x_mv_w_srs_cm_srsSign0_]], implicit $crunpacksize, implicit $unpacksign0
    ; CHECK-NEXT: $unpacksign0 = MOVX_mvx_cr_imm 0
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VUNPACK_mv_unpack_w_unpackSign0_]]
    %1:accregbank(<32 x s32>) = COPY $cml0
    %2:gprregbank(s32) = COPY $r0
    %3:gprregbank(s32) = COPY $r1
    %0:vregbank(<32 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I256.v32.acc32.srs), %1(<32 x s32>), %2(s32), %3(s32)
    %4:vregbank(<32 x s16>) = G_INTRINSIC intrinsic(@llvm.aie2ps.unpack.I512.I8.I4), %0(<32 x s8>), %2(s32)
    PseudoRET implicit $lr, implicit %4
...
