# RUN: llc -mtriple aie2ps -run-pass=legalizer %s -verify-machineinstrs -o - | FileCheck %s

---
name: test_fadd_vec_1024
body: |
  bb.0:
    liveins: $cml0, $cml1
    ; CHECK-LABEL: name: test_fadd_vec_1024
    ; CHECK: liveins: $cml0, $cml1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<32 x s32>) = COPY $cml0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<32 x s32>) = COPY $cml1
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:_(<32 x s32>) = G_FADD [[COPY]], [[COPY1]]
    ; CHECK-NEXT: $cml0 = COPY [[FADD]](<32 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $cml0
    %1:_(<32 x s32>) = COPY $cml0
    %3:_(<32 x s32>) = COPY $cml1
    %4:_(<32 x s32>) = G_FADD %1, %3
    $cml0 = COPY %4(<32 x s32>)
    PseudoRET implicit $lr, implicit $cml0
...

