    %100:_(p0) = COPY $p0
    %0:_(<4 x s32>) = G_LOAD %100(p0) :: (load (<4 x s32>), align 16)
    %1:_(<4 x s32>) = G_LOAD %100(p0) :: (load (<4 x s32>), align 16)
