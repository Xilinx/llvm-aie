# A chain of vshifts that concatenates two 128-bit vectors (aie_api's concat
# of two 128-bit vectors) becomes one VSHUFFLE.

# [a, b, u, u]: one shuffle.
---
name:            two_pieces
legalized:       false
body:             |
  bb.0:
    liveins: $p0
    ; CHECK-LABEL: name: two_pieces
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(<4 x s32>) = G_LOAD [[COPY]](p0) :: (load (<4 x s32>))
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:_(<4 x s32>) = G_LOAD [[COPY]](p0) :: (load (<4 x s32>))
    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF:%[0-9]+]]:_(<16 x s32>) = G_AIE_PAD_VECTOR_UNDEF [[LOAD]](<4 x s32>)
    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF1:%[0-9]+]]:_(<16 x s32>) = G_AIE_PAD_VECTOR_UNDEF [[LOAD1]](<4 x s32>)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 34
    ; CHECK-NEXT: [[AIE_SHUFFLE_VECTOR:%[0-9]+]]:_(<16 x s32>) = G_AIE_SHUFFLE_VECTOR [[AIE_PAD_VECTOR_UNDEF]], [[AIE_PAD_VECTOR_UNDEF1]], [[C]](s32)
    ; CHECK-NEXT: $x0 = COPY [[AIE_SHUFFLE_VECTOR]](<16 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %100:_(p0) = COPY $p0
    %0:_(<4 x s32>) = G_LOAD %100(p0) :: (load (<4 x s32>), align 16)
    %1:_(<4 x s32>) = G_LOAD %100(p0) :: (load (<4 x s32>), align 16)
    %2:_(<16 x s32>) = G_AIE_PAD_VECTOR_UNDEF %0(<4 x s32>)
    %3:_(<16 x s32>) = G_AIE_PAD_VECTOR_UNDEF %1(<4 x s32>)
    %4:_(<16 x s32>) = G_IMPLICIT_DEF
    %5:_(s32) = G_CONSTANT i32 0
    %6:_(s32) = G_CONSTANT i32 16
    %7:_(s32) = G_CONSTANT i32 48
