    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2ps.vshift.I512.I512), [[DEF]](<16 x s32>), [[AIE_PAD_VECTOR_UNDEF]](<16 x s32>), [[C]](s32), [[C1]](s32)
    ; CHECK-NEXT: [[INT1:%[0-9]+]]:_(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2ps.vshift.I512.I512), [[INT]](<16 x s32>), [[AIE_PAD_VECTOR_UNDEF1]](<16 x s32>), [[C]](s32), [[C2]](s32)
    ; CHECK-NEXT: $x0 = COPY [[INT1]](<16 x s32>)
    ; CHECK-NEXT: $x1 = COPY [[INT]](<16 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0, implicit $x1
    %100:_(p0) = COPY $p0
    %0:_(<4 x s32>) = G_LOAD %100(p0) :: (load (<4 x s32>), align 16)
    %1:_(<4 x s32>) = G_LOAD %100(p0) :: (load (<4 x s32>), align 16)
    %2:_(<16 x s32>) = G_AIE_PAD_VECTOR_UNDEF %0(<4 x s32>)
    %3:_(<16 x s32>) = G_AIE_PAD_VECTOR_UNDEF %1(<4 x s32>)
    %4:_(<16 x s32>) = G_IMPLICIT_DEF
    %5:_(s32) = G_CONSTANT i32 0
    %6:_(s32) = G_CONSTANT i32 16
    %7:_(s32) = G_CONSTANT i32 48
    %8:_(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2ps.vshift.I512.I512), %4(<16 x s32>), %2(<16 x s32>), %5(s32), %6(s32)
    %9:_(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2ps.vshift.I512.I512), %8(<16 x s32>), %3(<16 x s32>), %5(s32), %7(s32)
    $x0 = COPY %9(<16 x s32>)
    $x1 = COPY %8(<16 x s32>)
    PseudoRET implicit $lr, implicit $x0, implicit $x1
...

# A nonzero step: no rewrite.
---
name:            negative_step
legalized:       false
body:             |
  bb.0:
    liveins: $p0
    ; CHECK-LABEL: name: negative_step
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
