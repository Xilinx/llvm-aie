    ; CHECK-NEXT: [[INT1:%[0-9]+]]:_(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2ps.vshift.I512.I512), [[INT]](<16 x s32>), [[AIE_PAD_VECTOR_UNDEF1]](<16 x s32>), [[C]](s32), [[C2]](s32)
    ; CHECK-NEXT: $x0 = COPY [[INT1]](<16 x s32>)
