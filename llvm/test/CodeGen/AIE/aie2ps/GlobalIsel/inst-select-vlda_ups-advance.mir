#
# Tests for VLDA_UPS combining using the canAdvanceOp fallback path.
#
# When canDelayMemOp fails (e.g., due to an intervening store), we can
# still combine by advancing the combined instruction to the load's position
# if canAdvanceOp succeeds (SideEffectsAreChecked=true).
#
# RUN: llc -mtriple aie2ps -run-pass=instruction-select %s -verify-machineinstrs -o - | FileCheck %s

---
name:            VLDA_UPS_advance_intervening_store
alignment:       16
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $p0, $p1, $r0, $wl0

    ; CHECK-LABEL: name: VLDA_UPS_advance_intervening_store
    ; CHECK: liveins: $p0, $p1, $r0, $wl0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ep = COPY $p1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vec256 = COPY $wl0
    ; CHECK-NEXT: $crupsmode = MOVX_mvx_cr_imm 0
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:es = COPY [[COPY2]]
    ; CHECK-NEXT: [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_:%[0-9]+]]:acc512 = VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1 [[COPY4]], [[COPY]], 0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1 :: (load (<16 x s16>))
    ; CHECK-NEXT: VST_dmw_sts_w_st_idx_imm [[COPY3]], [[COPY1]], 0 :: (store (<16 x s16>))
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_]]
    %0:ptrregbank(p0) = COPY $p0
    %1:ptrregbank(p0) = COPY $p1
    %2:gprregbank(s32) = COPY $r0
    %3:vregbank(<16 x s16>) = COPY $wl0
    %4:gprregbank(s32) = G_CONSTANT i32 1

    %5:vregbank(<16 x s16>) = G_LOAD %0:ptrregbank(p0) :: (load (<16 x s16>))

    G_STORE %3:vregbank(<16 x s16>), %1:ptrregbank(p0) :: (store (<16 x s16>))

    %6:accregbank(<8 x s64>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.acc32.v16.I256.ups), %5:vregbank(<16 x s16>), %2:gprregbank(s32), %4:gprregbank(s32)

    PseudoRET implicit $lr, implicit %6
...

---
name:            VLDA_UPS_advance_crupsmode_placement
alignment:       16
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $p0, $p1, $p2, $r0, $wl0

    ; CHECK-LABEL: name: VLDA_UPS_advance_crupsmode_placement
    ; CHECK: liveins: $p0, $p1, $p2, $r0, $wl0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ep = COPY $p1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:ep = COPY $p2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:vec256 = COPY $wl0
    ; CHECK-NEXT: [[LDA_dms_lda_scalar_ld_idx_imm:%[0-9]+]]:er = LDA_dms_lda_scalar_ld_idx_imm [[COPY2]], 0 :: (load (s32))
    ; CHECK-NEXT: $crupsmode = MOVX_mvx_cr_imm 0
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:es = COPY [[COPY3]]
    ; CHECK-NEXT: [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_:%[0-9]+]]:acc512 = VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1 [[COPY5]], [[COPY]], 0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1 :: (load (<16 x s16>))
    ; CHECK-NEXT: VST_dmw_sts_w_st_idx_imm [[COPY4]], [[COPY1]], 0 :: (store (<16 x s16>))
    ; CHECK-NEXT: $r1 = COPY [[LDA_dms_lda_scalar_ld_idx_imm]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_]], implicit $r1
    %0:ptrregbank(p0) = COPY $p0
    %1:ptrregbank(p0) = COPY $p1
    %2:ptrregbank(p0) = COPY $p2
    %3:gprregbank(s32) = COPY $r0
    %4:vregbank(<16 x s16>) = COPY $wl0
    %5:gprregbank(s32) = G_CONSTANT i32 1

    %6:gprregbank(s32) = G_LOAD %2:ptrregbank(p0) :: (load (s32))

    %7:vregbank(<16 x s16>) = G_LOAD %0:ptrregbank(p0) :: (load (<16 x s16>))

    G_STORE %4:vregbank(<16 x s16>), %1:ptrregbank(p0) :: (store (<16 x s16>))

    %8:accregbank(<8 x s64>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.acc32.v16.I256.ups), %7:vregbank(<16 x s16>), %3:gprregbank(s32), %5:gprregbank(s32)

    $r1 = COPY %6:gprregbank(s32)

    PseudoRET implicit $lr, implicit %8, implicit $r1
...

# A store between the load and the ups: the ups moves up to the load, after
# the definition of the addressing registers that the fused instruction uses.
---
name:            VLDA_UPS_advance_2d_load
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $p0, $p1, $r1, $wl0
    ; CHECK-LABEL: name: VLDA_UPS_advance_2d_load
    ; CHECK: liveins: $p0, $p1, $r1, $wl0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: %q:ep = COPY $p1
    ; CHECK-NEXT: %x:vec256 = COPY $wl0
    ; CHECK-NEXT: [[MOV_PD_imm11_pseudo:%[0-9]+]]:em = MOV_PD_imm11_pseudo 1
    ; CHECK-NEXT: [[MOV_PD_imm11_pseudo1:%[0-9]+]]:edj = MOV_PD_imm11_pseudo 2
    ; CHECK-NEXT: [[MOV_PD_imm11_pseudo2:%[0-9]+]]:edn = MOV_PD_imm11_pseudo 3
    ; CHECK-NEXT: [[MOV_PD_imm11_pseudo3:%[0-9]+]]:edc = MOV_PD_imm11_pseudo 4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:er = COPY $r1
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:ed = REG_SEQUENCE [[MOV_PD_imm11_pseudo]], %subreg.sub_mod, [[MOV_PD_imm11_pseudo2]], %subreg.sub_dim_size, [[MOV_PD_imm11_pseudo1]], %subreg.sub_dim_stride, [[MOV_PD_imm11_pseudo3]], %subreg.sub_dim_count
    ; CHECK-NEXT: $crupsmode = MOVX_mvx_cr_imm 0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:es = COPY [[COPY1]]
    ; CHECK-NEXT: [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign1_:%[0-9]+]]:acc512, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign1_1:%[0-9]+]]:ep, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign1_2:%[0-9]+]]:edc = VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign1 [[COPY2]], [[COPY]], [[REG_SEQUENCE]], implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1 :: (load (<16 x s16>))
    ; CHECK-NEXT: VST_dmw_sts_w_st_idx_imm %x, %q, 0 :: (store (<16 x s16>))
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign1_]], implicit [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign1_1]], implicit [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign1_2]]
    %0:ptrregbank(p0) = COPY $p0
    %q:ptrregbank(p0) = COPY $p1
    %x:vregbank(<16 x s16>) = COPY $wl0
    %1:em(s20) = G_CONSTANT i20 1
    %2:edj(s20) = G_CONSTANT i20 2
    %3:edn(s20) = G_CONSTANT i20 3
    %4:edc(s20) = G_CONSTANT i20 4
    %101:gprregbank(s32) = COPY $r1
    %102:gprregbank(s32) = G_CONSTANT i32 1
    %25:vregbank(<16 x s16>), %5:ptrregbank(p0), %6:modregbank(s20) = G_AIE_POSTINC_2D_LOAD %0, %1, %2, %3, %4 :: (load (<16 x s16>))
    G_STORE %x, %q :: (store (<16 x s16>))
    %103:accregbank(<8 x s64>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.acc32.v16.I256.ups), %25:vregbank(<16 x s16>), %101:gprregbank(s32), %102:gprregbank(s32)
    PseudoRET implicit $lr, implicit %103, implicit %5, implicit %6
...
