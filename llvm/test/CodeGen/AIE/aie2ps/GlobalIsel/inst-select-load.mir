    liveins: $p0
    ;AIE2PS-LABEL: name:            load_s64

    ;AIE2PS: [[COPY_0:%[0-9]+]]:ep = COPY $p0
    ;AIE2PS-NEXT: [[LDA__1:%[0-9]+]]:el = LDA_dml_lda_scalar_L_ld_idx_imm [[COPY_0]], 0 :: (load (s64))
    ;AIE2PS-NEXT: $l0 = COPY [[LDA__1]]
