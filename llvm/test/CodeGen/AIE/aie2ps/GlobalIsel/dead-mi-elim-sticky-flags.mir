# RUN: llc -mtriple aie2ps -run-pass=dead-mi-elimination %s -verify-machineinstrs -o - | FileCheck %s

# An instruction that sets a sticky status flag ORs into it: an earlier write
# of the flag stays live across it, and so does an earlier instruction that
# sets the flag, even if its result is unused.

---
name:            clear_before_srs
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bmll0, $p0, $r1
    ; CHECK-LABEL: name: clear_before_srs
    ; CHECK: liveins: $bmll0, $p0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:acc512 = COPY $bmll0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:er = COPY $r1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: $srsrs_of = MOV_alu_mv_mv_mv_sc_cg 0
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:es = COPY [[COPY1]]
    ; CHECK-NEXT: VST_SRS_2x_dmw_sts_srs_bm_idx_imm_srsSign1 [[COPY]], [[COPY3]], [[COPY2]], 0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1 :: (store (<16 x s16>))
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:er = COPY $srsrs_of
    ; CHECK-NEXT: $r0 = COPY [[COPY4]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %0:acc512 = COPY $bmll0
    %1:er = COPY $r1
    %2:ep = COPY $p0
    $srsrs_of = MOV_alu_mv_mv_mv_sc_cg 0
    %3:es = COPY %1
    VST_SRS_2x_dmw_sts_srs_bm_idx_imm_srsSign1 %0, %3, %2, 0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1 :: (store (<16 x s16>))
    %4:er = COPY $srsrs_of
    $r0 = COPY %4
    PseudoRET implicit $lr, implicit $r0
...

