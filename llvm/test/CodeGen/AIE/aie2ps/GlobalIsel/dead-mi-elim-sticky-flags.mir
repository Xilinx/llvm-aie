    ; CHECK-NEXT: [[VSRS_2x_mv_w_srs_bm_srsSign1_:%[0-9]+]]:vec256 = VSRS_2x_mv_w_srs_bm_srsSign1 [[COPY]], [[COPY3]], implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1
    ; CHECK-NEXT: VST_SRS_2x_dmw_sts_srs_bm_idx_imm_srsSign1 [[COPY]], [[COPY3]], [[COPY2]], 0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign1 :: (store (<16 x s16>))
