# crFPNlfMask keeps 8 bits, to which MOVX sign-extends its 5-bit immediate: it
# writes 255 as 31, but not 16, which MOV writes instead.
---
name:            set_fpnlfmask_16
alignment:       16
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: set_fpnlfmask_16
    ; CHECK: $crfpnlfmask = MOV_alu_mv_mv_mv_sc_cg 16
    ; CHECK-NEXT: PseudoRET implicit $lr
    %0:gprregbank(s32) = G_CONSTANT i32 24
    %1:gprregbank(s32) = G_CONSTANT i32 16
    G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.set.ctrl.reg), %0:gprregbank(s32), %1:gprregbank(s32)
    PseudoRET implicit $lr
...
