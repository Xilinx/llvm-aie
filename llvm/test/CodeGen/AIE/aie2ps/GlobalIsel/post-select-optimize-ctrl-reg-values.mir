# RUN: llc -mtriple aie2ps -run-pass=aie-post-select-optimize -verify-machineinstrs %s -o - | FileCheck %s

# A callee may change the saturation mode: it is not callee-saved.
---
name:            call_between
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: call_between
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %v:er = COPY $r1
    ; CHECK-NEXT: $crsat = COPY %v
    ; CHECK-NEXT: PseudoJL 32, csr_aie2ps, implicit-def $lr
    ; CHECK-NEXT: $crsat = COPY %v
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $crsat
    %v:er = COPY $r1
    $crsat = COPY %v
    PseudoJL 32, csr_aie2ps, implicit-def $lr
    $crsat = COPY %v
    PseudoRET implicit $lr, implicit $crsat
...

# Inline assembly may change it as well.
---
name:            inline_asm_between
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: inline_asm_between
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %v:er = COPY $r1
    ; CHECK-NEXT: $crsat = COPY %v
    ; CHECK-NEXT: INLINEASM &nop, 1 /* sideeffect attdialect */
    ; CHECK-NEXT: $crsat = COPY %v
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $crsat
    %v:er = COPY $r1
    $crsat = COPY %v
    INLINEASM &"nop", 1 /* sideeffect attdialect */
    $crsat = COPY %v
    PseudoRET implicit $lr, implicit $crsat
...

# A copy of the saturation mode from before a call does not hold its value
# after the call.
---
name:            copy_out_after_call
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: copy_out_after_call
    ; CHECK: %a:er = COPY $crsat
    ; CHECK-NEXT: PseudoJL 32, csr_aie2ps, implicit-def $lr
    ; CHECK-NEXT: %b:er = COPY $crsat
    ; CHECK-NEXT: $r0 = COPY %a
    ; CHECK-NEXT: $r1 = COPY %b
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0, implicit $r1
    %a:er = COPY $crsat
    PseudoJL 32, csr_aie2ps, implicit-def $lr
    %b:er = COPY $crsat
    $r0 = COPY %a
    $r1 = COPY %b
    PseudoRET implicit $lr, implicit $r0, implicit $r1
...
