# Positive test: Stores to different pointers
name: test_split_i512_srs_different_ptrs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $dm0, $r0, $r1, $p0, $p1


    ; CHECK-LABEL: name: test_split_i512_srs_different_ptrs
    ; CHECK: liveins: $dm0, $r0, $r1, $p0, $p1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %acc:_(<64 x s32>) = COPY $dm0
    ; CHECK-NEXT: %shift:_(s32) = COPY $r0
    ; CHECK-NEXT: %sign:_(s32) = COPY $r1
    ; CHECK-NEXT: %ptr1:_(p0) = COPY $p0
    ; CHECK-NEXT: %ptr2:_(p0) = COPY $p1
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<32 x s32>), [[UV1:%[0-9]+]]:_(<32 x s32>) = G_UNMERGE_VALUES %acc(<64 x s32>)
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(<32 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I256.v32.acc32.srs), [[UV]](<32 x s32>), %shift(s32), %sign(s32)
    ; CHECK-NEXT: [[INT1:%[0-9]+]]:_(<32 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I256.v32.acc32.srs), [[UV1]](<32 x s32>), %shift(s32), %sign(s32)
    ; CHECK-NEXT: %lo:_(<8 x s32>) = G_BITCAST [[INT]](<32 x s8>)
    ; CHECK-NEXT: %hi:_(<8 x s32>) = G_BITCAST [[INT1]](<32 x s8>)
    ; CHECK-NEXT: G_STORE %lo(<8 x s32>), %ptr1(p0) :: (store (<8 x s32>))
    ; CHECK-NEXT: G_STORE %hi(<8 x s32>), %ptr2(p0) :: (store (<8 x s32>))
    %acc:_(<64 x s32>) = COPY $dm0
    %shift:_(s32) = COPY $r0
    %sign:_(s32) = COPY $r1
    %ptr1:_(p0) = COPY $p0
    %ptr2:_(p0) = COPY $p1

    %srs:_(<64 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I512.v64.acc32.srs), %acc(<64 x s32>), %shift(s32), %sign(s32)
    %bitcast:_(<16 x s32>) = G_BITCAST %srs(<64 x s8>)
    %lo:_(<8 x s32>), %hi:_(<8 x s32>) = G_UNMERGE_VALUES %bitcast(<16 x s32>)
    G_STORE %lo(<8 x s32>), %ptr1(p0) :: (store (<8 x s32>))
    G_STORE %hi(<8 x s32>), %ptr2(p0) :: (store (<8 x s32>))
...

