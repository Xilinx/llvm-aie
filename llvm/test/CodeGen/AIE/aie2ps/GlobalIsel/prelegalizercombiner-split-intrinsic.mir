# Negative test: Multiple uses of SRS output (should NOT combine)
name: test_split_i512_srs_multiple_srs_uses
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $dm0, $r0, $r1, $p0


    ; CHECK-LABEL: name: test_split_i512_srs_multiple_srs_uses
    ; CHECK: liveins: $dm0, $r0, $r1, $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %acc:_(<64 x s32>) = COPY $dm0
    ; CHECK-NEXT: %shift:_(s32) = COPY $r0
    ; CHECK-NEXT: %sign:_(s32) = COPY $r1
    ; CHECK-NEXT: %ptr:_(p0) = COPY $p0
    ; CHECK-NEXT: %srs:_(<64 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I512.v64.acc32.srs), %acc(<64 x s32>), %shift(s32), %sign(s32)
    ; CHECK-NEXT: %bitcast:_(<16 x s32>) = G_BITCAST %srs(<64 x s8>)
    ; CHECK-NEXT: %lo:_(<8 x s32>), %hi:_(<8 x s32>) = G_UNMERGE_VALUES %bitcast(<16 x s32>)
    ; CHECK-NEXT: G_STORE %lo(<8 x s32>), %ptr(p0) :: (store (<8 x s32>))
    ; CHECK-NEXT: G_STORE %hi(<8 x s32>), %ptr(p0) :: (store (<8 x s32>))
    ; CHECK-NEXT: $x0 = COPY %srs(<64 x s8>)
    %acc:_(<64 x s32>) = COPY $dm0
    %shift:_(s32) = COPY $r0
    %sign:_(s32) = COPY $r1
    %ptr:_(p0) = COPY $p0

    %srs:_(<64 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I512.v64.acc32.srs), %acc(<64 x s32>), %shift(s32), %sign(s32)
    %bitcast:_(<16 x s32>) = G_BITCAST %srs(<64 x s8>)
    %lo:_(<8 x s32>), %hi:_(<8 x s32>) = G_UNMERGE_VALUES %bitcast(<16 x s32>)
    G_STORE %lo(<8 x s32>), %ptr(p0) :: (store (<8 x s32>))
    G_STORE %hi(<8 x s32>), %ptr(p0) :: (store (<8 x s32>))
    $x0 = COPY %srs(<64 x s8>)
...

