# Negative test: SRS not followed by BITCAST (should NOT combine)
name: test_split_i512_srs_wrong_pattern
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $dm0, $r0, $r1, $p0


    ; CHECK-LABEL: name: test_split_i512_srs_wrong_pattern
    ; CHECK: liveins: $dm0, $r0, $r1, $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %acc:_(<64 x s32>) = COPY $dm0
    ; CHECK-NEXT: %shift:_(s32) = COPY $r0
    ; CHECK-NEXT: %sign:_(s32) = COPY $r1
    ; CHECK-NEXT: %srs:_(<64 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I512.v64.acc32.srs), %acc(<64 x s32>), %shift(s32), %sign(s32)
    ; CHECK-NEXT: %other:_(<64 x s8>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: %concat:_(<128 x s8>) = G_CONCAT_VECTORS %srs(<64 x s8>), %other(<64 x s8>)
    ; CHECK-NEXT: $y2 = COPY %concat(<128 x s8>)
    %acc:_(<64 x s32>) = COPY $dm0
    %shift:_(s32) = COPY $r0
    %sign:_(s32) = COPY $r1
    %ptr:_(p0) = COPY $p0

    %srs:_(<64 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2ps.I512.v64.acc32.srs), %acc(<64 x s32>), %shift(s32), %sign(s32)
    %other:_(<64 x s8>) = G_IMPLICIT_DEF
    %concat:_(<128 x s8>) = G_CONCAT_VECTORS %srs(<64 x s8>), %other(<64 x s8>)
    $y2 = COPY %concat(<128 x s8>)
...
