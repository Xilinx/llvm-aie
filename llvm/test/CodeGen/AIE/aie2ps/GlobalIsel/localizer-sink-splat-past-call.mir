# RUN: llc -mtriple aie2ps -run-pass=localizer %s -verify-machineinstrs -o - | FileCheck %s

# These tests show that, once AIE's shouldLocalize() opts vector splats in, the
# generic GlobalISel Localizer sinks a constant vector splat (materialized by
# the IRTranslator at the top of the entry block) down to just before its first
# use. When a call sits between the splat and that use, the splat therefore ends
# up after the call, so its live range no longer crosses the call frame.

---
# A G_BUILD_VECTOR splat of an fp16 constant with one intervening call and the
# first use after the call: both the G_FCONSTANT and the splat are sunk past the
# PseudoJL.
name:            sink_splat_past_one_call
body:             |
  bb.1.entry:
    liveins: $p0
    ; CHECK-LABEL: name: sink_splat_past_one_call
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: $p0 = COPY [[COPY]](p0)
    ; CHECK-NEXT: PseudoJL &callee, csr_aie2ps, implicit-def $lr, implicit $p0
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s16) = G_FCONSTANT bfloat 0xRFF80
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<32 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16)
    ; CHECK-NEXT: $x0 = COPY [[BUILD_VECTOR]](<32 x s16>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %0:_(p0) = COPY $p0
    %1:_(s16) = G_FCONSTANT bfloat 0xRFF80
    %2:_(<32 x s16>) = G_BUILD_VECTOR %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16)
    ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    $p0 = COPY %0(p0)
    PseudoJL &callee, csr_aie2ps, implicit-def $lr, implicit $p0
    ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    $x0 = COPY %2(<32 x s16>)
    PseudoRET implicit $lr, implicit $x0
...

---
# Same shape, but using the target broadcast pseudo (the canonical form after
# the pre-legalizer combiner). The broadcast and its feeding constant are sunk
# past the call.
name:            sink_broadcast_past_call
body:             |
  bb.1.entry:
    liveins: $p0
    ; CHECK-LABEL: name: sink_broadcast_past_call
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: $p0 = COPY [[COPY]](p0)
    ; CHECK-NEXT: PseudoJL &callee, csr_aie2ps, implicit-def $lr, implicit $p0
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<32 x s16>) = G_AIE_BROADCAST_VECTOR [[C]](s32)
    ; CHECK-NEXT: $x0 = COPY [[AIE_BROADCAST_VECTOR]](<32 x s16>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %0:_(p0) = COPY $p0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(<32 x s16>) = G_AIE_BROADCAST_VECTOR %1(s32)
    ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    $p0 = COPY %0(p0)
    PseudoJL &callee, csr_aie2ps, implicit-def $lr, implicit $p0
    ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    $x0 = COPY %2(<32 x s16>)
    PseudoRET implicit $lr, implicit $x0
...

