---
# The original motivating shape: a constant splat materialized at entry-block
# top that feeds a loop PHI (so it would otherwise be live across the call in
# the entry block, i.e. the preheader). The splat's only user is the PHI, so the
# Localizer sinks it to the end of the entry block - after the call and just
# before the branch - rather than duplicating it inside the loop.
name:            sink_splat_past_call_phi_use
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: sink_splat_past_call_phi_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $p0
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   $p0 = COPY [[COPY]](p0)
  ; CHECK-NEXT:   PseudoJL &callee, csr_aie2ps, implicit-def $lr, implicit $p0
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s16) = G_FCONSTANT bfloat 0xRFF80
  ; CHECK-NEXT:   [[BUILD_VECTOR:%[0-9]+]]:_(<32 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(<32 x s16>) = G_PHI [[BUILD_VECTOR]](<32 x s16>), %bb.0, [[PHI]](<32 x s16>), %bb.1
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s1) = G_CONSTANT i1 true
  ; CHECK-NEXT:   G_BRCOND [[C1]](s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $x0 = COPY [[PHI]](<32 x s16>)
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit $x0
  bb.0:
    successors: %bb.1
    liveins: $p0
    %0:_(p0) = COPY $p0
    %1:_(s16) = G_FCONSTANT bfloat 0xRFF80
    %2:_(<32 x s16>) = G_BUILD_VECTOR %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16), %1(s16)
    ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    $p0 = COPY %0(p0)
    PseudoJL &callee, csr_aie2ps, implicit-def $lr, implicit $p0
    ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    G_BR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    %3:_(<32 x s16>) = G_PHI %2(<32 x s16>), %bb.0, %3(<32 x s16>), %bb.1
    %4:_(s1) = G_CONSTANT i1 true
    G_BRCOND %4(s1), %bb.1
    G_BR %bb.2

  bb.2:
    $x0 = COPY %3(<32 x s16>)
    PseudoRET implicit $lr, implicit $x0
...
