  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
