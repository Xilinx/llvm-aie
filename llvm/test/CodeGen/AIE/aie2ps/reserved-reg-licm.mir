    PseudoRET implicit $lr

  bb.2:
    successors: %bb.2(0x7c000000), %bb.1(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = COPY $r1
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    $srssign0 = MOVX_mvx_cr_imm 0
    ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    PseudoJL 32, CustomRegMask($lr,$p0,$r0,$r1,$r2,$r3,$r4,$r5,$r6,$r7), implicit-def $lr
    ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    PseudoJNZ $r0, %bb.2
    PseudoJ_jump_imm %bb.1

...
