# CustomRegMask clobbers $srssign0. Make sure no assignments are hoisted.
---
name:            srs_dyn_sign_loop_clobber
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_loop_clobber
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
