      $srssign0 = MOVX_mvx_cr_imm 0
      PseudoJNZ $r0, %bb.2
      PseudoJ_jump_imm %bb.1

...

# The loop has two distinct exit blocks (bb.1 and bb.3). getExitBlock() is null,
# so runOnLoop skips the loop entirely.
# Expected: no transformation — COPY and MOV stay in bb.2.
---
name:            srs_dyn_sign_multiple_exit_blocks
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_multiple_exit_blocks
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
