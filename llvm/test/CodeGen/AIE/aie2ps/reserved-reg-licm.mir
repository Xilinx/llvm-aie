  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.1
    bb.0:
      successors: %bb.5(0x40000000), %bb.1(0x40000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJNZ $r0, %bb.5

    bb.1:
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoRET implicit $lr

    bb.5:
      successors: %bb.2(0x80000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJ_jump_imm %bb.2

    bb.2:
      successors: %bb.2(0x40000000), %bb.1(0x40000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      $srssign0 = COPY $r1
      $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
      $srssign0 = MOVX_mvx_cr_imm 0
      PseudoJNZ $r0, %bb.2
      PseudoJNZ $r0, %bb.1

...

# Like srs_dyn_sign_loop_no_dedicated_exit but multi-block: COPY@bb.4, VSRS@bb.5
# (latch), MOVX@bb.6 (exiting; continue→bb.5 or exit→bb.1). bb.0 may skip
# directly to exit bb.1. MOVX must stay in bb.6 (bb.5 VSRS-first).
# Expected: no COPY hoist, no MOVX sink.
---
name:            srs_dyn_sign_multiblock_no_dedicated_exit
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_multiblock_no_dedicated_exit
