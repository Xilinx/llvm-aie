# Like srs_dyn_sign_loop, but bb.0 can skip the loop: branch to bb.4 (exit) or
# enter bb.1 → bb.2. bb.2 is both loop body and latch (COPY, VSRS, MOVX).
# Expected: no COPY hoist to bb.0 (would run on the skip path); MOVX sunk to
# exit bb.3 only (must not run when skipping via bb.4).
# Pass: COPY correctly stays in bb.2; MOVX also stays in bb.2 (missed sink).
# Result is suboptimal but correct.
---
name:            srs_dyn_sign_cond_latch_is_exit
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_cond_latch_is_exit
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.4
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.3(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1(0x40000000), %bb.4(0x40000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJNZ $r0, %bb.4
    PseudoJ_jump_imm %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.2

  bb.2:
    successors: %bb.1(0x7c000000), %bb.3(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = COPY $r1
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJNZ $r0, %bb.1
    PseudoJ_jump_imm %bb.3

  bb.3:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoRET implicit $lr

  bb.4:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoRET implicit $lr

...

# Two sibling inner loops with separate $r1 and $r2 invariants.
# Expected: each inner loop COPY hoisted to its preheader (bb.2 and bb.4).
# Pass: inner loop A ok; inner loop B COPY stays in bb.5.
# Result is suboptimal but correct.
---
name:            srs_dyn_sign_two_inner_loops
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_two_inner_loops
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.3(0x7c000000), %bb.4(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   $srssign0 = COPY $r2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.5(0x7c000000), %bb.6(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x1 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.5
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.7(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.7:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    PseudoJ_jump_imm %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    PseudoJ_jump_imm %bb.2

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    PseudoJ_jump_imm %bb.3

  bb.3:
    successors: %bb.3(0x7c000000), %bb.4(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    $srssign0 = COPY $r1
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJNZ $r0, %bb.3
    PseudoJ_jump_imm %bb.4

  bb.4:
    successors: %bb.5(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    PseudoJ_jump_imm %bb.5

  bb.5:
    successors: %bb.5(0x7c000000), %bb.6(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    $srssign0 = COPY $r2
    $x1 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJNZ $r0, %bb.5
    PseudoJ_jump_imm %bb.6

  bb.6:
    successors: %bb.1(0x7c000000), %bb.7(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    PseudoJNZ $r0, %bb.1
    PseudoJ_jump_imm %bb.7

  bb.7:
    liveins: $x0, $p0, $r0, $r1, $r2, $dm0, $s0
    PseudoRET implicit $lr

...

# Outer loop with header skip around nested inner loop.
# Expected: outer COPY hoisted to bb.0, outer MOVX sunk to bb.5 only.
# Pass: COPY hoisted to inner preheader bb.2 only; MOVX in inner bb.3 and outer exit bb.5.
# Result is suboptimal but correct.
---
name:            srs_dyn_sign_outer_if_inner_loop
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_outer_if_inner_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.5(0x04000000), %bb.2(0x7c000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.5
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.3(0x7c000000), %bb.4(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x1 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.1

  bb.1:
    successors: %bb.5(0x04000000), %bb.2(0x7c000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJNZ $r0, %bb.5
    PseudoJ_jump_imm %bb.2

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.3

  bb.3:
    successors: %bb.3(0x7c000000), %bb.4(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = COPY $r1
    $x1 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJNZ $r0, %bb.3
    PseudoJ_jump_imm %bb.4

  bb.4:
    successors: %bb.1(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.1

  bb.5:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoRET implicit $lr

...

# Call-like regmask clobber (ABI preserved set without $srssign0).
---
name:            srs_dyn_sign_real_call_clobber
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_real_call_clobber
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
