# Verify that non-reserved physical registers aren't considered for LICM
---
name:            test_is_simplifiable_reserved_reg
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: test_is_simplifiable_reserved_reg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $r0, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x7c000000), %bb.1(0x04000000)
  ; CHECK-NEXT:   liveins: $r0, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY $x0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  bb.0:
    successors: %bb.2(0x80000000)
    liveins: $r0, $x0
    PseudoJ_jump_imm %bb.2

  bb.1:
    liveins: $r0, $x0
    PseudoRET implicit $lr

  bb.2:
    successors: %bb.2(0x7c000000), %bb.1(0x04000000)
    liveins: $r0, $x0
    $x0 = COPY $x0
    PseudoJNZ $r0, %bb.2
    PseudoJ_jump_imm %bb.1

...

# The latch (bb.3) defines $srssign0 = MOVX 0 but is NOT the exiting block.
# The exiting block (bb.2) exits to bb.4 without going through bb.3, so the
# MOVX is not on the exit path. processForExitSink must scan the exiting block
# (bb.2), not the latch (bb.3), to avoid sinking the MOVX to bb.4.
---
name:            srs_dyn_sign_cond_latch_vs_exiting_no_sink
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_cond_latch_vs_exiting_no_sink
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x7c000000), %bb.4(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = COPY $r1
    PseudoJ_jump_imm %bb.2

  bb.2:
    successors: %bb.3(0x7c000000), %bb.4(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    PseudoJNZ $r0, %bb.3
    PseudoJ_jump_imm %bb.4

  bb.3:
    successors: %bb.1(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJ_jump_imm %bb.1

  bb.4:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoRET implicit $lr

...

# $srssign0 is used in one conditional branch (bb.2) but defined in the other
# (bb.3). The latch (bb.4) defines $srssign0 = MOVX 0 without using it first,
# so LatchEntryLive does NOT flag it. However, $srssign0 IS a true loop livein
# because bb.2 can execute on the first iteration without going through bb.3.
# collectLoopReservedLiveins detects this for hoist; sink is blocked by
# isRegLiveInAtInLoopSuccessor on the continue edge to the header (bb.4→bb.1),
# not by a separate header live-in test in processForExitSink.
---
name:            srs_dyn_sign_cond_livein_opposite_branch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_cond_livein_opposite_branch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.5(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.1

  bb.1:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJNZ $r0, %bb.3

  bb.2:
    successors: %bb.4(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    PseudoJ_jump_imm %bb.4

  bb.3:
    successors: %bb.4(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = COPY $r1
    PseudoJ_jump_imm %bb.4

  bb.4:
    successors: %bb.1(0x7c000000), %bb.5(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJNZ $r0, %bb.1
    PseudoJ_jump_imm %bb.5

  bb.5:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoRET implicit $lr

...

# $srssign0 is defined in one conditional branch (bb.2) but not the other
# (bb.3). The latch (bb.4) uses $srssign0 before defining it, so $srssign0 is
# live at the latch entry on the path through bb.3. Sinking MOVX_mvx_cr_imm 0
# from the latch to the exit would expose the wrong value on that path.
# Neither the COPY nor the MOVX should be moved.
---
name:            srs_dyn_sign_cond_skipdef_latch_use_before_def
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_cond_skipdef_latch_use_before_def
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.5(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.1

  bb.1:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJNZ $r0, %bb.3

  bb.2:
    successors: %bb.4(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = COPY $r1
    PseudoJ_jump_imm %bb.4

  bb.3:
    successors: %bb.4(0x80000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoJ_jump_imm %bb.4

  bb.4:
    successors: %bb.1(0x7c000000), %bb.5(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJNZ $r0, %bb.1
    PseudoJ_jump_imm %bb.5

  bb.5:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoRET implicit $lr

...
# bb.1 is the header; bb.3 is the latch (COPY + VSRS); bb.2 is the exiting block
# with only MOVX on the direct exit path (no VSRS use before the def). The header
# branches to bb.2 without going through the latch, so $srssign0 is not live at
# bb.2 entry and processForExitSink can sink the MOVX. COPY hoists from bb.3.
# Expected: COPY hoisted to preheader; MOV sunk to exit block.
---
name:            srs_dyn_sign_cond_exiting_block_hoist_sink
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_cond_exiting_block_hoist_sink
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x04000000), %bb.3(0x7c000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x7c000000), %bb.4(0x04000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoRET implicit $lr
    bb.0:
      successors: %bb.1(0x80000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJ_jump_imm %bb.1

    bb.1:
      successors: %bb.2(0x04000000), %bb.3(0x7c000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJNZ $r0, %bb.3
      PseudoJ_jump_imm %bb.2

    bb.2:
      successors: %bb.3(0x7c000000), %bb.4(0x04000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      $srssign0 = MOVX_mvx_cr_imm 0
      PseudoJNZ $r0, %bb.3
      PseudoJ_jump_imm %bb.4

    bb.3:
      successors: %bb.1(0x80000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      $srssign0 = COPY $r1
      $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
      PseudoJ_jump_imm %bb.1

    bb.4:
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoRET implicit $lr

...

# Side-block COPY could hoist to preheader; MOVX must stay in bb.4 (bb.4→bb.3 continue
# needs it before VSRS). Pass: no COPY hoist, MOVX stays in bb.4. Sink blocked by
# isRegLiveInAtInLoopSuccessor on bb.4→bb.3 (header loop live-in is false).
# Result is suboptimal but correct.
---
name:            srs_dyn_sign_cond_side_block_hoist_no_sink
tracksRegLiveness: true
