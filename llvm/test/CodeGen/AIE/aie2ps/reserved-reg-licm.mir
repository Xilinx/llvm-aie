    PseudoJ_jump_imm %bb.2

  bb.1:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoRET implicit $lr

  bb.2:
    successors: %bb.2(0x54000000), %bb.1(0x28000000), %bb.3(0x04000000)
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    $srssign0 = COPY $r1
    $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
    $srssign0 = MOVX_mvx_cr_imm 0
    PseudoJNZ $r0, %bb.2
    PseudoJNZ $r0, %bb.1
    PseudoJ_jump_imm %bb.3

  bb.3:
    liveins: $x0, $p0, $r0, $r1, $dm0, $s0
    PseudoRET implicit $lr

...
# bb.2 and bb.3 are both latches (back-edges to header bb.1); exit is only from
# bb.1. runOnLoop returns early when !L.getLoopLatch().
# Expected: no transformation.
---
name:            srs_dyn_sign_multi_latch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_multi_latch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x3d70a3d7), %bb.3(0x3d70a3d7), %bb.4(0x051eb852)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
