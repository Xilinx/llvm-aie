# Outer loop hoists COPY to bb.0 and sinks MOVX to bb.5. Inner loop spans bb.2 and
# bb.3 (side latch block on the back-edge path); inner COPY/MOVX are handled first.
# Expected: single outer MOVX at bb.5. Pass: duplicate MOVX at bb.5 (inner + outer).
# Result is suboptimal but correct.
---
name:            srs_dyn_sign_nested_multiblock_inner
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_nested_multiblock_inner
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.3
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   $srssign0 = MOVX_mvx_cr_imm 0
  ; CHECK-NEXT:   PseudoRET implicit $lr
    bb.0:
      successors: %bb.1(0x80000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJ_jump_imm %bb.1

    bb.1:
      successors: %bb.2(0x80000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJ_jump_imm %bb.2

    bb.2:
      successors: %bb.6(0x40000000), %bb.3(0x40000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      $srssign0 = COPY $r1
      $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
      $srssign0 = MOVX_mvx_cr_imm 0
      PseudoJNZ $r0, %bb.6
      PseudoJ_jump_imm %bb.3

    bb.6:
      successors: %bb.2(0x80000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJ_jump_imm %bb.2

    bb.3:
      successors: %bb.1(0x40000000), %bb.4(0x40000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoJNZ $r0, %bb.1
      PseudoJ_jump_imm %bb.4

    bb.4:
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      $srssign0 = MOVX_mvx_cr_imm 0
      PseudoRET implicit $lr

...

# $srssign0 uses the exiting-block sink pattern; $crsat has two defs in the latch
# (bb.3) only. Per-register Candidate maps: srssign0 hoists/sinks, crsat stays.
# Expected: $srssign0 COPY hoisted and MOV sunk; $crsat assignments stay in bb.3.
---
name:            srs_dyn_sign_two_reserved_regs
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_two_reserved_regs
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $p0, $r0, $r1, $dm0, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $srssign0 = COPY $r1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x04000000), %bb.3(0x7c000000)
