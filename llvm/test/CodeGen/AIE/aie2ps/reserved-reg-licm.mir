...

# Multi-block loop like exiting_block_sink, but CustomRegMask in the latch (bb.3)
# clobbers $srssign0 after COPY/VSRS. RegDefMap clears unique defs after regmask.
# Expected: no hoist/sink after RegMask clobber.
---
name:            srs_dyn_sign_multiblock_clobber
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_multiblock_clobber
