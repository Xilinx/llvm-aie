      $x0 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
      $srssign0 = MOVX_mvx_cr_imm 0
      PseudoJ_jump_imm %bb.1

    bb.3:
      successors: %bb.1(0x80000000)
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      $srssign0 = COPY $r1
      $x1 = VSRS_4x_mv_x_srs_dm_srsSign0 $dm0, $s0, implicit-def $srsrs_of, implicit $crrnd, implicit $crsrsmode, implicit $crsat, implicit $srssign0
      $srssign0 = MOVX_mvx_cr_imm 0
      PseudoJ_jump_imm %bb.1

    bb.4:
      liveins: $x0, $p0, $r0, $r1, $dm0, $s0
      PseudoRET implicit $lr

...

# bb.5 is the preheader; exit bb.1 also has pred bb.0 (no dedicated exit). The
# exiting block bb.2 branches to bb.1 with TBB == FBB (two PseudoJNZ to bb.1),
# so canSplitCriticalEdge returns false.
# Expected: no transformation — no edge split, COPY and MOV stay in bb.2.
---
name:            srs_dyn_sign_unsplittable_critical_edge
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: srs_dyn_sign_unsplittable_critical_edge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
