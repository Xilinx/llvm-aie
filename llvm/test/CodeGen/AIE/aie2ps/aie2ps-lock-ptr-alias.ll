; CHECK-NEXT:    nopa ; vldb x2, [p0], #64; nops ; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:  .LBB12_1: // %for.body
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:  .L_LEnd3:
; CHECK-NEXT:    nopa ; vldb x2, [p0], #64; vst x4, [p1], #64; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:  // %bb.2: // %for.exit
; CHECK-NEXT:    nopa ; nopb ; vst x4, [p1], #64; nopx ; vadd.32 x4, x2, x0; nopv
; CHECK-NEXT:    nopa ; vst x4, [p1], #64; nopx ; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #64; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #64; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #64; ret lr; vadd.32 x4, x2, x0
; CHECK-NEXT:    vst x4, [p1], #64; vadd.32 x4, x2, x0 // Delay Slot 5
; CHECK-NEXT:    vst x4, [p1], #64; vadd.32 x4, x2, x0 // Delay Slot 4
; CHECK-NEXT:    vst x4, [p1], #64 // Delay Slot 3
; CHECK-NEXT:    vst x4, [p1], #64 // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
  %cur_id.ptr = getelementptr inbounds i8, ptr %lock_io, i20 12
  %cur_id = load i32, ptr %cur_id.ptr, align 4
  %is_zero = icmp eq i32 %cur_id, 0
  %buf0.ptr = getelementptr inbounds i8, ptr %lock_io, i20 4
  %buf1.ptr = getelementptr inbounds i8, ptr %lock_io, i20 8
  %buf0 = load ptr, ptr %buf0.ptr, align 4
  %buf1 = load ptr, ptr %buf1.ptr, align 4
  %active = select i1 %is_zero, ptr %buf0, ptr %buf1
  call void @llvm.aie2ps.acquire.ptr(ptr %active, i32 %lock_id, i32 -1)
  %in = addrspacecast ptr %active to ptr addrspace(5)
  %out.as = addrspacecast ptr %out to ptr addrspace(5)
  call void @llvm.set.loop.iterations.i32(i32 16)
  br label %for.body

for.body:
  %in.ph = phi ptr addrspace(5) [ %in, %entry ], [ %in.next, %for.body ]
  %out.ph = phi ptr addrspace(5) [ %out.as, %entry ], [ %out.next, %for.body ]
  %v = load <16 x i32>, ptr addrspace(5) %in.ph, align 64
  %add = add <16 x i32> %v, splat (i32 1)
  store <16 x i32> %add, ptr addrspace(5) %out.ph, align 64
  %in.next = getelementptr inbounds i8, ptr addrspace(5) %in.ph, i20 64
  %out.next = getelementptr inbounds i8, ptr addrspace(5) %out.ph, i20 64
  %dec = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %dec, label %for.body, label %for.exit, !llvm.loop !16

for.exit:
  ret void
}

!16 = distinct !{!16, !17, !18}
!17 = !{!"llvm.loop.mustprogress"}
!18 = !{!"llvm.loop.itercount.range", i64 16}

; --- Part-word store lock alias tests ---
; Part-word stores are word RMWs in hardware. Lock stall/resume elision vs a
; part-word store uses source-level noalias on both pointers only — alias
; analysis is not run on this path. Without that annotation, stay conservative.

; Forward: acquire_ptr on bufA, part-word store to same bufA — keep gap.
define void @acq_ptr_before_part_word_store_same(ptr %p, i32 %id, i32 %val, i8 %bval) {
; CHECK-LABEL: acq_ptr_before_part_word_store_same:
; CHECK:       // %bb.0:
; CHECK-NEXT:    nopa ; acq r0, r1
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    st.s8 r2, [p0, #0]
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
  call void @llvm.aie2ps.acquire.ptr(ptr %p, i32 %id, i32 %val)
  store volatile i8 %bval, ptr %p
  ret void
}

; Forward: acquire_ptr on bufA, part-word store to disjoint bufB with noalias.
; Lock delays vs the store are elided when both ptrs carry source noalias.
define void @acq_ptr_before_part_word_store_disjoint(ptr noalias %lock_buf, ptr noalias %store_buf, i32 %id, i32 %val, i8 %bval) {
; CHECK-LABEL: acq_ptr_before_part_word_store_disjoint:
; CHECK:       // %bb.0:
; CHECK-NEXT:    st.s8 r2, [p1, #0]; nopb ; nops ; acq r0, r1; nopm ; nopv
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    nop // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    nop // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
  call void @llvm.aie2ps.acquire.ptr(ptr %lock_buf, i32 %id, i32 %val)
  store volatile i8 %bval, ptr %store_buf
  ret void
}

; Same as above but without noalias: no user contract — keep spacing.
define void @acq_ptr_before_part_word_store_disjoint_unknown_alias(ptr %lock_buf, ptr %store_buf, i32 %id, i32 %val, i8 %bval) {
; CHECK-LABEL: acq_ptr_before_part_word_store_disjoint_unknown_alias:
; CHECK:       // %bb.0:
