# REQUIRES: asserts

# Reproducer for a crash in AIEMachineAlignment after MachineBlockPlacement.
# The outer-loop pipeliner clones a profiled guard terminator at the warm-up
# and epilogue prefetch sites. The original !prof branch weights describe the
# steady-state guard, not the cloned copies that run at a different pipeline
# phase. Carrying them over biases MachineBlockPlacement so the loop's
# preheader is no longer the dedicated fall-through predecessor, which trips
# the "Null preheader block!" assertion when AIEMachineAlignment computes
# post-ZOL setup region sizes.

# RUN: not --crash llc -mtriple=aie2ps %s \
# RUN:   --start-before=block-placement --stop-after=aie-machine-alignment \
# RUN:   -o /dev/null 2>&1 | FileCheck %s

# CHECK: Null preheader block!

--- |
  ; ModuleID = 'llvm/test/CodeGen/AIE/aie2ps/end-to-end/gemm_int8_psum_conditional.ll'
  source_filename = "llvm/test/CodeGen/AIE/aie2ps/end-to-end/gemm_int8_psum_conditional.ll"
  target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "aie2ps"
  
  %"struct.std::__1::array" = type { [7 x %"struct.std::__1::array.26"] }
  %"struct.std::__1::array.26" = type { [2 x i32] }
  
  @_ZN3aie6detail19transpose_bits_implILj8EaLj64EE13shuffle_modesE = external dso_local local_unnamed_addr constant %"struct.std::__1::array", align 4
  
