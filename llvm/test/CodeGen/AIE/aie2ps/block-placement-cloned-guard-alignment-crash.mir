# REQUIRES: asserts

# Reproducer for a crash in AIEMachineAlignment after MachineBlockPlacement.
# The outer-loop pipeliner clones a profiled guard terminator at the warm-up
# and epilogue prefetch sites. The original !prof branch weights describe the
# steady-state guard, not the cloned copies that run at a different pipeline
# phase. Carrying them over biases MachineBlockPlacement to interleave the
# cloned cold arm between the cooldown setup and its ZOL body, so the ZOL
# body's preheader is no longer its dedicated fall-through predecessor.
# AIEMachineAlignment then trips its "Null preheader block!" assertion.

# RUN: not --crash llc -mtriple=aie2ps %s \
# RUN:   --start-before=block-placement --stop-after=aie-machine-alignment \
# RUN:   -o /dev/null 2>&1 | FileCheck %s

# CHECK: Null preheader block!

--- |
  target triple = "aie2ps"
  define void @cloned_guard_alignment_crash() {
  entry:
    br label %if.then.peel.pro
  if.then.peel.pro:
    br label %if.end.peel.pro
  if.end.peel.pro:
    br label %for.body
  for.body:
    br label %for.body144
  for.body144:
    br label %for.cond.cleanup143
  for.cond.cleanup143:
    br label %if.then.epi
  if.then.epi:
    br label %if.end.epi
  if.end.epi:
    br label %cooldown.entry
  cooldown.entry:
    br label %for.body144.cd
  for.body144.cd:
    br label %cooldown.exit
  cooldown.exit:
    ret void
  }
...
---
name:            cloned_guard_alignment_crash
alignment:       16
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0.entry:
    successors: %bb.2(0x7ebb907a), %bb.1(0x01446f86)
    liveins: $r30

    PseudoJZ renamable $r30, %bb.2

  bb.1.if.then.peel.pro:
    successors: %bb.2(0x80000000)

    renamable $r0 = MOV_RLC_imm11_pseudo 0

  bb.2.if.end.peel.pro:
    successors: %bb.3(0x80000000)

  bb.3.for.body:
    successors: %bb.4(0x80000000)

    renamable $r28 = MOV_RLC_imm11_pseudo 10
    LoopStart killed renamable $r28, 0

  bb.4.for.body144:
    successors: %bb.4(0x7ce0c7ce), %bb.5(0x031f3832)

    renamable $r0 = MOV_RLC_imm11_pseudo 0
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.4

  bb.5.for.cond.cleanup143:
    successors: %bb.7(0x7ebb907a), %bb.6(0x01446f86)
    liveins: $r30

    PseudoJZ renamable $r30, %bb.7

  bb.6.if.then.epi:
    successors: %bb.7(0x80000000)

    renamable $r0 = MOV_RLC_imm11_pseudo 0

  bb.7.if.end.epi:
    successors: %bb.3(0x745d1746), %bb.8(0x0ba2e8ba)
    liveins: $r1

    renamable $r1 = LoopDec killed renamable $r1, implicit-def $srcarry
    renamable $p5 = MOVXM_lng_cg %bb.3
    LoopJNZ renamable $r1, killed renamable $p5

  bb.8.cooldown.entry:
    successors: %bb.9(0x80000000)

    renamable $r28 = MOV_RLC_imm11_pseudo 10
    LoopStart killed renamable $r28, 0

  bb.9.for.body144.cd:
    successors: %bb.9(0x7ce0c7ce), %bb.10(0x031f3832)

    renamable $r0 = MOV_RLC_imm11_pseudo 0
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.9

  bb.10.cooldown.exit:
    PseudoRET implicit $lr

...
