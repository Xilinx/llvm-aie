# RUN: llc -mtriple=aie2ps -run-pass=aie-olp-mov-rotation \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s
#
# This file is licensed under the Apache License v2.0 with LLVM Exceptions.
# See https://llvm.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
#
# (c) Copyright 2026 Advanced Micro Devices, Inc. or its affiliates
#
# Negative: SteadyTop has 3 predecessors instead of the expected 2
# (OuterPreheader + SteadyBottom). The extra predecessor (bb.7) makes
# isSafeToRotate() return false, so rotation is skipped.

# CHECK-LABEL: name: no_rotation_extra_pred
#
# SteadyTop still has the MOV because isSafeToRotate fails:
# CHECK:      bb.1.steady.top:
# CHECK:        $r2 = MOV_OR_pseudo $r1

--- |
  define void @no_rotation_extra_pred() {
  entry:
    br label %steady.top
  steady.top:
    br label %steady.inner
  steady.inner:
    br i1 undef, label %steady.inner, label %steady.bottom
  steady.bottom:
    br i1 undef, label %steady.top, label %peeled.top, !llvm.loop !0
  peeled.top:
    br label %peeled.inner
  peeled.inner:
    br i1 undef, label %peeled.inner, label %peeled.bottom
  peeled.bottom:
    ret void
  extra.pred:
    br label %steady.top
  }

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.hint.aie_outerloop_pipeliner_success", i64 1}
...
---
name:            no_rotation_extra_pred
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $r0, $r1

    PseudoJ_jump_imm %bb.1

  bb.1.steady.top:
    successors: %bb.2
    liveins: $r0, $r1

    $r2 = MOV_OR_pseudo $r1

  bb.2.steady.inner:
    successors: %bb.2, %bb.3
    liveins: $r0, $r2

    NOP
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3.steady.bottom:
    successors: %bb.1, %bb.4
    liveins: $r0, $r1

    PseudoJNZ $r0, %bb.1

  bb.4.peeled.top:
    successors: %bb.5
    liveins: $r0, $r1

    $r2 = MOV_OR_pseudo $r1

  bb.5.peeled.inner:
    successors: %bb.5, %bb.6
    liveins: $r0, $r2

    NOP
    PseudoLoopEnd <mcsymbol .L_LEnd1>, %bb.5

  bb.6.peeled.bottom:
    successors: %bb.7
    liveins: $r0

    PseudoRET implicit $lr

  ; Extra predecessor for SteadyTop -> pred_size() == 3 instead of 2.
  bb.7.extra.pred:
    successors: %bb.1
    liveins: $r0, $r1

    PseudoJ_jump_imm %bb.1
...
