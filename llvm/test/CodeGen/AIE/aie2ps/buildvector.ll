; The splat is spelled out lane by lane. Building it with a shufflevector
; instead crashes the pre-legalizer combiner, which is a separate bug.
define void @test_runtime_splat_buildvector_64bits(i8 %a) {
; CHECK-LABEL: test_runtime_splat_buildvector_64bits:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    nopa ; extend.u8 r0, r0; nopm
; CHECK-NEXT:    mova r2, #8
; CHECK-NEXT:    mova r4, #16
; CHECK-NEXT:    mova p0, #0
; CHECK-NEXT:    lshl r2, r0, r2
; CHECK-NEXT:    lshl r4, r0, r4
; CHECK-NEXT:    or r2, r0, r2
; CHECK-NEXT:    or r2, r2, r4
; CHECK-NEXT:    mova r4, #24
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    lshl r0, r0, r4 // Delay Slot 5
; CHECK-NEXT:    or r0, r2, r0 // Delay Slot 4
; CHECK-NEXT:    mov r1, r0 // Delay Slot 3
; CHECK-NEXT:    st r1:r0, [p0, #0] // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
  %0 = insertelement <8 x i8> poison, i8 %a, i32 0
  %1 = insertelement <8 x i8> %0, i8 %a, i32 1
  %2 = insertelement <8 x i8> %1, i8 %a, i32 2
  %3 = insertelement <8 x i8> %2, i8 %a, i32 3
  %4 = insertelement <8 x i8> %3, i8 %a, i32 4
  %5 = insertelement <8 x i8> %4, i8 %a, i32 5
  %6 = insertelement <8 x i8> %5, i8 %a, i32 6
  %7 = insertelement <8 x i8> %6, i8 %a, i32 7
  store <8 x i8> %7, ptr addrspace(6) null, align 8
  ret void
}

