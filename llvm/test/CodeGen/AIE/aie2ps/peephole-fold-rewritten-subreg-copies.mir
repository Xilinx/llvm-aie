# RUN: llc -mtriple=aie2ps -run-pass=peephole-opt %s -verify-machineinstrs -o - | FileCheck %s

# Each chain extracts the low 512 bits of the same accumulator into a vector
# register. The peephole optimizer rewrites the subregister copies to read the
# accumulator directly; the rewritten copies are identical and must be folded
# into one, so that a single vector value feeds both extracts.
---
name: same_subreg_copy_chains
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $cml0, $cml1
    ; CHECK-LABEL: name: same_subreg_copy_chains
    ; CHECK: liveins: $cml0, $cml1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ecml = COPY $cml0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ecml = COPY $cml1
    ; CHECK-NEXT: [[MOV_RLC_imm11_pseudo:%[0-9]+]]:mrv8 = MOV_RLC_imm11_pseudo 60
    ; CHECK-NEXT: [[VADD_f_vacc_half_fp:%[0-9]+]]:ecml = VADD_f_vacc_half_fp [[COPY]], [[COPY1]], [[MOV_RLC_imm11_pseudo]], implicit-def dead $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:acc1024 = COPY [[VADD_f_vacc_half_fp]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:acc512 = COPY [[VADD_f_vacc_half_fp]].sub_512_acc_lo
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:vec512 = COPY [[COPY3]]
    ; CHECK-NEXT: [[VEXTRACT_64_vec_extract_imm_vaddSign1_:%[0-9]+]]:el = VEXTRACT_64_vec_extract_imm_vaddSign1 [[COPY4]], 0, implicit $vaddsign1
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:acc512 = COPY [[VADD_f_vacc_half_fp]].sub_512_acc_lo
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:vec512 = COPY [[COPY5]]
    ; CHECK-NEXT: [[VEXTRACT_64_vec_extract_imm_vaddSign1_1:%[0-9]+]]:el = VEXTRACT_64_vec_extract_imm_vaddSign1 [[COPY6]], 1, implicit $vaddsign1
    ; CHECK-NEXT: $l0 = COPY [[VEXTRACT_64_vec_extract_imm_vaddSign1_]]
    ; CHECK-NEXT: $l1 = COPY [[VEXTRACT_64_vec_extract_imm_vaddSign1_1]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $l0, implicit $l1
    %0:ecml = COPY $cml0
    %1:ecml = COPY $cml1
    %2:mrv8 = MOV_RLC_imm11_pseudo 60
    %3:ecml = VADD_f_vacc_half_fp %0, %1, %2, implicit-def dead $srfpflags, implicit $crfpmask
    %4:acc1024 = COPY %3
    %5:acc512 = COPY %4.sub_512_acc_lo
    %6:vec512 = COPY %5
    %7:el = VEXTRACT_64_vec_extract_imm_vaddSign1 %6, 0, implicit $vaddsign1
    %8:acc1024 = COPY %3
    %9:acc512 = COPY %8.sub_512_acc_lo
    %10:vec512 = COPY %9
    %11:el = VEXTRACT_64_vec_extract_imm_vaddSign1 %10, 1, implicit $vaddsign1
    $l0 = COPY %7
    $l1 = COPY %11
    PseudoRET implicit $lr, implicit $l0, implicit $l1
...

# The low and the high half are different values: nothing to fold.
---
name: different_subreg_copy_chains
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $cml0, $cml1
    ; CHECK-LABEL: name: different_subreg_copy_chains
