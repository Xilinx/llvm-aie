; CHECK-NEXT:    [[DST_NEXT_FIRSTITER]] = extractvalue { ptr, i20 } [[UPD_FIRSTITER]], 0
; CHECK-NEXT:    [[CNT_NEXT_FIRSTITER]] = extractvalue { ptr, i20 } [[UPD_FIRSTITER]], 1
