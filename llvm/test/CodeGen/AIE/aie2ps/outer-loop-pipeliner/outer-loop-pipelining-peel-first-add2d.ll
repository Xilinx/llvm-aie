; CHECK-NEXT:    br label %[[STEADY_STAGE1_BOTTOM_AND_STAGE0_TOP]]
; CHECK:       [[LASTITER_STAGE1_BOTTOM]]:
; CHECK-NEXT:    store i32 [[ACC_NEXT_STEADY]], ptr [[DST_PTR_STEADY]], align 4
