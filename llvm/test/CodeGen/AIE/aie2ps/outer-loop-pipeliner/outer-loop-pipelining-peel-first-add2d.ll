;
; The AIE 2D pointer increment returns an aggregate { ptr, i20 }. It can sit in
; stage 0, as the outer pointer update whose fields feed the header PHIs, or in
; stage 1, as the address computation of a deferred store.

declare void @llvm.set.loop.iterations.i32(i32)
declare i1 @llvm.loop.decrement.i32(i32)
declare { ptr, i20 } @llvm.aie2ps.add.2d(ptr, i20, i20, i20, i20)

