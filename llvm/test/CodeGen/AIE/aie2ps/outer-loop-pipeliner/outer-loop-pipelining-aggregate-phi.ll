entry:
  %has.work = icmp ugt i32 %n, 1
  br i1 %has.work, label %outer.header, label %exit

outer.header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %outer.latch ]
  %a.ptr = phi ptr [ %a, %entry ], [ %a.ptr.next, %outer.latch ]
  %fifo = phi <32 x i32> [ zeroinitializer, %entry ], [ %fifo.next, %outer.latch ]
  %state = phi i32 [ 0, %entry ], [ %state.next, %outer.latch ]
  %c.ptr = phi ptr [ %c, %entry ], [ %c.ptr.next, %outer.latch ]
  %popped = call { <64 x i8>, ptr, <32 x i32>, i32 } @llvm.aie2ps.fifo.ld.pop.512.unaligned.p0.p0(ptr %a.ptr, <32 x i32> %fifo, i32 %state)
  %data = extractvalue { <64 x i8>, ptr, <32 x i32>, i32 } %popped, 0
  %popped.ptr = extractvalue { <64 x i8>, ptr, <32 x i32>, i32 } %popped, 1
  %popped.fifo = extractvalue { <64 x i8>, ptr, <32 x i32>, i32 } %popped, 2
  %popped.state = extractvalue { <64 x i8>, ptr, <32 x i32>, i32 } %popped, 3
  %scaled = add <64 x i8> %data, %data
  call void @llvm.set.loop.iterations.i32(i32 %m)
  br label %inner.header

inner.header:
  %result = phi i32 [ 0, %outer.header ], [ %result.next, %inner.header ]
  %lane = extractelement <64 x i8> %scaled, i32 0
  %lane.ext = zext i8 %lane to i32
  %result.next = add i32 %result, %lane.ext
  %inner.cond = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %inner.cond, label %inner.header, label %outer.latch, !llvm.loop !1

outer.latch:
  store i32 %result.next, ptr %c.ptr, align 4
  %a.ptr.next = getelementptr inbounds <64 x i8>, ptr %popped.ptr, i32 1
  %fifo.next = add <32 x i32> %popped.fifo, zeroinitializer
  %state.next = add i32 %popped.state, 0
  %c.ptr.next = getelementptr inbounds i32, ptr %c.ptr, i32 1
  %i.next = add nuw i32 %i, 1
  %outer.cond = icmp eq i32 %i.next, %n
  br i1 %outer.cond, label %drain.preheader, label %outer.header, !llvm.loop !0

drain.preheader:
  %a.last = phi ptr [ %a.ptr, %outer.latch ]
  call void @llvm.set.loop.iterations.i32(i32 %k)
  br label %drain

drain:
  %p = phi ptr [ %a.last, %drain.preheader ], [ %p.next, %drain ]
  %q = phi ptr [ %out, %drain.preheader ], [ %q.next, %drain ]
  %v = load <16 x i32>, ptr %p, align 64
  %w = add <16 x i32> %v, %v
  store <16 x i32> %w, ptr %q, align 64
  %p.next = getelementptr inbounds <16 x i32>, ptr %p, i32 1
  %q.next = getelementptr inbounds <16 x i32>, ptr %q, i32 1
  %drain.cond = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %drain.cond, label %drain, label %exit, !llvm.loop !4

exit:
  ret void
