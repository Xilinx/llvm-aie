;
; The outer loop reaches the pipeliner already converted to a JNZD hardware
; loop: start.loop.iterations in the preheader, a counter PHI in the header and
; loop.decrement.reg in the latch. Peeling the first iteration keeps that
; hardware loop: the steady counter starts from start.loop.iterations, whose
; trip count is lowered to N-1, and the first iteration carries no decrement.

declare i32 @llvm.start.loop.iterations.i32(i32)
declare i32 @llvm.loop.decrement.reg.i32(i32, i32)
declare void @llvm.set.loop.iterations.i32(i32)
declare i1 @llvm.loop.decrement.i32(i32)

