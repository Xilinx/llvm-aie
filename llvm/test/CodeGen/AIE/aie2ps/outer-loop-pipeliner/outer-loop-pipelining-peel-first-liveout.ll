; CHECK: [[META1]] = !{!"llvm.loop.mustprogress"}
; CHECK: [[LOOP2]] = distinct !{[[LOOP2]], [[META1]], [[META3:![0-9]+]]}
; CHECK: [[META3]] = !{!"llvm.loop.itercount.range", i32 2}
