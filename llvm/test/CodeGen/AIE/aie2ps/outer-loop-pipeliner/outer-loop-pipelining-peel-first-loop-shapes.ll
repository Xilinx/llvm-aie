entry:
  %cmprows = icmp sgt i32 %Rows, 0
  br i1 %cmprows, label %top.ph, label %exit

top.ph:
  br label %top.header

top.header:
  %row = phi i32 [ 0, %top.ph ], [ %row.next, %top.latch ]
  %src.row = phi ptr [ %src, %top.ph ], [ %src.row.next, %top.latch ]
  %dst.row = phi ptr [ %dst, %top.ph ], [ %dst.row.next, %top.latch ]
  br label %ph

ph:
  br label %outer.header

outer.header:
  %i = phi i32 [ 0, %ph ], [ %i.next, %outer.latch ]
  %src.ptr = phi ptr [ %src.row, %ph ], [ %src.next, %outer.latch ]
  %dst.ptr = phi ptr [ %dst.row, %ph ], [ %dst.next, %outer.latch ]
  %val = load i32, ptr %src.ptr, align 4
  call void @llvm.set.loop.iterations.i32(i32 %M)
