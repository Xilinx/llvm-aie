;
; Multiple stores with GEP address chains in the bottom block. All stores and
; their address GEPs are stage-0 (displaced to steady top). Pointer-update
; intrinsics feeding outer-loop PHI back-edges stay as stage-1 (stationary in
; the bottom). Multiple inner_result_phi nodes are created for the inner-loop
; live-outs consumed by the stores.

declare void @llvm.set.loop.iterations.i32(i32)
declare i1 @llvm.loop.decrement.i32(i32)

define void @peel_first_multi_store(ptr noalias %src, ptr noalias %dst, i32 %N, i32 %M) {
; CHECK-LABEL: define void @peel_first_multi_store(
; CHECK-SAME: ptr noalias [[SRC:%.*]], ptr noalias [[DST:%.*]], i32 [[N:%.*]], i32 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i32 [[N]], 1
; CHECK-NEXT:    br i1 [[CMP]], label %[[OUTER_HEADER_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_HEADER_PREHEADER]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i32 [ [[N]], %[[OUTER_HEADER_PREHEADER]] ], [ [[LSR_IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[SRC_PTR_STEADY:%.*]] = phi ptr [ [[SRC_NEXT2:%.*]], %[[OUTER_LATCH]] ], [ [[SRC]], %[[OUTER_HEADER_PREHEADER]] ]
; CHECK-NEXT:    [[DST_NEXT3_CHAINED_STEADY:%.*]] = phi ptr [ [[DST_NEXT3_CHAINED:%.*]], %[[OUTER_LATCH]] ], [ [[DST]], %[[OUTER_HEADER_PREHEADER]] ]
; CHECK-NEXT:    [[VAL_STEADY:%.*]] = load i32, ptr [[SRC_PTR_STEADY]], align 4
; CHECK-NEXT:    call void @llvm.set.loop.iterations.i32(i32 [[M]])
; CHECK-NEXT:    br label %[[INNER_HEADER:.*]]
; CHECK:       [[INNER_HEADER]]:
; CHECK-NEXT:    [[ACC_A_STEADY:%.*]] = phi i32 [ 0, %[[OUTER_HEADER]] ], [ [[ACC_A_NEXT_STEADY:%.*]], %[[INNER_HEADER]] ]
; CHECK-NEXT:    [[ACC_B_STEADY:%.*]] = phi i32 [ 1, %[[OUTER_HEADER]] ], [ [[ACC_B_NEXT_STEADY:%.*]], %[[INNER_HEADER]] ]
; CHECK-NEXT:    [[ACC_A_NEXT_STEADY]] = add i32 [[ACC_A_STEADY]], [[VAL_STEADY]]
; CHECK-NEXT:    [[ACC_B_NEXT_STEADY]] = mul i32 [[ACC_B_STEADY]], [[VAL_STEADY]]
; CHECK-NEXT:    [[INNER_COND_FIRSTITER:%.*]] = call i1 @llvm.loop.decrement.i32(i32 1)
; CHECK-NEXT:    br i1 [[INNER_COND_FIRSTITER]], label %[[INNER_HEADER]], label %[[OUTER_LATCH]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    store i32 [[ACC_A_NEXT_STEADY]], ptr [[DST_NEXT3_CHAINED_STEADY]], align 4
; CHECK-NEXT:    [[DST_MID1_EPILOGUE:%.*]] = getelementptr inbounds i8, ptr [[DST_NEXT3_CHAINED_STEADY]], i32 4
; CHECK-NEXT:    store i32 [[ACC_B_NEXT_STEADY]], ptr [[DST_MID1_EPILOGUE]], align 4
; CHECK-NEXT:    [[SRC_NEXT2]] = getelementptr inbounds i8, ptr [[SRC_PTR_STEADY]], i32 4
; CHECK-NEXT:    [[DST_NEXT3_CHAINED]] = getelementptr inbounds i8, ptr [[DST_MID1_EPILOGUE]], i32 4
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV]], -1
; CHECK-NEXT:    [[OUTER_COND:%.*]] = icmp eq i32 [[LSR_IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[OUTER_COND]], label %[[EXIT]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP2:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cmp = icmp sgt i32 %N, 1
  br i1 %cmp, label %outer.header, label %exit

outer.header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %outer.latch ]
  %src.ptr = phi ptr [ %src, %entry ], [ %src.next, %outer.latch ]
  %dst.ptr = phi ptr [ %dst, %entry ], [ %dst.next, %outer.latch ]
  %val = load i32, ptr %src.ptr, align 4
  call void @llvm.set.loop.iterations.i32(i32 %M)
  br label %inner.header

inner.header:
  %acc.a = phi i32 [ 0, %outer.header ], [ %acc.a.next, %inner.header ]
  %acc.b = phi i32 [ 1, %outer.header ], [ %acc.b.next, %inner.header ]
  %acc.a.next = add i32 %acc.a, %val
  %acc.b.next = mul i32 %acc.b, %val
  %inner.cond = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %inner.cond, label %inner.header, label %outer.latch, !llvm.loop !1

outer.latch:
  %res.a = phi i32 [ %acc.a.next, %inner.header ]
  %res.b = phi i32 [ %acc.b.next, %inner.header ]
  ; Stage-0: stores + address GEPs (displaced to steady top)
  store i32 %res.a, ptr %dst.ptr, align 4
  %dst.mid = getelementptr inbounds i32, ptr %dst.ptr, i32 1
  store i32 %res.b, ptr %dst.mid, align 4
  ; Stage-1: ptr-updates feeding outer-loop PHI back-edges (stationary)
  %src.next = getelementptr inbounds i32, ptr %src.ptr, i32 1
  %dst.next = getelementptr inbounds i32, ptr %dst.ptr, i32 2
  %i.next = add nuw i32 %i, 1
  %outer.cond = icmp eq i32 %i.next, %N
  br i1 %outer.cond, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !2, !3}
!1 = distinct !{!1, !2}
!2 = !{!"llvm.loop.mustprogress"}
!3 = !{!"llvm.loop.itercount.range", i32 2}
;.
