entry:
  %cmp = icmp sgt i32 %N, 1
  br i1 %cmp, label %outer.header, label %exit

outer.header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %outer.latch ]
  %src.ptr = phi ptr [ %src, %entry ], [ %src.next, %outer.latch ]
  %dst.ptr = phi ptr [ %dst, %entry ], [ %dst.next, %outer.latch ]
  %val = load i32, ptr %src.ptr, align 4
  call void @llvm.set.loop.iterations.i32(i32 %M)
  br label %inner.header

inner.header:
  %acc.a = phi i32 [ 0, %outer.header ], [ %acc.a.next, %inner.header ]
  %acc.b = phi i32 [ 1, %outer.header ], [ %acc.b.next, %inner.header ]
  %acc.a.next = add i32 %acc.a, %val
  %acc.b.next = mul i32 %acc.b, %val
  %inner.cond = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %inner.cond, label %inner.header, label %outer.latch, !llvm.loop !1

outer.latch:
  %res.a = phi i32 [ %acc.a.next, %inner.header ]
  %res.b = phi i32 [ %acc.b.next, %inner.header ]
  ; Stage-0: stores + address GEPs (displaced to steady top)
  store i32 %res.a, ptr %dst.ptr, align 4
  %dst.mid = getelementptr inbounds i32, ptr %dst.ptr, i32 1
  store i32 %res.b, ptr %dst.mid, align 4
  ; Stage-1: ptr-updates feeding outer-loop PHI back-edges (stationary)
  %src.next = getelementptr inbounds i32, ptr %src.ptr, i32 1
  %dst.next = getelementptr inbounds i32, ptr %dst.ptr, i32 2
  %i.next = add nuw i32 %i, 1
  %outer.cond = icmp eq i32 %i.next, %N
  br i1 %outer.cond, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !2, !3}
!1 = distinct !{!1, !2}
!2 = !{!"llvm.loop.mustprogress"}
!3 = !{!"llvm.loop.itercount.range", i32 2}
