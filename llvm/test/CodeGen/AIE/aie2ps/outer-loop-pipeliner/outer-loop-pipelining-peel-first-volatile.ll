;
; A volatile store may not be moved to the next iteration, so the loop is not
; pipelined in either mode.

declare void @llvm.set.loop.iterations.i32(i32)
declare i1 @llvm.loop.decrement.i32(i32)

define void @volatile_store(ptr noalias %src, ptr noalias %dst, i32 %N, i32 %M) {
; CHECK-LABEL: define void @volatile_store(
; CHECK-SAME: ptr noalias [[SRC:%.*]], ptr noalias [[DST:%.*]], i32 [[N:%.*]], i32 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i32 [[N]], 1
; CHECK-NEXT:    br i1 [[CMP]], label %[[PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[PH]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[SRC_PTR:%.*]] = phi ptr [ [[SRC]], %[[PH]] ], [ [[SRC_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[DST_PTR:%.*]] = phi ptr [ [[DST]], %[[PH]] ], [ [[DST_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[VAL:%.*]] = load i32, ptr [[SRC_PTR]], align 4
; CHECK-NEXT:    call void @llvm.set.loop.iterations.i32(i32 [[M]])
; CHECK-NEXT:    br label %[[INNER_HEADER:.*]]
; CHECK:       [[INNER_HEADER]]:
; CHECK-NEXT:    [[ACC:%.*]] = phi i32 [ 0, %[[OUTER_HEADER]] ], [ [[ACC_NEXT:%.*]], %[[INNER_HEADER]] ]
; CHECK-NEXT:    [[ACC_NEXT]] = add i32 [[ACC]], [[VAL]]
; CHECK-NEXT:    [[INNER_COND:%.*]] = call i1 @llvm.loop.decrement.i32(i32 1)
; CHECK-NEXT:    br i1 [[INNER_COND]], label %[[INNER_HEADER]], label %[[OUTER_LATCH]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[RESULT:%.*]] = phi i32 [ [[ACC_NEXT]], %[[INNER_HEADER]] ]
; CHECK-NEXT:    store volatile i32 [[RESULT]], ptr [[DST_PTR]], align 4
; CHECK-NEXT:    [[DST_NEXT]] = getelementptr inbounds i32, ptr [[DST_PTR]], i32 1
; CHECK-NEXT:    [[SRC_NEXT]] = getelementptr inbounds i32, ptr [[SRC_PTR]], i32 1
; CHECK-NEXT:    [[I_NEXT]] = add nuw i32 [[I]], 1
; CHECK-NEXT:    [[OUTER_COND:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[OUTER_COND]], label %[[EXIT]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP2:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cmp = icmp sgt i32 %N, 1
  br i1 %cmp, label %ph, label %exit

ph:
  br label %outer.header

outer.header:
  %i = phi i32 [ 0, %ph ], [ %i.next, %outer.latch ]
  %src.ptr = phi ptr [ %src, %ph ], [ %src.next, %outer.latch ]
  %dst.ptr = phi ptr [ %dst, %ph ], [ %dst.next, %outer.latch ]
  %val = load i32, ptr %src.ptr, align 4
  call void @llvm.set.loop.iterations.i32(i32 %M)
  br label %inner.header

inner.header:
  %acc = phi i32 [ 0, %outer.header ], [ %acc.next, %inner.header ]
  %acc.next = add i32 %acc, %val
  %inner.cond = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %inner.cond, label %inner.header, label %outer.latch, !llvm.loop !1

outer.latch:
  %result = phi i32 [ %acc.next, %inner.header ]
  store volatile i32 %result, ptr %dst.ptr, align 4
  %dst.next = getelementptr inbounds i32, ptr %dst.ptr, i32 1
  %src.next = getelementptr inbounds i32, ptr %src.ptr, i32 1
  %i.next = add nuw i32 %i, 1
  %outer.cond = icmp eq i32 %i.next, %N
  br i1 %outer.cond, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !2, !3}
!1 = distinct !{!1, !2}
!2 = !{!"llvm.loop.mustprogress"}
!3 = !{!"llvm.loop.itercount.range", i32 2}
