; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %header

header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %a0 = phi ptr [ %p0, %entry ], [ %a0.next, %latch ]
  %a1 = phi ptr [ %p1, %entry ], [ %a1.next, %latch ]
  %a2 = phi ptr [ %p2, %entry ], [ %a2.next, %latch ]
