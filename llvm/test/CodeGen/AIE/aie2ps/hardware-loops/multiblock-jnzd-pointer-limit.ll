; CHECK-NEXT:    [[A1:%.*]] = phi ptr [ [[P1]], %[[ENTRY]] ], [ [[A1_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[A2:%.*]] = phi ptr [ [[P2]], %[[ENTRY]] ], [ [[A2_NEXT:%.*]], %[[LATCH]] ]
