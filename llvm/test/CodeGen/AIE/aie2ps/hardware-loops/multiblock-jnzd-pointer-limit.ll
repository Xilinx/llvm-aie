; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    store i32 [[V]], ptr [[A3]], align 4
; CHECK-NEXT:    store i32 [[V]], ptr [[A4]], align 4
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[A0_NEXT]] = getelementptr inbounds i8, ptr [[A0]], i32 4
; CHECK-NEXT:    [[A1_NEXT]] = getelementptr inbounds i8, ptr [[A1]], i32 4
