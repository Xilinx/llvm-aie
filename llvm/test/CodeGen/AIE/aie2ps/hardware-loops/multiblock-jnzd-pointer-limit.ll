  store i32 %v, ptr %a2, align 4
  br label %latch

else:
  store i32 %v, ptr %a3, align 4
  store i32 %v, ptr %a4, align 4
  br label %latch

latch:
  %a0.next = getelementptr inbounds i8, ptr %a0, i32 4
  %a1.next = getelementptr inbounds i8, ptr %a1, i32 4
  %a2.next = getelementptr inbounds i8, ptr %a2, i32 4
