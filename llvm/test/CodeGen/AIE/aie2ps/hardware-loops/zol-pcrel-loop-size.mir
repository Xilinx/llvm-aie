# RUN: llc -mtriple=aie2ps -run-pass=aie-hardware-loops \
# RUN:   --enable-aie-hardware-loops --enable-aie-zero-overhead-loops %s \
# RUN:   -verify-machineinstrs -o - | FileCheck %s

# Test the size-based selection of PC-relative vs absolute ZOL loop setup.
#
# The ZOL PC-relative offset is an unsigned 11-bit field, so the setup->LEND
# byte distance must fit in [0, 2047]. AIEBaseHardwareLoops decides this early
# (before bundling) with a conservative worst-case estimate: it assumes every
# instruction occupies its own full (maximum-size) bundle, i.e.
#   (#loop-body-instrs + LoopSetupDistance) * 16 bytes.
# With LoopSetupDistance = 7 (AIE2PS), the worst-case fits only when the loop
# body has at most ~120 instructions (127 total bundles * 16 = 2032 <= 2047).
#
# PC-relative addressing is on by default (-aie-pcrel-zol=true), so these tests
# exercise the SIZE guard, not the flag:
#   - small_loop_pcrel:      few instructions  -> SET_LS_REL_pseudo / SET_LE_REL_pseudo
#   - large_loop_absolute:   many vector stores -> MOVXM_lng_cg_ls_abs / MOVXM_lng_cg_le_abs

---
name:            small_loop_pcrel
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: small_loop_pcrel
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x50000000), %bb.3(0x30000000)
  ; CHECK-NEXT:   liveins: $p0, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r1 = MOV_RLC_imm11_pseudo 0
  ; CHECK-NEXT:   renamable $r2 = GE renamable $r1, renamable $r0
  ; CHECK-NEXT:   PseudoJNZ killed renamable $r2, %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $lc = ADD_NC_add_lc_ri $r0, 0
  ; CHECK-NEXT:   SET_LS_REL_pseudo %bb.2, implicit-def $ls, implicit $pc
  ; CHECK-NEXT:   SET_LE_REL_pseudo <mcsymbol .L_LEnd0>, implicit-def $le, implicit $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  ; CHECK-NEXT:   liveins: $p0, $wl0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
  ; CHECK-NEXT:   VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
  ; CHECK-NEXT:   VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
  ; CHECK-NEXT:   VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0.entry:
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $p0, $r0

    renamable $r1 = MOV_RLC_imm11_pseudo 0
    renamable $r2 = GE renamable $r1, renamable $r0
    PseudoJNZ killed renamable $r2, %bb.3

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $p0, $r0

    LoopStart killed renamable $r0, 0

  bb.2 (align 16):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $p0, $wl0

    VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
    VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
    VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
    VST_128_dmv_sts_w_spill $wl0, 0, implicit $sp
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.2

  bb.3 (align 16):
    PseudoRET implicit $lr
...

