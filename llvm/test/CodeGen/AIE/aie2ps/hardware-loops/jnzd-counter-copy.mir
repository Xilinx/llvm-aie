  ; CHECK-NEXT:   $r13 = MOV_OR_pseudo $r28
  ; CHECK-NEXT:   $r28 = ADDM_NC_mv_add_ri $r28, 1
  ; CHECK-NEXT:   $r28 = PseudoJNZD $r28, $p4, implicit-def $srcarry
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
