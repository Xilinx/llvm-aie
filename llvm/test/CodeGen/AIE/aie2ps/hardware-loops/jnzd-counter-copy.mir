# RUN:   %s -o - | FileCheck %s

# Register allocation left the decremented counter in $r28 and copies it back
# into the loop-carried $r13 right before the loop branch. The copy gets the
# counter from an explicit decrement, which the latch undoes before the JNZD.
# Reduced from AIESW-51543 (softmax_rows).
---
name:            counter_copy
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: counter_copy
  ; CHECK: bb.0 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $p4 = MOVXM_lng_cg %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p4, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r28 = ADDM_NC_mv_add_ri $r13, -1
  ; CHECK-NEXT:   $r13 = MOV_OR_pseudo $r28
  ; CHECK-NEXT:   $r28 = ADDM_NC_mv_add_ri $r28, 1
  ; CHECK-NEXT:   $r28 = PseudoJNZD $r28, $p4, implicit-def $srcarry
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0 (align 16):
    successors: %bb.1(0x80000000)
    liveins: $r13

    renamable $p4 = MOVXM_lng_cg %bb.1

  bb.1 (align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p4, $r13

    renamable $r28 = LoopDec $r13, implicit-def $srcarry
    $r13 = MOV_OR_pseudo $r28
    LoopJNZ killed renamable $r28, renamable $p4
    PseudoJ_jump_imm %bb.2

  bb.2 (align 16):
    PseudoRET implicit $lr
...

# A store of the decremented counter is handled the same way.
---
name:            counter_store
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: counter_store
  ; CHECK: bb.0 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $p4 = MOVXM_lng_cg %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p0, $p4, $r13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r13 = ADDM_NC_mv_add_ri killed renamable $r13, -1
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx_imm renamable $r13, renamable $p0, 0 :: (store (s32))
  ; CHECK-NEXT:   $r13 = ADDM_NC_mv_add_ri $r13, 1
  ; CHECK-NEXT:   $r13 = PseudoJNZD $r13, $p4, implicit-def $srcarry
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0 (align 16):
    successors: %bb.1(0x80000000)
    liveins: $p0, $r13

    renamable $p4 = MOVXM_lng_cg %bb.1

  bb.1 (align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p0, $p4, $r13

    renamable $r13 = LoopDec killed renamable $r13, implicit-def $srcarry
    ST_dms_sts_scalar_st_idx_imm renamable $r13, renamable $p0, 0 :: (store (s32))
    LoopJNZ renamable $r13, renamable $p4
    PseudoJ_jump_imm %bb.2

  bb.2 (align 16):
    PseudoRET implicit $lr
