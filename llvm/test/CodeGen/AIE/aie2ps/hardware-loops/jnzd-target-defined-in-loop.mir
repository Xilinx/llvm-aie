# RUN: llc -O2 -mtriple=aie2ps -verify-machineinstrs -run-pass=aie-hardware-loops %s -o - | FileCheck %s

# A JNZD target pointer defined in the loop is rebuilt every iteration, and JNZD
# has to wait for it, which leaves its delay slots empty. Such a loop falls back
# to add + JNZ, whatever defines the pointer. JNZD tests the counter before
# decrementing, JNZ after, so the preheader adds one to the counter. The
# definition is removed when nothing else needs the pointer.

---
# Rematerialized target. The preheader decrement is folded.
name:            remat_in_latch
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: remat_in_latch
  ; CHECK: bb.0 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = MOV_OR_pseudo $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 16):
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (align 16):
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.3(0x04000000)
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = ADDM_NC_mv_add_ri $r0, -1
  ; CHECK-NEXT:   PseudoJNZ $r0, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3 (align 16):
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0 (align 16):
    successors: %bb.1(0x80000000)
    liveins: $r1

    $r0 = ADDM_NC_mv_add_ri $r1, -1

  bb.1 (align 16):
    successors: %bb.2(0x80000000)
    liveins: $r0

  bb.2 (align 16):
    successors: %bb.1(0x7c000000), %bb.3(0x04000000)
    liveins: $r0

    renamable $p2 = MOVXM_lng_cg %bb.1
    renamable $r0 = LoopDec killed renamable $r0, implicit-def $srcarry
    LoopJNZ renamable $r0, killed renamable $p2
    PseudoJ_jump_imm %bb.3

  bb.3 (align 16):
    PseudoRET implicit $lr
...

