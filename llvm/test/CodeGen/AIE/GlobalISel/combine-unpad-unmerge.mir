# RUN:         -verify-machineinstrs -o - | FileCheck %s

# Tests for UNPAD/UNMERGE combiner that unifies redundant vector splitting operations

---
name:            test_unpad_dominates_unmerge
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: test_unpad_dominates_unmerge
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<16 x s32>) = COPY $x0
    ; CHECK-NEXT: [[AIE_UNPAD_VECTOR:%[0-9]+]]:_(<8 x s32>) = G_AIE_UNPAD_VECTOR [[COPY]](<16 x s32>)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<8 x s32>), [[UV1:%[0-9]+]]:_(<8 x s32>) = G_UNMERGE_VALUES [[COPY]](<16 x s32>)
    ; CHECK-NEXT: $wl0 = COPY [[AIE_UNPAD_VECTOR]](<8 x s32>)
    ; CHECK-NEXT: $wl1 = COPY [[UV]](<8 x s32>)
    ; CHECK-NEXT: $wl2 = COPY [[UV1]](<8 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $wl0, implicit $wl1, implicit $wl2
    %0:_(<16 x s32>) = COPY $x0
    %1:_(<8 x s32>) = G_AIE_UNPAD_VECTOR %0(<16 x s32>)
    %2:_(<8 x s32>), %3:_(<8 x s32>) = G_UNMERGE_VALUES %0(<16 x s32>)
    $wl0 = COPY %1(<8 x s32>)
    $wl1 = COPY %2(<8 x s32>)
    $wl2 = COPY %3(<8 x s32>)
    PseudoRET implicit $lr, implicit $wl0, implicit $wl1, implicit $wl2

...

