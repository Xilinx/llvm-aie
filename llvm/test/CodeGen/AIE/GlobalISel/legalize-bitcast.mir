name:            test_16
body:             |
  bb.1.entry:

    ; CHECK-LABEL: name: test_16
    ; CHECK: [[COPY:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL [[COPY]], [[C]](s32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 16711680
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND [[SHL]], [[C1]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(s32) = G_CONSTANT i32 255
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(s32) = G_AND [[COPY]], [[C2]]
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR [[AND1]], [[AND]]
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<2 x s16>) = G_BITCAST [[OR]](s32)
    ; CHECK-NEXT: $r0 = COPY [[BITCAST]](<2 x s16>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %4:_(s32) = COPY $r2
    %3:_(s16) = G_TRUNC %4(s32)
    %0:_(<2 x s8>) = G_BITCAST %3(s16)
    %5:_(<2 x s16>) = G_ANYEXT %0(<2 x s8>)
    $r0 = COPY %5(<2 x s16>)
    PseudoRET implicit $lr, implicit $r0
...

