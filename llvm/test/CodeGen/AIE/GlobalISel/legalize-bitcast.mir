name:            test_v2s8
body:             |
  bb.1.entry:

    ; CHECK-LABEL: name: test_v2s8
    ; CHECK: [[COPY:%[0-9]+]]:_(<2 x s16>) = COPY $r2
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(s32) = G_BITCAST [[COPY]](<2 x s16>)
    ; CHECK-NEXT: $r0 = COPY [[BITCAST]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %4:_(<2 x s16>) = COPY $r2
    %3:_(<2 x s8>) = G_TRUNC %4(<2 x s16>)
    %0:_(s16) = G_BITCAST %3(<2 x s8>)
    %5:_(s32) = G_ANYEXT %0(s16)
    $r0 = COPY %5(s32)
    PseudoRET implicit $lr, implicit $r0
...

