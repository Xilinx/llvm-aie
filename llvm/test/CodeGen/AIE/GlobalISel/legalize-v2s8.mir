    %3:_(s32) = G_CONSTANT i32 1
    %4:_(s8) = G_EXTRACT_VECTOR_ELT %2(<2 x s8>), %3(s32)
    %5:_(s32) = G_ANYEXT %4(s8)
    $r0 = COPY %5(s32)
    PseudoRET implicit $lr, implicit $r0
...

