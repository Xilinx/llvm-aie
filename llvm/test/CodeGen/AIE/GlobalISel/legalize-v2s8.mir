# A <2 x s8> keeps its two elements packed in the low half of a GPR, so the
# bitcast to and from s16 is free while splitting, building, extracting from
# and extending it are not.

---
name:            unmerge_v4s8_into_v2s8
body:             |
  bb.0:
    liveins: $r0

    ; CHECK-LABEL: name: unmerge_v4s8_into_v2s8
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<4 x s8>) = COPY $r0
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(s32) = G_BITCAST [[COPY]](<4 x s8>)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(s32) = G_LSHR [[BITCAST]], [[C]](s32)
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s16) = G_TRUNC [[BITCAST]](s32)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(<2 x s8>) = G_BITCAST [[TRUNC]](s16)
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(s16) = G_TRUNC [[LSHR]](s32)
    ; CHECK-NEXT: [[BITCAST2:%[0-9]+]]:_(<2 x s8>) = G_BITCAST [[TRUNC1]](s16)
    ; CHECK-NEXT: [[BITCAST3:%[0-9]+]]:_(s16) = G_BITCAST [[BITCAST1]](<2 x s8>)
    ; CHECK-NEXT: [[BITCAST4:%[0-9]+]]:_(s16) = G_BITCAST [[BITCAST2]](<2 x s8>)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(s32) = G_ANYEXT [[BITCAST3]](s16)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(s32) = G_ANYEXT [[BITCAST4]](s16)
    ; CHECK-NEXT: $r0 = COPY [[ANYEXT]](s32)
    ; CHECK-NEXT: $r1 = COPY [[ANYEXT1]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0, implicit $r1
    %0:_(<4 x s8>) = COPY $r0
    %1:_(<2 x s8>), %2:_(<2 x s8>) = G_UNMERGE_VALUES %0(<4 x s8>)
    %3:_(s16) = G_BITCAST %1(<2 x s8>)
    %4:_(s16) = G_BITCAST %2(<2 x s8>)
    %5:_(s32) = G_ANYEXT %3(s16)
    %6:_(s32) = G_ANYEXT %4(s16)
    $r0 = COPY %5(s32)
    $r1 = COPY %6(s32)
    PseudoRET implicit $lr, implicit $r0, implicit $r1
...

---
name:            bitcast_v2s8_to_s16
body:             |
  bb.0:
    liveins: $r0

    ; CHECK-LABEL: name: bitcast_v2s8_to_s16
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<4 x s8>) = COPY $r0
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(s32) = G_BITCAST [[COPY]](<4 x s8>)
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s16) = G_TRUNC [[BITCAST]](s32)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(<2 x s8>) = G_BITCAST [[TRUNC]](s16)
    ; CHECK-NEXT: [[BITCAST2:%[0-9]+]]:_(s16) = G_BITCAST [[BITCAST1]](<2 x s8>)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(s32) = G_ANYEXT [[BITCAST2]](s16)
    ; CHECK-NEXT: $r0 = COPY [[ANYEXT]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %0:_(<4 x s8>) = COPY $r0
    %1:_(<2 x s8>), %2:_(<2 x s8>) = G_UNMERGE_VALUES %0(<4 x s8>)
    %3:_(s16) = G_BITCAST %1(<2 x s8>)
    %4:_(s32) = G_ANYEXT %3(s16)
    $r0 = COPY %4(s32)
    PseudoRET implicit $lr, implicit $r0
...

