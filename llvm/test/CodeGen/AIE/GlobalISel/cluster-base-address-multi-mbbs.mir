    %12:_(p0) = G_PTR_ADD %InputPtr:_, %11:_(s20)
    G_STORE %2:_(s32), %12:_(p0) :: (store (s32))
    %13:_(s20) = G_CONSTANT i20 2
    %14:_(p0) = G_PTR_ADD %InputPtr:_, %13:_(s20)
    G_STORE %2:_(s32), %14:_(p0) :: (store (s32))
    G_BR %bb.3

  bb.3:
    %15:_(s20) = G_CONSTANT i20 19
    %16:_(p0) = G_PTR_ADD %InputPtr:_, %15:_(s20)
    G_STORE %2:_(s32), %16:_(p0) :: (store (s32))

...

# Ptr updated before and inside of the Loop. Updated Pointer is used after loop.

---
name:            ModInLoopAndLaterModUse
legalized: true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: ModInLoopAndLaterModUse
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $p3
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(s20) = G_CONSTANT i20 5
  ; CHECK-NEXT:   %LoopBound:_(s32) = G_CONSTANT i32 5
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C2]](s20)
  ; CHECK-NEXT:   G_STORE [[C1]](s32), [[PTR_ADD]](p0) :: (store (s32))
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   [[C4:%[0-9]+]]:_(s20) = G_CONSTANT i20 -1
  ; CHECK-NEXT:   [[PTR_ADD1:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD]], [[C4]](s20)
  ; CHECK-NEXT:   G_STORE [[C1]](s32), [[PTR_ADD1]](p0) :: (store (s32))
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %Idx:_(s32) = G_PHI %Inc(s32), %bb.1, [[C1]](s32), %bb.0
  ; CHECK-NEXT:   %InPtr:_(p0) = G_PHI %LoopPtrMod(p0), %bb.1, [[COPY]](p0), %bb.0
  ; CHECK-NEXT:   [[C5:%[0-9]+]]:_(s20) = G_CONSTANT i20 19
  ; CHECK-NEXT:   [[PTR_ADD2:%[0-9]+]]:_(p0) = G_PTR_ADD %InPtr, [[C5]](s20)
  ; CHECK-NEXT:   G_STORE [[C1]](s32), [[PTR_ADD2]](p0) :: (store (s32))
  ; CHECK-NEXT:   [[C6:%[0-9]+]]:_(s20) = G_CONSTANT i20 6
  ; CHECK-NEXT:   [[C7:%[0-9]+]]:_(s20) = G_CONSTANT i20 -13
  ; CHECK-NEXT:   %LoopPtrMod:_(p0) = G_PTR_ADD [[PTR_ADD2]], [[C7]](s20)
  ; CHECK-NEXT:   G_STORE [[C1]](s32), %LoopPtrMod(p0) :: (store (s32))
  ; CHECK-NEXT:   %Inc:_(s32) = G_ADD %Idx, [[C]]
  ; CHECK-NEXT:   %BR_SEL:_(s1) = G_ICMP intpred(sle), %Idx(s32), %LoopBound
  ; CHECK-NEXT:   G_BRCOND %BR_SEL(s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PTR_ADD3:%[0-9]+]]:_(p0) = G_PTR_ADD %LoopPtrMod, [[C2]](s20)
  ; CHECK-NEXT:   G_STORE [[C1]](s32), [[PTR_ADD3]](p0) :: (store (s32))
  ; CHECK-NEXT:   [[C8:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   [[C9:%[0-9]+]]:_(s20) = G_CONSTANT i20 -1
  ; CHECK-NEXT:   [[PTR_ADD4:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD3]], [[C9]](s20)
  ; CHECK-NEXT:   G_STORE [[C1]](s32), [[PTR_ADD4]](p0) :: (store (s32))

  bb.0.entry:
    successors: %bb.1
    liveins: $p3
    %0:_(p0) = COPY $p3
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s32) = G_CONSTANT i32 0
    %3:_(s20) = G_CONSTANT i20 5
    %LoopBound = G_CONSTANT i32 5
    %4:_(p0) = G_PTR_ADD %0:_, %3:_(s20)
    G_STORE %2:_(s32), %4:_(p0) :: (store (s32))
    %7:_(s20) = G_CONSTANT i20 4
    %8:_(p0) = G_PTR_ADD %0:_, %7:_(s20)
    G_STORE %2:_(s32), %8:_(p0) :: (store (s32))
    G_BR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    %Idx:_(s32) = G_PHI %Inc, %bb.1, %2, %bb.0
    %InPtr:_(p0) = G_PHI %LoopPtrMod, %bb.1, %0, %bb.0
    %12:_(s20) = G_CONSTANT i20 19
    %13:_(p0) = G_PTR_ADD %InPtr:_, %12:_(s20)
    G_STORE %2:_(s32), %13:_(p0) :: (store (s32))
    %14:_(s20) = G_CONSTANT i20 6
    %LoopPtrMod:_(p0) = G_PTR_ADD %InPtr:_, %14:_(s20)
    G_STORE %2:_(s32), %LoopPtrMod:_(p0) :: (store (s32))
    %Inc:_(s32) = G_ADD %Idx:_(s32), %1:_(s32)
    %BR_SEL:_(s1) = G_ICMP intpred(sle), %Idx:_(s32), %LoopBound:_(s32)
    G_BRCOND %BR_SEL, %bb.1
    G_BR %bb.2

  bb.2:
    %16:_(p0) = G_PTR_ADD %LoopPtrMod:_, %3:_(s20)
    G_STORE %2:_(s32), %16:_(p0) :: (store (s32))
    %17:_(s20) = G_CONSTANT i20 4
    %18:_(p0) = G_PTR_ADD %LoopPtrMod:_, %17:_(s20)
    G_STORE %2:_(s32), %18:_(p0) :: (store (s32))

...

