# Insert PHI nodes to collect the original pointer and the updated path.
#
#        Def InputPtr + Mod
#        /         \
# InputPtr mod    InputPtr mod
#         \       /
#      orig Inputptr Use
---
name:            DivergingModifications
legalized: true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: DivergingModifications
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $p3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %InputPtr:_(p0) = COPY $p3
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY $r0
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD %InputPtr, [[C1]](s20)
  ; CHECK-NEXT:   G_STORE [[C]](s32), [[PTR_ADD]](p0) :: (store (s32))
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(s20) = G_CONSTANT i20 2
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(s20) = G_CONSTANT i20 -2
  ; CHECK-NEXT:   [[PTR_ADD1:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD]], [[C3]](s20)
  ; CHECK-NEXT:   G_STORE [[C]](s32), [[PTR_ADD1]](p0) :: (store (s32))
  ; CHECK-NEXT:   G_BRCOND [[COPY]](s32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C4:%[0-9]+]]:_(s20) = G_CONSTANT i20 5
  ; CHECK-NEXT:   [[C5:%[0-9]+]]:_(s20) = G_CONSTANT i20 3
  ; CHECK-NEXT:   [[PTR_ADD2:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD1]], [[C5]](s20)
  ; CHECK-NEXT:   G_STORE [[C]](s32), [[PTR_ADD2]](p0) :: (store (s32))
  ; CHECK-NEXT:   [[C6:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   [[C7:%[0-9]+]]:_(s20) = G_CONSTANT i20 -1
  ; CHECK-NEXT:   [[PTR_ADD3:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD2]], [[C7]](s20)
  ; CHECK-NEXT:   G_STORE [[C]](s32), [[PTR_ADD3]](p0) :: (store (s32))
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C8:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   [[C9:%[0-9]+]]:_(s20) = G_CONSTANT i20 2
  ; CHECK-NEXT:   [[PTR_ADD4:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD1]], [[C9]](s20)
  ; CHECK-NEXT:   G_STORE [[C]](s32), [[PTR_ADD4]](p0) :: (store (s32))
  ; CHECK-NEXT:   [[C10:%[0-9]+]]:_(s20) = G_CONSTANT i20 2
  ; CHECK-NEXT:   [[C11:%[0-9]+]]:_(s20) = G_CONSTANT i20 -2
  ; CHECK-NEXT:   [[PTR_ADD5:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD4]], [[C11]](s20)
  ; CHECK-NEXT:   G_STORE [[C]](s32), [[PTR_ADD5]](p0) :: (store (s32))
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[C12:%[0-9]+]]:_(s20) = G_CONSTANT i20 19
  ; CHECK-NEXT:   [[C13:%[0-9]+]]:_(s20) = G_CONSTANT i20 17
  ; CHECK-NEXT:   [[PTR_ADD6:%[0-9]+]]:_(p0) = G_PTR_ADD [[PTR_ADD1]], [[C13]](s20)
  ; CHECK-NEXT:   G_STORE [[C]](s32), [[PTR_ADD6]](p0) :: (store (s32))

  bb.0:
    successors: %bb.2, %bb.1
    liveins: $r0, $p3
    %InputPtr:_(p0) = COPY $p3
    %1:_(s32) = COPY $r0
    %2:_(s32) = G_CONSTANT i32 0
    %3:_(s20) = G_CONSTANT i20 4
    %4:_(p0) = G_PTR_ADD %InputPtr:_, %3:_(s20)
    G_STORE %2:_(s32), %4:_(p0) :: (store (s32))
    %5:_(s20) = G_CONSTANT i20 2
    %6:_(p0) = G_PTR_ADD %InputPtr:_, %5:_(s20)
    G_STORE %2:_(s32), %6:_(p0) :: (store (s32))
    G_BRCOND %1:_(s32), %bb.2
    G_BR %bb.1

  bb.1:
    successors: %bb.3
    %7:_(s20) = G_CONSTANT i20 5
    %8:_(p0) = G_PTR_ADD %InputPtr:_, %7:_(s20)
    G_STORE %2:_(s32), %8:_(p0) :: (store (s32))
    %9:_(s20) = G_CONSTANT i20 4
    %10:_(p0) = G_PTR_ADD %InputPtr:_, %9:_(s20)
    G_STORE %2:_(s32), %10:_(p0) :: (store (s32))
