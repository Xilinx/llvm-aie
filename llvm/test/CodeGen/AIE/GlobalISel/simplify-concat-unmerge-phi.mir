  ; COMMON-NEXT:   [[PHI1:%[0-9]+]]:_(<16 x s32>) = G_PHI [[DEF1]](<16 x s32>), %bb.0, %6(<16 x s32>), %bb.1
  ; COMMON-NEXT:   [[CONCAT_VECTORS:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[PHI]](<16 x s32>), [[PHI1]](<16 x s32>)
  ; COMMON-NEXT:   G_STORE [[CONCAT_VECTORS]](<32 x s32>), %ptr(p0) :: (store (<32 x s32>))
  ; COMMON-NEXT:   [[DEF2:%[0-9]+]]:_(<16 x s32>) = G_IMPLICIT_DEF
  ; COMMON-NEXT:   [[INT:%[0-9]+]]:_(s1) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.loop.decrement), [[C]](s32)
  ; COMMON-NEXT:   G_BRCOND [[INT]](s1), %bb.1
