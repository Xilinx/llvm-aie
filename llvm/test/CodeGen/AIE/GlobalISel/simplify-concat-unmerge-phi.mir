    %2:_(s32) = G_CONSTANT i32 1
    %3:_(<16 x s32>) = G_IMPLICIT_DEF
    %4:_(<16 x s32>) = G_IMPLICIT_DEF
    G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.set.loop.iterations), %0(s32)

  bb.1:

    %7:_(<16 x s32>) = G_PHI %3(<16 x s32>), %bb.0, %8(<16 x s32>), %bb.1
