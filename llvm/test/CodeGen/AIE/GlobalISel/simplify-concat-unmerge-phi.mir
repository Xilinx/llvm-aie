name:            ThreeMBBPHIMultipleDominatingMBBs
alignment:       16
tracksRegLiveness: true
body:             |
  ; COMMON-LABEL: name: ThreeMBBPHIMultipleDominatingMBBs
  ; COMMON: bb.0:
  ; COMMON-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; COMMON-NEXT:   liveins: $p0, $p1, $p2, $r0
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $p0
  ; COMMON-NEXT:   [[COPY1:%[0-9]+]]:_(s32) = COPY $r0
  ; COMMON-NEXT:   [[DEF:%[0-9]+]]:_(<16 x s32>) = G_IMPLICIT_DEF
  ; COMMON-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; COMMON-NEXT:   [[XOR:%[0-9]+]]:_(s32) = G_XOR [[COPY1]], [[C]]
  ; COMMON-NEXT:   G_BRCOND [[XOR]](s32), %bb.2
  ; COMMON-NEXT:   G_BR %bb.1
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT: bb.1:
  ; COMMON-NEXT:   successors: %bb.2(0x80000000)
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT:   [[DEF1:%[0-9]+]]:_(<16 x s32>) = G_IMPLICIT_DEF
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT: bb.2:
  ; COMMON-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT:   [[PHI:%[0-9]+]]:_(<16 x s32>) = G_PHI [[DEF]](<16 x s32>), %bb.0, [[DEF1]](<16 x s32>), %bb.1, %9(<16 x s32>), %bb.2
  ; COMMON-NEXT:   [[PHI1:%[0-9]+]]:_(<16 x s32>) = G_PHI [[DEF]](<16 x s32>), %bb.0, [[DEF1]](<16 x s32>), %bb.1, %9(<16 x s32>), %bb.2
  ; COMMON-NEXT:   [[CONCAT_VECTORS:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[PHI1]](<16 x s32>), [[PHI]](<16 x s32>)
  ; COMMON-NEXT:   G_STORE [[CONCAT_VECTORS]](<32 x s32>), [[COPY]](p0) :: (store (<32 x s32>))
  ; COMMON-NEXT:   [[DEF2:%[0-9]+]]:_(<16 x s32>) = G_IMPLICIT_DEF
  ; COMMON-NEXT:   G_BRCOND [[COPY1]](s32), %bb.2
  ; COMMON-NEXT:   G_BR %bb.3
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT: bb.3:
  ; COMMON-NEXT:   PseudoRET implicit $lr
  bb.0:
    liveins: $p0, $p1, $p2, $r0

    %0:_(p0) = COPY $p0
    %1:_(s32) = COPY $r0
    %2:_(<32 x s32>) = G_IMPLICIT_DEF
    %3:_(<16 x s32>), %4:_(<16 x s32>) = G_UNMERGE_VALUES %2(<32 x s32>)
    G_BRCOND %1(s32), %bb.1
    G_BR %bb.2

  bb.1:
    %12:_(<32 x s32>) = G_IMPLICIT_DEF
    %13:_(<16 x s32>), %14:_(<16 x s32>) = G_UNMERGE_VALUES %12(<32 x s32>)

  bb.2:
    %5:_(<16 x s32>) = G_PHI %3(<16 x s32>), %bb.0, %13(<16 x s32>), %bb.1, %16(<16 x s32>), %bb.2
    %6:_(<16 x s32>) = G_PHI %4(<16 x s32>), %bb.0, %14(<16 x s32>), %bb.1, %17(<16 x s32>), %bb.2
    %35:_(<32 x s32>) = G_CONCAT_VECTORS %6(<16 x s32>), %5(<16 x s32>)
    G_STORE %35(<32 x s32>), %0(p0) :: (store (<32 x s32>))
    %15:_(<32 x s32>) = G_IMPLICIT_DEF
    %16:_(<16 x s32>), %17:_(<16 x s32>) = G_UNMERGE_VALUES %15(<32 x s32>)
    G_BRCOND %1(s32), %bb.2
    G_BR %bb.3

  bb.3:
    PseudoRET implicit $lr

...
