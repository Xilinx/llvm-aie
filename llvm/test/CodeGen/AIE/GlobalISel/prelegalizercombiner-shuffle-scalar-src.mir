# Test scalar source in second operand position (splat index > 0).
# When both sources are scalar and we splat from the second one.
---
name: shuffle_vector_second_src_scalar
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $l0, $l1

    ; CHECK-LABEL: name: shuffle_vector_second_src_scalar
    ; CHECK: liveins: $l0, $l1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s64) = COPY $l1
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<2 x s32>) = G_BITCAST [[COPY]](s64)
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<8 x s64>) = G_AIE_BROADCAST_VECTOR [[BITCAST]](<2 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[AIE_BROADCAST_VECTOR]](<8 x s64>)
    %0:_(s64) = COPY $l0
    %1:_(s64) = COPY $l1
    %2:_(<8 x s64>) = G_SHUFFLE_VECTOR %0(s64), %1, shufflemask(1, 1, 1, 1, 1, 1, 1, 1)
    PseudoRET implicit $lr, implicit %2
...
