    %1:_(s32) = G_CONSTANT i32 77
    %2:_(s32) = G_CONSTANT i32 68
    %3:_(s32) = G_CONSTANT i32 33
    %4:_(<4 x s32>) = G_BUILD_VECTOR %0(s32), %1(s32), %2(s32), %3(s32)
    %5:_(s32) = G_CONSTANT i32 2
    %6:_(s32) = G_EXTRACT_VECTOR_ELT %4(<4 x s32>), %5(s32)
    $r0 = COPY %6(s32)
