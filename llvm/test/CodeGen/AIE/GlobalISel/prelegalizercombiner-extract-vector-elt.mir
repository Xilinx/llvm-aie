    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<64 x s8>), [[UV1:%[0-9]+]]:_(<64 x s8>) = G_UNMERGE_VALUES [[COPY]](<128 x s8>)
    ; CHECK-NEXT: [[AIE_ZEXT_EXTRACT_VECTOR_ELT:%[0-9]+]]:_(s32) = G_AIE_ZEXT_EXTRACT_VECTOR_ELT [[UV]](<64 x s8>), [[C]](s32)
    ; CHECK-NEXT: $r0 = COPY [[AIE_ZEXT_EXTRACT_VECTOR_ELT]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %0:_(<128 x s8>) = COPY $y2
    %1:_(s32) = G_CONSTANT i32 1
    %3:_(s32) = G_AIE_ZEXT_EXTRACT_VECTOR_ELT %0(<128 x s8>), %1(s32)
    $r0 = COPY %3(s32)
    PseudoRET implicit $lr, implicit $r0

...
