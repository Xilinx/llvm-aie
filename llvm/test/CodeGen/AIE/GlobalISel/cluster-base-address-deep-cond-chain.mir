# RUN: llc -mtriple aie2 -run-pass=aie-cluster-base-address %s -verify-machineinstrs -o - | FileCheck %s

# Regression test: a deep use-def chain where each G_MUL uses its input twice
# (DAG fan-in) feeding a conditional branch. Without the visited-set fix in
# findLoadsFeedingInstr this would enumerate 2^depth paths and time out.
---
name:            deep_cond_chain
legalized: true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: deep_cond_chain
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $p0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $p0
  ; CHECK-NEXT:   %off4:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   %off8:_(s20) = G_CONSTANT i20 8
  ; CHECK-NEXT:   %off12:_(s20) = G_CONSTANT i20 12
  ; CHECK-NEXT:   %ptr4:_(p0) = nuw G_PTR_ADD [[COPY]], %off4(s20)
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   %ptr8:_(p0) = nuw G_PTR_ADD %ptr4, [[C]](s20)
  ; CHECK-NEXT:   %ld4:_(s32) = G_LOAD %ptr4(p0) :: (dereferenceable load (s32))
  ; CHECK-NEXT:   %ld8:_(s32) = G_LOAD %ptr8(p0) :: (dereferenceable load (s32))
  ; CHECK-NEXT:   %ptr12:_(p0) = nuw G_PTR_ADD [[COPY]], %off12(s20)
  ; CHECK-NEXT:   %v0:_(s32) = G_LOAD %ptr12(p0) :: (dereferenceable load (s32))
  ; CHECK-NEXT:   %v1:_(s32) = G_MUL %v0, %v0
  ; CHECK-NEXT:   %v2:_(s32) = G_MUL %v1, %v1
  ; CHECK-NEXT:   %v3:_(s32) = G_MUL %v2, %v2
  ; CHECK-NEXT:   %v4:_(s32) = G_MUL %v3, %v3
  ; CHECK-NEXT:   %v5:_(s32) = G_MUL %v4, %v4
  ; CHECK-NEXT:   %v6:_(s32) = G_MUL %v5, %v5
  ; CHECK-NEXT:   %v7:_(s32) = G_MUL %v6, %v6
  ; CHECK-NEXT:   %v8:_(s32) = G_MUL %v7, %v7
  ; CHECK-NEXT:   %v9:_(s32) = G_MUL %v8, %v8
  ; CHECK-NEXT:   %v10:_(s32) = G_MUL %v9, %v9
  ; CHECK-NEXT:   %v11:_(s32) = G_MUL %v10, %v10
  ; CHECK-NEXT:   %v12:_(s32) = G_MUL %v11, %v11
  ; CHECK-NEXT:   %v13:_(s32) = G_MUL %v12, %v12
  ; CHECK-NEXT:   %v14:_(s32) = G_MUL %v13, %v13
  ; CHECK-NEXT:   %v15:_(s32) = G_MUL %v14, %v14
  ; CHECK-NEXT:   %v16:_(s32) = G_MUL %v15, %v15
  ; CHECK-NEXT:   %v17:_(s32) = G_MUL %v16, %v16
  ; CHECK-NEXT:   %v18:_(s32) = G_MUL %v17, %v17
  ; CHECK-NEXT:   %v19:_(s32) = G_MUL %v18, %v18
  ; CHECK-NEXT:   %v20:_(s32) = G_MUL %v19, %v19
  ; CHECK-NEXT:   %v21:_(s32) = G_MUL %v20, %v20
  ; CHECK-NEXT:   %v22:_(s32) = G_MUL %v21, %v21
  ; CHECK-NEXT:   %v23:_(s32) = G_MUL %v22, %v22
  ; CHECK-NEXT:   %v24:_(s32) = G_MUL %v23, %v23
  ; CHECK-NEXT:   %v25:_(s32) = G_MUL %v24, %v24
  ; CHECK-NEXT:   %v26:_(s32) = G_MUL %v25, %v25
  ; CHECK-NEXT:   %v27:_(s32) = G_MUL %v26, %v26
  ; CHECK-NEXT:   %v28:_(s32) = G_MUL %v27, %v27
  ; CHECK-NEXT:   %zero:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   %cmp:_(s1) = G_ICMP intpred(sle), %v28(s32), %zero
  ; CHECK-NEXT:   G_BRCOND %cmp(s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit %ld4(s32), implicit %ld8(s32)
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $p0

    %0:_(p0) = COPY $p0

    ; Two G_PTR_ADDs sharing the same base to trigger collectPtrUses.
    %off4:_(s20) = G_CONSTANT i20 4
    %off8:_(s20) = G_CONSTANT i20 8
    %off12:_(s20) = G_CONSTANT i20 12
    %ptr4:_(p0) = nuw G_PTR_ADD %0, %off4(s20)
    %ptr8:_(p0) = nuw G_PTR_ADD %0, %off8(s20)
    %ld4:_(s32) = G_LOAD %ptr4(p0) :: (dereferenceable load (s32))
    %ld8:_(s32) = G_LOAD %ptr8(p0) :: (dereferenceable load (s32))

    ; The load whose result feeds a deep chain ending at a conditional branch.
    %ptr12:_(p0) = nuw G_PTR_ADD %0, %off12(s20)
    %v0:_(s32) = G_LOAD %ptr12(p0) :: (dereferenceable load (s32))

    ; 28-step chain: each G_MUL uses the same register for both operands,
    ; creating a DAG where every node has fan-in 2 when walked bottom-up.
    %v1:_(s32) = G_MUL %v0, %v0
    %v2:_(s32) = G_MUL %v1, %v1
    %v3:_(s32) = G_MUL %v2, %v2
    %v4:_(s32) = G_MUL %v3, %v3
    %v5:_(s32) = G_MUL %v4, %v4
    %v6:_(s32) = G_MUL %v5, %v5
    %v7:_(s32) = G_MUL %v6, %v6
    %v8:_(s32) = G_MUL %v7, %v7
    %v9:_(s32) = G_MUL %v8, %v8
    %v10:_(s32) = G_MUL %v9, %v9
    %v11:_(s32) = G_MUL %v10, %v10
    %v12:_(s32) = G_MUL %v11, %v11
    %v13:_(s32) = G_MUL %v12, %v12
    %v14:_(s32) = G_MUL %v13, %v13
    %v15:_(s32) = G_MUL %v14, %v14
    %v16:_(s32) = G_MUL %v15, %v15
    %v17:_(s32) = G_MUL %v16, %v16
    %v18:_(s32) = G_MUL %v17, %v17
    %v19:_(s32) = G_MUL %v18, %v18
    %v20:_(s32) = G_MUL %v19, %v19
    %v21:_(s32) = G_MUL %v20, %v20
    %v22:_(s32) = G_MUL %v21, %v21
    %v23:_(s32) = G_MUL %v22, %v22
    %v24:_(s32) = G_MUL %v23, %v23
    %v25:_(s32) = G_MUL %v24, %v24
    %v26:_(s32) = G_MUL %v25, %v25
    %v27:_(s32) = G_MUL %v26, %v26
    %v28:_(s32) = G_MUL %v27, %v27

    %zero:_(s32) = G_CONSTANT i32 0
    %cmp:_(s1) = G_ICMP intpred(sle), %v28(s32), %zero
    G_BRCOND %cmp(s1), %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.2(0x80000000)

    G_BR %bb.2

  bb.2:
    PseudoRET implicit $lr, implicit %ld4(s32), implicit %ld8(s32)
...
