    ; COMBINE-NEXT: %p1:_(p0) = G_PTR_ADD %p, %off1(s20)
    ; COMBINE-NEXT: %off2:_(s20) = G_CONSTANT i20 4
    ; COMBINE-NEXT: %v1:_(s32), %p2:_(p0) = G_AIE_POSTINC_LOAD %p1, %off2(s20) :: (load (s32))
    ; COMBINE-NEXT: %v2:_(s32) = G_LOAD %p2(p0) :: (load (s32))
    ; COMBINE-NEXT: %off3:_(s20) = G_CONSTANT i20 4
    ; COMBINE-NEXT: %v3:_(s32) = G_AIE_OFFSET_LOAD %p2(p0), %off3(s20) :: (load (s32))
    ; COMBINE-NEXT: %sum1:_(s32) = G_ADD %v1, %v2
    ; COMBINE-NEXT: %sum2:_(s32) = G_ADD %sum1, %v3
    ; COMBINE-NEXT: PseudoRET implicit $lr, implicit %sum2(s32)
    ;
    ; ISEL-LABEL: name: keep-postinc-not-a-loop
    ; ISEL: liveins: $p0
    ; ISEL-NEXT: {{  $}}
    ; ISEL-NEXT: %p:ep = COPY $p0
    ; ISEL-NEXT: %off1:em = MOV_PD_imm11_pseudo 4
    ; ISEL-NEXT: %p1:ep = PADD_mod_pseudo %p, %off1
    ; ISEL-NEXT: %v1:mlockid_reg, %p2:ep = LDA_dms_lda_scalar_ld_pstm_nrm_imm %p1, 4 :: (load (s32))
    ; ISEL-NEXT: %v2:mlockid_reg = LDA_dms_lda_scalar_ld_idx_imm %p2, 0 :: (load (s32))
    ; ISEL-NEXT: %v3:mlockid_reg = LDA_dms_lda_scalar_ld_idx_imm %p2, 4 :: (load (s32))
    ; ISEL-NEXT: %sum1:mlockid_reg = ADD_alu_r_rr %v1, %v2, implicit-def dead $srcarry
    ; ISEL-NEXT: %sum2:mlockid_reg = ADD_alu_r_rr %sum1, %v3, implicit-def dead $srcarry
    ; ISEL-NEXT: PseudoRET implicit $lr, implicit %sum2
    %p:_(p0) = COPY $p0
    %off1:_(s20) = G_CONSTANT i20 4
    %p1:_(p0) = G_PTR_ADD %p(p0), %off1(s20)
    %v1:_(s32) = G_LOAD %p1(p0) :: (load (s32))
    %off2:_(s20) = G_CONSTANT i20 4
    %p2:_(p0) = G_PTR_ADD %p1(p0), %off2(s20)
    %v2:_(s32) = G_LOAD %p2(p0) :: (load (s32))
    %off3:_(s20) = G_CONSTANT i20 4
    %p3:_(p0) = G_PTR_ADD %p2(p0), %off3(s20)
    %v3:_(s32) = G_LOAD %p3(p0) :: (load (s32))
    %sum1:_(s32) = G_ADD %v1, %v2
    %sum2:_(s32) = G_ADD %sum1, %v3
    PseudoRET implicit $lr, implicit %sum2(s32)
...

# ---------------------------------------------------------------------
# Keep post-increments: the increment still encodes as a post-increment, but
# the displacement flattened back to the root (36) is outside the offset
# range for an s32 access, so the load cannot be rebased.
# ---------------------------------------------------------------------
---
name:            keep-postinc-flattened-offset-too-large
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  ; COMBINE-LABEL: name: keep-postinc-flattened-offset-too-large
  ; COMBINE: bb.0:
  ; COMBINE-NEXT:   successors: %bb.1(0x80000000)
  ; COMBINE-NEXT:   liveins: $p0, $r0
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT:   %base:_(p0) = COPY $p0
  ; COMBINE-NEXT:   %n:_(s32) = COPY $r0
  ; COMBINE-NEXT:   %zero:_(s32) = G_CONSTANT i32 0
  ; COMBINE-NEXT:   %minus1:_(s32) = G_CONSTANT i32 -1
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT: bb.1:
  ; COMBINE-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT:   %p:_(p0) = G_PHI %base(p0), %bb.0, %next(p0), %bb.1
  ; COMBINE-NEXT:   %i:_(s32) = G_PHI %n(s32), %bb.0, %inext(s32), %bb.1
  ; COMBINE-NEXT:   %off1:_(s20) = G_CONSTANT i20 36
  ; COMBINE-NEXT:   %p1:_(p0) = G_PTR_ADD %p, %off1(s20)
  ; COMBINE-NEXT:   %off2:_(s20) = G_CONSTANT i20 4
  ; COMBINE-NEXT:   %v1:_(s32), %p2:_(p0) = G_AIE_POSTINC_LOAD %p1, %off2(s20) :: (load (s32))
  ; COMBINE-NEXT:   %v2:_(s32) = G_LOAD %p2(p0) :: (load (s32))
  ; COMBINE-NEXT:   %off3:_(s20) = G_CONSTANT i20 4
  ; COMBINE-NEXT:   %v3:_(s32) = G_AIE_OFFSET_LOAD %p2(p0), %off3(s20) :: (load (s32))
  ; COMBINE-NEXT:   %d0:_(s20) = G_CONSTANT i20 1
  ; COMBINE-NEXT:   %d1:_(s20) = G_CONSTANT i20 2
  ; COMBINE-NEXT:   %d2:_(s20) = G_CONSTANT i20 3
  ; COMBINE-NEXT:   %d3:_(s20) = G_CONSTANT i20 4
  ; COMBINE-NEXT:   %next:_(p0), %mod:_(s20) = G_INTRINSIC intrinsic(@llvm.aie2ps.add.2d), %p(p0), %d0(s20), %d1(s20), %d2(s20), %d3(s20)
  ; COMBINE-NEXT:   %inext:_(s32) = G_ADD %i, %minus1
  ; COMBINE-NEXT:   %cond:_(s32) = G_ICMP intpred(sgt), %inext(s32), %zero
  ; COMBINE-NEXT:   G_BRCOND %cond(s32), %bb.1
  ; COMBINE-NEXT:   G_BR %bb.2
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT: bb.2:
  ; COMBINE-NEXT:   %sum1:_(s32) = G_ADD %v1, %v2
  ; COMBINE-NEXT:   %sum2:_(s32) = G_ADD %sum1, %v3
  ; COMBINE-NEXT:   PseudoRET implicit $lr, implicit %sum2(s32)
  ;
  ; ISEL-LABEL: name: keep-postinc-flattened-offset-too-large
  ; ISEL: bb.0:
  ; ISEL-NEXT:   successors: %bb.1(0x80000000)
  ; ISEL-NEXT:   liveins: $p0, $r0
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT:   %base:ep = COPY $p0
  ; ISEL-NEXT:   %n:er = COPY $r0
  ; ISEL-NEXT:   %zero:mlockid_reg = MOV_RLC_imm11_pseudo 0
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT: bb.1:
  ; ISEL-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT:   %p:ep = PHI %base, %bb.0, %next, %bb.1
  ; ISEL-NEXT:   %i:mlockid_reg = PHI %n, %bb.0, %inext, %bb.1
  ; ISEL-NEXT:   %off1:em = MOV_PD_imm11_pseudo 36
  ; ISEL-NEXT:   %p1:ep = PADD_mod_pseudo %p, %off1
  ; ISEL-NEXT:   %v1:mlockid_reg, %p2:ep = LDA_dms_lda_scalar_ld_pstm_nrm_imm %p1, 4 :: (load (s32))
  ; ISEL-NEXT:   %v2:mlockid_reg = LDA_dms_lda_scalar_ld_idx_imm %p2, 0 :: (load (s32))
  ; ISEL-NEXT:   %v3:mlockid_reg = LDA_dms_lda_scalar_ld_idx_imm %p2, 4 :: (load (s32))
  ; ISEL-NEXT:   %d0:em = MOV_PD_imm11_pseudo 1
  ; ISEL-NEXT:   %d1:edj = MOV_PD_imm11_pseudo 2
  ; ISEL-NEXT:   %d2:edn = MOV_PD_imm11_pseudo 3
  ; ISEL-NEXT:   %d3:edc = MOV_PD_imm11_pseudo 4
  ; ISEL-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:ed = REG_SEQUENCE %d0, %subreg.sub_mod, %d2, %subreg.sub_dim_size, %d1, %subreg.sub_dim_stride, %d3, %subreg.sub_dim_count
  ; ISEL-NEXT:   %next:ep, %mod:edc = PADD_2D_pseudo %p, [[REG_SEQUENCE]]
  ; ISEL-NEXT:   %inext:mlockid_reg = ADD_add_r_ri %i, -1, implicit-def dead $srcarry
  ; ISEL-NEXT:   %cond:mlockid_reg = LT %zero, %inext
  ; ISEL-NEXT:   PseudoJNZ %cond, %bb.1
  ; ISEL-NEXT:   PseudoJ_jump_imm %bb.2
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT: bb.2:
  ; ISEL-NEXT:   %sum1:mlockid_reg = ADD_alu_r_rr %v1, %v2, implicit-def dead $srcarry
  ; ISEL-NEXT:   %sum2:mlockid_reg = ADD_alu_r_rr %sum1, %v3, implicit-def dead $srcarry
  ; ISEL-NEXT:   PseudoRET implicit $lr, implicit %sum2
  bb.0:
    liveins: $p0, $r0
    %base:_(p0) = COPY $p0
    %n:_(s32) = COPY $r0
    %zero:_(s32) = G_CONSTANT i32 0
    %minus1:_(s32) = G_CONSTANT i32 -1

  bb.1:
    %p:_(p0) = G_PHI %base(p0), %bb.0, %next(p0), %bb.1
    %i:_(s32) = G_PHI %n(s32), %bb.0, %inext(s32), %bb.1
    %off1:_(s20) = G_CONSTANT i20 36
    %p1:_(p0) = G_PTR_ADD %p(p0), %off1(s20)
    %v1:_(s32) = G_LOAD %p1(p0) :: (load (s32))
    %off2:_(s20) = G_CONSTANT i20 4
    %p2:_(p0) = G_PTR_ADD %p1(p0), %off2(s20)
    %v2:_(s32) = G_LOAD %p2(p0) :: (load (s32))
    %off3:_(s20) = G_CONSTANT i20 4
    %p3:_(p0) = G_PTR_ADD %p2(p0), %off3(s20)
    %v3:_(s32) = G_LOAD %p3(p0) :: (load (s32))
    %d0:_(s20) = G_CONSTANT i20 1
    %d1:_(s20) = G_CONSTANT i20 2
    %d2:_(s20) = G_CONSTANT i20 3
    %d3:_(s20) = G_CONSTANT i20 4
    %next:_(p0), %mod:_(s20) = G_INTRINSIC intrinsic(@llvm.aie2ps.add.2d), %p(p0), %d0(s20), %d1(s20), %d2(s20), %d3(s20)
    %inext:_(s32) = G_ADD %i, %minus1
    %cond:_(s32) = G_ICMP intpred(sgt), %inext(s32), %zero
    G_BRCOND %cond(s32), %bb.1
    G_BR %bb.2

  bb.2:
    %sum1:_(s32) = G_ADD %v1, %v2
    %sum2:_(s32) = G_ADD %sum1, %v3
    PseudoRET implicit $lr, implicit %sum2(s32)
...

# ---------------------------------------------------------------------
# Prefer offset loads: Same G_PTR_ADD advance as keep_post_increments_ptr_add_variant_stride, but the stride is
# computed in the preheader. Folding the advance into an access then costs
# nothing, because the stride is already available on loop entry.
# ---------------------------------------------------------------------
---
name:            prefer_post_increments_ptr_add_invariant_stride
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  ; COMBINE-LABEL: name: prefer_post_increments_ptr_add_invariant_stride
  ; COMBINE: bb.0:
  ; COMBINE-NEXT:   successors: %bb.1(0x80000000)
  ; COMBINE-NEXT:   liveins: $p0, $r0
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT:   %base:_(p0) = COPY $p0
  ; COMBINE-NEXT:   %n:_(s32) = COPY $r0
  ; COMBINE-NEXT:   %zero:_(s32) = G_CONSTANT i32 0
  ; COMBINE-NEXT:   %minus1:_(s32) = G_CONSTANT i32 -1
  ; COMBINE-NEXT:   %stride:_(s20) = G_TRUNC %n(s32)
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT: bb.1:
  ; COMBINE-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT:   %p:_(p0) = G_PHI %base(p0), %bb.0, %next(p0), %bb.1
  ; COMBINE-NEXT:   %i:_(s32) = G_PHI %n(s32), %bb.0, %inext(s32), %bb.1
  ; COMBINE-NEXT:   %off1:_(s20) = G_CONSTANT i20 4
  ; COMBINE-NEXT:   %p1:_(p0) = G_PTR_ADD %p, %off1(s20)
  ; COMBINE-NEXT:   %off2:_(s20) = G_CONSTANT i20 4
  ; COMBINE-NEXT:   %v1:_(s32), %p2:_(p0) = G_AIE_POSTINC_LOAD %p1, %off2(s20) :: (load (s32))
  ; COMBINE-NEXT:   %v2:_(s32) = G_LOAD %p2(p0) :: (load (s32))
  ; COMBINE-NEXT:   %off3:_(s20) = G_CONSTANT i20 4
  ; COMBINE-NEXT:   %v3:_(s32) = G_AIE_OFFSET_LOAD %p2(p0), %off3(s20) :: (load (s32))
  ; COMBINE-NEXT:   %next:_(p0) = G_PTR_ADD %p, %stride(s20)
  ; COMBINE-NEXT:   %inext:_(s32) = G_ADD %i, %minus1
  ; COMBINE-NEXT:   %cond:_(s32) = G_ICMP intpred(sgt), %inext(s32), %zero
  ; COMBINE-NEXT:   G_BRCOND %cond(s32), %bb.1
  ; COMBINE-NEXT:   G_BR %bb.2
  ; COMBINE-NEXT: {{  $}}
  ; COMBINE-NEXT: bb.2:
  ; COMBINE-NEXT:   %sum1:_(s32) = G_ADD %v1, %v2
  ; COMBINE-NEXT:   %sum2:_(s32) = G_ADD %sum1, %v3
  ; COMBINE-NEXT:   PseudoRET implicit $lr, implicit %sum2(s32)
  ;
  ; ISEL-LABEL: name: prefer_post_increments_ptr_add_invariant_stride
  ; ISEL: bb.0:
  ; ISEL-NEXT:   successors: %bb.1(0x80000000)
  ; ISEL-NEXT:   liveins: $p0, $r0
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT:   %base:ep = COPY $p0
  ; ISEL-NEXT:   %n:er = COPY $r0
  ; ISEL-NEXT:   %zero:mlockid_reg = MOV_RLC_imm11_pseudo 0
  ; ISEL-NEXT:   %stride:em = COPY %n
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT: bb.1:
  ; ISEL-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT:   %p:ep = PHI %base, %bb.0, %next, %bb.1
  ; ISEL-NEXT:   %i:mlockid_reg = PHI %n, %bb.0, %inext, %bb.1
  ; ISEL-NEXT:   %off1:em = MOV_PD_imm11_pseudo 4
  ; ISEL-NEXT:   %p1:ep = PADD_mod_pseudo %p, %off1
  ; ISEL-NEXT:   %v1:mlockid_reg, %p2:ep = LDA_dms_lda_scalar_ld_pstm_nrm_imm %p1, 4 :: (load (s32))
  ; ISEL-NEXT:   %v2:mlockid_reg = LDA_dms_lda_scalar_ld_idx_imm %p2, 0 :: (load (s32))
  ; ISEL-NEXT:   %v3:mlockid_reg = LDA_dms_lda_scalar_ld_idx_imm %p2, 4 :: (load (s32))
  ; ISEL-NEXT:   %next:ep = PADD_mod_pseudo %p, %stride
  ; ISEL-NEXT:   %inext:mlockid_reg = ADD_add_r_ri %i, -1, implicit-def dead $srcarry
  ; ISEL-NEXT:   %cond:mlockid_reg = LT %zero, %inext
  ; ISEL-NEXT:   PseudoJNZ %cond, %bb.1
  ; ISEL-NEXT:   PseudoJ_jump_imm %bb.2
  ; ISEL-NEXT: {{  $}}
  ; ISEL-NEXT: bb.2:
  ; ISEL-NEXT:   %sum1:mlockid_reg = ADD_alu_r_rr %v1, %v2, implicit-def dead $srcarry
  ; ISEL-NEXT:   %sum2:mlockid_reg = ADD_alu_r_rr %sum1, %v3, implicit-def dead $srcarry
  ; ISEL-NEXT:   PseudoRET implicit $lr, implicit %sum2
  bb.0:
    liveins: $p0, $r0
    %base:_(p0) = COPY $p0
    %n:_(s32) = COPY $r0
    %zero:_(s32) = G_CONSTANT i32 0
    %minus1:_(s32) = G_CONSTANT i32 -1
    %stride:_(s20) = G_TRUNC %n(s32)

  bb.1:
    %p:_(p0) = G_PHI %base(p0), %bb.0, %next(p0), %bb.1
    %i:_(s32) = G_PHI %n(s32), %bb.0, %inext(s32), %bb.1
    %off1:_(s20) = G_CONSTANT i20 4
    %p1:_(p0) = G_PTR_ADD %p(p0), %off1(s20)
  %v1:_(s32) = G_LOAD %p1(p0) :: (load (s32))
    %off2:_(s20) = G_CONSTANT i20 4
    %p2:_(p0) = G_PTR_ADD %p1(p0), %off2(s20)
    %v2:_(s32) = G_LOAD %p2(p0) :: (load (s32))
    %off3:_(s20) = G_CONSTANT i20 4
    %p3:_(p0) = G_PTR_ADD %p2(p0), %off3(s20)
    %v3:_(s32) = G_LOAD %p3(p0) :: (load (s32))
    %next:_(p0) = G_PTR_ADD %p(p0), %stride(s20)
    %inext:_(s32) = G_ADD %i, %minus1
    %cond:_(s32) = G_ICMP intpred(sgt), %inext(s32), %zero
    G_BRCOND %cond(s32), %bb.1
    G_BR %bb.2

  bb.2:
    %sum1:_(s32) = G_ADD %v1, %v2
    %sum2:_(s32) = G_ADD %sum1, %v3
    PseudoRET implicit $lr, implicit %sum2(s32)
