# aie-ptr-mod-opt combines the access of %2 with %3 = G_PTR_ADD %2, 64 into a
# post-increment. ptr_add_immed_chain must not rewrite %3 into
# G_PTR_ADD %0, 128 before that combine is applied. Offset combines are not
# affected by the rewrite.

---
name:            postinc-load-immed-chain
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0
    ; CHECK-LABEL: name: postinc-load-immed-chain
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 64
    ; CHECK-NEXT: [[AIE_POSTINC_LOAD:%[0-9]+]]:_(<8 x s32>), [[AIE_POSTINC_LOAD1:%[0-9]+]]:_(p0) = G_AIE_POSTINC_LOAD [[COPY]], [[C]](s20) :: (load (<8 x s32>))
    ; CHECK-NEXT: [[AIE_POSTINC_LOAD2:%[0-9]+]]:_(<8 x s32>), [[AIE_POSTINC_LOAD3:%[0-9]+]]:_(p0) = G_AIE_POSTINC_LOAD [[AIE_POSTINC_LOAD1]], [[C]](s20) :: (load (<8 x s32>))
    ; CHECK-NEXT: $wl0 = COPY [[AIE_POSTINC_LOAD]](<8 x s32>)
    ; CHECK-NEXT: $wl1 = COPY [[AIE_POSTINC_LOAD2]](<8 x s32>)
    ; CHECK-NEXT: $p1 = COPY [[AIE_POSTINC_LOAD3]](p0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $wl0, implicit $wl1, implicit $p1
    %0:_(p0) = COPY $p0
    %1:_(s20) = G_CONSTANT i20 64
    %2:_(p0) = G_PTR_ADD %0, %1
    %3:_(p0) = G_PTR_ADD %2, %1
    %4:_(<8 x s32>) = G_LOAD %0 :: (load (<8 x s32>))
    %5:_(<8 x s32>) = G_LOAD %2 :: (load (<8 x s32>))
    $wl0 = COPY %4
    $wl1 = COPY %5
    $p1 = COPY %3
    PseudoRET implicit $lr, implicit $wl0, implicit $wl1, implicit $p1
...
