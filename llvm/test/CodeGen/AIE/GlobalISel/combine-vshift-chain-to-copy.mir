# RUN: llc -mtriple aie2p -run-pass=aie-prelegalizer-combiner %s \
# RUN:         -verify-machineinstrs -o - | FileCheck %s

# Tests for VSHIFT chain combiner that recognizes legalization patterns
# and simplifies them to COPY operations.

---
name:            test_vshift_chain_basic
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $wl0

    ; CHECK-LABEL: name: test_vshift_chain_basic
    ; CHECK: liveins: $wl0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<8 x s32>) = COPY $wl0
    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF:%[0-9]+]]:_(<16 x s32>) = G_AIE_PAD_VECTOR_UNDEF [[COPY]](<8 x s32>)
    ; CHECK-NEXT: $x0 = COPY [[AIE_PAD_VECTOR_UNDEF]](<16 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %0:_(<8 x s32>) = COPY $wl0
    %1:_(<8 x s32>) = G_IMPLICIT_DEF
    %2:_(<16 x s32>) = G_CONCAT_VECTORS %0(<8 x s32>), %1(<8 x s32>)
    %3:_(s32) = G_CONSTANT i32 16
    %4:_(<16 x s32>) = G_IMPLICIT_DEF
    %5:_(<16 x s32>) = G_AIE_VSHIFT_RIGHT %2, %4, %3(s32)
    %6:_(s32) = G_CONSTANT i32 48
    %7:_(<16 x s32>) = G_IMPLICIT_DEF
    %8:_(<16 x s32>) = G_AIE_VSHIFT_RIGHT %7, %5, %6(s32)
    $x0 = COPY %8(<16 x s32>)
    PseudoRET implicit $lr, implicit $x0

...

