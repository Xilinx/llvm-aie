# G_READCYCLECOUNTER is legal for s64.
---
name:            readcyclecounter
body:             |
  bb.0:
    ; CHECK-LABEL: name: readcyclecounter
    ; CHECK: [[READCYCLECOUNTER:%[0-9]+]]:_(s64) = G_READCYCLECOUNTER
    ; CHECK-NEXT: $l0 = COPY [[READCYCLECOUNTER]](s64)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $l0
    %0:_(s64) = G_READCYCLECOUNTER
    $l0 = COPY %0(s64)
    PseudoRET implicit $lr, implicit $l0
...

