    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<16 x s8>) = G_BITCAST [[AIE_UNPAD_VECTOR]](<8 x s16>)
    ; CHECK-NEXT: %idx:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF:%[0-9]+]]:_(<64 x s8>) = G_AIE_PAD_VECTOR_UNDEF [[BITCAST]](<16 x s8>)
