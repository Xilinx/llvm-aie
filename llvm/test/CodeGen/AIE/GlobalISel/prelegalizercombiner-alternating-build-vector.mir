# --- 4 x s8: <64 x s8> (512-bit) with constants ---
# Packed = 1 | (2 << 8) | (3 << 16) | (4 << 24) = 0x04030201 = 67305985
---
name:            alternating_4xs8_v64i8
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: alternating_4xs8_v64i8
    ; CHECK: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 67305985
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<16 x s32>) = G_AIE_BROADCAST_VECTOR [[C]](s32)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<64 x s8>) = G_BITCAST [[AIE_BROADCAST_VECTOR]](<16 x s32>)
    ; CHECK-NEXT: $x0 = COPY [[BITCAST]](<64 x s8>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %0:_(s8) = G_CONSTANT i8 1
    %1:_(s8) = G_CONSTANT i8 2
    %2:_(s8) = G_CONSTANT i8 3
    %3:_(s8) = G_CONSTANT i8 4
    %4:_(<64 x s8>) = G_BUILD_VECTOR %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8)
    $x0 = COPY %4(<64 x s8>)
    PseudoRET implicit $lr, implicit $x0

...

# --- 4 x s8: non-constant arbitrary values in <64 x s8> ---
---
name:            alternating_4xs8_v64i8_noncst
body:             |
  bb.1.entry:
    liveins: $r0, $r1, $r2, $r3
    ; CHECK-LABEL: name: alternating_4xs8_v64i8_noncst
    ; CHECK: liveins: $r0, $r1, $r2, $r3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %tmp0:_(s32) = COPY $r0
    ; CHECK-NEXT: %tmp1:_(s32) = COPY $r1
    ; CHECK-NEXT: %tmp2:_(s32) = COPY $r2
    ; CHECK-NEXT: %tmp3:_(s32) = COPY $r3
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s8) = G_TRUNC %tmp0(s32)
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(s8) = G_TRUNC %tmp1(s32)
    ; CHECK-NEXT: [[TRUNC2:%[0-9]+]]:_(s8) = G_TRUNC %tmp2(s32)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(s32) = G_ZEXT [[TRUNC2]](s8)
    ; CHECK-NEXT: [[ZEXT1:%[0-9]+]]:_(s32) = G_ZEXT [[TRUNC1]](s8)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(s32) = G_CONSTANT i32 24
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %tmp3, [[C2]](s32)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(s32) = G_SHL [[ZEXT]], [[C1]](s32)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR [[SHL]], [[SHL1]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(s32) = G_SHL [[ZEXT1]], [[C]](s32)
    ; CHECK-NEXT: [[OR1:%[0-9]+]]:_(s32) = G_OR [[OR]], [[SHL2]]
    ; CHECK-NEXT: [[ZEXT2:%[0-9]+]]:_(s32) = G_ZEXT [[TRUNC]](s8)
    ; CHECK-NEXT: [[OR2:%[0-9]+]]:_(s32) = G_OR [[OR1]], [[ZEXT2]]
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<16 x s32>) = G_AIE_BROADCAST_VECTOR [[OR2]](s32)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<64 x s8>) = G_BITCAST [[AIE_BROADCAST_VECTOR]](<16 x s32>)
    ; CHECK-NEXT: $x0 = COPY [[BITCAST]](<64 x s8>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %tmp0:_(s32) = COPY $r0
    %tmp1:_(s32) = COPY $r1
    %tmp2:_(s32) = COPY $r2
    %tmp3:_(s32) = COPY $r3
    %0:_(s8) = G_TRUNC %tmp0(s32)
    %1:_(s8) = G_TRUNC %tmp1(s32)
    %2:_(s8) = G_TRUNC %tmp2(s32)
    %3:_(s8) = G_TRUNC %tmp3(s32)
    %4:_(<64 x s8>) = G_BUILD_VECTOR %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8), %0(s8), %1(s8), %2(s8), %3(s8)
    $x0 = COPY %4(<64 x s8>)
    PseudoRET implicit $lr, implicit $x0

...

