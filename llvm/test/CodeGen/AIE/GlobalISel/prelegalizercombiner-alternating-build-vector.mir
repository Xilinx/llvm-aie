    ; CHECK-NEXT: %ext:_(s32) = G_ASSERT_ZEXT [[AIE_ZEXT_EXTRACT_VECTOR_ELT]], 8
    ; CHECK-NEXT: $r0 = COPY %ext(s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %0:_(s8) = G_CONSTANT i8 1
    %1:_(s8) = G_CONSTANT i8 0
    %2:_(<16 x s8>) = G_BUILD_VECTOR %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8)
    %idx:_(s32) = G_CONSTANT i32 0
    %elt:_(s8) = G_EXTRACT_VECTOR_ELT %2(<16 x s8>), %idx(s32)
    %ext:_(s32) = G_ZEXT %elt(s8)
