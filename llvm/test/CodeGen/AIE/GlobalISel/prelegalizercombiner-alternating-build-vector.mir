  bb.1.entry:
    ; CHECK-LABEL: name: alternating_2xs16_v32i16
    ; CHECK: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 131073
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<16 x s32>) = G_AIE_BROADCAST_VECTOR [[C]](s32)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<32 x s16>) = G_BITCAST [[AIE_BROADCAST_VECTOR]](<16 x s32>)
    ; CHECK-NEXT: $x0 = COPY [[BITCAST]](<32 x s16>)
