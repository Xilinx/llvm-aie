body:             |
  bb.1.entry:
    liveins: $r0, $r1
    ; CHECK-LABEL: name: alternating_2xs16_v32i16_noncst
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
