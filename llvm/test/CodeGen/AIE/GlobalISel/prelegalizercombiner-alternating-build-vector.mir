# RUN: llc -mtriple aie2ps -run-pass=aie-prelegalizer-combiner %s -verify-machineinstrs -o - | FileCheck %s

# Tests for combine_alternating_build_vector.
#
# Supported patterns:
#   2 x s8  -> s16  (packed into i16, broadcast into <N/2  x s16>)
#   4 x s8  -> s32  (packed into i32, broadcast into <N/4  x s32>)
#   2 x s16 -> s32  (packed into i32, broadcast into <N/2  x s32>)

# ---------------------------------------------------------------------------- #
# 2 x s8 patterns
# ---------------------------------------------------------------------------- #

---
name:            alternating_2xs8_v64i8
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: alternating_2xs8_v64i8
    ; CHECK: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<32 x s16>) = G_AIE_BROADCAST_VECTOR [[C]](s32)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<64 x s8>) = G_BITCAST [[AIE_BROADCAST_VECTOR]](<32 x s16>)
    ; CHECK-NEXT: $x0 = COPY [[BITCAST]](<64 x s8>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %0:_(s8) = G_CONSTANT i8 1
    %1:_(s8) = G_CONSTANT i8 0
    %2:_(<64 x s8>) = G_BUILD_VECTOR %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8)
    $x0 = COPY %2(<64 x s8>)
    PseudoRET implicit $lr, implicit $x0

...

