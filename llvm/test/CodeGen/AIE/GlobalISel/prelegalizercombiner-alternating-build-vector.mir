    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<32 x s16>) = G_BITCAST [[AIE_BROADCAST_VECTOR]](<16 x s32>)
    ; CHECK-NEXT: $x0 = COPY [[BITCAST]](<32 x s16>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %tmp0:_(s32) = COPY $r0
    %tmp1:_(s32) = COPY $r1
    %0:_(s16) = G_TRUNC %tmp0(s32)
    %1:_(s16) = G_TRUNC %tmp1(s32)
    %2:_(<32 x s16>) = G_BUILD_VECTOR %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16), %0(s16), %1(s16)
    $x0 = COPY %2(<32 x s16>)
    PseudoRET implicit $lr, implicit $x0

...

# ---------------------------------------------------------------------------- #
# Negative tests: the combine should NOT fire
# ---------------------------------------------------------------------------- #

# --- Negative: <8 x s8> (64-bit) is below the 128-bit minimum ---
---
name:            no_combine_v8i8_too_small
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: no_combine_v8i8_too_small
    ; CHECK: [[C:%[0-9]+]]:_(s8) = G_CONSTANT i8 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s8) = G_CONSTANT i8 0
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<8 x s8>) = G_BUILD_VECTOR [[C]](s8), [[C1]](s8), [[C]](s8), [[C1]](s8), [[C]](s8), [[C1]](s8), [[C]](s8), [[C1]](s8)
    ; CHECK-NEXT: $l0 = COPY [[BUILD_VECTOR]](<8 x s8>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $l0
    %0:_(s8) = G_CONSTANT i8 1
    %1:_(s8) = G_CONSTANT i8 0
    %2:_(<8 x s8>) = G_BUILD_VECTOR %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8), %0(s8), %1(s8)
    $l0 = COPY %2(<8 x s8>)
    PseudoRET implicit $lr, implicit $l0

...

