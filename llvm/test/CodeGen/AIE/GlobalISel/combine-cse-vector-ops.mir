# RUN: llc -mtriple=aie2p -run-pass=aie-postlegalizer-custom-combiner -global-isel %s -verify-machineinstrs -o - | FileCheck %s

# Test the combine_cse_vector_ops combiner which performs Common Subexpression Elimination
# for duplicate G_CONCAT_VECTORS operations with identical operands.
# The combiner replaces duplicate concatenations with a COPY from the earlier result.

# POSITIVE: Simple duplicate concat - two identical G_CONCAT_VECTORS
# The second concat should be replaced with a COPY from the first concat's result.
---
name:            test_cse_simple_duplicate_concat
alignment:       1
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: test_cse_simple_duplicate_concat
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<16 x s32>) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<16 x s32>) = COPY $x1
    ; CHECK-NEXT: [[CONCAT_VECTORS:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: [[CONCAT_VECTORS1:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: $y0 = COPY [[CONCAT_VECTORS]](<32 x s32>)
    ; CHECK-NEXT: $y1 = COPY [[CONCAT_VECTORS1]](<32 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $y0, implicit $y1
    %0:_(<16 x s32>) = COPY $x0
    %1:_(<16 x s32>) = COPY $x1
    %2:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    %3:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    $y0 = COPY %2(<32 x s32>)
    $y1 = COPY %3(<32 x s32>)
    PseudoRET implicit $lr, implicit $y0, implicit $y1

...

# POSITIVE: Duplicate concat with intermediate operations
# The duplicate concat appears after some other operations, but should still be eliminated.
---
name:            test_cse_duplicate_concat_with_intermediate_ops
alignment:       1
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1, $x2

    ; CHECK-LABEL: name: test_cse_duplicate_concat_with_intermediate_ops
    ; CHECK: liveins: $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<16 x s32>) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<16 x s32>) = COPY $x1
    ; CHECK-NEXT: [[CONCAT_VECTORS:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:_(<32 x s32>) = G_FADD [[CONCAT_VECTORS]], [[CONCAT_VECTORS]]
    ; CHECK-NEXT: [[CONCAT_VECTORS1:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: $y0 = COPY [[FADD]](<32 x s32>)
    ; CHECK-NEXT: $y1 = COPY [[CONCAT_VECTORS1]](<32 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $y0, implicit $y1
    %0:_(<16 x s32>) = COPY $x0
    %1:_(<16 x s32>) = COPY $x1
    %2:_(<16 x s32>) = COPY $x2
    %3:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    %4:_(<32 x s32>) = G_FADD %3(<32 x s32>), %3(<32 x s32>)
    %5:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    $y0 = COPY %4(<32 x s32>)
    $y1 = COPY %5(<32 x s32>)
    PseudoRET implicit $lr, implicit $y0, implicit $y1

...

# POSITIVE: Multiple duplicate concats in sequence
# Three identical concats - the second and third should both be replaced with COPYs.
---
name:            test_cse_multiple_duplicate_concats
alignment:       1
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: test_cse_multiple_duplicate_concats
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<16 x s32>) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<16 x s32>) = COPY $x1
    ; CHECK-NEXT: [[CONCAT_VECTORS:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: [[CONCAT_VECTORS1:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: [[CONCAT_VECTORS2:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: $y0 = COPY [[CONCAT_VECTORS]](<32 x s32>)
    ; CHECK-NEXT: $y1 = COPY [[CONCAT_VECTORS1]](<32 x s32>)
    ; CHECK-NEXT: $y2 = COPY [[CONCAT_VECTORS2]](<32 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $y0, implicit $y1, implicit $y2
    %0:_(<16 x s32>) = COPY $x0
    %1:_(<16 x s32>) = COPY $x1
    %2:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    %3:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    %4:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    $y0 = COPY %2(<32 x s32>)
    $y1 = COPY %3(<32 x s32>)
    $y2 = COPY %4(<32 x s32>)
    PseudoRET implicit $lr, implicit $y0, implicit $y1, implicit $y2

...

# NEGATIVE: Different first operand
