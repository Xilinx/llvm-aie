    ; CHECK-NEXT: [[CONCAT_VECTORS1:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[COPY2]](<16 x s32>), [[COPY1]](<16 x s32>)
    ; CHECK-NEXT: $y0 = COPY [[CONCAT_VECTORS]](<32 x s32>)
    ; CHECK-NEXT: $y1 = COPY [[CONCAT_VECTORS1]](<32 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $y0, implicit $y1
    %0:_(<16 x s32>) = COPY $x0
    %1:_(<16 x s32>) = COPY $x1
    %2:_(<16 x s32>) = COPY $x2
    %3:_(<32 x s32>) = G_CONCAT_VECTORS %0(<16 x s32>), %1(<16 x s32>)
    %4:_(<32 x s32>) = G_CONCAT_VECTORS %2(<16 x s32>), %1(<16 x s32>)
    $y0 = COPY %3(<32 x s32>)
    $y1 = COPY %4(<32 x s32>)
    PseudoRET implicit $lr, implicit $y0, implicit $y1

