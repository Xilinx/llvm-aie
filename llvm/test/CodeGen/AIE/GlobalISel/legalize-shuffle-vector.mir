    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(s32) = G_SHL [[UV5]], [[C1]](s32)
    ; CHECK-NEXT: [[OR2:%[0-9]+]]:_(s32) = G_OR [[LSHR2]], [[SHL2]]
