  ; CHECK-NEXT:   G_BRCOND %cond(s32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[C5:%[0-9]+]]:_(s20) = G_CONSTANT i20 32
  ; CHECK-NEXT:   %loaded:_(s32) = G_AIE_OFFSET_LOAD %pre(p0), [[C5]](s20) :: (load (s32))
  ; CHECK-NEXT:   [[C6:%[0-9]+]]:_(s20) = G_CONSTANT i20 40
  ; CHECK-NEXT:   G_AIE_OFFSET_STORE [[C]](s32), %pre(p0), [[C6]](s20) :: (store (s32))
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit %loaded(s32)
