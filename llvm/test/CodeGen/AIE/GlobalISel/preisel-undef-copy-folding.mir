# RUN: llc -mtriple aie2 -run-pass=aie-preisel-combiner -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple aie2p -run-pass=aie-preisel-combiner -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple aie2ps -run-pass=aie-preisel-combiner -verify-machineinstrs %s -o - | FileCheck %s


# Cross bank copy of an undef can be simplified to an implicit def.
---
name:              undef_copy_acc_to_vec
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $x2

    ; CHECK-LABEL: name: undef_copy_acc_to_vec
    ; CHECK: liveins: $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:accregbank(<16 x s32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:vregbank(<16 x s32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[DEF]](<16 x s32>), implicit [[DEF1]](<16 x s32>)
    %0:vregbank(<16 x s32>) = COPY $x2
    %1:accregbank(<16 x s32>) = G_IMPLICIT_DEF
    %2:vregbank(<16 x s32>) = COPY %1(<16 x s32>)
    PseudoRET implicit $lr, implicit %1(<16 x s32>), implicit %2(<16 x s32>)
...

# Same bank copy of an undef should be folded by replacing the destination
# with the source register, eliminating the redundant copies. This pattern
# appears in Conv2D bf16 kernels where multiple uses copy the same undef.
---
name:              undef_copy_same_bank
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins:

    ; CHECK-LABEL: name: undef_copy_same_bank
    ; CHECK: [[DEF:%[0-9]+]]:vregbank(<16 x s32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[DEF]](<16 x s32>), implicit [[DEF]](<16 x s32>)
    %0:vregbank(<16 x s32>) = G_IMPLICIT_DEF
    %1:vregbank(<16 x s32>) = COPY %0(<16 x s32>)
    PseudoRET implicit $lr, implicit %0, implicit %1(<16 x s32>)
...

# A same-bank fold rewrites every COPY destination use. Include a CSEable user
# so that missing GISelChangeObserver notifications are detected.
---
name:              undef_copy_same_bank_cse_user
legalized:       true
regBankSelected: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: undef_copy_same_bank_cse_user
    ; CHECK: [[DEF:%[0-9]+]]:gprregbank(s32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:gprregbank(s32) = G_ADD [[DEF]], [[DEF]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[ADD]](s32)
    %0:gprregbank(s32) = G_IMPLICIT_DEF
    %1:gprregbank(s32) = COPY %0
    %2:gprregbank(s32) = G_ADD %1, %1
    PseudoRET implicit $lr, implicit %2
...

# Cover the cross-bank path, which creates a new G_IMPLICIT_DEF before
# rewriting every user of the COPY destination.
---
name:              undef_copy_cross_bank_cse_user
legalized:       true
regBankSelected: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: undef_copy_cross_bank_cse_user
    ; CHECK: [[VECDEF:%[0-9]+]]:vregbank(<16 x s32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:vregbank(<16 x s32>) = G_ADD [[VECDEF]], [[VECDEF]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[ADD]](<16 x s32>)
    %0:accregbank(<16 x s32>) = G_IMPLICIT_DEF
    %1:vregbank(<16 x s32>) = COPY %0
    %2:vregbank(<16 x s32>) = G_ADD %1, %1
    PseudoRET implicit $lr, implicit %2
...
