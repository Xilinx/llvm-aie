# Address Chaining test considering FRAME_INDEX with stack objects.

--- |
  %struct.params = type <{ i8, i8, i16, i32, i32, i32, i32, i32, i32, i8, i8, [2 x i8], i32, i8, [27 x i8] }>

  declare dso_local void @anchor(%struct.params) local_unnamed_addr

  define dso_local void @load_and_store_chain(ptr %ifm, ptr %ofm, %struct.params %sm_params.coerce) {
  entry:
    tail call void @anchor(%struct.params %sm_params.coerce) #1
    ret void
  }


