# llvm.loop.decrement returns a Type greater than s1 type
---
name:            widerScalar
alignment:       16
legalized:       true
tracksRegLiveness: true
body:             |
  ; COMMON-LABEL: name: widerScalar
  ; COMMON: bb.0:
  ; COMMON-NEXT:   successors: %bb.1(0x80000000)
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 42
  ; COMMON-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; COMMON-NEXT:   G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.set.loop.iterations), [[C]](s32)
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT: bb.1:
  ; COMMON-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT:   [[INT:%[0-9]+]]:_(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.loop.decrement), [[C1]](s32)
  ; COMMON-NEXT:   [[ASSERT_ZEXT:%[0-9]+]]:_(s32) = G_ASSERT_ZEXT [[INT]], 1
  ; COMMON-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY [[ASSERT_ZEXT]](s32)
  ; COMMON-NEXT:   G_BRCOND [[COPY]](s32), %bb.1
  ; COMMON-NEXT:   G_BR %bb.2
  ; COMMON-NEXT: {{  $}}
  ; COMMON-NEXT: bb.2:
  ; COMMON-NEXT:   PseudoRET implicit $lr
  bb.1:
    successors: %bb.2(0x80000000)

    %0:_(s32) = G_CONSTANT i32 42
    %32:_(s32) = G_CONSTANT i32 1
    G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.set.loop.iterations), %0(s32)

  bb.2:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)

    %46:_(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.loop.decrement), %32(s32)
    G_BRCOND %46(s32), %bb.2
    G_BR %bb.3

  bb.3:
    PseudoRET implicit $lr

...
