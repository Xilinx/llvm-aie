---
name: test_fabs_s16
body: |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: test_fabs_s16
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 32767
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND [[COPY]], [[C]]
    ; CHECK-NEXT: $r0 = COPY [[AND]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %2:_(s32) = COPY $r1
    %1:_(s16) = G_TRUNC %2(s32)
    %0:_(s16) = G_FABS %1
    %3:_(s32) = G_ANYEXT %0(s16)
    $r0 = COPY %3(s32)
    PseudoRET implicit $lr, implicit $r0
...

