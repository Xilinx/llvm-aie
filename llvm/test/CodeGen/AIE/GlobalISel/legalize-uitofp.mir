---
name: test_uitofp_s33_to_s32
body: |
  bb.0:
    liveins: $r2, $r3

    ; COMMON-LABEL: name: test_uitofp_s33_to_s32
    ; COMMON: liveins: $r2, $r3
    ; COMMON-NEXT: {{  $}}
    ; COMMON-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r2
    ; COMMON-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r3
    ; COMMON-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 -1
    ; COMMON-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; COMMON-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND [[COPY]], [[C]]
    ; COMMON-NEXT: [[AND1:%[0-9]+]]:_(s32) = G_AND [[COPY1]], [[C1]]
    ; COMMON-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    ; COMMON-NEXT: $r1 = COPY [[AND]](s32)
    ; COMMON-NEXT: $r2 = COPY [[AND1]](s32)
    ; COMMON-NEXT: PseudoJL &__floatundisf, csr_aie[[VER]], implicit-def $lr, implicit $r1, implicit $r2, implicit-def $r0
    ; COMMON-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r0
    ; COMMON-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    ; COMMON-NEXT: $r0 = COPY [[COPY2]](s32)
    %0:_(s32) = COPY $r2
    %1:_(s32) = COPY $r3
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s33) = G_TRUNC %2
    %4:_(s32) = G_UITOFP %3
    $r0 = COPY %4
...

---
name: test_uitofp_s64_to_s16
body: |
