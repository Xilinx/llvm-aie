  ; CHECK-NEXT:   G_STORE %zero(s32), %a2(p0) :: (store (s32))
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
