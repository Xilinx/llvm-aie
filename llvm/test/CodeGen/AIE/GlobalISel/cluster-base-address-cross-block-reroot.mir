# RUN: llc -mtriple aie2 -run-pass=aie-cluster-base-address %s -verify-machineinstrs -o - | FileCheck %s

# Tests for AIEClusterBaseAddress's cross-MBB chain reuse
# (PtrChainEndTracker).

# ---------------------------------------------------------------------
# Cross-MBB reroot must not fire when the shared live-in base still has
# a non-chain consumer (here a direct G_LOAD/G_STORE on %base) in the
# dominated MBB. Rerooting would force RA to save and restore the
# live-in.
# ---------------------------------------------------------------------
---
name:            crossBlockLiveInBaseHasNonChainUse
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: crossBlockLiveInBaseHasNonChainUse
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %base:_(p0) = COPY $p3
  ; CHECK-NEXT:   %zero:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   %off_a1:_(s20) = G_CONSTANT i20 64
  ; CHECK-NEXT:   %a1:_(p0) = G_PTR_ADD %base, %off_a1(s20)
  ; CHECK-NEXT:   G_STORE %zero(s32), %a1(p0) :: (store (s32))
  ; CHECK-NEXT:   %off_a2:_(s20) = G_CONSTANT i20 68
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   %a2:_(p0) = G_PTR_ADD %a1, [[C]](s20)
  ; CHECK-NEXT:   G_STORE %zero(s32), %a2(p0) :: (store (s32))
  ; CHECK-NEXT:   %off_a3:_(s20) = G_CONSTANT i20 72
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   %a3:_(p0) = G_PTR_ADD %a2, [[C1]](s20)
  ; CHECK-NEXT:   G_STORE %zero(s32), %a3(p0) :: (store (s32))
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   %v:_(s32) = G_LOAD %base(p0) :: (load (s32))
  ; CHECK-NEXT:   G_STORE %v(s32), %base(p0) :: (store (s32))
  ; CHECK-NEXT:   %off_b1:_(s20) = G_CONSTANT i20 128
  ; CHECK-NEXT:   %b1:_(p0) = G_PTR_ADD %base, %off_b1(s20)
  ; CHECK-NEXT:   G_STORE %zero(s32), %b1(p0) :: (store (s32))
  ; CHECK-NEXT:   %off_b2:_(s20) = G_CONSTANT i20 132
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   %b2:_(p0) = G_PTR_ADD %b1, [[C2]](s20)
  ; CHECK-NEXT:   G_STORE %zero(s32), %b2(p0) :: (store (s32))
  ; CHECK-NEXT:   %off_b3:_(s20) = G_CONSTANT i20 136
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
  ; CHECK-NEXT:   %b3:_(p0) = G_PTR_ADD %b2, [[C3]](s20)
  ; CHECK-NEXT:   G_STORE %zero(s32), %b3(p0) :: (store (s32))
  bb.0:
    successors: %bb.1
    liveins: $p3

    %base:_(p0) = COPY $p3
    %zero:_(s32) = G_CONSTANT i32 0

    %off_a1:_(s20) = G_CONSTANT i20 64
    %a1:_(p0) = G_PTR_ADD %base:_, %off_a1:_(s20)
    G_STORE %zero:_(s32), %a1:_(p0) :: (store (s32))

    %off_a2:_(s20) = G_CONSTANT i20 68
    %a2:_(p0) = G_PTR_ADD %base:_, %off_a2:_(s20)
    G_STORE %zero:_(s32), %a2:_(p0) :: (store (s32))

    %off_a3:_(s20) = G_CONSTANT i20 72
    %a3:_(p0) = G_PTR_ADD %base:_, %off_a3:_(s20)
    G_STORE %zero:_(s32), %a3:_(p0) :: (store (s32))

    G_BR %bb.1

  bb.1:
    %v:_(s32) = G_LOAD %base:_(p0) :: (load (s32))
    G_STORE %v:_(s32), %base:_(p0) :: (store (s32))

    %off_b1:_(s20) = G_CONSTANT i20 128
    %b1:_(p0) = G_PTR_ADD %base:_, %off_b1:_(s20)
    G_STORE %zero:_(s32), %b1:_(p0) :: (store (s32))

    %off_b2:_(s20) = G_CONSTANT i20 132
    %b2:_(p0) = G_PTR_ADD %base:_, %off_b2:_(s20)
    G_STORE %zero:_(s32), %b2:_(p0) :: (store (s32))

    %off_b3:_(s20) = G_CONSTANT i20 136
    %b3:_(p0) = G_PTR_ADD %base:_, %off_b3:_(s20)
    G_STORE %zero:_(s32), %b3:_(p0) :: (store (s32))
...

# ---------------------------------------------------------------------
# Dominator publishes chain tail at %base + 512. Dominated MBB chain on
# %base has leading offset 3840. Clusterer reroots head to
# G_PTR_ADD %a3, 3328 -- drops a base-materialisation and shrinks the
# padda constant.
