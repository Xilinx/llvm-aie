# RUN: llc -mtriple aie2 -run-pass=aie-ptr-mod-opt,aie-postlegalizer-custom-combiner %s -verify-machineinstrs -o - | FileCheck %s
# RUN: llc -mtriple aie2p -run-pass=aie-ptr-mod-opt,aie-postlegalizer-custom-combiner %s -verify-machineinstrs -o - | FileCheck %s
# RUN: llc -mtriple aie2ps -run-pass=aie-ptr-mod-opt,aie-postlegalizer-custom-combiner %s -verify-machineinstrs -o - | FileCheck %s

# aie-ptr-mod-opt combines the load of %0 with %2 and the load of %2 with %4
# into post-increments. ptr_add_immed_chain in the custom combiner must not fold
# %4 into %0 + 8 before these combines are applied, or the load of %2 would read
# %0.
---
name:            rebased_modifier_is_not_folded
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0

    ; CHECK-LABEL: name: rebased_modifier_is_not_folded
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 12
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s20) = G_CONSTANT i20 -4
    ; CHECK-NEXT: [[AIE_POSTINC_LOAD:%[0-9]+]]:_(p0), [[AIE_POSTINC_LOAD1:%[0-9]+]]:_(p0) = G_AIE_POSTINC_LOAD [[COPY]], [[C]](s20) :: (load (p0), align 4)
    ; CHECK-NEXT: [[AIE_POSTINC_LOAD2:%[0-9]+]]:_(p0), [[AIE_POSTINC_LOAD3:%[0-9]+]]:_(p0) = G_AIE_POSTINC_LOAD [[AIE_POSTINC_LOAD1]], [[C1]](s20) :: (load (p0), align 4)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[AIE_POSTINC_LOAD3]](p0), implicit [[AIE_POSTINC_LOAD]](p0), implicit [[AIE_POSTINC_LOAD2]](p0)
    %0:_(p0) = COPY $p0
    %1:_(s20) = G_CONSTANT i20 12
    %2:_(p0) = G_PTR_ADD %0, %1(s20)
    %3:_(s20) = G_CONSTANT i20 -4
    %4:_(p0) = G_PTR_ADD %2, %3(s20)
    %5:_(p0) = G_LOAD %0(p0) :: (load (p0), align 4)
    %6:_(p0) = G_LOAD %2(p0) :: (load (p0), align 4)
    PseudoRET implicit $lr, implicit %4, implicit %5, implicit %6
...

# The load of %0 is dead, so it is not combined with %2 into a post-increment:
# the pointer result of the combined instruction would keep it alive.
---
name:            dead_load_is_not_combined
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0

    ; CHECK-LABEL: name: dead_load_is_not_combined
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 4
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C]](s20)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[PTR_ADD]](p0)
    %0:_(p0) = COPY $p0
    %1:_(s20) = G_CONSTANT i20 4
    %2:_(p0) = G_PTR_ADD %0, %1(s20)
    %3:_(s32) = G_LOAD %0(p0) :: (load (s32))
    PseudoRET implicit $lr, implicit %2
...

# The offset load of %7 is moved above the post-increment of the load of %2,
# which overwrites the pointer. Folding %7 into %0 + 48 before applying it would
# leave the new constant below the moved load, a use before its def.
# FIXME: The custom combiner folds it first, so the G_AIE_OFFSET_LOAD uses the
# G_CONSTANT 48 defined below it.
---
name:            reordered_offset_load
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0

    ; CHECK-LABEL: name: reordered_offset_load
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 16
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C]](s20)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s20) = G_CONSTANT i20 64
    ; CHECK-NEXT: [[AIE_OFFSET_LOAD:%[0-9]+]]:_(<8 x s32>) = G_AIE_OFFSET_LOAD [[COPY]](p0), %9(s20) :: (load (<8 x s32>))
    ; CHECK-NEXT: [[AIE_POSTINC_LOAD:%[0-9]+]]:_(<8 x s32>), [[AIE_POSTINC_LOAD1:%[0-9]+]]:_(p0) = G_AIE_POSTINC_LOAD [[PTR_ADD]], [[C1]](s20) :: (load (<8 x s32>))
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(s20) = G_CONSTANT i20 48
    ; CHECK-NEXT: $wl0 = COPY [[AIE_POSTINC_LOAD]](<8 x s32>)
    ; CHECK-NEXT: $wl1 = COPY [[AIE_OFFSET_LOAD]](<8 x s32>)
    ; CHECK-NEXT: $p1 = COPY [[AIE_POSTINC_LOAD1]](p0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $wl0, implicit $wl1, implicit $p1
    %0:_(p0) = COPY $p0
    %1:_(s20) = G_CONSTANT i20 16
    %2:_(p0) = G_PTR_ADD %0, %1(s20)
    %3:_(<8 x s32>) = G_LOAD %2(p0) :: (load (<8 x s32>))
    %4:_(s20) = G_CONSTANT i20 64
    %5:_(p0) = G_PTR_ADD %2, %4(s20)
    %6:_(s20) = G_CONSTANT i20 32
    %7:_(p0) = G_PTR_ADD %2, %6(s20)
    %8:_(<8 x s32>) = G_LOAD %7(p0) :: (load (<8 x s32>))
    $wl0 = COPY %3
    $wl1 = COPY %8
    $p1 = COPY %5
    PseudoRET implicit $lr, implicit $wl0, implicit $wl1, implicit $p1
...
