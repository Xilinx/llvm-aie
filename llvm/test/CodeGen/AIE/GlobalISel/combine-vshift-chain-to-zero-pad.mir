# RUN:         -verify-machineinstrs -o - | FileCheck %s

# Tests for VSHIFT chain combiner that optimizes VSHIFT sequences into
# CONCAT operations with usage-aware padding (UNDEF vs zeros).

---
name:            test_vshift_chain_basic
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0


    ; CHECK-LABEL: name: test_vshift_chain_basic
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<16 x s32>) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(<16 x s32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[AIE_VSHIFT_RIGHT:%[0-9]+]]:_(<16 x s32>) = G_AIE_VSHIFT_RIGHT [[COPY]], [[DEF]], [[C]](s32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 48
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:_(<16 x s32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[AIE_VSHIFT_RIGHT1:%[0-9]+]]:_(<16 x s32>) = G_AIE_VSHIFT_RIGHT [[DEF1]], [[AIE_VSHIFT_RIGHT]], [[C1]](s32)
    ; CHECK-NEXT: $x0 = COPY [[AIE_VSHIFT_RIGHT1]](<16 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %0:_(<16 x s32>) = COPY $x0
    %1:_(s32) = G_CONSTANT i32 16
    %2:_(<16 x s32>) = G_IMPLICIT_DEF
    %3:_(<16 x s32>) = G_AIE_VSHIFT_RIGHT %0, %2, %1(s32)
    %4:_(s32) = G_CONSTANT i32 48
    %5:_(<16 x s32>) = G_IMPLICIT_DEF
    %6:_(<16 x s32>) = G_AIE_VSHIFT_RIGHT %5, %3, %4(s32)
    $x0 = COPY %6(<16 x s32>)
    PseudoRET implicit $lr, implicit $x0

...

