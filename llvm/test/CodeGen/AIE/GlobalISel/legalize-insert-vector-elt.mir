name:            insert_v128i8_dyn
alignment:       16
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $r0, $r1, $y3

    ; CHECK-LABEL: name: insert_v128i8_dyn
    ; CHECK: liveins: $r0, $r1, $y3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<128 x s8>) = COPY $y3
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[FRAME_INDEX:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.0
    ; CHECK-NEXT: G_STORE [[COPY]](<128 x s8>), [[FRAME_INDEX]](p0) :: (store (<128 x s8>) into %stack.0)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 127
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND [[COPY2]], [[C]]
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(s32) = G_MUL [[AND]], [[C1]]
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s20) = G_TRUNC [[MUL]](s32)
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[FRAME_INDEX]], [[TRUNC]](s20)
    ; CHECK-NEXT: G_STORE [[COPY1]](s32), [[PTR_ADD]](p0) :: (store (s8))
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(<128 x s8>) = G_LOAD [[FRAME_INDEX]](p0) :: (load (<128 x s8>))
    ; CHECK-NEXT: $y2 = COPY [[LOAD]](<128 x s8>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $y2
    %1:_(<128 x s8>) = COPY $y3
    %4:_(s32) = COPY $r0
    %2:_(s8) = G_TRUNC %4(s32)
    %3:_(s32) = COPY $r1
    %0:_(<128 x s8>) = G_INSERT_VECTOR_ELT %1, %2(s8), %3(s32)
    $y2 = COPY %0(<128 x s8>)
    PseudoRET implicit $lr, implicit $y2

