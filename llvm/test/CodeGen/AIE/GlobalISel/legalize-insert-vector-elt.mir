    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 11
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<32 x s16>), [[UV1:%[0-9]+]]:_(<32 x s16>) = G_UNMERGE_VALUES [[COPY]](<64 x s16>)
    ; CHECK-NEXT: [[AIE_INSERT_VECTOR_ELT:%[0-9]+]]:_(<32 x s16>) = G_AIE_INSERT_VECTOR_ELT [[UV]], [[COPY1]](s32), [[C]](s32)
    ; CHECK-NEXT: [[CONCAT_VECTORS:%[0-9]+]]:_(<64 x s16>) = G_CONCAT_VECTORS [[AIE_INSERT_VECTOR_ELT]](<32 x s16>), [[UV1]](<32 x s16>)
    ; CHECK-NEXT: $y2 = COPY [[CONCAT_VECTORS]](<64 x s16>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $y2
    %1:_(<64 x s16>) = COPY $y3
    %3:_(s32) = COPY $r0
    %2:_(s16) = G_TRUNC %3(s32)
    %4:_(s32) = G_CONSTANT i32 11
    %0:_(<64 x s16>) = G_INSERT_VECTOR_ELT %1, %2(s16), %4(s32)
    $y2 = COPY %0(<64 x s16>)
    PseudoRET implicit $lr, implicit $y2

