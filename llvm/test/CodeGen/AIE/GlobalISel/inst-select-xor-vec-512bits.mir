name:            test_xor_v64s8
alignment:       16
legalized:       true
regBankSelected: true
body:             |
  bb.0:
    liveins: $x2, $x4

    ; CHECK-LABEL: name: test_xor_v64s8
    ; CHECK: liveins: $x2, $x4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vec512 = COPY $x2
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vec512 = COPY $x4
    ; CHECK-NEXT: [[VBAND:%[0-9]+]]:vec512 = VBAND [[COPY1]], [[COPY]]
    ; CHECK-NEXT: [[VBOR:%[0-9]+]]:mxm = VBOR [[COPY1]], [[COPY]]
    ; CHECK-NEXT: [[VSUB_32_:%[0-9]+]]:vec512 = VSUB_32 [[VBOR]], [[VBAND]]
    ; CHECK-NEXT: $x0 = COPY [[VSUB_32_]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    ;
    ; AIE2PS-LABEL: name: test_xor_v64s8
    ; AIE2PS: liveins: $x2, $x4
    ; AIE2PS-NEXT: {{  $}}
    ; AIE2PS-NEXT: [[COPY:%[0-9]+]]:vec512 = COPY $x2
    ; AIE2PS-NEXT: [[COPY1:%[0-9]+]]:vec512 = COPY $x4
    ; AIE2PS-NEXT: [[VBAND:%[0-9]+]]:vec512 = VBAND [[COPY1]], [[COPY]], implicit $crbf8conf, implicit $crfp8conf
    ; AIE2PS-NEXT: [[VBOR:%[0-9]+]]:mxm = VBOR [[COPY1]], [[COPY]], implicit $crbf8conf, implicit $crfp8conf
    ; AIE2PS-NEXT: [[VSUB_32_:%[0-9]+]]:vec512 = VSUB_32 [[VBOR]], [[VBAND]], implicit $crbf8conf, implicit $crfp8conf
    ; AIE2PS-NEXT: $x0 = COPY [[VSUB_32_]]
    ; AIE2PS-NEXT: PseudoRET implicit $lr, implicit $x0
    %0:vregbank(<64 x s8>) = COPY $x2
    %1:vregbank(<64 x s8>) = COPY $x4
    %2:vregbank(<64 x s8>) = G_XOR %1, %0
    $x0 = COPY %2(<64 x s8>)
    PseudoRET implicit $lr, implicit $x0

