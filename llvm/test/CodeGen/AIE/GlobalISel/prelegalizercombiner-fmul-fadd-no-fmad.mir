# RUN: llc -mtriple aie2 -run-pass=aie-prelegalizer-combiner %s -verify-machineinstrs -o - | FileCheck %s
# RUN: llc -mtriple aie2p -run-pass=aie-prelegalizer-combiner %s -verify-machineinstrs -o - | FileCheck %s
# RUN: llc -mtriple aie2ps -run-pass=aie-prelegalizer-combiner %s -verify-machineinstrs -o - | FileCheck %s

# No AIE target can select G_FMAD, so no AIE combiner may fuse a contractable
# fmul + fadd into one. Scalar s32 G_FMUL and G_FADD are libcalls or custom
# legalization on AIE2/AIE2P/AIE2PS, so this input is only valid before
# legalization; it is not legalized MIR.

---
name:            fmul_fadd_contract
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2
    ; CHECK-LABEL: name: fmul_fadd_contract
    ; CHECK: liveins: $r0, $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[FMUL:%[0-9]+]]:_(s32) = contract G_FMUL [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:_(s32) = contract G_FADD [[FMUL]], [[COPY2]]
    ; CHECK-NEXT: $r0 = COPY [[FADD]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = COPY $r2
    %3:_(s32) = contract G_FMUL %0, %1
    %4:_(s32) = contract G_FADD %3, %2
    $r0 = COPY %4
    PseudoRET implicit $lr, implicit $r0
...
---
name:            fmul_fsub_contract
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2
    ; CHECK-LABEL: name: fmul_fsub_contract
    ; CHECK: liveins: $r0, $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[FMUL:%[0-9]+]]:_(s32) = contract G_FMUL [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[FSUB:%[0-9]+]]:_(s32) = contract G_FSUB [[FMUL]], [[COPY2]]
    ; CHECK-NEXT: $r0 = COPY [[FSUB]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = COPY $r2
    %3:_(s32) = contract G_FMUL %0, %1
    %4:_(s32) = contract G_FSUB %3, %2
    $r0 = COPY %4
    PseudoRET implicit $lr, implicit $r0
...
