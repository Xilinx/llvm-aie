; The aie_api unaligned 256-bit load with a real floor_ptr (AIESW-49989,
; Xilinx/aie_api#16): load 2 x 256 bits from P & ~31 and P & ~31 + 32 and
; return P & 31 as the shift amount. The hardware ignores the low 5 address
; bits of a 256-bit access, so the loads use P directly and only the
; P & 31 computation remains.
define void @unaligned_load_256(ptr %p, ptr %out, ptr %frac_out) {
; AIE2P-LABEL: unaligned_load_256:
; AIE2P:       // %bb.0:
; AIE2P-NEXT:    vldb wh0, [p0, #0]; nopxm
; AIE2P-NEXT:    vldb wh2, [p0, #32]
; AIE2P-NEXT:    nop
; AIE2P-NEXT:    nop
; AIE2P-NEXT:    nop
; AIE2P-NEXT:    ret lr
; AIE2P-NEXT:    nop // Delay Slot 5
; AIE2P-NEXT:    mova r0, #31; vst wh0, [p1, #0]; mov r1, p0 // Delay Slot 4
; AIE2P-NEXT:    vst wh2, [p1, #32]; and r0, r1, r0 // Delay Slot 3
; AIE2P-NEXT:    st r0, [p2, #0] // Delay Slot 2
; AIE2P-NEXT:    nop // Delay Slot 1
;
; AIE2PS-LABEL: unaligned_load_256:
; AIE2PS:       // %bb.0:
; AIE2PS-NEXT:    vldb wh0, [p0, #0]; nopxm
; AIE2PS-NEXT:    vldb wh2, [p0, #32]
; AIE2PS-NEXT:    nop
; AIE2PS-NEXT:    nop
; AIE2PS-NEXT:    nop
; AIE2PS-NEXT:    ret lr
; AIE2PS-NEXT:    nop // Delay Slot 5
; AIE2PS-NEXT:    mova r0, #31; vst wh0, [p1, #0]; mov r2, p0 // Delay Slot 4
; AIE2PS-NEXT:    vst wh2, [p1, #32]; and r0, r2, r0 // Delay Slot 3
; AIE2PS-NEXT:    st r0, [p2, #0] // Delay Slot 2
; AIE2PS-NEXT:    nop // Delay Slot 1
  %i = ptrtoint ptr %p to i20
  %frac = and i20 %i, 31
  %qi = and i20 %i, -32
  %q = inttoptr i20 %qi to ptr
  %q1 = getelementptr inbounds i8, ptr %q, i20 32
  %lo = load <8 x i32>, ptr %q, align 32
  %hi = load <8 x i32>, ptr %q1, align 32
  store <8 x i32> %lo, ptr %out, align 32
  %out1 = getelementptr inbounds i8, ptr %out, i20 32
  store <8 x i32> %hi, ptr %out1, align 32
