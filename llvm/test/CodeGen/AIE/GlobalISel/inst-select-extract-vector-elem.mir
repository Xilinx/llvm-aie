name:            extract_32bit_v2int32
alignment:       16
exposesReturnsTwice: false
legalized:       true
regBankSelected: true
selected:        false
body:             |
  bb.1.entry:
    liveins: $l0

    ; COMMON-LABEL: name: extract_32bit_v2int32
