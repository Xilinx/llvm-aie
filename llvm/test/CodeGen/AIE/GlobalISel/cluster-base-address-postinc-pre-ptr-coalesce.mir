  ; CHECK-COALESCER-NEXT:   %pre:ep = COPY [[COPY]]
  ; CHECK-COALESCER-NEXT:   dead %val:er, [[COPY]]:ep_as_32bit = LDA_dms_lda_scalar_ld_pstm_nrm [[COPY]], [[MOV_PD_imm11_pseudo]] :: (load (s32))
