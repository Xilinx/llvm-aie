  ; CHECK-COMBINER-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $p0
  ; CHECK-COMBINER-NEXT:   [[COPY1:%[0-9]+]]:_(s32) = COPY $r0
  ; CHECK-COMBINER-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
  ; CHECK-COMBINER-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 -1
  ; CHECK-COMBINER-NEXT:   [[C2:%[0-9]+]]:_(s20) = G_CONSTANT i20 32
