  ; CHECK-COMBINER-NEXT:   [[C3:%[0-9]+]]:_(s20) = G_CONSTANT i20 12
  ; CHECK-COMBINER-NEXT:   G_AIE_OFFSET_STORE [[C]](s32), [[COPY]](p0), [[C3]](s20) :: (store (s32))
  ; CHECK-COMBINER-NEXT: {{  $}}
  ; CHECK-COMBINER-NEXT: bb.1:
  ; CHECK-COMBINER-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-COMBINER-NEXT: {{  $}}
  ; CHECK-COMBINER-NEXT:   %pre:_(p0) = G_PHI [[COPY]](p0), %bb.0, %post(p0), %bb.1
  ; CHECK-COMBINER-NEXT:   %i:_(s32) = G_PHI [[COPY1]](s32), %bb.0, %inext(s32), %bb.1
  ; CHECK-COMBINER-NEXT:   %val:_(s32), %post:_(p0) = G_AIE_POSTINC_LOAD %pre, [[C2]](s20) :: (load (s32))
  ; CHECK-COMBINER-NEXT:   %lk_off1:_(s20) = G_CONSTANT i20 8
  ; CHECK-COMBINER-NEXT:   G_AIE_OFFSET_STORE [[C]](s32), %pre(p0), %lk_off1(s20) :: (store (s32))
  ; CHECK-COMBINER-NEXT:   [[C4:%[0-9]+]]:_(s20) = G_CONSTANT i20 16
  ; CHECK-COMBINER-NEXT:   G_AIE_OFFSET_STORE [[C]](s32), %pre(p0), [[C4]](s20) :: (store (s32))
  ; CHECK-COMBINER-NEXT:   %inext:_(s32) = G_ADD %i, [[C1]]
  ; CHECK-COMBINER-NEXT:   %cond:_(s32) = G_ICMP intpred(sgt), %inext(s32), [[C]]
  ; CHECK-COMBINER-NEXT:   G_BRCOND %cond(s32), %bb.1
  ; CHECK-COMBINER-NEXT:   G_BR %bb.2
  ; CHECK-COMBINER-NEXT: {{  $}}
  ; CHECK-COMBINER-NEXT: bb.2:
  ; CHECK-COMBINER-NEXT:   [[C5:%[0-9]+]]:_(s20) = G_CONSTANT i20 32
  ; CHECK-COMBINER-NEXT:   %adjusted:_(p0) = G_PTR_ADD %pre, [[C5]](s20)
  ; CHECK-COMBINER-NEXT:   G_AIE_OFFSET_STORE [[C]](s32), %pre(p0), [[C5]](s20) :: (store (s32))
  ; CHECK-COMBINER-NEXT:   [[C6:%[0-9]+]]:_(s20) = G_CONSTANT i20 40
  ; CHECK-COMBINER-NEXT:   G_AIE_OFFSET_STORE [[C]](s32), %pre(p0), [[C6]](s20) :: (store (s32))
  ; CHECK-COMBINER-NEXT:   PseudoRET implicit $lr, implicit %adjusted(p0)
