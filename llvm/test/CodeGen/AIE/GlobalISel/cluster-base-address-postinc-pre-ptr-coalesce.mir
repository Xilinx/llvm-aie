  ; CHECK-COALESCER: bb.0:
  ; CHECK-COALESCER-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-COALESCER-NEXT:   liveins: $p0, $r0
  ; CHECK-COALESCER-NEXT: {{  $}}
  ; CHECK-COALESCER-NEXT:   [[COPY:%[0-9]+]]:ep_as_32bit = COPY $p0
  ; CHECK-COALESCER-NEXT:   [[COPY1:%[0-9]+]]:mlockid_reg = COPY $r0
  ; CHECK-COALESCER-NEXT:   [[MOV_RLC_imm11_pseudo:%[0-9]+]]:mlockid_reg = MOV_RLC_imm11_pseudo 0
  ; CHECK-COALESCER-NEXT:   [[MOV_PD_imm11_pseudo:%[0-9]+]]:em = MOV_PD_imm11_pseudo 32
  ; CHECK-COALESCER-NEXT:   ST_dms_sts_scalar_st_idx_imm [[MOV_RLC_imm11_pseudo]], [[COPY]], 8 :: (store (s32))
  ; CHECK-COALESCER-NEXT:   ST_dms_sts_scalar_st_idx_imm [[MOV_RLC_imm11_pseudo]], [[COPY]], 12 :: (store (s32))
