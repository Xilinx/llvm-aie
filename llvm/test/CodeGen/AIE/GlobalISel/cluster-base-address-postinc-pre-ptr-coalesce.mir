# Tests that combine_lag_ptr_add lets the register coalescer merge the
# lag-PHI %pre and POSTINC's %post, eliminating the back-edge COPY
# between two p-class regs.
---
name:            ptr-postinc-coalesce
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-COMBINER-LABEL: name: ptr-postinc-coalesce
  ; CHECK-COMBINER: bb.0:
  ; CHECK-COMBINER-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-COMBINER-NEXT:   liveins: $p0, $r0
