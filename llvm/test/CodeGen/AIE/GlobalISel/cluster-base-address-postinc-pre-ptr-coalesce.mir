  ; CHECK-COALESCER-NEXT:   [[COPY1:%[0-9]+]]:mlockid_reg = ADD_add_r_ri [[COPY1]], -1, implicit-def dead $srcarry
  ; CHECK-COALESCER-NEXT:   %cond:mlockid_reg = LT [[MOV_RLC_imm11_pseudo]], [[COPY1]]
  ; CHECK-COALESCER-NEXT:   PseudoJNZ %cond, %bb.1
  ; CHECK-COALESCER-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-COALESCER-NEXT: {{  $}}
  ; CHECK-COALESCER-NEXT: bb.2:
  ; CHECK-COALESCER-NEXT:   [[MOV_PD_imm11_pseudo1:%[0-9]+]]:edj = MOV_PD_imm11_pseudo 32
  ; CHECK-COALESCER-NEXT:   [[COPY2:%[0-9]+]]:em = COPY [[MOV_PD_imm11_pseudo1]]
  ; CHECK-COALESCER-NEXT:   %adjusted:ep = COPY %pre
  ; CHECK-COALESCER-NEXT:   %adjusted:ep = PADD_mod_pseudo %adjusted, [[COPY2]]
  ; CHECK-COALESCER-NEXT:   ST_dms_sts_scalar_st_idx [[MOV_RLC_imm11_pseudo]], %pre, [[MOV_PD_imm11_pseudo1]] :: (store (s32))
  ; CHECK-COALESCER-NEXT:   [[MOV_PD_imm11_pseudo2:%[0-9]+]]:edj = MOV_PD_imm11_pseudo 40
  ; CHECK-COALESCER-NEXT:   ST_dms_sts_scalar_st_idx [[MOV_RLC_imm11_pseudo]], %pre, [[MOV_PD_imm11_pseudo2]] :: (store (s32))
  ; CHECK-COALESCER-NEXT:   PseudoRET implicit $lr, implicit %adjusted
  ;
  ; CHECK-LABEL: name: ptr-postinc-coalesce
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r2 = MOV_RLC_imm11_pseudo 0
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx_imm renamable $r2, renamable $p0, 8 :: (store (s32))
  ; CHECK-NEXT:   renamable $m0 = MOV_PD_imm11_pseudo 32
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx_imm renamable $r2, renamable $p0, 12 :: (store (s32))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $m0, $p0, $r0, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $p1 = COPY renamable $p0
  ; CHECK-NEXT:   dead renamable $r1, renamable $p0 = LDA_dms_lda_scalar_ld_pstm_nrm killed renamable $p0, renamable $m0 :: (load (s32))
  ; CHECK-NEXT:   renamable $r0 = ADD_add_r_ri killed renamable $r0, -1, implicit-def dead $srcarry
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx_imm renamable $r2, renamable $p1, 8 :: (store (s32))
  ; CHECK-NEXT:   renamable $r4 = LT renamable $r2, renamable $r0
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx_imm renamable $r2, renamable $p1, 16 :: (store (s32))
  ; CHECK-NEXT:   PseudoJNZ killed renamable $r4, %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $p1, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $dj0 = MOV_PD_imm11_pseudo 32
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx renamable $r2, renamable $p1, renamable $dj0 :: (store (s32))
  ; CHECK-NEXT:   renamable $m0 = COPY killed renamable $dj0
  ; CHECK-NEXT:   renamable $p0 = COPY renamable $p1
  ; CHECK-NEXT:   renamable $p0 = PADD_mod_pseudo killed renamable $p0, killed renamable $m0
  ; CHECK-NEXT:   renamable $dj0 = MOV_PD_imm11_pseudo 40
  ; CHECK-NEXT:   ST_dms_sts_scalar_st_idx killed renamable $r2, killed renamable $p1, killed renamable $dj0 :: (store (s32))
