  bb.0:
    liveins: $p0, $r0
    %0:_(p0) = COPY $p0
    %1:_(s32) = COPY $r0
    %2:_(s32) = G_CONSTANT i32 0
    %3:_(s32) = G_CONSTANT i32 -1
    %4:_(s20) = G_CONSTANT i20 32
    %pr_off1:_(s20) = G_CONSTANT i20 8
    %pr_ptr1:_(p0) = G_PTR_ADD %0(p0), %pr_off1(s20)
    G_STORE %2(s32), %pr_ptr1(p0) :: (store (s32))
    %pr_off2:_(s20) = G_CONSTANT i20 12
    %pr_ptr2:_(p0) = G_PTR_ADD %0(p0), %pr_off2(s20)
    G_STORE %2(s32), %pr_ptr2(p0) :: (store (s32))

  bb.1:
    %pre:_(p0) = G_PHI %0(p0), %bb.0, %post(p0), %bb.1
    %i:_(s32) = G_PHI %1(s32), %bb.0, %inext(s32), %bb.1
    %val:_(s32), %post:_(p0) = G_AIE_POSTINC_LOAD %pre(p0), %4(s20) :: (load (s32))
    %lk_off1:_(s20) = G_CONSTANT i20 8
    %lk_ptr1:_(p0) = G_PTR_ADD %pre(p0), %lk_off1(s20)
    G_STORE %2(s32), %lk_ptr1(p0) :: (store (s32))
    %lk_off2:_(s20) = G_CONSTANT i20 16
    %lk_ptr2:_(p0) = G_PTR_ADD %pre(p0), %lk_off2(s20)
    G_STORE %2(s32), %lk_ptr2(p0) :: (store (s32))
    %inext:_(s32) = G_ADD %i, %3
    %cond:_(s32) = G_ICMP intpred(sgt), %inext(s32), %2
    G_BRCOND %cond(s32), %bb.1
    G_BR %bb.2

  bb.2:
    %step:_(s20) = G_CONSTANT i20 32
    %adjusted:_(p0) = G_PTR_ADD %pre, %step(s20)
    G_STORE %2(s32), %adjusted(p0) :: (store (s32))
    %ep_off2:_(s20) = G_CONSTANT i20 40
    %ep_ptr2:_(p0) = G_PTR_ADD %pre(p0), %ep_off2(s20)
    G_STORE %2(s32), %ep_ptr2(p0) :: (store (s32))
