    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 2
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C]](s20)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s20) = G_CONSTANT i20 2
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(s20) = G_CONSTANT i20 66
    ; CHECK-NEXT: [[AIE_OFFSET_LOAD:%[0-9]+]]:_(<8 x s32>) = G_AIE_OFFSET_LOAD [[COPY]](p0), [[C2]](s20) :: (load (<8 x s32>))
    ; CHECK-NEXT: [[AIE_POSTINC_LOAD:%[0-9]+]]:_(<8 x s32>), [[AIE_POSTINC_LOAD1:%[0-9]+]]:_(p0) = G_AIE_POSTINC_LOAD [[PTR_ADD]], [[C1]](s20) :: (load (<8 x s32>))
    ; CHECK-NEXT: $wl2 = COPY [[AIE_POSTINC_LOAD]](<8 x s32>)
    ; CHECK-NEXT: $wl3 = COPY [[AIE_OFFSET_LOAD]](<8 x s32>)
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(<8 x s32>) = G_LOAD [[AIE_POSTINC_LOAD1]](p0) :: (load (<8 x s32>))
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(s20) = G_CONSTANT i20 32
    ; CHECK-NEXT: [[AIE_OFFSET_LOAD1:%[0-9]+]]:_(<8 x s32>) = G_AIE_OFFSET_LOAD [[AIE_POSTINC_LOAD1]](p0), [[C3]](s20) :: (load (<8 x s32>))
    ; CHECK-NEXT: $wl0 = COPY [[LOAD]](<8 x s32>)
    ; CHECK-NEXT: $wl1 = COPY [[AIE_OFFSET_LOAD1]](<8 x s32>)
