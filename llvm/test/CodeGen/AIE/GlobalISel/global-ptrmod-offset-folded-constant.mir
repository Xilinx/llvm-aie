    %0:_(p0) = COPY $p0
    %1:_(s20) = G_CONSTANT i20 2
    %2:_(p0) = G_PTR_ADD %0, %1(s20)
    %3:_(<8 x s32>) = G_LOAD %2(p0) :: (load (<8 x s32>))
    %4:_(s20) = G_CONSTANT i20 64
    %5:_(p0) = G_PTR_ADD %2, %4(s20)
    %6:_(<8 x s32>) = G_LOAD %5(p0) :: (load (<8 x s32>))
    $wl2 = COPY %3
    $wl3 = COPY %6
    %7:_(s20) = G_CONSTANT i20 4
    %8:_(p0) = G_PTR_ADD %0, %7(s20)
    %9:_(<8 x s32>) = G_LOAD %8(p0) :: (load (<8 x s32>))
    %10:_(s20) = G_CONSTANT i20 36
    %11:_(p0) = G_PTR_ADD %0, %10(s20)
    %12:_(<8 x s32>) = G_LOAD %11(p0) :: (load (<8 x s32>))
    $wl0 = COPY %9
    $wl1 = COPY %12
