    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s32) = G_AIE_SEXT_EXTRACT_VECTOR_ELT %0(<32 x s16>), %1(s32)
    %3:_(<32 x s16>) = G_AIE_BROADCAST_VECTOR %2(s32)
    %4:_(s32) = G_AIE_SEXT_EXTRACT_VECTOR_ELT %3(<32 x s16>), %1(s32)
    %5:_(s32) = G_CONSTANT i32 1
