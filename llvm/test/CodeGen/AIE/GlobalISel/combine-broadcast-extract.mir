    %12:_(<16 x s32>), %13:_(<16 x s32>) = G_UNMERGE_VALUES %20(<32 x s32>)
    %2:_(s32) = G_AIE_SEXT_EXTRACT_VECTOR_ELT %12(<16 x s32>), %3(s32)
    $r0 = COPY %2(s32)
    PseudoRET implicit $lr, implicit $r0

...

