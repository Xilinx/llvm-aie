# RUN:    | FileCheck %s


---
name:            pack_dyn_sign_loop
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: pack_dyn_sign_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $r1, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:er = COPY $r0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:ep = COPY $p0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:er = COPY $r1
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:mxs = COPY $x0
  ; CHECK-NEXT:   $packsign0 = COPY [[COPY2]]
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $packsign0 = MOV_scalar_imm11_pseudo 0
  ; CHECK-NEXT:   PseudoRET implicit $lr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x7c000000), %bb.1(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   VST_PACK_dmw_sts_pack_idx_imm_packSign0 [[COPY3]], [[COPY1]], 0, implicit $crpacksize, implicit $crsat, implicit $packsign0
  ; CHECK-NEXT:   PseudoJNZ [[COPY]], %bb.2
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.1
  bb.0:
    successors: %bb.2(0x80000000)
    liveins: $p0, $r0, $r1, $x0
    %0:er = COPY $r0
    %1:ep = COPY $p0
    %2:er = COPY $r1
    %3:mxs = COPY $x0
    PseudoJ_jump_imm %bb.2

  bb.1:
    PseudoRET implicit $lr

  bb.2:
    successors: %bb.2(0x7c000000), %bb.1(0x04000000)
    $packsign0 = COPY %2
    VST_PACK_dmw_sts_pack_idx_imm_packSign0 %3, %1, 0, implicit $crpacksize, implicit $crsat, implicit $packsign0
    $packsign0 = MOV_scalar_imm11_pseudo 0
    PseudoJNZ %0, %bb.2
    PseudoJ_jump_imm %bb.1
...

# Similar to above, but the loop has no dedicated exit.
# A dedicated exit block should be created.
