    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE implicit-def $x3, implicit-def $p1, implicit-def $lf1, implicit-def $r25, implicit-def $lfe, implicit-def $srfifo_uf, implicit-def $x8, implicit killed $r30, implicit killed $p1, implicit killed $lf1, implicit killed $r25, implicit killed $lfe, implicit $x9, implicit $r21 {
    ; CHECK-NEXT:   $x3, $p1, $lf1, $r25 = VLDB_POPX_512 killed $r30, $r30, killed $p1, killed $lf1, killed $r25, implicit-def $lfe, implicit-def $srfifo_uf, implicit killed $lfe
    ; CHECK-NEXT:   renamable $x8 = VSHUFFLE_vec_shuffle_x renamable $x9, renamable $x9, renamable $r21
    ; CHECK-NEXT: }
    ; CHECK-NEXT: renamable $x8 = VSHUFFLE_vec_shuffle_x renamable $x9, renamable $x9, renamable $r21
    ; CHECK-NEXT: renamable $x8 = VSHUFFLE_vec_shuffle_x renamable $x9, renamable $x9, renamable $r21
    ; CHECK-NEXT: renamable $x8 = VSHUFFLE_vec_shuffle_x renamable $x9, renamable $x9, renamable $r21
