# RUN: llc -march=aie2p -run-pass=postmisched %s -issue-limit=6 -o - | FileCheck %s

# Tests the MOV slot bypass (MOV_Bypass)
# This is particular looks at bypasses behavior for the wl and wh register
# files. Most instructions involved in MOV_Bypass use X registers, but some
# like VCONV, VEXP2 and VTANH actually use W registers. For those, we have to
# make sure that the bypass isn't used for WH registers, as it isn't supported in HW.

---
name:            bypass_wl_from_x_with_vmov
alignment:       16
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: bypass_wl_from_x_with_vmov
    ; CHECK: $x0 = VBAND killed $x0, killed $x4
    ; CHECK-NEXT: $wh0 = VMOV_alu_mv_mv_w killed $wl0
    ; CHECK-NEXT: NOP
    $x0 = VBAND $x0, $x4
    $wh0 = VMOV_alu_mv_mv_w $wl0
...

---
name:            bypass_wh_from_x_with_vmov
alignment:       16
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: bypass_wh_from_x_with_vmov
    ; CHECK: $x0 = VBAND killed $x0, killed $x4
    ; CHECK-NEXT: $wl0 = VMOV_alu_mv_mv_w killed $wh0
    ; CHECK-NEXT: NOP
    $x0 = VBAND $x0, $x4
    $wl0 = VMOV_alu_mv_mv_w $wh0
...

---
name:            bypass_wl_from_x_with_vconv
alignment:       16
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: bypass_wl_from_x_with_vconv
    ; CHECK: $x0 = VBAND killed $x0, killed $x4
    ; CHECK-NEXT: $bmll0 = VCONV_fp32_bf16_mv_ups_wbf killed $wl0
    ; CHECK-NEXT: NOP
    $x0 = VBAND $x0, $x4
    $bmll0 = VCONV_fp32_bf16_mv_ups_wbf $wl0
...

---
name:            bypass_wh_from_x_with_vconv
alignment:       16
body:             |
  bb.0.entry:
