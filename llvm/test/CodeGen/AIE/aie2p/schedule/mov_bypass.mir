    ; CHECK: $x0 = VBAND killed $x0, killed $x4
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $bmll0 = VCONV_fp32_bf16_mv_ups_wbf killed $wh0
    ; CHECK-NEXT: NOP
    $x0 = VBAND $x0, $x4
    $bmll0 = VCONV_fp32_bf16_mv_ups_wbf $wh0
...

