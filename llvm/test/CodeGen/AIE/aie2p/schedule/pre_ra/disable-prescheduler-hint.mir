#
# llvm.loop.hint.aie-disable-prescheduler always skips pre-RA scheduling of a
# single-block loop, independent of -aie-presched-follows-skip-pipeliner and of
# either pipeliner. llvm.loop.pipeline.disable alone still skips only when
# follows-skip is true (default). CYCLE_SEPARATOR markers appear only in
# scheduled regions.
#
# RUN: llc -mtriple=aie2p -run-pass=machine-scheduler \
# RUN:   -aie-presched-follows-skip-pipeliner=false -aie-prera-cycle-separators \
# RUN:   %s -o - | FileCheck %s --check-prefixes=CHECK,FOLLOW-OFF
#
# RUN: llc -mtriple=aie2p -run-pass=machine-scheduler \
# RUN:   -aie-prera-cycle-separators \
# RUN:   %s -o - | FileCheck %s --check-prefixes=CHECK,FOLLOW-ON

--- |
  target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "aie2p"

  define void @hinted(ptr noalias %a, ptr noalias %b, ptr noalias %c, i32 %n) {
  entry:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.body:                                         ; preds = %for.body, %entry
    %pa = phi ptr [ %a, %entry ], [ %pa.n, %for.body ]
    %pb = phi ptr [ %b, %entry ], [ %pb.n, %for.body ]
    %pc = phi ptr [ %c, %entry ], [ %pc.n, %for.body ]
    %va = load i32, ptr %pa, align 4
    %vb = load i32, ptr %pb, align 4
    %sum = add i32 %va, %vb
    %xor = xor i32 %va, 7
    %or = or i32 %sum, %xor
    store i32 %or, ptr %pc, align 4
    %pa.n = getelementptr inbounds i32, ptr %pa, i20 1
    %pb.n = getelementptr inbounds i32, ptr %pb, i20 1
    %pc.n = getelementptr inbounds i32, ptr %pc, i20 1
    %0 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %0, label %for.body, label %exit.bb, !llvm.loop !0

  exit.bb:                                          ; preds = %for.body
    ret void
  }

  define void @unhinted(ptr noalias %a, ptr noalias %b, ptr noalias %c, i32 %n) {
  entry:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.body:                                         ; preds = %for.body, %entry
    %pa = phi ptr [ %a, %entry ], [ %pa.n, %for.body ]
    %pb = phi ptr [ %b, %entry ], [ %pb.n, %for.body ]
    %pc = phi ptr [ %c, %entry ], [ %pc.n, %for.body ]
    %va = load i32, ptr %pa, align 4
    %vb = load i32, ptr %pb, align 4
    %sum = add i32 %va, %vb
    %xor = xor i32 %va, 7
    %or = or i32 %sum, %xor
    store i32 %or, ptr %pc, align 4
    %pa.n = getelementptr inbounds i32, ptr %pa, i20 1
    %pb.n = getelementptr inbounds i32, ptr %pb, i20 1
    %pc.n = getelementptr inbounds i32, ptr %pc, i20 1
    %0 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %0, label %for.body, label %exit.bb

  exit.bb:                                          ; preds = %for.body
    ret void
  }

  define void @pipeline_disable(ptr noalias %a, ptr noalias %b, ptr noalias %c, i32 %n) {
  entry:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.body:                                         ; preds = %for.body, %entry
    %pa = phi ptr [ %a, %entry ], [ %pa.n, %for.body ]
    %pb = phi ptr [ %b, %entry ], [ %pb.n, %for.body ]
    %pc = phi ptr [ %c, %entry ], [ %pc.n, %for.body ]
    %va = load i32, ptr %pa, align 4
    %vb = load i32, ptr %pb, align 4
    %sum = add i32 %va, %vb
    %xor = xor i32 %va, 7
    %or = or i32 %sum, %xor
    store i32 %or, ptr %pc, align 4
    %pa.n = getelementptr inbounds i32, ptr %pa, i20 1
    %pb.n = getelementptr inbounds i32, ptr %pb, i20 1
    %pc.n = getelementptr inbounds i32, ptr %pc, i20 1
    %0 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %0, label %for.body, label %exit.bb, !llvm.loop !2

  exit.bb:                                          ; preds = %for.body
    ret void
  }

  define void @hinted_and_pipeline_disable(ptr noalias %a, ptr noalias %b, ptr noalias %c, i32 %n) {
  entry:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %for.body

  for.body:                                         ; preds = %for.body, %entry
    %pa = phi ptr [ %a, %entry ], [ %pa.n, %for.body ]
    %pb = phi ptr [ %b, %entry ], [ %pb.n, %for.body ]
    %pc = phi ptr [ %c, %entry ], [ %pc.n, %for.body ]
    %va = load i32, ptr %pa, align 4
    %vb = load i32, ptr %pb, align 4
    %sum = add i32 %va, %vb
    %xor = xor i32 %va, 7
    %or = or i32 %sum, %xor
    store i32 %or, ptr %pc, align 4
    %pa.n = getelementptr inbounds i32, ptr %pa, i20 1
    %pb.n = getelementptr inbounds i32, ptr %pb, i20 1
    %pc.n = getelementptr inbounds i32, ptr %pc, i20 1
