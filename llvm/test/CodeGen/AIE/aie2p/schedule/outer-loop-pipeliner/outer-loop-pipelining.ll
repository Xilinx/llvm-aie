  ; CHECK: bb.1.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.10(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $p2, $r0, $r1
  ; CHECK-NEXT: {{  $}}
