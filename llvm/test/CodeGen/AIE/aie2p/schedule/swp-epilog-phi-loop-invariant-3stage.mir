# RUN: llc --mtriple=aie2p --run-pass=pipeliner %s -o - | FileCheck %s

--- |
  ; ModuleID = 't.ll'
  source_filename = "t.ll"
  target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "aie2p"

  define void @f(ptr noalias readonly %a, ptr noalias readonly %b, ptr noalias writeonly %c) {
  entry:
    call void @llvm.set.loop.iterations.i32(i32 3)
    br label %for.body

  for.cond.cleanup:                                 ; preds = %for.body
    %0 = tail call <32 x i16> @llvm.aie2p.I512.v32.acc64.srs(<32 x i64> %m4, i32 0, i32 1)
    store <32 x i16> %0, ptr %c, align 64
    ret void

  for.body:                                         ; preds = %for.body, %entry
    %k = phi i32 [ 0, %entry ], [ 1, %for.body ]
    %z = phi i32 [ 795, %entry ], [ 794, %for.body ]
    %acc = phi <32 x i64> [ undef, %entry ], [ %m4, %for.body ]
    %1 = trunc nuw nsw i32 %k to i20
    %pa = getelementptr inbounds nuw <32 x i16>, ptr %a, i20 %1
    %x = load <16 x i32>, ptr %pa, align 64
    %pb = getelementptr inbounds nuw <32 x i16>, ptr %b, i20 %1
    %y = load <32 x i16>, ptr %pb, align 64
    %m1 = tail call <32 x i64> @llvm.aie2p.I512.I512.ACC2048.mac.conf(<16 x i32> %x, <32 x i16> %y, <32 x i64> %acc, i32 0)
    %m2 = tail call <32 x i64> @llvm.aie2p.I512.I512.ACC2048.mac.conf(<16 x i32> %x, <32 x i16> %y, <32 x i64> %m1, i32 0)
    %m3 = tail call <32 x i64> @llvm.aie2p.I512.I512.ACC2048.mac.conf(<16 x i32> %x, <32 x i16> %y, <32 x i64> %m2, i32 0)
    %m4 = tail call <32 x i64> @llvm.aie2p.I512.I512.ACC2048.mac.conf(<16 x i32> %x, <32 x i16> %y, <32 x i64> %m3, i32 %z)
    %2 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %2, label %for.body, label %for.cond.cleanup, !llvm.loop !0
  }

  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare <32 x i64> @llvm.aie2p.I512.I512.ACC2048.mac.conf(<16 x i32>, <32 x i16>, <32 x i64>, i32) #0

  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(inaccessiblemem: read)
  declare <32 x i16> @llvm.aie2p.I512.v32.acc64.srs(<32 x i64>, i32, i32) #1

  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare void @llvm.set.loop.iterations.i32(i32) #2

  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i1 @llvm.loop.decrement.i32(i32) #2

  attributes #0 = { nocallback nofree nosync nounwind willreturn memory(none) }
  attributes #1 = { nocallback nofree nosync nounwind willreturn memory(inaccessiblemem: read) }
  attributes #2 = { nocallback noduplicate nofree nosync nounwind willreturn }

  !0 = distinct !{!0, !1, !2}
  !1 = !{!"llvm.loop.mustprogress"}
  !2 = !{!"llvm.loop.itercount.range", i32 3}
...
