    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: REL_mLockId_imm 0, killed $r1
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    REL_mLockId_imm 0, $r0
    REL_mLockId_imm 0, $r1
...

