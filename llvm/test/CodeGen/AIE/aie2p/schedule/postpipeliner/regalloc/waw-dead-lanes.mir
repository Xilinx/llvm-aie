# A 32-lane bf16 vmul.f writes its whole 2048-bit dm six cycles after issue,
# the upper half included. Here that half is dead: the vmov fills it with the
# other product before the push reads the dm. In the virtual mode the dm, its
# upper half and the push are one virtual register, and the WAW edge from the
# vmul.f to the vmov must keep the vmov's write (issue + 2) after the vmul.f's
# (issue + 6): latency 5, as for physical registers. With latency 0, the vmov
# could issue right after the vmul.f and land first; the push then read the
# vmul.f's upper half instead of the moved product.

# RUN: llc -verify-machineinstrs --mtriple=aie2p -O2 \
# RUN:     --start-before=postmisched %s \
# RUN:     --aie-postpipeliner-vreg-mode=1 \
# RUN:     --aie-postpipeliner-phys-mode=0 \
# RUN:     -o - | FileCheck %s

--- |
  target triple = "aie2p"

  define void @waw_dead_lanes(i32 %n) {
  ; CHECK-LABEL: waw_dead_lanes:
  ; CHECK:       // %bb.0: // %preheader
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; add.nc lc, r1, #-4; vmul.f dm0, x2, x3, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm ls, #.LBB0_1; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; vmul.f dm0, x2, x3, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmul.f dm0, x2, x3, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vmov cmh1, cml0; vmul.f dm0, x2, x3, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_1: // %loop_body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; nopb ; vst.push.576.conv.bfp16ebs8.fp32 dm1, [p2, sf, r26]; nopx ; vmov cmh1, cml0; vmul.f dm0, x2, x3, r2
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    nopa ; vst.push.576.conv.bfp16ebs8.fp32 dm1, [p2, sf, r26]; nopx ; vmov cmh1, cml0
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vst.push.576.conv.bfp16ebs8.fp32 dm1, [p2, sf, r26]; vmov cmh1, cml0
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vst.push.576.conv.bfp16ebs8.fp32 dm1, [p2, sf, r26]; vmov cmh1, cml0
  ; CHECK-NEXT:    ret lr
  ; CHECK-NEXT:    vst.push.576.conv.bfp16ebs8.fp32 dm1, [p2, sf, r26] // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 16}
...
---
name:            waw_dead_lanes
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $r1, $r2, $sf, $p2, $r26, $x0, $x1, $x2, $x3, $x4, $x5

    $lc = ADD_NC_mv_add_ri $r1, 0
    $ls = MOVXM %bb.1
    $le = MOVXM <mcsymbol .L_LEnd0>

  bb.1.loop_body (align 16):
    successors: %bb.1, %bb.2
    liveins: $r2, $sf, $p2, $r26, $x0, $x1, $x2, $x3, $x4, $x5

    ; dm0's upper half is dead until the vmov fills it.
    $dm0 = VMUL_f_vmul_bf_vmul_bf_core_X_X $x0, $x1, $r2, implicit-def dead $srfpflags, implicit $crfpmask
    $dm1 = VMUL_f_vmul_bf_vmul_bf_core_X_X $x2, $x3, $r2, implicit-def dead $srfpflags, implicit $crfpmask
    $cmh0 = VMOV_alu_mv_mv_cm killed $cml1
    $sf, $p2, $r26 = VST_PUSH_576_CONV_bfp16ebs8_fp32 $sf, killed $dm0, $p2, $r26, implicit-def $srf2bflags, implicit-def $srfifo_of, implicit $crf2bmask, implicit $crrnd
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):
    liveins: $sf, $p2, $r26
    RET implicit $lr
    DelayedSchedBarrier
...
