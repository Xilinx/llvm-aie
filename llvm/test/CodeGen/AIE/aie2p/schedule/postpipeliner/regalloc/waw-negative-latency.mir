# dm1 is one virtual register in the virtual mode: the vmul.f writes all of it
# (issue + 6), the vmac.f reads it, the vconv rewrites its low half (issue + 2)
# and the vsub.f reads both halves. The WAW edge from the vconv to the next
# iteration's vmul.f has latency 2 - 6 + 1 = -3: that vmul.f may issue before
# this iteration's vconv and still land after it. With latency 0 the loop
# needed II 5; with -3 it runs at II 4.

# RUN: llc -verify-machineinstrs --mtriple=aie2p -O2 \
# RUN:     --start-before=postmisched %s \
# RUN:     --aie-postpipeliner-vreg-mode=1 \
# RUN:     --aie-postpipeliner-phys-mode=0 \
# RUN:     -o - | FileCheck %s

--- |
  target triple = "aie2p"

  define void @waw_negative(i32 %n) {
  ; CHECK-LABEL: waw_negative:
  ; CHECK:       // %bb.0: // %preheader
  ; CHECK-NEXT:    nopa ; nopb ; nopxm ; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vmac.f dm3, dm1, x2, x3, r2
  ; CHECK-NEXT:    vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    vconv.fp32.bf16 cml1, x4
  ; CHECK-NEXT:    add.nc lc, r1, #-3; vsub.f dm3, dm3, dm1, r2
  ; CHECK-NEXT:    movxm ls, #.LBB0_1; vmac.f dm3, dm1, x2, x3, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; movxm le, #.L_LEnd0; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vconv.fp32.bf16 cml1, x4; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vsub.f dm3, dm3, dm1, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac.f dm3, dm1, x2, x3, r2
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB0_1: // %loop_body
  ; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
  ; CHECK-NEXT:    nopa ; nopb ; vst bmll3, [p2], #64; nopxm ; vmul.f dm1, x0, x1, r2
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; vconv.fp32.bf16 cml1, x4; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vsub.f dm3, dm3, dm1, r2
  ; CHECK-NEXT:  .L_LEnd0:
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; vmac.f dm3, dm1, x2, x3, r2
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  // %bb.2: // %exit
  ; CHECK-NEXT:    vst bmll3, [p2], #64
  ; CHECK-NEXT:    vconv.fp32.bf16 cml1, x4
  ; CHECK-NEXT:    vsub.f dm3, dm3, dm1, r2
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vst bmll3, [p2], #64; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    vst bmll3, [p2], #64 // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  preheader:
    call void @llvm.set.loop.iterations.i32(i32 %n)
    br label %loop_body

  loop_body:
    %dec = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %dec, label %loop_body, label %exit, !llvm.loop !0

  exit:
    ret void
  }

  declare void @llvm.set.loop.iterations.i32(i32)
  declare i1 @llvm.loop.decrement.i32(i32)

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.itercount.range", i64 16}
...
---
name:            waw_negative
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.preheader:
    successors: %bb.1
    liveins: $r1, $r2, $sf, $p2, $r26, $x0, $x1, $x2, $x3, $x4, $x5

    $lc = ADD_NC_mv_add_ri $r1, 0
    $ls = MOVXM %bb.1
    $le = MOVXM <mcsymbol .L_LEnd0>

  bb.1.loop_body (align 16):
    successors: %bb.1, %bb.2
    liveins: $r2, $sf, $p2, $r26, $x0, $x1, $x2, $x3, $x4, $x5

    $dm1 = VMUL_f_vmul_bf_vmul_bf_core_X_X $x0, $x1, $r2, implicit-def dead $srfpflags, implicit $crfpmask
    $dm0 = VMAC_f_vmac_bf_vmul_bf_core_X_X $dm1, $x2, $x3, $r2, implicit-def dead $srfpflags, implicit $crfpmask
    $cml1 = VCONV_fp32_bf16_mv_ups_xbf $x4
    $dm3 = VSUB_f_vmac_cm2_add_reg killed $dm0, $dm1, $r2, implicit-def dead $srfpflags, implicit $crfpmask
    $p2 = VST_dmx_sts_bm_pstm_nrm_imm killed $bmll3, $p2, 64
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2.exit (align 16):
    liveins: $sf, $p2, $r26
    RET implicit $lr
    DelayedSchedBarrier
...
