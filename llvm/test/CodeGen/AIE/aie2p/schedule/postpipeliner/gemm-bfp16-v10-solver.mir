    $cmh4 = VLDA_CONV_fp32_bf16_dmx_lda_ups_bf_idx_imm $p6, 64 :: (load (<32 x s16>))
    $cml4, $p6, $dc1, $dc5 = VLDA_3D_CONV_fp32_bf16_dmx_lda_ups_bf $p6, $d1_3d :: (load (<32 x s16>))
    $p4 = MOVS $p7
    $x4 = VLDB_dmx_ldb_x_idx_imm $p7, 64 :: (load (<16 x s32>))
    $x7, $p7, $dc0, $dc4 = VLDB_3D_dmx_ldb_x $p7, $d0_3d :: (load (<16 x s32>))
    $x6 = VSHUFFLE_vec_shuffle_x $x7, $x4, $r0
    $x7 = VSHUFFLE_vec_shuffle_x $x7, $x4, $r1

    $ex0 = VCONV_bfp16ebs8_fp32 $dm4, implicit-def $srf2bflags, implicit $crf2bmask, implicit $crrnd

    $dm4 = VMUL_f_vmul_bf_vmul_bf_core_Y_Y $y3, $y5, $r2, implicit-def $srfpflags, implicit $crfpmask
    $ex1 = VCONV_bfp16ebs8_fp32 $dm4, implicit-def $srf2bflags, implicit $crf2bmask, implicit $crrnd

    $p4 = PADDB_pstm_nrm $p4, $m4
    $x5 = VLDB_dmx_ldb_x_idx_imm $p4, 64 :: (load (<16 x s32>))
    $x9 = VLDB_dmx_ldb_x_idx_imm $p4, 0 :: (load (<16 x s32>))
    $x8 = VSHUFFLE_vec_shuffle_x $x9, $x5, $r0
    $x9 = VSHUFFLE_vec_shuffle_x $x9, $x5, $r1
    $dm4 = VMUL_f_vmul_bf_vmul_bf_core_Y_Y $y4, $y5, $r2, implicit-def $srfpflags, implicit $crfpmask
    $ex3 = VCONV_bfp16ebs8_fp32 $dm4, implicit-def $srf2bflags, implicit $crf2bmask, implicit $crrnd

    $p5 = PADDA_pstm_nrm $p5, $m5
    $cmh4 = VLDA_CONV_fp32_bf16_dmx_lda_ups_bf_idx_imm $p5, 64 :: (load (<32 x s16>))
    $cml4 = VLDA_CONV_fp32_bf16_dmx_lda_ups_bf_idx_imm $p5, 0 :: (load (<32 x s16>))
