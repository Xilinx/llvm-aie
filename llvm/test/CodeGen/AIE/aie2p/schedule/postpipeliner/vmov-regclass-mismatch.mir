  ;
  ; Verify that computeRegisterClass correctly lifts sub-register encoding
  ; constraints to the base register class. When an LR's base is dm0 (class
  ; ACC2048) and an operand accesses it via the bmlh0 sub-register (bypass
  ; class eBMLH at SubRegIdx 3), getMatchingSuperRegClass must be used, not
  ; getSubClassWithSubReg, to avoid a spurious null intersection that would
  ; incorrectly reject the live range from virtualization.
  ;
  ; With the fix, the VMOV no longer causes a schedule class mismatch. LR#1
  ; passes safety filtering and refinement, then is correctly rejected by the
  ; coverage pruning step (because VADDMAC's tied dm0 def is uncovered once
  ; its own tied-operand LR#0 is removed).
  ;
  ; RUN: llc -mtriple=aie2ps -run-pass=postmisched \
  ; RUN:     -debug-only=aie-reg-liverange -o /dev/null %s 2>&1 | FileCheck %s
  ; REQUIRES: asserts
  ;
  ; CHECK: Keep:{{.*}}LR#1 Base=dm0
  ; CHECK: Reject: pruned by full coverage (uncovered alias dm0)
  ;
  ; ModuleID = 'red.ll'
  source_filename = "Work/aie/0_0/src/0_0.cc"
  target datalayout = "e-m:e-p:20:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "aie2ps-none-unknown-elf"
  
