; Pipelined ptr-coupled lock alias for FIFO pop/push.
; Complements pipelined-lock-ptr-alias.mir (scalar G_LOAD/G_STORE where disjoint alias works) and
; aie2p-lock-ptr-alias.ll (same-block LockDelays coverage).
;
; FIFO ptr-coupled lock alias — known gap
;
; These pipelined tests show that ptr-coupled lock spacing does NOT distinguish
; same-port vs disjoint-port for FIFO pop/push.
; CHECK output for *_fifo_same and *_fifo_disjoint is intentionally identical.
;
; Why conservative today:
;   - Lock ptr MMOs are annotative unknown-size (getTgtMemIntrinsic for
;     acquire_ptr/release_ptr uses MVT::Other).
;   - FIFO pop/push MMOs are also unknown-size.
;   - AA returns MayAlias when both MMOs are unknown-size, so AIERegMemEventTracker
;     always orders locks against loop FIFO memory ops — even when IR pointers are noalias.

declare void @llvm.aie2p.acquire.ptr(ptr, i32, i32)
declare void @llvm.aie2p.release.ptr(ptr, i32, i32)
declare void @llvm.set.loop.iterations.i32(i32)
declare i1 @llvm.loop.decrement.i32(i32)
declare { <64 x i8>, ptr, <32 x i32>, i32, <16 x i32> }
  @llvm.aie2p.fifo.ld.popx(ptr, <32 x i32>, i32, <16 x i32>, i32)
declare { ptr, <32 x i32>, i32 }
  @llvm.aie2p.fifo.st.push.512.bfp16.p0.p0(ptr, <16 x i32>, <32 x i32>, i32)

; --- Acquire ptr (prologue): pipelined fifo.ld.popx in loop ---

; Same port: acquire_ptr orders against fifo pop on lock port — conservative spacing.
define void @pipelined_acquire_ptr_fifo_same(ptr noalias %io, i32 %lock_id) {
; CHECK-LABEL: pipelined_acquire_ptr_fifo_same:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    lda r1, [p0, #4]; nopxm
; CHECK-NEXT:    lda r2, [p0, #8]
; CHECK-NEXT:    lda r27, [p0, #12]
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    movxm ls, #.LBB0_1
; CHECK-NEXT:    movxm le, #.L_LEnd0
; CHECK-NEXT:    mova r2, #-1; sel.eqz r1, r1, r2, r27
; CHECK-NEXT:    acq r0, r2
; CHECK-NEXT:    paddxm [sp], #64
; CHECK-NEXT:    mova r3, #16; movx r24, #0; mov p1, sp
; CHECK-NEXT:    padda [p1], #-64; nopb ; nops ; movx r30, #63; add.nc lc, r3, #0; nopv
; CHECK-NEXT:  .LBB0_1: // %for.body
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nopa ; nopb ; movs p0, r1; nopxm ; nopv
; CHECK-NEXT:    nopa ; vldb.popx.512 x2, [p0, lf0, r24]; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopx ; mov r1, p0; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:    st.s8 r0, [p1, #0]
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    vextract.8 r0, x2, #0, vaddsign1
; CHECK-NEXT:    nop
; CHECK-NEXT:  .L_LEnd0:
; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
; CHECK-NEXT:  // %bb.2: // %for.exit
; CHECK-NEXT:    nopa ; nopb ; nops ; ret lr; nopm ; nopv
; CHECK-NEXT:    nopx // Delay Slot 5
; CHECK-NEXT:    nop // Delay Slot 4
; CHECK-NEXT:    nop // Delay Slot 3
; CHECK-NEXT:    paddxm [sp], #-64 // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
entry:
  %sink = alloca i8, align 1
  %cur_id.ptr = getelementptr inbounds i8, ptr %io, i20 12
  %cur_id = load i32, ptr %cur_id.ptr, align 4
  %is_zero = icmp eq i32 %cur_id, 0
  %buf0.ptr = getelementptr inbounds i8, ptr %io, i20 4
  %buf1.ptr = getelementptr inbounds i8, ptr %io, i20 8
  %buf0 = load ptr, ptr %buf0.ptr, align 4
  %buf1 = load ptr, ptr %buf1.ptr, align 4
  %port = select i1 %is_zero, ptr %buf0, ptr %buf1
  call void @llvm.aie2p.acquire.ptr(ptr %port, i32 %lock_id, i32 -1)
  call void @llvm.set.loop.iterations.i32(i32 16)
  br label %for.body

for.body:
  %p = phi ptr [ %port, %entry ], [ %p.next, %for.body ]
  %fifo.buf = phi <32 x i32> [ poison, %entry ], [ %fifo.buf.next, %for.body ]
  %avail = phi i32 [ 0, %entry ], [ %avail.next, %for.body ]
  %pos = phi <16 x i32> [ poison, %entry ], [ %pos.next, %for.body ]
  %pop = tail call { <64 x i8>, ptr, <32 x i32>, i32, <16 x i32> }
    @llvm.aie2p.fifo.ld.popx(ptr %p, <32 x i32> %fifo.buf, i32 %avail, <16 x i32> %pos, i32 63)
  %data = extractvalue { <64 x i8>, ptr, <32 x i32>, i32, <16 x i32> } %pop, 0
  %p.next = extractvalue { <64 x i8>, ptr, <32 x i32>, i32, <16 x i32> } %pop, 1
  %fifo.buf.next = extractvalue { <64 x i8>, ptr, <32 x i32>, i32, <16 x i32> } %pop, 2
  %avail.next = extractvalue { <64 x i8>, ptr, <32 x i32>, i32, <16 x i32> } %pop, 3
  %pos.next = extractvalue { <64 x i8>, ptr, <32 x i32>, i32, <16 x i32> } %pop, 4
  %b0 = extractelement <64 x i8> %data, i64 0
  store volatile i8 %b0, ptr %sink, align 1
  %dec = call i1 @llvm.loop.decrement.i32(i32 1)
  br i1 %dec, label %for.body, label %for.exit, !llvm.loop !16

for.exit:
  ret void
}

