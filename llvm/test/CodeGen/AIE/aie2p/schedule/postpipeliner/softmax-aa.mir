  ; The goal of this test is to verify that we can't pipeline the code because the pointers are
  ; not in lockstep in the outermost loop (one additional update in one side).

  define void @softmax_row_major_fail_not_lockstep(ptr noalias nocapture readnone %ifm, ptr noalias %ofm, i32 noundef %rows, i32 noundef %cols) local_unnamed_addr #0 {
  ; CHECK-LABEL: softmax_row_major_fail_not_lockstep:
  ; CHECK:         .p2align 4
  ; CHECK-NEXT:  // %bb.0: // %entry
  ; CHECK-NEXT:    mova r2, #0
  ; CHECK-NEXT:    ge r2, r2, r0
  ; CHECK-NEXT:    jnz r2, #.LBB3_5
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ; CHECK-NEXT:  // %bb.1: // %for.cond2.preheader.lr.ph
  ; CHECK-NEXT:    movxm r2, #16256
  ; CHECK-NEXT:    mova m0, #32; movx r3, #-4
  ; CHECK-NEXT:    mova r2, #828; movs p0, p1; ashl r1, r1, r3; vbcst.16 x0, r2
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB3_2: // %for.cond2.preheader
  ; CHECK-NEXT:    // =>This Loop Header: Depth=1
  ; CHECK-NEXT:    // Child Loop BB3_3 Depth 2
  ; CHECK-NEXT:    nopa ; nopx ; add.nc lc, r1, #0
  ; CHECK-NEXT:    movxm ls, #.LBB3_3
  ; CHECK-NEXT:    padda [p1], m0; nopb ; nops ; movxm le, #.L_LEnd3; nopv
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB3_3: // %for.body5
  ; CHECK-NEXT:    // Parent Loop BB3_2 Depth=1
  ; CHECK-NEXT:    // => This Inner Loop Header: Depth=2
  ; CHECK-NEXT:    nopa ; vldb wl2, [p1], #32; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nops ; nopxm ; nopv
  ; CHECK-NEXT:    nopa ; nopb ; nopxm ; nops
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    vmul.f dm0, x2, x0, r2
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:    nop
  ; CHECK-NEXT:  .L_LEnd3:
  ; CHECK-NEXT:    nopa ; nopb ; vst.conv.bf16.fp32 bmll0, [p0], #32; nopxm ; nopv
  ; CHECK-NEXT:  // %bb.4: // %for.cond.cleanup4
  ; CHECK-NEXT:    // in Loop: Header=BB3_2 Depth=1
  ; CHECK-NEXT:    nopa ; nopb ; nops ; add r0, r0, #-1; nopm ; nopv
  ; CHECK-NEXT:    jnz r0, #.LBB3_2
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  ; CHECK-NEXT:    .p2align 4
  ; CHECK-NEXT:  .LBB3_5: // %for.cond.cleanup
  ; CHECK-NEXT:    nopa ; ret lr
  ; CHECK-NEXT:    nop // Delay Slot 5
  ; CHECK-NEXT:    nop // Delay Slot 4
  ; CHECK-NEXT:    nop // Delay Slot 3
  ; CHECK-NEXT:    nop // Delay Slot 2
  ; CHECK-NEXT:    nop // Delay Slot 1
  entry:
    %shr = ashr i32 %cols, 4
    %cmp34 = icmp sgt i32 %rows, 0
    br i1 %cmp34, label %for.cond2.preheader.lr.ph, label %for.cond.cleanup

  for.cond2.preheader.lr.ph:                        ; preds = %entry
    br label %for.cond2.preheader

  for.cond2.preheader:                              ; preds = %for.cond.cleanup4, %for.cond2.preheader.lr.ph
    %lsr.iv41 = phi i32 [ %rows, %for.cond2.preheader.lr.ph ], [ %lsr.iv.next42, %for.cond.cleanup4 ]
    %it_scale.sroa.0.036 = phi ptr [ %ofm, %for.cond2.preheader.lr.ph ], [ %add.ptr.i.i.i.i, %for.cond.cleanup4 ]
    %it_soft_out.sroa.0.035 = phi ptr [ %ofm, %for.cond2.preheader.lr.ph ], [ %add.ptr.i.i.i.i28, %for.cond.cleanup4 ]
    %addx = getelementptr inbounds i8, ptr %it_scale.sroa.0.036, i20 32
    call void @llvm.set.loop.iterations.i32(i32 %shr)
    br label %for.body5

  for.cond.cleanup:                                 ; preds = %for.cond.cleanup4, %entry
    ret void

  for.cond.cleanup4:                                ; preds = %for.body5
    %lsr.iv.next42 = add i32 %lsr.iv41, -1
    %exitcond40.not = icmp eq i32 %lsr.iv.next42, 0
    br i1 %exitcond40.not, label %for.cond.cleanup, label %for.cond2.preheader, !llvm.loop !2

  for.body5:                                        ; preds = %for.body5, %for.cond2.preheader
    %it_scale.sroa.0.132 = phi ptr [ %addx, %for.cond2.preheader ], [ %add.ptr.i.i.i.i, %for.body5 ]
    %it_soft_out.sroa.0.131 = phi ptr [ %it_soft_out.sroa.0.035, %for.cond2.preheader ], [ %add.ptr.i.i.i.i28, %for.body5 ]
    %add.ptr.i.i.i.i = getelementptr inbounds i8, ptr %it_scale.sroa.0.132, i20 32
    %in_elems.sroa.0.0.copyload = load <8 x i32>, ptr %it_scale.sroa.0.132, align 64
    %shuffle.i.i.i.i.i.i.i.i.i.i.i.i.i.i.i.i.i = shufflevector <8 x i32> %in_elems.sroa.0.0.copyload, <8 x i32> undef, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
    %0 = bitcast <16 x i32> %shuffle.i.i.i.i.i.i.i.i.i.i.i.i.i.i.i.i.i to <32 x bfloat>
    %1 = tail call noundef <32 x float> @llvm.aie2p.I512.I512.ACC1024.bf.mul.conf(<32 x bfloat> %0, <32 x bfloat> <bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat 0xR3F80, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef, bfloat undef>, i32 828)
    %2 = shufflevector <32 x float> %1, <32 x float> poison, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
    %3 = tail call noundef <16 x bfloat> @llvm.aie2p.v16accfloat.to.v16bf16(<16 x float> %2)
    %add.ptr.i.i.i.i28 = getelementptr inbounds i8, ptr %it_soft_out.sroa.0.131, i20 32
    store <16 x bfloat> %3, ptr %it_soft_out.sroa.0.131, align 64
    %4 = call i1 @llvm.loop.decrement.i32(i32 1)
    br i1 %4, label %for.body5, label %for.cond.cleanup4, !llvm.loop !5
  }

