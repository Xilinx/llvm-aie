    %0 = bitcast <32 x i16> %splat.splat.i.i.i.i.i.i.i.i.i.i to <16 x i32>
    %shuffle.i.i.i.i.i13.i.i.i.i.i.i.i.i.i.i.i.i = shufflevector <16 x i32> %0, <16 x i32> undef, <32 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15, i32 16, i32 17, i32 18, i32 19, i32 20, i32 21, i32 22, i32 23, i32 24, i32 25, i32 26, i32 27, i32 28, i32 29, i32 30, i32 31>
