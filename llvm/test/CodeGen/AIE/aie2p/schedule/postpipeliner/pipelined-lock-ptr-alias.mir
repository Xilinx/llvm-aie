# RUN: llc --mtriple=aie2p -O2 --run-pass=postmisched --aie-loop-min-tripcount=16 %s -o - | FileCheck %s

# Exercises alias-aware lock spacing in AIERegMemEventTracker via EmitFixedSUnits
# for pipelined prologue/epilogue scheduling (distinct from same-block LockDelays
# coverage in aie2p-lock-ptr-alias.ll).
#
# Epilogue REL_ptr: stall-before-lock uses getSafeOperandsDistanceFromTop().
# Prologue ACQ_ptr: resume-after-lock uses getSafeOperandsDistanceFromBottom().
#
# Pointer-coupled locks use annotative MMOs tied to distinct IR allocas so AA can
# distinguish same-buffer vs disjoint-buffer cases.

--- |
  target triple = "aie2p"

  define void @epilogue_release_ptr_same_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @epilogue_release_ptr_disjoint_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @prologue_acquire_ptr_same_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @prologue_acquire_ptr_disjoint_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @prologue_release_ptr_same_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @prologue_release_ptr_disjoint_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @epilogue_acquire_ptr_same_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

  define void @epilogue_acquire_ptr_disjoint_buffer() {
  entry:
    %store_buf = alloca i32, align 4
    %lock_buf = alloca i32, align 4
    unreachable
  }

---
name:            epilogue_release_ptr_same_buffer
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, name: store_buf, offset: -8, size: 4, alignment: 4 }
  - { id: 1, name: lock_buf, offset: -4, size: 4, alignment: 4 }
body:             |
  ; CHECK-LABEL: name: epilogue_release_ptr_same_buffer
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r0, $r18, $m0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $x0, implicit-def $p0, implicit-def $lc, implicit killed $p0, implicit $r0 {
  ; CHECK-NEXT:     $x0, $p0 = VLDB_dmx_ldb_x_pstm_nrm_imm killed $p0, 64
  ; CHECK-NEXT:     $lc = ADD_NC_mv_add_ri $r0, -2
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $ls = MOVXM %bb.2
  ; CHECK-NEXT:   $le = MOVXM <mcsymbol .L_LEnd0>
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r0, $m0, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = VADD_16 killed $x0, $x0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $p1 = VST_dmx_sts_x_pstm_nrm_imm $x0, killed $p1, 64 :: (store (s32) into %ir.store_buf)
  ; CHECK-NEXT:   PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $p0, $p1, $r18, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   REL_mLockId_imm 49, killed renamable $r18 :: (load unknown-size from %ir.store_buf, align 1)
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   $p1 = VST_dmx_sts_x_pstm_nrm_imm $x0, killed $p1, 64 :: (store (s32) into %ir.store_buf)
  ; CHECK-NEXT:   $p1 = VST_dmx_sts_x_pstm_nrm_imm killed $x0, killed $p1, 64 :: (store (s32) into %ir.store_buf)
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $p0, $p1, $r0, $r18, $m0

    $lc = ADD_NC_mv_add_ri $r0, -2
    $ls = MOVXM %bb.2
    $le = MOVXM <mcsymbol .L_LEnd0>
    $x0, $p0 = VLD_x_pstm_nrm_imm_pseudo $p0, 64

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $p0, $p1, $r0, $m0, $x0

    $x0 = VADD_16 $x0, $x0
    $p1 = VST_dmx_sts_x_pstm_nrm_imm $x0, $p1, 64 :: (store (s32) into %ir.store_buf)
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.1

  bb.2:
    liveins: $p0, $p1, $r18, $x0
    REL_mLockId_imm 49, renamable $r18 :: (load unknown-size from %ir.store_buf, align 1)
    $p1 = VST_dmx_sts_x_pstm_nrm_imm $x0, $p1, 64 :: (store (s32) into %ir.store_buf)
    $p1 = VST_dmx_sts_x_pstm_nrm_imm $x0, $p1, 64 :: (store (s32) into %ir.store_buf)
    RET implicit $lr
    DelayedSchedBarrier
...

