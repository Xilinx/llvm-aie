# RUN: llc --mtriple=aie2p --run-pass=postmisched %s -o - | FileCheck %s

# The callee is invisible to the region that ends at a call, so the bottom
# scoreboard blocks every cycle after it: the ACQ's lock request (LCKREQ, four
# cycles) must end before the callee's first bundle, which may read the buffer
# the lock guards. acq_call shows it in a block that is not a loop. In
# acq_call_loop the block is a loop, scheduled loop-aware, and the call region
# must get the same scoreboard as in acq_call: the loop's resource cap only
# describes the cycles after the bottom region, the loop's back edge.

---
name:            acq_call
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0, $p1, $r8
    ; CHECK-LABEL: name: acq_call
    ; CHECK: liveins: $p0, $p1, $r8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: JL_lng 0, implicit-def $lr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: ACQ_mLockId_imm 49, killed $r8
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: DelayedSchedBarrier implicit killed $p0, implicit killed $p1
    ; CHECK-NEXT: RET implicit $lr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: DelayedSchedBarrier
    ACQ_mLockId_imm 49, $r8
    JL_lng 0, implicit-def $lr
    DelayedSchedBarrier implicit killed $p0, implicit killed $p1
    RET implicit $lr
    DelayedSchedBarrier
...

---
name:            acq_call_loop
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: acq_call_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r8, $r9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $p0, $p1, $r8, $r9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JL_lng 0, implicit-def $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   ACQ_mLockId_imm 49, $r8
  ; CHECK-NEXT:   DelayedSchedBarrier implicit $p0, implicit $p1
  ; CHECK-NEXT:   JNZ $r9, %bb.1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET implicit $lr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   DelayedSchedBarrier
  bb.0:
    successors: %bb.1
    liveins: $p0, $p1, $r8, $r9

  bb.1:
    successors: %bb.2, %bb.1
    liveins: $p0, $p1, $r8, $r9
    ACQ_mLockId_imm 49, $r8
    JL_lng 0, implicit-def $lr
    DelayedSchedBarrier implicit $p0, implicit $p1
    JNZ $r9, %bb.1
    DelayedSchedBarrier

  bb.2:
    RET implicit $lr
    DelayedSchedBarrier
...
