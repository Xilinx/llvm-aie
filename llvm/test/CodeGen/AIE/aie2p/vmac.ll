entry:
  %0 = bitcast <64 x i8> %a to <16 x i32>
  %1 = tail call <16 x i32> @llvm.aie2p.vshuffle(<16 x i32> %0, <16 x i32> undef, i32 50)
  %shuffle.i.i.i = shufflevector <16 x i32> %1, <16 x i32> poison, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %shuffle1.i.i.i = shufflevector <16 x i32> %1, <16 x i32> poison, <8 x i32> <i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %2 = bitcast <128 x i8> %b to <32 x i32>
  %shuffle.i.i19.i = shufflevector <32 x i32> %2, <32 x i32> poison, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %3 = bitcast <16 x i32> %shuffle.i.i19.i to <64 x i8>
  %tobool.i = icmp ne i32 %sgn_y, 0
  %conv.i.i = zext i1 %tobool.i to i32
  %4 = tail call noundef <128 x i8> @llvm.aie2p.unpack.I1024.I8.I4(<64 x i8> %3, i32 %conv.i.i)
  %shuffle1.i.i20.i = shufflevector <32 x i32> %2, <32 x i32> poison, <16 x i32> <i32 16, i32 17, i32 18, i32 19, i32 20, i32 21, i32 22, i32 23, i32 24, i32 25, i32 26, i32 27, i32 28, i32 29, i32 30, i32 31>
  %5 = bitcast <16 x i32> %shuffle1.i.i20.i to <64 x i8>
  %6 = tail call noundef <128 x i8> @llvm.aie2p.unpack.I1024.I8.I4(<64 x i8> %5, i32 %conv.i.i)
  %shuffle.i.i22.i = shufflevector <8 x i32> %shuffle1.i.i.i, <8 x i32> undef, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %shl1.i.i.i = shl i32 %shift16, 10
  %shl2.i.i.i = shl i32 %sub_mul, 11
  %shl4.i.i.i = shl i32 %sub_acc1, 12
  %shl14.i.i.i = shl i32 %sgn_x, 9
  %shl15.i.i.i = shl i32 %sgn_y, 8
  %or3.i.i.i = or i32 %shl15.i.i.i, %shl14.i.i.i
  %7 = or i32 %shl1.i.i.i, %zero_acc1
  %8 = or i32 %7, %shl2.i.i.i
  %9 = or i32 %8, %shl4.i.i.i
  %or16.i.i.i = or i32 %9, %or3.i.i.i
  %or17.i.i.i = or i32 %or16.i.i.i, 200
  %10 = bitcast <128 x i8> %6 to <64 x i16>
  %11 = bitcast <64 x i32> %acc1 to <32 x i64>
  %12 = tail call <32 x i64> @llvm.aie2p.I512.I1024.ACC2048.msc.conf(<16 x i32> %shuffle.i.i22.i, <64 x i16> %10, <32 x i64> %11, i32 %or17.i.i.i)
  %shuffle.i.i23.i = shufflevector <8 x i32> %shuffle.i.i.i, <8 x i32> undef, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %shl6.i.i.i = shl i32 %sub_acc2, 13
  %or7.i.i27.i = or i32 %or3.i.i.i, %shl6.i.i.i
  %or19.i.i.i = or disjoint i32 %or7.i.i27.i, 200
  %13 = bitcast <128 x i8> %4 to <64 x i16>
  %14 = bitcast <64 x i32> %acc2 to <32 x i64>
  %15 = tail call <32 x i64> @llvm.aie2p.I512.I1024.ACC2048.addmsc.conf(<16 x i32> %shuffle.i.i23.i, <64 x i16> %13, <32 x i64> %12, <32 x i64> %14, i32 %or19.i.i.i)
  %16 = bitcast <32 x i64> %15 to <64 x i32>
  ret <64 x i32> %16
