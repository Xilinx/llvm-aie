; CHECK-NEXT:    [[RUNS_TWICE:%.*]] = icmp ugt i32 [[OUTER_TRIP]], 1
; CHECK-NEXT:    br i1 [[RUNS_TWICE]], label %[[OUTER_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[OUTER_HWLOOP_START:%.*]] = call i32 @llvm.start.loop.iterations.i32(i32 [[OUTER_TRIP]])
; CHECK-NEXT:    br label %[[STAGE0_TOP:.*]]
; CHECK:       [[STAGE0_TOP]]:
; CHECK-NEXT:    [[IN_VAL_STEADY_TOP:%.*]] = load i32, ptr [[IN]], align 4
; CHECK-NEXT:    br label %[[STEADY_STAGE1_TOP:.*]]
; CHECK:       [[STEADY_STAGE1_TOP]]:
; CHECK-NEXT:    [[OUTER_REMAINING_STEADY:%.*]] = phi i32 [ [[OUTER_HWLOOP_START]], %[[STAGE0_TOP]] ], [ [[OUTER_REMAINING_NEXT_STEADY:%.*]], %[[STEADY_STAGE1_BOTTOM_AND_STAGE0_TOP:.*]] ]
; CHECK-NEXT:    [[IN_PTR_STEADY:%.*]] = phi ptr [ [[IN]], %[[STAGE0_TOP]] ], [ [[IN_PTR_NEXT_STEADY:%.*]], %[[STEADY_STAGE1_BOTTOM_AND_STAGE0_TOP]] ]
; CHECK-NEXT:    [[OUT_PTR_STEADY:%.*]] = phi ptr [ [[OUT]], %[[STAGE0_TOP]] ], [ [[OUT_PTR_NEXT_STEADY:%.*]], %[[STEADY_STAGE1_BOTTOM_AND_STAGE0_TOP]] ]
; CHECK-NEXT:    [[IN_VAL_STEADY_PHI:%.*]] = phi i32 [ [[IN_VAL_STEADY_TOP]], %[[STAGE0_TOP]] ], [ [[IN_VAL_STEADY_BOTTOM:%.*]], %[[STEADY_STAGE1_BOTTOM_AND_STAGE0_TOP]] ]
; CHECK-NEXT:    call void @llvm.set.loop.iterations.i32(i32 [[INNER_TRIP]])
; CHECK-NEXT:    [[IN_PTR_NEXT_STEADY]] = getelementptr inbounds i32, ptr [[IN_PTR_STEADY]], i32 1
; CHECK-NEXT:    [[OUT_PTR_NEXT_STEADY]] = getelementptr inbounds i32, ptr [[OUT_PTR_STEADY]], i32 1
