name: test_fmul_s32
body: |
  bb.0:
    liveins: $r1, $r2, $p0
    ; CHECK-LABEL: name: test_fmul_s32
    ; CHECK: liveins: $r1, $r2, $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r2
