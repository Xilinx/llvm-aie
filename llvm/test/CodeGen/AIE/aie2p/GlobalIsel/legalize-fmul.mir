    %2:_(s32) = COPY $r2
    %4:_(s32) = G_FMUL %0, %2
    $r0 = COPY %4(s32)
    PseudoRET implicit $lr, implicit $r0
...

---
name: test_fmul_s64
body: |
  bb.0:
    liveins: $l1, $l2, $p0
    ; CHECK-LABEL: name: test_fmul_s64
    ; CHECK: liveins: $l1, $l2, $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s64) = COPY $l1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s64) = COPY $l2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[COPY]](s64)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(s32), [[UV3:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[COPY1]](s64)
    ; CHECK-NEXT: $r2 = COPY [[UV]](s32)
    ; CHECK-NEXT: $r3 = COPY [[UV1]](s32)
    ; CHECK-NEXT: $r4 = COPY [[UV2]](s32)
    ; CHECK-NEXT: $r5 = COPY [[UV3]](s32)
    ; CHECK-NEXT: PseudoJL &__muldf3, csr_aie2p, implicit-def $lr, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit-def $r0, implicit-def $r1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r0
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[COPY2]](s32), [[COPY3]](s32)
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: $l0 = COPY [[MV]](s64)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $r0
    %0:_(s64) = COPY $l1
    %2:_(s64) = COPY $l2
    %4:_(s64) = G_FMUL %0, %2
    $l0 = COPY %4(s64)
    PseudoRET implicit $lr, implicit $r0
...
