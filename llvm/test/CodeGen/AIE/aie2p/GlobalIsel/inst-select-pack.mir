name:            pack_from_I512_to_64lanes_of_I4
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $r0, $x2

    ; CHECK-LABEL: name: pack_from_I512_to_64lanes_of_I4
    ; CHECK: liveins: $r0, $x2
    ; CHECK-NEXT: {{  $}}
