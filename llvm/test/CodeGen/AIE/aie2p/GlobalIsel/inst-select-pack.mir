    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: $packsign0 = COPY [[COPY1]]
    ; CHECK-NEXT: $crpacksize = MOV_scalar_imm11_pseudo 0
    ; CHECK-NEXT: [[VPACK_mv_pack_w_packSign0_:%[0-9]+]]:vec256 = VPACK_mv_pack_w_packSign0 [[COPY]], implicit $crpacksize, implicit $crsat, implicit $packsign0
    ; CHECK-NEXT: $packsign0 = MOV_scalar_imm11_pseudo 0
    ; CHECK-NEXT: $wl0 = COPY [[VPACK_mv_pack_w_packSign0_]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $wl0
    %1:vregbank(<64 x s8>) = COPY $x2
    %2:gprregbank(s32) = COPY $r0
    %0:vregbank(<32 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.pack.I512.I4.I8), %1(<64 x s8>), %2(s32)
    $wl0 = COPY %0(<32 x s8>)
    PseudoRET implicit $lr, implicit $wl0

