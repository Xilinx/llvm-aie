# RUN: llc -mtriple aie2p -run-pass=instruction-select %s -verify-machineinstrs -o - | FileCheck %s

# Regression test for the -O0 ICE in
# https://github.com/Xilinx/llvm-aie/issues/847
#
# A store whose value is the mantissa result of a bfp16 conversion intrinsic
# (v64accfloat_to_v64bfp16ebs8 / ebs16) must NOT be folded into the
# store-convert (VST.CONV) combine. Those intrinsics produce an aggregate
# {mantissa, exponent} value (two defs), which shifts the intrinsic source to
# operand 3 and made the combine read operand 2 (the intrinsic ID) as a
# register -- the isReg() assertion failure in selectG_AIE_STORE_CONV. The
# conversion is instead selected as a register VCONV and the mantissa stored
# with a plain vector store.

---
name:            store_bfp16ebs8_mantissa
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $dm0, $p0
    ; CHECK-LABEL: name: store_bfp16ebs8_mantissa
    ; CHECK: liveins: $dm0, $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:acc2048 = COPY $dm0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: [[VCONV_bfp16ebs8_fp32_:%[0-9]+]]:mexa = VCONV_bfp16ebs8_fp32 [[COPY]], implicit-def $srf2bflags, implicit $crf2bmask, implicit $crrnd
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vec512 = COPY [[VCONV_bfp16ebs8_fp32_]].sub_bfp16_x
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:expvec64 = COPY [[VCONV_bfp16ebs8_fp32_]].sub_bfp16_e
    ; CHECK-NEXT: VST_dmx_sts_x_idx_imm [[COPY2]], [[COPY1]], 0 :: (store (<64 x s8>))
    ; CHECK-NEXT: PseudoRET implicit $lr
    %1:accregbank(<64 x s32>) = COPY $dm0
    %2:ptrregbank(p0) = COPY $p0
    %0:vregbank(<64 x s8>), %3:gprregbank(<8 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.v64accfloat.to.v64bfp16ebs8), %1(<64 x s32>)
    G_STORE %0(<64 x s8>), %2(p0) :: (store (<64 x s8>))
    PseudoRET implicit $lr
...

---
