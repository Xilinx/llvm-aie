# This tests that even if one of the load's defs is used before the VCONV, we still combine if that
# use is part of a dead instruction
---
name:            VLD_CONV_dead_use_256
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $p0, $m0, $r0
    ; CHECK-LABEL: name: VLD_CONV_dead_use_256
    ; CHECK: liveins: $p0, $m0, $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:em = COPY $m0
    ; CHECK-NEXT: [[VLDA_CONV_fp32_bf16_dmw_lda_ups_bf_pstm_nrm:%[0-9]+]]:acc512, [[VLDA_CONV_fp32_bf16_dmw_lda_ups_bf_pstm_nrm1:%[0-9]+]]:ep = VLDA_CONV_fp32_bf16_dmw_lda_ups_bf_pstm_nrm [[COPY]], [[COPY1]] :: (load (<16 x s16>))
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VLDA_CONV_fp32_bf16_dmw_lda_ups_bf_pstm_nrm]]
    %0:ptrregbank(p0) = COPY $p0
    %7:modregbank(s20) = COPY $m0
    %70:gprregbank(s32) = COPY $r0
    %25:vregbank(<16 x s16>), %19:ptrregbank(p0) = G_AIE_POSTINC_LOAD %0, %7 :: (load (<16 x s16>))
    %190:ptrregbank(p0) = COPY %19:ptrregbank(p0)
    %103:accregbank(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2p.v16bf16.to.v16accfloat), %25:vregbank(<16 x s16>)
    PseudoRET implicit $lr, implicit %103
...

