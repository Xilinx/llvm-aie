# v16accfloat_to_v16bf16 "mayLoad". But it should not try and combine with VCONV_fp32_bf16_mv_ups_wbf.
---
name:            no_combine_256
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $bmlh0
    ; CHECK-LABEL: name: no_combine_256
    ; CHECK: liveins: $bmlh0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:acc512 = COPY $bmlh0
    ; CHECK-NEXT: [[VCONV_bf16_fp32_mv_w_srs_bf:%[0-9]+]]:vec256 = VCONV_bf16_fp32_mv_w_srs_bf [[COPY]], implicit-def dead $srf2fflags, implicit $crf2fmask, implicit $crrnd
    ; CHECK-NEXT: [[VCONV_fp32_bf16_mv_ups_wbf:%[0-9]+]]:acc512 = VCONV_fp32_bf16_mv_ups_wbf [[VCONV_bf16_fp32_mv_w_srs_bf]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VCONV_fp32_bf16_mv_ups_wbf]]
    %1:accregbank(<16 x s32>) = COPY $bmlh0
    %2:vregbank(<16 x s16>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.v16accfloat.to.v16bf16), %1:accregbank(<16 x s32>)
    %3:accregbank(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2p.v16bf16.to.v16accfloat), %2:vregbank(<16 x s16>)
    PseudoRET implicit $lr, implicit %3
...

