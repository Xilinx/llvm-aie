# RUN: llc -mtriple aie2p -run-pass=aie-post-select-optimize %s -verify-machineinstrs -o - | FileCheck %s
# RUN: llc -mtriple aie2p -run-pass=aie-post-select-optimize -assume-4xload-ro-data=false %s -verify-machineinstrs -o - | FileCheck %s --check-prefix=NORO --implicit-check-not=__aie_common_lookup_table

# 4x loads whose address vector does not lead to the tables. Under
# -assume-4xload-ro-data they get the common lookup table; without it they keep
# no memory operands. Neither crashes.

--- |
  @lut_ab = external global [0 x float]
  @lut_cd = external global [0 x float]

  define void @offset_globals() { ret void }
  define void @constant_bases() { ret void }
  define void @integer_argument_bases() { ret void }
  define void @undefined_base() { ret void }
  define void @loaded_address() { ret void }
  define void @loop_carried_address() { ret void }
...

