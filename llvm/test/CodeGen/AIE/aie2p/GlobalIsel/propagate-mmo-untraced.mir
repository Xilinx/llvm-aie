# Addresses advanced in the loop: ADD (PHI, BROADCAST(4))

---
name:            loop_carried_address
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: loop_carried_address
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0, $r0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:ep = COPY $p0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:er = COPY $r0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vec512 = COPY $x2
  ; CHECK-NEXT:   [[MOV_RLC_imm11_pseudo:%[0-9]+]]:er = MOV_RLC_imm11_pseudo 4
  ; CHECK-NEXT:   [[VBCST_32_:%[0-9]+]]:vec512 = VBCST_32 [[MOV_RLC_imm11_pseudo]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vec512 = PHI [[COPY2]], %bb.0, %6, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:ep = PHI [[COPY]], %bb.0, %8, %bb.1
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:er = PHI [[COPY1]], %bb.0, %10, %bb.1
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vec256 = COPY [[PHI]].sub_256_lo
  ; CHECK-NEXT:   [[VLDB_4x32_lo:%[0-9]+]]:ewl = VLDB_4x32_lo [[COPY3]] :: (load unknown-size from @__aie_common_lookup_table, align 1)
  ; CHECK-NEXT:   [[VLDB_4x32_hi:%[0-9]+]]:ewh = VLDB_4x32_hi [[COPY3]] :: (load unknown-size from @__aie_common_lookup_table, align 1)
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vec512 = REG_SEQUENCE [[VLDB_4x32_lo]], %subreg.sub_256_lo, [[VLDB_4x32_hi]], %subreg.sub_256_hi
  ; CHECK-NEXT:   [[VST_dmx_sts_x_pstm_nrm_imm:%[0-9]+]]:ep = VST_dmx_sts_x_pstm_nrm_imm [[REG_SEQUENCE]], [[PHI1]], 64 :: (store (<16 x s32>))
  ; CHECK-NEXT:   [[VADD_32_:%[0-9]+]]:vec512 = VADD_32 [[PHI]], [[VBCST_32_]]
  ; CHECK-NEXT:   [[ADD_add_r_ri:%[0-9]+]]:er = ADD_add_r_ri [[PHI2]], -1, implicit-def dead $srcarry
  ; CHECK-NEXT:   PseudoJNZ [[ADD_add_r_ri]], %bb.1
  ; CHECK-NEXT:   PseudoJ_jump_imm %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  ;
  ; NORO-LABEL: name: loop_carried_address
  ; NORO: bb.0:
  ; NORO-NEXT:   successors: %bb.1(0x80000000)
  ; NORO-NEXT:   liveins: $p0, $r0, $x2
  ; NORO-NEXT: {{  $}}
  ; NORO-NEXT:   [[COPY:%[0-9]+]]:ep = COPY $p0
  ; NORO-NEXT:   [[COPY1:%[0-9]+]]:er = COPY $r0
  ; NORO-NEXT:   [[COPY2:%[0-9]+]]:vec512 = COPY $x2
  ; NORO-NEXT:   [[MOV_RLC_imm11_pseudo:%[0-9]+]]:er = MOV_RLC_imm11_pseudo 4
  ; NORO-NEXT:   [[VBCST_32_:%[0-9]+]]:vec512 = VBCST_32 [[MOV_RLC_imm11_pseudo]]
  ; NORO-NEXT: {{  $}}
  ; NORO-NEXT: bb.1:
  ; NORO-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NORO-NEXT: {{  $}}
  ; NORO-NEXT:   [[PHI:%[0-9]+]]:vec512 = PHI [[COPY2]], %bb.0, %6, %bb.1
  ; NORO-NEXT:   [[PHI1:%[0-9]+]]:ep = PHI [[COPY]], %bb.0, %8, %bb.1
  ; NORO-NEXT:   [[PHI2:%[0-9]+]]:er = PHI [[COPY1]], %bb.0, %10, %bb.1
  ; NORO-NEXT:   [[COPY3:%[0-9]+]]:vec256 = COPY [[PHI]].sub_256_lo
  ; NORO-NEXT:   [[VLDB_4x32_lo:%[0-9]+]]:ewl = VLDB_4x32_lo [[COPY3]]
  ; NORO-NEXT:   [[VLDB_4x32_hi:%[0-9]+]]:ewh = VLDB_4x32_hi [[COPY3]]
  ; NORO-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vec512 = REG_SEQUENCE [[VLDB_4x32_lo]], %subreg.sub_256_lo, [[VLDB_4x32_hi]], %subreg.sub_256_hi
  ; NORO-NEXT:   [[VST_dmx_sts_x_pstm_nrm_imm:%[0-9]+]]:ep = VST_dmx_sts_x_pstm_nrm_imm [[REG_SEQUENCE]], [[PHI1]], 64 :: (store (<16 x s32>))
  ; NORO-NEXT:   [[VADD_32_:%[0-9]+]]:vec512 = VADD_32 [[PHI]], [[VBCST_32_]]
  ; NORO-NEXT:   [[ADD_add_r_ri:%[0-9]+]]:er = ADD_add_r_ri [[PHI2]], -1, implicit-def dead $srcarry
  ; NORO-NEXT:   PseudoJNZ [[ADD_add_r_ri]], %bb.1
  ; NORO-NEXT:   PseudoJ_jump_imm %bb.2
  ; NORO-NEXT: {{  $}}
  ; NORO-NEXT: bb.2:
  ; NORO-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1
    liveins: $p0, $r0, $x2

    %0:ep = COPY $p0
    %1:er = COPY $r0
    %2:vec512 = COPY $x2
    %3:er = MOV_RLC_imm11_pseudo 4
    %4:vec512 = VBCST_32 %3

  bb.1:
    successors: %bb.1, %bb.2

    %5:vec512 = PHI %2, %bb.0, %6, %bb.1
    %7:ep = PHI %0, %bb.0, %8, %bb.1
    %9:er = PHI %1, %bb.0, %10, %bb.1
    %11:vec256 = COPY %5.sub_256_lo
    %12:ewl = VLDB_4x32_lo %11
    %13:ewh = VLDB_4x32_hi %11
    %14:vec512 = REG_SEQUENCE %12, %subreg.sub_256_lo, %13, %subreg.sub_256_hi
    %8:ep = VST_dmx_sts_x_pstm_nrm_imm %14, %7, 64 :: (store (<16 x s32>))
    %6:vec512 = VADD_32 %5, %4
    %10:er = ADD_add_r_ri %9, -1, implicit-def dead $srcarry
    PseudoJNZ %10, %bb.1
    PseudoJ_jump_imm %bb.2

  bb.2:
    PseudoRET implicit $lr
...
