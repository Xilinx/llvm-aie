    ; CHECK-NEXT: [[UV16:%[0-9]+]]:_(<4 x s64>), [[UV17:%[0-9]+]]:_(<4 x s64>) = G_UNMERGE_VALUES [[AIE_ADD_VECTOR_ELT_HI3]](<8 x s64>)
