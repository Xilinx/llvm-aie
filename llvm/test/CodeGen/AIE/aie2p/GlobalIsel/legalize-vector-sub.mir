    ; CHECK-NEXT: [[AIE_SEXT_EXTRACT_VECTOR_ELT4:%[0-9]+]]:_(s64) = G_AIE_SEXT_EXTRACT_VECTOR_ELT [[CONCAT_VECTORS4]](<8 x s64>), [[C]](s32)
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:_(<4 x s64>) = COPY [[DEF]](<4 x s64>)
