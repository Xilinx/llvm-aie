    ; CHECK-NEXT: [[AIE_UNPAD_VECTOR:%[0-9]+]]:_(<16 x s8>) = G_AIE_UNPAD_VECTOR [[COPY]](<32 x s8>)
    ; CHECK-NEXT: [[AIE_UNPAD_VECTOR1:%[0-9]+]]:_(<16 x s8>) = G_AIE_UNPAD_VECTOR [[COPY1]](<32 x s8>)
    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF:%[0-9]+]]:_(<64 x s8>) = G_AIE_PAD_VECTOR_UNDEF [[AIE_UNPAD_VECTOR]](<16 x s8>)
    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF1:%[0-9]+]]:_(<64 x s8>) = G_AIE_PAD_VECTOR_UNDEF [[AIE_UNPAD_VECTOR1]](<16 x s8>)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(<64 x s8>) = G_SUB [[AIE_PAD_VECTOR_UNDEF]], [[AIE_PAD_VECTOR_UNDEF1]]
    ; CHECK-NEXT: [[AIE_UNPAD_VECTOR2:%[0-9]+]]:_(<16 x s8>) = G_AIE_UNPAD_VECTOR [[SUB]](<64 x s8>)
    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF2:%[0-9]+]]:_(<32 x s8>) = G_AIE_PAD_VECTOR_UNDEF [[AIE_UNPAD_VECTOR2]](<16 x s8>)
    ; CHECK-NEXT: $wl0 = COPY [[AIE_PAD_VECTOR_UNDEF2]](<32 x s8>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $wl0
    %1:_(<32 x s8>) = COPY $wl2
    %2:_(<32 x s8>) = COPY $wl4
    %3:_(<16 x s8>) = G_AIE_UNPAD_VECTOR %1(<32 x s8>)
    %4:_(<16 x s8>) = G_AIE_UNPAD_VECTOR %2(<32 x s8>)
    %0:_(<16 x s8>) = G_SUB %3, %4
    %5:_(<32 x s8>) = G_AIE_PAD_VECTOR_UNDEF %0(<16 x s8>)
    $wl0 = COPY %5(<32 x s8>)
    PseudoRET implicit $lr, implicit $wl0
...
