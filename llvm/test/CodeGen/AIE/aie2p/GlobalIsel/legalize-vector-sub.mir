    ; CHECK-NEXT: [[AIE_SEXT_EXTRACT_VECTOR_ELT3:%[0-9]+]]:_(s64) = G_AIE_SEXT_EXTRACT_VECTOR_ELT [[CONCAT_VECTORS3]](<8 x s64>), [[C3]](s32)
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:_(<4 x s64>) = COPY [[DEF]](<4 x s64>)
