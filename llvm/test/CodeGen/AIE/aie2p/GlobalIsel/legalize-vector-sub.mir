    ; CHECK-NEXT: [[AIE_SEXT_EXTRACT_VECTOR_ELT6:%[0-9]+]]:_(s64) = G_AIE_SEXT_EXTRACT_VECTOR_ELT [[CONCAT_VECTORS6]](<8 x s64>), [[C2]](s32)
    ; CHECK-NEXT: [[COPY8:%[0-9]+]]:_(<4 x s64>) = COPY [[DEF]](<4 x s64>)
