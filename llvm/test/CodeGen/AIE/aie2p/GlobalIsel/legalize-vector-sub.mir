    ; CHECK-NEXT: [[AIE_SEXT_EXTRACT_VECTOR_ELT5:%[0-9]+]]:_(s64) = G_AIE_SEXT_EXTRACT_VECTOR_ELT [[CONCAT_VECTORS5]](<8 x s64>), [[C1]](s32)
    ; CHECK-NEXT: [[COPY7:%[0-9]+]]:_(<4 x s64>) = COPY [[DEF]](<4 x s64>)
