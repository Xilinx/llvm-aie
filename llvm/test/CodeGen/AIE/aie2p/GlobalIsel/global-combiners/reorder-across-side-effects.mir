    ; CHECK-NEXT: %second:_(s32) = G_AIE_OFFSET_LOAD [[COPY]](p0), %off1(s20) :: (load (s32))
    ; CHECK-NEXT: %third:_(s32) = G_AIE_OFFSET_LOAD [[COPY]](p0), %off2(s20) :: (load (s32))
