    %ptr1:_(p0), %d0:_(s20), %d1:_(s20) = G_INTRINSIC intrinsic(@llvm.aie2p.add.3d), %0:_(p0), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20)

