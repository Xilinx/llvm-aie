# RUN: llc --mtriple=aie2p -verify-machineinstrs \
# RUN:  --start-before=aie-postlegalizer-generic-combiner \
# RUN:  --stop-after=aie-postlegalizer-custom-combiner \
# RUN:  --aie-address-chaining=false \
# RUN:  --aie-global-ptr-mod-opt=true \
# RUN:  -o - %s  | FileCheck %s

# OffsetCombiner must not hoist a load past a side-effecting instruction
# (e.g. a lock acquire/release). The acquire establishes a memory ordering
# constraint: loads after it must observe stores that completed before
# the corresponding release on another tile. Hoisting a load above the
# acquire breaks this contract.

# Single acquire between post-inc load and offset load.
---
name:            no_reorder_across_acquire
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0
    ; CHECK-LABEL: name: no_reorder_across_acquire
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: %lockid:_(s32) = G_CONSTANT i32 50
    ; CHECK-NEXT: %lockval:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %off:_(s20) = G_CONSTANT i20 12
    ; CHECK-NEXT: %first:_(s32), %ptr1:_(p0), %d0:_(s20), %d1:_ = G_AIE_POSTINC_3D_LOAD [[COPY]], %off, %off, %off, %off, %off, %off, %off :: (load (s32))
    ; CHECK-NEXT: G_STORE %first(s32), [[COPY]](p0) :: (store (s32))
    ; CHECK-NEXT: G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.acquire), %lockid(s32), %lockval(s32)
    ; CHECK-NEXT: %second:_(s32) = G_AIE_OFFSET_LOAD [[COPY]](p0), %off(s20) :: (load (s32))
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit %first(s32), implicit %second(s32), implicit %ptr1(p0)
    %0:_(p0) = COPY $p0
    %lockid:_(s32) = G_CONSTANT i32 50
    %lockval:_(s32) = G_CONSTANT i32 1
    %off:_(s20) = G_CONSTANT i20 12

    %first:_(s32) = G_LOAD %0(p0) :: (load (s32))
    G_STORE %first(s32), %0(p0) :: (store (s32))
    %ptr1:_(p0), %d0:_(s20), %d1:_(s20) = G_INTRINSIC intrinsic(@llvm.aie2p.add.3d), %0:_(p0), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20), %off:_(s20)

    G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.acquire), %lockid(s32), %lockval(s32)

    %addr:_(p0) = nuw G_PTR_ADD %0, %off(s20)
    %second:_(s32) = G_LOAD %addr(p0) :: (load (s32))

    PseudoRET implicit $lr, implicit %first, implicit %second, implicit %ptr1
...

