# Both combiner positions sit between two barriers (acquire before,
# release after). The load does not cross either barrier, so
# combination should proceed.
---
name:            reorder_allowed_barrier_around_both
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0
