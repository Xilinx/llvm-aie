    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s20) = G_CONSTANT i20 64
    %3:_(s32) = G_CONSTANT i32 -1
  bb.1:
    %4:_(s20) = G_ADD %2, %2
    G_STORE %4(s20), %0(p0) :: (store (s20))
    %5:_(s20) = G_LOAD %0(p0) :: (load (s20))
    %7:_(p0) = G_PTR_ADD %0(p0), %5(s20)
