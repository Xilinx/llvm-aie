# RUN: llc --mtriple=aie2p -verify-machineinstrs \
# RUN:  --start-before=aie-postlegalizer-generic-combiner \
# RUN:  --stop-after=aie-postlegalizer-custom-combiner \
# RUN: --aie-global-ptr-mod-opt=true \
# RUN:  -o - %s  | FileCheck %s

# Test case: G_PTR_ADD is inside a loop, but the memory instruction that uses
# the resulting pointer is outside the loop. This should NOT be combined into
# G_AIE_OFFSET_STORE because doing so would require the intermediate pointer
# value from the loop body to be live across the loop boundary, causing
# unnecessary register pressure.

---
name:            ptr-add-inside-loop-store-outside
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: ptr-add-inside-loop-store-outside
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $p0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $p0
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s20) = G_CONSTANT i20 64
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(s32) = G_CONSTANT i32 4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(s32) = G_PHI %5(s32), %bb.1, [[C2]](s32), %bb.0
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(s32) = nsw G_ADD [[PHI]], [[C3]]
  ; CHECK-NEXT:   [[AIE_POSTINC_STORE:%[0-9]+]]:_(p0) = G_AIE_POSTINC_STORE [[ADD]](s32), [[COPY]], [[C]](s20) :: (store (s32))
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:_(s32) = G_ICMP intpred(sgt), [[ADD]](s32), [[C1]]
  ; CHECK-NEXT:   G_BRCOND [[ICMP]](s32), %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   G_AIE_OFFSET_STORE [[ADD]](s32), [[COPY]](p0), [[C]](s20) :: (store (s32))
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    liveins: $p0
    %0:_(p0) = COPY $p0
    %1:_(s20) = G_CONSTANT i20 64
    %2:_(s32) = G_CONSTANT i32 0
    %3:_(s32) = G_CONSTANT i32 4
  bb.1:
    successors: %bb.1, %bb.2
    %4:_(s32) = G_PHI %6(s32), %bb.1, %3(s32), %bb.0
    %5:_(s32) = G_CONSTANT i32 1
    %6:_(s32) = nsw G_ADD %4, %5
    ; G_PTR_ADD is inside the loop
    %7:_(p0) = G_PTR_ADD %0, %1(s20)
    G_STORE %6(s32), %0(p0) :: (store (s32))
    %8:_(s32) = G_ICMP intpred(sgt), %6(s32), %2
    G_BRCOND %8(s32), %bb.1
  bb.2:
    ; Memory instruction uses the pointer computed inside the loop
    ; This should NOT be combined because %7 is defined inside the loop
    G_STORE %6(s32), %7(p0) :: (store (s32))
    PseudoRET implicit $lr
...
