# RUN: llc --mtriple=aie2p -verify-machineinstrs \
# RUN:  --start-before=aie-postlegalizer-generic-combiner \
# RUN:  --stop-after=aie-postlegalizer-custom-combiner \
# RUN:  --aie-global-ptr-mod-opt=true \
# RUN:  -o - %s | FileCheck %s

#
# A chain of loads reads from consecutive pointers built with a chain of
# G_PTR_ADDs sharing a common base:
#     %p1 = %0 + 32
#     %p2 = %p1 + 32   (= %0 + 64)
#     %p3 = %p2 + 32   (= %0 + 96)
#     load %0 ; load %p1 ; load %p2 ; load %p3
#
# The global post-increment combine forms G_AIE_POSTINC_LOADs. The FIRST
# post-inc load is correct, but the following ones are miscompiled: instead
# of chaining each post-inc load onto the previous load's post-incremented
# pointer, the combine rebases every load address back onto the common base
# %0 while accumulating the increment (32, 64, 96). Because a post-inc load
# reads at its BASE and only then increments, this makes %v1 and %v2 read
# from %0 (the same address as %v0) instead of %0+32 and %0+64.
#
# FIXME: This is a miscompile. The load addresses for %v1/%v2 are WRONG.
# The correct result must load %v1 from %0+32 and %v2 from %0+64, e.g. by
# chaining the post-inc loads:
#     %v0,%p1 = G_AIE_POSTINC_LOAD %0,  32
#     %v1,%p2 = G_AIE_POSTINC_LOAD %p1, 32
#     %v2,%p3 = G_AIE_POSTINC_LOAD %p2, 32
# The CHECK lines below intentionally pin the current, INCORRECT behavior so
# that a fix to the combine visibly flips this test.

---
name:            postinc_chain
legalized:       true
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $p0
    ; CHECK-LABEL: name: postinc_chain
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: %off:_(s20) = G_CONSTANT i20 32
    ; CHECK-NEXT: [[C64:%[0-9]+]]:_(s20) = G_CONSTANT i20 64
    ; CHECK-NEXT: [[C96:%[0-9]+]]:_(s20) = G_CONSTANT i20 96
    ; CHECK-NEXT: %v0:_(s32), %p1:_(p0) = G_AIE_POSTINC_LOAD [[COPY]], %off(s20) :: (load (s32))
    ; CHECK-NEXT: %v1:_(s32), %p2:_(p0) = G_AIE_POSTINC_LOAD [[COPY]], [[C64]](s20) :: (load (s32))
    ; CHECK-NEXT: %v2:_(s32), %p3:_(p0) = G_AIE_POSTINC_LOAD [[COPY]], [[C96]](s20) :: (load (s32))
    ; CHECK-NEXT: %v3:_(s32) = G_LOAD %p3(p0) :: (load (s32))
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit %v0(s32), implicit %v1(s32), implicit %v2(s32), implicit %v3(s32)
    %0:_(p0) = COPY $p0
    %off:_(s20) = G_CONSTANT i20 32
    %p1:_(p0) = nuw G_PTR_ADD %0, %off(s20)
    %p2:_(p0) = nuw G_PTR_ADD %p1, %off(s20)
    %p3:_(p0) = nuw G_PTR_ADD %p2, %off(s20)
    %v0:_(s32) = G_LOAD %0(p0) :: (load (s32))
    %v1:_(s32) = G_LOAD %p1(p0) :: (load (s32))
    %v2:_(s32) = G_LOAD %p2(p0) :: (load (s32))
    %v3:_(s32) = G_LOAD %p3(p0) :: (load (s32))
    PseudoRET implicit $lr, implicit %v0, implicit %v1, implicit %v2, implicit %v3
...
