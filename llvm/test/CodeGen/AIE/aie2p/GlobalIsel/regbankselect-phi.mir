# Test 4:  The instruction  %19:_(p0) = G_PHI %0(p0), %bb.0, %27(p0), %bb.1
# should not be mapped to accregbank. The result of the PHI node is used by an instruction
# that is considered an `accumulator-use instruction` but the considered result is just a scalar
# pointer.

---
name:            neg_test_acc.vmac_store
legalized:       true
regBankSelected: false
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: neg_test_acc.vmac_store
