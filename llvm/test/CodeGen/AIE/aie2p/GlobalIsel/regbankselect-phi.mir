  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1
    liveins: $p0

    %0:_(p0) = COPY $p0
    %4:_(s32) = G_CONSTANT i32 10
    %63:_(s32) = G_CONSTANT i32 1
    %66:_(<32 x s32>) = G_IMPLICIT_DEF
    %77:_(<32 x s16>) = G_IMPLICIT_DEF
    %3:_(s32) = G_CONSTANT i32 1
    %5:_(s20) = G_CONSTANT i20 32
