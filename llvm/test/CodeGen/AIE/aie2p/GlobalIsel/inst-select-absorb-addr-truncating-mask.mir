# The unaligned load idiom of aie_api: Q = P & ~(M - 1), loads from Q and
# Q + M. Selected loads ignore the address bits below their granularity, so
# the mask can be absorbed by the load when M is not larger than that
# granularity and the offset is a multiple of M.

---
name:            load_256_mask_32
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $p0
    ; NOFOLD-LABEL: name: load_256_mask_32
    ; NOFOLD: liveins: $p0
    ; NOFOLD-NEXT: {{  $}}
    ; NOFOLD-NEXT: %p:ep = COPY $p0
    ; NOFOLD-NEXT: %cm32:er = MOV_RLC_imm11_pseudo -32
    ; NOFOLD-NEXT: %int:er = COPY %p
    ; NOFOLD-NEXT: %mod:mdm = COPY %int
    ; NOFOLD-NEXT: %ext:er = COPY %mod
    ; NOFOLD-NEXT: %qint:er = AND %ext, %cm32
    ; NOFOLD-NEXT: %qtrunc:ep = COPY %qint
    ; NOFOLD-NEXT: %lo:vec256 = VLD_w_idx_imm_pseudo %qtrunc, 0 :: (load (<8 x s32>))
    ; NOFOLD-NEXT: %hi:vec256 = VLD_w_idx_imm_pseudo %qtrunc, 32 :: (load (<8 x s32>))
    ; NOFOLD-NEXT: $wl0 = COPY %lo
    ; NOFOLD-NEXT: $wl1 = COPY %hi
    ;
    ; FOLD-LABEL: name: load_256_mask_32
    ; FOLD: liveins: $p0
    ; FOLD-NEXT: {{  $}}
    ; FOLD-NEXT: %p:ep = COPY $p0
    ; FOLD-NEXT: %lo:vec256 = VLD_w_idx_imm_pseudo %p, 0 :: (load (<8 x s32>))
    ; FOLD-NEXT: %hi:vec256 = VLD_w_idx_imm_pseudo %p, 32 :: (load (<8 x s32>))
    ; FOLD-NEXT: $wl0 = COPY %lo
    ; FOLD-NEXT: $wl1 = COPY %hi
    %p:ptrregbank(p0) = COPY $p0
    %cm32:gprregbank(s32) = G_CONSTANT i32 -32
    %int:gprregbank(s20) = G_PTRTOINT %p(p0)
    %mod:modregbank(s20) = COPY %int(s20)
    %ext:gprregbank(s32) = G_ANYEXT %mod(s20)
    %qint:gprregbank(s32) = G_AND %ext, %cm32
    %qtrunc:ptrregbank(s20) = G_TRUNC %qint(s32)
    %q:ptrregbank(p0) = G_INTTOPTR %qtrunc(s20)
    %off:modregbank(s20) = G_CONSTANT i20 32
    %lo:vregbank(<8 x s32>) = G_LOAD %q(p0) :: (load (<8 x s32>))
    %hi:vregbank(<8 x s32>) = G_AIE_OFFSET_LOAD %q(p0), %off(s20) :: (load (<8 x s32>))
    $wl0 = COPY %lo(<8 x s32>)
    $wl1 = COPY %hi(<8 x s32>)
...

