# Fused load (UNPACK): the access size of the original load is the granularity.
---
name:            fused_unpack_load_mask_32
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $p0
    ; NOFOLD-LABEL: name: fused_unpack_load_mask_32
