    ; NOFOLD-NEXT: %qint:er = AND %ext, %cm32
    ; NOFOLD-NEXT: %qtrunc:ep = COPY %qint
    ; NOFOLD-NEXT: $crunpacksize = MOV_scalar_imm11_pseudo 0
    ; NOFOLD-NEXT: %u:vec512 = VLDB_UNPACK_dmw_ldb_unpack_idx_imm_unpackSign1 %qtrunc, 0, implicit $crunpacksize, implicit $unpacksign1 :: (load (<32 x s8>))
    ; NOFOLD-NEXT: $x0 = COPY %u
    ; NOFOLD-NEXT: PseudoRET implicit $lr, implicit $x0
    ;
    ; FOLD-LABEL: name: fused_unpack_load_mask_32
    ; FOLD: liveins: $p0
    ; FOLD-NEXT: {{  $}}
    ; FOLD-NEXT: %p:ep = COPY $p0
    ; FOLD-NEXT: $crunpacksize = MOV_scalar_imm11_pseudo 0
    ; FOLD-NEXT: %u:vec512 = VLDB_UNPACK_dmw_ldb_unpack_idx_imm_unpackSign1 %p, 0, implicit $crunpacksize, implicit $unpacksign1 :: (load (<32 x s8>))
    ; FOLD-NEXT: $x0 = COPY %u
    ; FOLD-NEXT: PseudoRET implicit $lr, implicit $x0
    %p:ptrregbank(p0) = COPY $p0
    %cm32:gprregbank(s32) = G_CONSTANT i32 -32
    %int:gprregbank(s20) = G_PTRTOINT %p(p0)
    %mod:modregbank(s20) = COPY %int(s20)
    %ext:gprregbank(s32) = G_ANYEXT %mod(s20)
    %qint:gprregbank(s32) = G_AND %ext, %cm32
    %qtrunc:ptrregbank(s20) = G_TRUNC %qint(s32)
    %q:ptrregbank(p0) = G_INTTOPTR %qtrunc(s20)
    %sign:gprregbank(s32) = G_CONSTANT i32 1
    %l:vregbank(<32 x s8>) = G_LOAD %q(p0) :: (load (<32 x s8>))
    %u:vregbank(<32 x s16>) = G_INTRINSIC intrinsic(@llvm.aie2p.unpack.I512.I8.I4), %l:vregbank(<32 x s8>), %sign:gprregbank(s32)
    $x0 = COPY %u(<32 x s16>)
    PseudoRET implicit $lr, implicit $x0
...

