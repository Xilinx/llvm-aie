# Test 1 - Remove identity copies of crfpmask (mCRm Reg class aka Control Register).
# Transform -
# %0 = COPY $crfpmask               |   |    |   %0 = COPY $crfpmask
# $crfpmask = COPY %0               |   |    |   ---------------------------
# %1 = opcode implicit $crfpmask    |   |    |   %1 = opcode implicit $crfpmask
# $crfpmask = COPY %0               |   |    |   ---------------------------
# %2 = opcode implicit $crfpmask    |   |    |   %2 = opcode implicit $crfpmask
# %10 = COPY $crfpmask              |-> to ->|   ---------------------------
# $crfpmask = COPY %10              |   |    |   ---------------------------
# %3 = opcode implicit $crfpmask    |   |    |   %3 = opcode implicit $crfpmask
# $crfpmask = COPY %0               |   |    |   ---------------------------
# %4 = opcode implicit $crfpmask    |   |    |   %4 = opcode implicit $crfpmask
---
name:            crfpmask_multiple
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0.entry:
  liveins: $crfpmask, $dm3
    ; CHECK-LABEL: name: crfpmask_multiple
    ; CHECK: liveins: $crfpmask, $dm3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:edm = COPY $dm3
    ; CHECK-NEXT: [[MOVXM:%[0-9]+]]:er = MOVXM 28
    ; CHECK-NEXT: [[VNEG_f:%[0-9]+]]:edm = VNEG_f [[COPY]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: [[VNEG_f1:%[0-9]+]]:edm = VNEG_f [[VNEG_f]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: [[VNEG_f2:%[0-9]+]]:edm = VNEG_f [[VNEG_f1]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: [[VNEG_f3:%[0-9]+]]:edm = VNEG_f [[VNEG_f2]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: [[VNEG_f4:%[0-9]+]]:edm = VNEG_f [[VNEG_f3]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: [[VNEG_f5:%[0-9]+]]:edm = VNEG_f [[VNEG_f4]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    %1:edm = COPY $dm3
    %2:er = MOVXM 28
    %3:ercr = COPY $crfpmask
    $crfpmask = COPY %3:ercr
    %4:edm = VNEG_f %1:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    $crfpmask = COPY %3:ercr
    %5:edm = VNEG_f %4:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    %6:ercr = COPY $crfpmask
    $crfpmask = COPY %6:ercr
    %7:edm = VNEG_f %5:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    $crfpmask = COPY %3:ercr
    %8:edm = VNEG_f %7:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    $crfpmask = COPY %3:ercr
    %9:edm = VNEG_f %8:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    $crfpmask = COPY %3:ercr
    %10:edm = VNEG_f %9:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
...

