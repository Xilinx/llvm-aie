# Test 5 - Deadcode elimination.
# %0 = COPY $r0                    |   |    | %0 = COPY $r0
# $1 = COPY $r1                    |   |    | $1 = COPY $r1
# $upssign0 = COPY %0             |   |    | $upssign0 = COPY %0
# %2 = opcode implicit $upssign0  |   |    | %2 = opcode implicit $upssign0
# $upssign0 = MOV 0               |-> to ->| -------------------------------
# $upssign0 = COPY %0             |   |    | -------------------------------
# %3 = opcode implicit $upssign0  |   |    | %3 = opcode implicit $upssign0
# $upssign0 = MOV 0               |   |    | -------------------------------
# $upssign0 = COPY %1             |   |    | $upssign0 = COPY %1
---
name:            crupsign0_redundant_reassignments
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0.entry:

    liveins: $r0, $crsat, $p0, $d0, $s3
    ; CHECK-LABEL: name: crupsign0_redundant_reassignments
    ; CHECK: liveins: $r0, $crsat, $p0, $d0, $s3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: $upssign0 = COPY [[COPY]]
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_:%[0-9]+]]:mbmm, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_1:%[0-9]+]]:ep, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_2:%[0-9]+]]:edc = VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0 $s3, [[COPY1]], $d0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_3:%[0-9]+]]:mbmm, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_4:%[0-9]+]]:ep, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_5:%[0-9]+]]:edc = VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0 $s3, [[COPY1]], $d0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_6:%[0-9]+]]:mbmm, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_7:%[0-9]+]]:ep, [[VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0_8:%[0-9]+]]:edc = VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0 $s3, [[COPY1]], $d0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: $upssign0 = MOVXM 0
    %0:er = MOVXM 0
    %1:er = COPY $r0
    %2:ercr = COPY $crsat
    $crsat = COPY %2:ercr
    $upssign0 = COPY %1:er
    %3:mss = COPY %0:er
    %4:ep = COPY $p0
    %5:ed = COPY $d0
    %6:mbmm, %7:ep, %8:edc =  VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0 $s3, %4:ep, $d0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    $upssign0 = MOVXM 0
    $crsat = COPY %2:ercr
    $upssign0 = COPY %1:er
    %9:mbmm, %10:ep, %11:edc =  VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0 $s3, %4:ep, $d0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    $upssign0 = MOVXM 0
    $crsat = COPY %2:ercr
    $upssign0 = COPY %1:er
    %12:mbmm, %13:ep, %14:edc =  VLDA_2D_UPS_2x_dmw_lda_ups_w2b_upsSign0 $s3, %4:ep, $d0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    $upssign0 = MOVXM 0
...


