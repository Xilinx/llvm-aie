# Test 10
# %10 holds a copy of $crfpmask, but it is invalidated. Make sure uses
# of %10 after the invalidation aren't simplified using $crfpmask.
---
name:            invalidate_copy
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0.entry:
  liveins: $bmll2, $r0
    ; CHECK-LABEL: name: invalidate_copy
    ; CHECK: liveins: $bmll2, $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:edm = COPY $bmll2
    ; CHECK-NEXT: [[MOVXM:%[0-9]+]]:er = MOVXM 28
    ; CHECK-NEXT: $crfpmask = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ercr = COPY $crfpmask
    ; CHECK-NEXT: $crfpmask = MOVXM 0
    ; CHECK-NEXT: [[VNEG_f:%[0-9]+]]:edm = VNEG_f [[COPY]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: $crfpmask = COPY [[COPY1]]
    ; CHECK-NEXT: [[VNEG_f1:%[0-9]+]]:edm = VNEG_f [[VNEG_f]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    %1:edm = COPY $bmll2
    %2:er = MOVXM 28
    %3:er = COPY $r0
    $crfpmask = COPY $r0
    %10:ercr = COPY $crfpmask
    $crfpmask = MOVXM 0
    %4:edm = VNEG_f  %1:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    $crfpmask = COPY %10
    %5:edm = VNEG_f  %4:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
...

# Test 11
# $crfpmask is saved and restored twice around VNEG_f instructions
# Make sure we simplify this to only one vreg for saving and restoring.
---
name:            save_restore_twice
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.0.entry:
  liveins: $bmll2, $r0
    ; CHECK-LABEL: name: save_restore_twice
    ; CHECK: liveins: $bmll2, $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:edm = COPY $bmll2
    ; CHECK-NEXT: [[MOVXM:%[0-9]+]]:er = MOVXM 28
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ercr = COPY $crfpmask
    ; CHECK-NEXT: $crfpmask = MOVXM 0
    ; CHECK-NEXT: [[VNEG_f:%[0-9]+]]:edm = VNEG_f [[COPY]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: $crfpmask = MOVXM 1
    ; CHECK-NEXT: [[VNEG_f1:%[0-9]+]]:edm = VNEG_f [[VNEG_f]], [[MOVXM]], implicit-def $srfpflags, implicit $crfpmask
    ; CHECK-NEXT: $crfpmask = COPY [[COPY1]]
    %1:edm = COPY $bmll2
    %2:er = MOVXM 28
    %10:ercr = COPY $crfpmask
    $crfpmask = MOVXM 0
    %4:edm = VNEG_f  %1:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    $crfpmask = COPY %10
    %11:ercr = COPY $crfpmask
    $crfpmask = MOVXM 1
    %5:edm = VNEG_f  %4:edm, %2:er, implicit-def $srfpflags, implicit $crfpmask
    $crfpmask = COPY %11
...



