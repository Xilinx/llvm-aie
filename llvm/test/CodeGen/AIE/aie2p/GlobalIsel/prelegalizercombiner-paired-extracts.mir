      %38:_(s32) = G_CONSTANT i32 4
      %34:_(s32) = G_EXTRACT_VECTOR_ELT %33(<32 x s32>), %35(s32)
      %37:_(s32) = G_EXTRACT_VECTOR_ELT %33(<32 x s32>), %38(s32)
      $r0 = COPY %34
      $r1 = COPY %37
...

