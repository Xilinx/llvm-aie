# Test case where two paired vector extracts are merged (0 and 1).
---
name: paired_0_1
body:             |
  bb.1:
    ; CHECK-LABEL: name: paired_0_1
    ; CHECK: [[COPY:%[0-9]+]]:_(<32 x s32>) = COPY $y2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<16 x s64>) = G_BITCAST [[COPY]](<32 x s32>)
    ; CHECK-NEXT: [[EVEC:%[0-9]+]]:_(s64) = G_EXTRACT_VECTOR_ELT [[BITCAST]](<16 x s64>), [[C]](s32)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[EVEC]](s64)
    ; CHECK-NEXT: $r0 = COPY [[UV]](s32)
    ; CHECK-NEXT: $r1 = COPY [[UV1]](s32)
      %33:_(<32 x s32>) = COPY $y2
      %35:_(s32) = G_CONSTANT i32 0
      %38:_(s32) = G_CONSTANT i32 1
      %34:_(s32) = G_EXTRACT_VECTOR_ELT %33(<32 x s32>), %35(s32)
      %37:_(s32) = G_EXTRACT_VECTOR_ELT %33(<32 x s32>), %38(s32)
      $r0 = COPY %34
      $r1 = COPY %37
...

