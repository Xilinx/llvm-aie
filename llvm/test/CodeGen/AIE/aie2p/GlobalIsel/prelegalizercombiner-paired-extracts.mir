    ; CHECK-NEXT: [[EVEC:%[0-9]+]]:_(s64) = G_EXTRACT_VECTOR_ELT [[BITCAST]](<16 x s64>), [[C]](s32)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[EVEC]](s64)
    ; CHECK-NEXT: $r0 = COPY [[UV1]](s32)
    ; CHECK-NEXT: $r1 = COPY [[UV]](s32)
      %33:_(<32 x s32>) = COPY $y2
