    ; AIE2PS-NEXT: [[AIE_ADD_VECTOR_ELT_HI3:%[0-9]+]]:_(<16 x s32>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI2]], [[SHL3]](s32)
    ; AIE2PS-NEXT: [[C4:%[0-9]+]]:_(s32) = G_CONSTANT i32 48
    ; AIE2PS-NEXT: [[INT:%[0-9]+]]:_(<16 x s32>) = G_INTRINSIC intrinsic(@llvm.aie2ps.vshift.I512.I512), [[AIE_ADD_VECTOR_ELT_HI3]](<16 x s32>), [[AIE_ADD_VECTOR_ELT_HI3]](<16 x s32>), [[C]](s32), [[C4]](s32)
    ; AIE2PS-NEXT: [[AIE_UNPAD_VECTOR2:%[0-9]+]]:_(<4 x s32>) = G_AIE_UNPAD_VECTOR [[INT]](<16 x s32>)
    ; AIE2PS-NEXT: [[AIE_PAD_VECTOR_UNDEF2:%[0-9]+]]:_(<8 x s32>) = G_AIE_PAD_VECTOR_UNDEF [[AIE_UNPAD_VECTOR2]](<4 x s32>)
    ; AIE2PS-NEXT: $wl0 = COPY [[AIE_PAD_VECTOR_UNDEF2]](<8 x s32>)
    ; AIE2PS-NEXT: PseudoRET implicit $lr, implicit $wl0
    %1:_(<8 x s32>) = COPY $wl2
    %2:_(<8 x s32>) = COPY $wl4
    %3:_(<4 x s32>) = G_AIE_UNPAD_VECTOR %1(<8 x s32>)
    %4:_(<4 x s32>) = G_AIE_UNPAD_VECTOR %2(<8 x s32>)
    %0:_(<4 x s32>) = G_SHL %3, %4
    %5:_(<8 x s32>) = G_AIE_PAD_VECTOR_UNDEF %0(<4 x s32>)
    $wl0 = COPY %5(<8 x s32>)
    PseudoRET implicit $lr, implicit $wl0
...
