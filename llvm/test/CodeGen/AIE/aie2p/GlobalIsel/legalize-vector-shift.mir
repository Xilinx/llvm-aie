name:            test_shl_v2s32
body:             |
  bb.1:
    liveins: $l1, $l2
    ; CHECK-LABEL: name: test_shl_v2s32
    ; CHECK: liveins: $l1, $l2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<2 x s32>) = COPY $l1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<2 x s32>) = COPY $l2
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[COPY]](<2 x s32>)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(s32), [[UV3:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[COPY1]](<2 x s32>)
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL [[UV]], [[UV2]](s32)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(s32) = G_SHL [[UV1]], [[UV3]](s32)
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x s32>) = G_BUILD_VECTOR [[SHL]](s32), [[SHL1]](s32)
    ; CHECK-NEXT: $l0 = COPY [[BUILD_VECTOR]](<2 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $l0
    %1:_(<2 x s32>) = COPY $l1
    %2:_(<2 x s32>) = COPY $l2
    %0:_(<2 x s32>) = G_SHL %1, %2
    $l0 = COPY %0(<2 x s32>)
    PseudoRET implicit $lr, implicit $l0
...
