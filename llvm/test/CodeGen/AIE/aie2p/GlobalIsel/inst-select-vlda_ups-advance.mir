#
# Tests for VLDA_UPS combining using the canAdvanceOp fallback path.
#
# When canDelayMemOp fails (e.g., due to an intervening store), we can
# still combine by advancing the combined instruction to the load's position
# if canAdvanceOp succeeds (AllowSideEffects=true).
#
# RUN: llc -mtriple aie2p -run-pass=instruction-select %s -verify-machineinstrs -o - | FileCheck %s

---
# Positive test case: canDelayMemOp fails due to intervening store,
# but canAdvanceOp succeeds because the store doesn't define any UPS input.
#
# The load result is only used by UPS (hasOneUse requirement satisfied).
# There's a store between load and UPS which makes canDelayMemOp fail
# (isSafeToMove returns false for the load when there's a store).
# But canAdvanceOp succeeds because we can move UPS to load's position.
name:            VLDA_UPS_advance_intervening_store
alignment:       16
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $p0, $p1, $r0, $wl0

    ; CHECK-LABEL: name: VLDA_UPS_advance_intervening_store
    ; CHECK: liveins: $p0, $p1, $r0, $wl0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ep = COPY $p1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vec256 = COPY $wl0
    ; CHECK-NEXT: $crupsmode = MOV_scalar_imm11_pseudo 0
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:es = COPY [[COPY2]]
    ; CHECK-NEXT: [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_:%[0-9]+]]:acc512 = VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1 [[COPY4]], [[COPY]], 0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1 :: (load (<16 x s16>))
    ; CHECK-NEXT: VST_dmw_sts_w_idx_imm [[COPY3]], [[COPY1]], 0 :: (store (<16 x s16>))
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_]]

    %0:ptrregbank(p0) = COPY $p0
    %1:ptrregbank(p0) = COPY $p1
    %2:gprregbank(s32) = COPY $r0
    %3:vregbank(<16 x s16>) = COPY $wl0
    %4:gprregbank(s32) = G_CONSTANT i32 1

    ; Load the vector - result only used by UPS
    %5:vregbank(<16 x s16>) = G_LOAD %0:ptrregbank(p0) :: (load (<16 x s16>))

    ; Store between load and UPS - this makes canDelayMemOp fail
    ; because we can't safely move the load past the store.
    ; But canAdvanceOp succeeds because we can move UPS to load's position.
    G_STORE %3:vregbank(<16 x s16>), %1:ptrregbank(p0) :: (store (<16 x s16>))

    ; UPS instruction using the load result (only use)
    %6:accregbank(<8 x s64>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.acc32.v16.I256.ups), %5:vregbank(<16 x s16>), %2:gprregbank(s32), %4:gprregbank(s32)

    PseudoRET implicit $lr, implicit %6
...

---
# Test case demonstrating crupsmode placement issue with canAdvanceOp.
#
# When canDelayMemOp fails and canAdvanceOp succeeds, the crupsmode control
# register is set at the load's original position. This can be suboptimal
# when there are instructions between the load and UPS that don't depend on
# crupsmode - ideally the scheduler could hoist crupsmode earlier.
#
# In this test:
# - There's a scalar load (lda r1) before the vector load
# - The vector load feeds into UPS
# - There's a store between load and UPS (makes canDelayMemOp fail)
# - The scalar load result is used after the store
#
# The crupsmode is placed right before the combined vlda.ups, but there
# may be latency stalls if the scheduler cannot hoist it earlier.
name:            VLDA_UPS_advance_crupsmode_placement
alignment:       16
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $p0, $p1, $p2, $r0, $wl0

    ; CHECK-LABEL: name: VLDA_UPS_advance_crupsmode_placement
    ; CHECK: liveins: $p0, $p1, $p2, $r0, $wl0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ep = COPY $p0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:ep = COPY $p1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:ep = COPY $p2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:er = COPY $r0
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:vec256 = COPY $wl0
    ; CHECK-NEXT: [[LDA_dms_lda_idx_imm:%[0-9]+]]:er = LDA_dms_lda_idx_imm [[COPY2]], 0 :: (load (s32))
    ; CHECK-NEXT: $crupsmode = MOV_scalar_imm11_pseudo 0
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:es = COPY [[COPY3]]
    ; CHECK-NEXT: [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_:%[0-9]+]]:acc512 = VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1 [[COPY5]], [[COPY]], 0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1 :: (load (<16 x s16>))
    ; CHECK-NEXT: VST_dmw_sts_w_idx_imm [[COPY4]], [[COPY1]], 0 :: (store (<16 x s16>))
    ; CHECK-NEXT: $r1 = COPY [[LDA_dms_lda_idx_imm]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[VLDA_UPS_2x_dmw_lda_ups_w2b_idx_imm_upsSign1_]], implicit $r1
    %0:ptrregbank(p0) = COPY $p0
    %1:ptrregbank(p0) = COPY $p1
    %2:ptrregbank(p0) = COPY $p2
    %3:gprregbank(s32) = COPY $r0
    %4:vregbank(<16 x s16>) = COPY $wl0
    %5:gprregbank(s32) = G_CONSTANT i32 1

    %6:gprregbank(s32) = G_LOAD %2:ptrregbank(p0) :: (load (s32))

    %7:vregbank(<16 x s16>) = G_LOAD %0:ptrregbank(p0) :: (load (<16 x s16>))

    G_STORE %4:vregbank(<16 x s16>), %1:ptrregbank(p0) :: (store (<16 x s16>))

    %8:accregbank(<8 x s64>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.acc32.v16.I256.ups), %7:vregbank(<16 x s16>), %3:gprregbank(s32), %5:gprregbank(s32)

    $r1 = COPY %6:gprregbank(s32)

    PseudoRET implicit $lr, implicit %8, implicit $r1
...
