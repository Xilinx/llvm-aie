    %3:_(<16 x s8>) = G_AIE_UNPAD_VECTOR %1(<32 x s8>)
    %4:_(<16 x s8>) = G_AIE_UNPAD_VECTOR %2(<32 x s8>)
    %0:_(<16 x s8>) = G_OR %3, %4
    %5:_(<32 x s8>) = G_AIE_PAD_VECTOR_UNDEF %0(<16 x s8>)
    $wl0 = COPY %5(<32 x s8>)
    PseudoRET implicit $lr, implicit $wl0
