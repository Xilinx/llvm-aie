# RUN: llc -mtriple aie2p -run-pass=aie2p-prelegalizer-combiner -print-after=aie2p-prelegalizer-combiner %s -verify-machineinstrs -o - | FileCheck %s


# The combiner will try to combine the vector load and the extract to a single scalar load if it is Legal
# or if we are before the legalizer. 
# The bug showcased in the previous commit is now fixed and the test would pass after successful compilation 
# but the combine doesn't happen. This is due to another issue which will be fixed by the following commit thus 
# enabling the combine.
---
name:            not_combine_extracted_vector_load_s16_align2
alignment:       16
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $p0

    ; CHECK-LABEL: name: combine_extracted_vector_load_s16_IdxNonZeroa
    ; CHECK: liveins: $p0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $p0
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(<32 x s16>) = G_LOAD [[COPY]](p0) :: (load (<8 x s16>) from `ptr null`, align 2)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 3
    ; CHECK-NEXT: [[EVEC:%[0-9]+]]:_(s16) = G_EXTRACT_VECTOR_ELT [[LOAD]](<32 x s16>), [[C]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[EVEC]](s16)
    %1:_(p0) = COPY $p0
    %2:_(<32 x s16>) = G_LOAD %1:_(p0) :: (load (<8 x s16>) from `ptr null`, align 2)
    %4:_(s32) = G_CONSTANT i32 3
    %7:_(s16) = G_EXTRACT_VECTOR_ELT %2:_(<32 x s16>), %4:_(s32)
    PseudoRET implicit $lr, implicit %7
...

