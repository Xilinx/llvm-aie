    %3:_(<8 x s8>) = G_IMPLICIT_DEF
    %4:_(<8 x s8>) = G_SHUFFLE_VECTOR %2(<8 x s8>), %3, shufflemask(0, 0, 0, 0, 0, 0, 0, 0)
