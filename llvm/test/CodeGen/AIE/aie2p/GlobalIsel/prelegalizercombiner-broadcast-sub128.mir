# RUN: llc -mtriple aie2p -run-pass=aie-prelegalizer-combiner %s -verify-machineinstrs -o - | FileCheck %s
# RUN: llc -mtriple aie2ps -run-pass=aie-prelegalizer-combiner %s -verify-machineinstrs -o - | FileCheck %s

# Tests for sub-128-bit vector splat shuffles.
# These exercise buildBroadcastVector with 32-bit and 64-bit destination vectors.

# 64-bit vector: <2 x s32>
---
name:            test_shuffle_v2s32_splat
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1
    ; CHECK-LABEL: name: test_shuffle_v2s32_splat
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r0
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<16 x s32>) = G_AIE_BROADCAST_VECTOR [[COPY]](s32)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<2 x s32>), [[UV1:%[0-9]+]]:_(<2 x s32>), [[UV2:%[0-9]+]]:_(<2 x s32>), [[UV3:%[0-9]+]]:_(<2 x s32>), [[UV4:%[0-9]+]]:_(<2 x s32>), [[UV5:%[0-9]+]]:_(<2 x s32>), [[UV6:%[0-9]+]]:_(<2 x s32>), [[UV7:%[0-9]+]]:_(<2 x s32>) = G_UNMERGE_VALUES [[AIE_BROADCAST_VECTOR]](<16 x s32>)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(s64) = G_BITCAST [[UV]](<2 x s32>)
    ; CHECK-NEXT: $l0 = COPY [[BITCAST]](s64)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $l0
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(<2 x s32>) = G_BUILD_VECTOR %0(s32), %1(s32)
    %3:_(<2 x s32>) = G_IMPLICIT_DEF
    %4:_(<2 x s32>) = G_SHUFFLE_VECTOR %2(<2 x s32>), %3, shufflemask(0, 0)
    %5:_(s64) = G_BITCAST %4(<2 x s32>)
    $l0 = COPY %5(s64)
    PseudoRET implicit $lr, implicit $l0
...

# 64-bit vector: <4 x s16>
---
name:            test_shuffle_v4s16_splat
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $l0
    ; CHECK-LABEL: name: test_shuffle_v4s16_splat
    ; CHECK: liveins: $l0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s64) = COPY $l0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s16) = G_TRUNC [[COPY]](s64)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(s32) = G_ANYEXT [[TRUNC]](s16)
    ; CHECK-NEXT: [[AIE_BROADCAST_VECTOR:%[0-9]+]]:_(<32 x s16>) = G_AIE_BROADCAST_VECTOR [[ANYEXT]](s32)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<4 x s16>), [[UV1:%[0-9]+]]:_(<4 x s16>), [[UV2:%[0-9]+]]:_(<4 x s16>), [[UV3:%[0-9]+]]:_(<4 x s16>), [[UV4:%[0-9]+]]:_(<4 x s16>), [[UV5:%[0-9]+]]:_(<4 x s16>), [[UV6:%[0-9]+]]:_(<4 x s16>), [[UV7:%[0-9]+]]:_(<4 x s16>) = G_UNMERGE_VALUES [[AIE_BROADCAST_VECTOR]](<32 x s16>)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(s64) = G_BITCAST [[UV]](<4 x s16>)
    ; CHECK-NEXT: $l0 = COPY [[BITCAST]](s64)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $l0
    %0:_(s64) = COPY $l0
    %1:_(<4 x s16>) = G_BITCAST %0(s64)
    ; Use a build_vector from truncated elements to get a known source
    %10:_(s16) = G_TRUNC %0(s64)
    %2:_(<4 x s16>) = G_BUILD_VECTOR %10(s16), %10(s16), %10(s16), %10(s16)
    %3:_(<4 x s16>) = G_IMPLICIT_DEF
    %4:_(<4 x s16>) = G_SHUFFLE_VECTOR %2(<4 x s16>), %3, shufflemask(0, 0, 0, 0)
    %5:_(s64) = G_BITCAST %4(<4 x s16>)
    $l0 = COPY %5(s64)
    PseudoRET implicit $lr, implicit $l0
...

