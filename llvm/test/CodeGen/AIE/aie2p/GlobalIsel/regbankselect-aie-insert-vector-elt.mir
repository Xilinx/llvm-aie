    ; CHECK-NEXT: [[AIE_INSERT_VECTOR_ELT:%[0-9]+]]:vregbank(<4 x s64>) = G_AIE_INSERT_VECTOR_ELT [[COPY]], [[COPY1]](s64), [[C]](s32)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[AIE_INSERT_VECTOR_ELT]](<4 x s64>)
    %0:_(<4 x s64>) = COPY $wl0
    %1:_(s64) = COPY $l0
    %2:_(s32) = G_CONSTANT i32 0
    %3:_(<4 x s64>) = G_AIE_INSERT_VECTOR_ELT %0(<4 x s64>), %1(s64), %2(s32)
    PseudoRET implicit $lr, implicit %3
...

