    ; CHECK-NEXT: [[AIE_PAD_VECTOR_UNDEF2:%[0-9]+]]:_(<16 x s16>) = G_AIE_PAD_VECTOR_UNDEF [[AIE_UNPAD_VECTOR2]](<8 x s16>)
    ; CHECK-NEXT: $wl0 = COPY [[AIE_PAD_VECTOR_UNDEF2]](<16 x s16>)
