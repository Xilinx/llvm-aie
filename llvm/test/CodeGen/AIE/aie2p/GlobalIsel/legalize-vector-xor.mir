name:            test_xor_v32s64
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_xor_v32s64
    ; CHECK: [[DEF:%[0-9]+]]:_(<32 x s64>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:_(<32 x s64>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<64 x s32>) = G_BITCAST [[DEF]](<32 x s64>)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(<64 x s32>) = G_BITCAST [[DEF1]](<32 x s64>)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<32 x s32>), [[UV1:%[0-9]+]]:_(<32 x s32>) = G_UNMERGE_VALUES [[BITCAST]](<64 x s32>)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(<16 x s32>), [[UV3:%[0-9]+]]:_(<16 x s32>) = G_UNMERGE_VALUES [[UV]](<32 x s32>)
    ; CHECK-NEXT: [[UV4:%[0-9]+]]:_(<16 x s32>), [[UV5:%[0-9]+]]:_(<16 x s32>) = G_UNMERGE_VALUES [[UV1]](<32 x s32>)
    ; CHECK-NEXT: [[UV6:%[0-9]+]]:_(<32 x s32>), [[UV7:%[0-9]+]]:_(<32 x s32>) = G_UNMERGE_VALUES [[BITCAST1]](<64 x s32>)
    ; CHECK-NEXT: [[UV8:%[0-9]+]]:_(<16 x s32>), [[UV9:%[0-9]+]]:_(<16 x s32>) = G_UNMERGE_VALUES [[UV6]](<32 x s32>)
    ; CHECK-NEXT: [[UV10:%[0-9]+]]:_(<16 x s32>), [[UV11:%[0-9]+]]:_(<16 x s32>) = G_UNMERGE_VALUES [[UV7]](<32 x s32>)
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(<16 x s32>) = G_XOR [[UV2]], [[UV8]]
    ; CHECK-NEXT: [[XOR1:%[0-9]+]]:_(<16 x s32>) = G_XOR [[UV3]], [[UV9]]
    ; CHECK-NEXT: [[XOR2:%[0-9]+]]:_(<16 x s32>) = G_XOR [[UV4]], [[UV10]]
    ; CHECK-NEXT: [[XOR3:%[0-9]+]]:_(<16 x s32>) = G_XOR [[UV5]], [[UV11]]
    ; CHECK-NEXT: [[CONCAT_VECTORS:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[XOR]](<16 x s32>), [[XOR1]](<16 x s32>)
    ; CHECK-NEXT: [[CONCAT_VECTORS1:%[0-9]+]]:_(<32 x s32>) = G_CONCAT_VECTORS [[XOR2]](<16 x s32>), [[XOR3]](<16 x s32>)
    ; CHECK-NEXT: [[CONCAT_VECTORS2:%[0-9]+]]:_(<64 x s32>) = G_CONCAT_VECTORS [[CONCAT_VECTORS]](<32 x s32>), [[CONCAT_VECTORS1]](<32 x s32>)
    ; CHECK-NEXT: [[BITCAST2:%[0-9]+]]:_(<32 x s64>) = G_BITCAST [[CONCAT_VECTORS2]](<64 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit [[BITCAST2]](<32 x s64>)
    %1:_(<32 x s64>) = G_IMPLICIT_DEF
    %2:_(<32 x s64>) = G_IMPLICIT_DEF
    %0:_(<32 x s64>) = G_XOR %1, %2
    PseudoRET implicit $lr, implicit %0
...
