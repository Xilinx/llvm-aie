    %2:_(<16 x s16>) = COPY $wl4
    %3:_(<8 x s16>) = G_AIE_UNPAD_VECTOR %1(<16 x s16>)
    %4:_(<8 x s16>) = G_AIE_UNPAD_VECTOR %2(<16 x s16>)
    %0:_(<8 x s16>) = G_XOR %3, %4
    %5:_(<16 x s16>) = G_AIE_PAD_VECTOR_UNDEF %0(<8 x s16>)
    $wl0 = COPY %5(<16 x s16>)
    PseudoRET implicit $lr, implicit $wl0
...
