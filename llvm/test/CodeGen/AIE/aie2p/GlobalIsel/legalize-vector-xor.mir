---
name:            test_xor_v64s8
alignment:       16
body:             |
  bb.1:
    liveins: $x2, $x4

    ; CHECK-LABEL: name: test_xor_v64s8
    ; CHECK: liveins: $x2, $x4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<64 x s8>) = COPY $x2
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<64 x s8>) = COPY $x4
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(<64 x s8>) = G_XOR [[COPY1]], [[COPY]]
    ; CHECK-NEXT: $x0 = COPY [[XOR]](<64 x s8>)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0
    %1:_(<64 x s8>) = COPY $x2
    %2:_(<64 x s8>) = COPY $x4
    %0:_(<64 x s8>) = G_XOR %2, %1
    $x0 = COPY %0(<64 x s8>)
    PseudoRET implicit $lr, implicit $x0

...

