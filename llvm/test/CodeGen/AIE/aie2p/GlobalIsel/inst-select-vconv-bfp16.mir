    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vec512 = COPY $x1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:edm = COPY [[COPY]]
    ; CHECK-NEXT: [[VCONV_bfp16ebs16_fp32_:%[0-9]+]]:mexa = VCONV_bfp16ebs16_fp32 [[COPY1]], implicit-def $srf2bflags, implicit $crf2bmask, implicit $crrnd
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vec512 = COPY [[VCONV_bfp16ebs16_fp32_]].sub_bfp16_x
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:expvec64 = COPY [[VCONV_bfp16ebs16_fp32_]].sub_bfp16_e
    ; CHECK-NEXT: $x0 = COPY [[COPY2]]
    ; CHECK-NEXT: $e0 = COPY [[COPY3]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x0, implicit $e0
    %1:accregbank(<64 x s32>) = COPY $dm0
    %2:vregbank(<64 x s8>) = COPY $x1
    %3:gprregbank(<8 x s8>) = COPY $e1
    %0:vregbank(<64 x s8>), %4:gprregbank(<8 x s8>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aie2p.v64accfloat.to.v64bfp16ebs16), %2(<64 x s8>), %3(<8 x s8>), %1(<64 x s32>)
    $x0 = COPY %0(<64 x s8>)
    $e0 = COPY %4(<8 x s8>)
    PseudoRET implicit $lr, implicit $x0, implicit $e0
...


