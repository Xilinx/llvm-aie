name:            accfloat_to_bfp16ebs16
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    liveins: $dm0, $x1, $e1

    ; CHECK-LABEL: name: accfloat_to_bfp16ebs16
    ; CHECK: liveins: $dm0, $x1, $e1
