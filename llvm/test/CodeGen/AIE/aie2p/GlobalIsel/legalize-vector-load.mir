    ; AIE2PS-NEXT: PseudoRET implicit $lr, implicit [[AIE_ADD_VECTOR_ELT_HI7]](<8 x s64>)
    %1:_(p0) = COPY $p0
    %0:_(<8 x s64>) = G_LOAD %1(p0) :: (load (<8 x s64>), align 16)
    PseudoRET implicit $lr, implicit %0

...
