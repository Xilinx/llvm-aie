    ; AIE2PS-NEXT: [[AIE_ADD_VECTOR_ELT_HI1:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI]], [[LOAD1]](s64)
    ; AIE2PS-NEXT: [[AIE_ADD_VECTOR_ELT_HI2:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI1]], [[LOAD2]](s64)
    ; AIE2PS-NEXT: [[AIE_ADD_VECTOR_ELT_HI3:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI2]], [[LOAD3]](s64)
    ; AIE2PS-NEXT: [[AIE_ADD_VECTOR_ELT_HI4:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI3]], [[LOAD4]](s64)
    ; AIE2PS-NEXT: [[AIE_ADD_VECTOR_ELT_HI5:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI4]], [[LOAD5]](s64)
