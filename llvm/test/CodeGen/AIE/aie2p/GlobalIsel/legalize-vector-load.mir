    ; AIE2P-NEXT: [[AIE_ADD_VECTOR_ELT_HI2:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI1]], [[MV2]](s64)
    ; AIE2P-NEXT: [[AIE_ADD_VECTOR_ELT_HI3:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI2]], [[MV3]](s64)
    ; AIE2P-NEXT: [[AIE_ADD_VECTOR_ELT_HI4:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI3]], [[MV4]](s64)
    ; AIE2P-NEXT: [[AIE_ADD_VECTOR_ELT_HI5:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI4]], [[MV5]](s64)
    ; AIE2P-NEXT: [[AIE_ADD_VECTOR_ELT_HI6:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI5]], [[MV6]](s64)
    ; AIE2P-NEXT: [[AIE_ADD_VECTOR_ELT_HI7:%[0-9]+]]:_(<8 x s64>) = G_AIE_ADD_VECTOR_ELT_HI [[AIE_ADD_VECTOR_ELT_HI6]], [[MV7]](s64)
