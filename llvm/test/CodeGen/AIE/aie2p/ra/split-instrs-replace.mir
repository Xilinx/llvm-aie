tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $dc4, $dj4, $dn4, $p0, $m0, $dn0, $dj0, $dc0
    ; CHECK-LABEL: name: PADD_3D
    ; CHECK: liveins: $dc0, $dc4, $dj0, $dj4, $dn0, $dn4, $m0, $p0, $d0_3d:0x0001C00000200E00
