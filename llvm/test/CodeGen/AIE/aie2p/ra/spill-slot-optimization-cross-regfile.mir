# RUN: llc -mtriple=aie2p -run-pass=aie-spill-slot-opt -o - %s | FileCheck %s

# StackSlotColoring can coalesce registers with disjoint live ranges from
# different register files onto a single frame index. Here a DS descriptor spill
# (which decomposes into 32-bit scalar lanes) and a DM accumulator spill (which
# decomposes into 512-bit BM lanes) share %stack.0, so the scalar lane and the BM
# lane both map to byte offset 0 but with different sizes (4 vs 64 bytes).
#
# Decomposing such a slot is not safe/profitable: the per-offset replacement slot
# would have to grow to the largest (512-bit) lane, replacing one small coalesced
# object with several much larger ones (increasing stack usage), and the size
# mismatch can select an illegal spill opcode for the accumulator register. The
# pass detects the conflicting same-offset lanes and bails out, leaving the
# original composite DS/DM spills and reloads untouched.

---
name:            ds_dm_shared_slot
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 256, alignment: 128 }
body:             |
  ; CHECK-LABEL: name: ds_dm_shared_slot
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $d0_3d
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ST_R_SPILL $m0, %stack.1, implicit $sp :: (store (s32) into %stack.1)
  ; CHECK-NEXT:   ST_R_SPILL $dn0, %stack.2, implicit $sp :: (store (s32) into %stack.2)
  ; CHECK-NEXT:   ST_R_SPILL $dj0, %stack.3, implicit $sp :: (store (s32) into %stack.3)
  ; CHECK-NEXT:   ST_R_SPILL $dc0, %stack.4, implicit $sp :: (store (s32) into %stack.4)
  ; CHECK-NEXT:   ST_R_SPILL $m4, %stack.5, implicit $sp :: (store (s32) into %stack.5)
  ; CHECK-NEXT:   ST_R_SPILL $dn4, %stack.6, implicit $sp :: (store (s32) into %stack.6)
  ; CHECK-NEXT:   ST_R_SPILL $dj4, %stack.7, implicit $sp :: (store (s32) into %stack.7)
  ; CHECK-NEXT:   ST_R_SPILL $dc4, %stack.8, implicit $sp :: (store (s32) into %stack.8)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $dm0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $m0 = LDA_R_SPILL %stack.1, implicit $sp :: (load (s32) from %stack.1)
  ; CHECK-NEXT:   renamable $dn0 = LDA_R_SPILL %stack.2, implicit $sp :: (load (s32) from %stack.2)
  ; CHECK-NEXT:   renamable $dj0 = LDA_R_SPILL %stack.3, implicit $sp :: (load (s32) from %stack.3)
  ; CHECK-NEXT:   renamable $dc0 = LDA_R_SPILL %stack.4, implicit $sp :: (load (s32) from %stack.4)
  ; CHECK-NEXT:   renamable $m4 = LDA_R_SPILL %stack.5, implicit $sp :: (load (s32) from %stack.5)
  ; CHECK-NEXT:   renamable $dn4 = LDA_R_SPILL %stack.6, implicit $sp :: (load (s32) from %stack.6)
  ; CHECK-NEXT:   renamable $dj4 = LDA_R_SPILL %stack.7, implicit $sp :: (load (s32) from %stack.7)
  ; CHECK-NEXT:   renamable $dc4 = LDA_R_SPILL %stack.8, implicit $sp :: (load (s32) from %stack.8)
  ; CHECK-NEXT:   VST_dmx_sts_bm_spill $bmll0, %stack.1, implicit $sp :: (store (s32) into %stack.1)
  ; CHECK-NEXT:   VST_dmx_sts_bm_spill $bmlh0, %stack.9, implicit $sp :: (store (s512) into %stack.9)
  ; CHECK-NEXT:   VST_dmx_sts_bm_spill $bmhl0, %stack.10, implicit $sp :: (store (s512) into %stack.10)
  ; CHECK-NEXT:   VST_dmx_sts_bm_spill $bmhh0, %stack.11, implicit $sp :: (store (s512) into %stack.11)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $d0_3d
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $bmll1 = VLDA_dmx_lda_bm_spill %stack.1, implicit $sp :: (load (s32) from %stack.1)
  ; CHECK-NEXT:   renamable $bmlh1 = VLDA_dmx_lda_bm_spill %stack.9, implicit $sp :: (load (s512) from %stack.9)
  ; CHECK-NEXT:   renamable $bmhl1 = VLDA_dmx_lda_bm_spill %stack.10, implicit $sp :: (load (s512) from %stack.10)
  ; CHECK-NEXT:   renamable $bmhh1 = VLDA_dmx_lda_bm_spill %stack.11, implicit $sp :: (load (s512) from %stack.11)
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit $d0_3d, implicit $dm1
  bb.0:
    successors: %bb.1
    liveins: $d0_3d

    ST_DS_SPILL $d0_3d, %stack.0, implicit $sp :: (store (s256) into %stack.0, align 4)

  bb.1:
    successors: %bb.2
    liveins: $dm0

    renamable $d0_3d = LDA_DS_SPILL %stack.0, implicit $sp :: (load (s256) from %stack.0, align 4)
    VST_DM_SPILL $dm0, %stack.0, implicit $sp :: (store (s2048) into %stack.0, align 128)

  bb.2:
    liveins: $d0_3d

    renamable $dm1 = VLDA_DM_SPILL %stack.0, implicit $sp :: (load (s2048) from %stack.0, align 128)
    PseudoRET implicit $lr, implicit $d0_3d, implicit $dm1
...
