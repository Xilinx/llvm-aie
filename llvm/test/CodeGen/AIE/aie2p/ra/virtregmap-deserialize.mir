# RUN: llc -O2 -mtriple=aie2p -verify-machineinstrs \
# RUN:     -start-before=virtregrewriter -o - %s \
# RUN:    | FileCheck %s --check-prefix=DESER

# Test that VirtRegMap assignments can be loaded from serialized MIR.
# The assigned-register fields should be used by virtregrewriter to
# convert virtual registers to their assigned physical registers.

---
name:            test_virtregmap_deserialize
tracksRegLiveness: true
registers:
  - { id: 0, class: ep, assigned-register: '$p0' }
  - { id: 1, class: ep, assigned-register: '$p1' }
body:             |
  bb.0.entry:
    liveins: $p0, $p1

    ; DESER-LABEL: test_virtregmap_deserialize:
    ; DESER: {{  }}ret lr

    %0:ep = COPY $p0
    %1:ep = COPY $p1
    PseudoRET implicit $lr, implicit %0, implicit %1
...
