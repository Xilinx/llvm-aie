  bb.0.entry:
    liveins: $dj0, $p1, $plfr0
    ; CHECK-LABEL: name: test_composed_subreg
    ; CHECK: liveins: $dj0, $p1, $plfr0
    ; CHECK-NEXT: {{  $}}
