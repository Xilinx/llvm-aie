    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:eldfifohreg = COPY [[COPY2]].sub_hi_lf
    ; CHECK-NEXT: VST_dmx_sts_fifohl_idx_imm killed [[COPY4]], [[COPY]], 64 :: (store (<16 x s32>))
    ; CHECK-NEXT: VST_dmx_sts_fifohl_idx_imm killed [[COPY3]], [[COPY]], 0 :: (store (<16 x s32>))
