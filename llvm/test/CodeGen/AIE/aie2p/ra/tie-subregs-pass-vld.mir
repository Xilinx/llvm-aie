    %11:eldfifohreg = COPY killed %8.sub_hi_lf:eldfiforeg
    VST_dmx_sts_fifohl_idx_imm killed %11:eldfifohreg, %1:ep, 64 :: (store (<16 x s32>) )
    VST_dmx_sts_fifohl_idx_imm killed %10:eldfifolreg, %1:ep, 0 :: (store (<16 x s32>) )
    PseudoRET implicit $lr
