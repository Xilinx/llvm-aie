    ; CHECK-NEXT: [[COPY2:%[0-9]+]].sub_ptr:epsrfldf, [[COPY2:%[0-9]+]].sub_fifo:epsrfldf, [[COPY2:%[0-9]+]].sub_avail:epsrfldf = VLDB_FILL_512 [[COPY2]]
