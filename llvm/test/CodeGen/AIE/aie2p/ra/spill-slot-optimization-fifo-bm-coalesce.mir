# RUN: llc -mtriple=aie2p --verify-machineinstrs \
# RUN:     -run-pass=aie-spill-slot-opt -o - %s | FileCheck %s

# StackSlotColoring can coalesce registers with disjoint live ranges from
# different register files onto a single frame index. Here a 1024-bit CM
# accumulator spill (which decomposes into 512-bit BM lanes) and a 1024-bit load
# FIFO spill (which decomposes into 512-bit FIFO lanes) share %stack.0. Both
# register files decompose into same-sized 512-bit lanes at byte offsets 0 and
# 64, so the lanes do not conflict and the slot is decomposed.
#
# When emitting the per-lane spill/reload, the opcode must be selected from the
# register actually being accessed, not from the replacement slot's register
# class (which belongs to whichever register created the slot first). Otherwise
# the FIFO lanes (lfl0/lfh0) would be stored/loaded with a BM spill opcode
# (VST_dmx_sts_bm_spill), which cannot encode a FIFO register and crashes the
# MC code emitter. Check that the BM lanes use the BM spill opcodes and the FIFO
# lanes use the FIFO spill opcodes.

---
name:            fifo_bm_coalesced_slot
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 128, alignment: 64 }
body:             |
  ; CHECK-LABEL: name: fifo_bm_coalesced_slot
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $cml0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   VST_dmx_sts_bm_spill renamable $bmll0, %stack.1, implicit $sp :: (store (s512) into %stack.1)
  ; CHECK-NEXT:   VST_dmx_sts_bm_spill renamable $bmlh0, %stack.2, implicit $sp :: (store (s512) into %stack.2)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $cml0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $bmll0 = VLDA_dmx_lda_bm_spill %stack.1, implicit $sp :: (load (s512) from %stack.1)
  ; CHECK-NEXT:   renamable $bmlh0 = VLDA_dmx_lda_bm_spill %stack.2, implicit $sp :: (load (s512) from %stack.2)
  ; CHECK-NEXT:   $x0 = COPY killed renamable $cml0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $lf0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   VST_dmx_sts_fifohl_spill renamable $lfl0, %stack.1, implicit $sp :: (store (s512) into %stack.1)
  ; CHECK-NEXT:   VST_dmx_sts_fifohl_spill renamable $lfh0, %stack.2, implicit $sp :: (store (s512) into %stack.2)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $lf0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $lfl0 = VLDA_dmx_lda_fifohl_spill %stack.1, implicit $sp :: (load (s512) from %stack.1)
  ; CHECK-NEXT:   renamable $lfh0 = VLDA_dmx_lda_fifohl_spill %stack.2, implicit $sp :: (load (s512) from %stack.2)
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit $lf0
  bb.0:
    successors: %bb.1
    liveins: $cml0

    VST_CM_SPILL renamable $cml0, %stack.0, implicit $sp :: (store (s1024) into %stack.0, align 64)

  bb.1:
    successors: %bb.2
    liveins: $cml0

    renamable $cml0 = VLDA_CM_SPILL %stack.0, implicit $sp :: (load (s1024) from %stack.0, align 64)
    $x0 = COPY killed renamable $cml0

  bb.2:
    successors: %bb.3
    liveins: $lf0

    VST_FIFO_SPILL renamable $lf0, %stack.0, implicit $sp :: (store (s1024) into %stack.0, align 64)

  bb.3:
    liveins: $lf0

    renamable $lf0 = VLDA_FIFO_SPILL %stack.0, implicit $sp :: (load (s1024) from %stack.0, align 64)
    PseudoRET implicit $lr, implicit $lf0
...
