  ; CHECK-NEXT:   liveins: $bmlh2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $dm1 = IMPLICIT_DEF
  ; CHECK-NEXT:   VST_DM_SPILL killed $dm1, %stack.0, implicit $sp :: (store (s2048) into %stack.0, align 64)
