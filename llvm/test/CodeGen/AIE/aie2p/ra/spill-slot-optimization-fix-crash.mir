  ; STACK: bb.0:
  ; STACK-NEXT:   successors: %bb.1(0x80000000)
  ; STACK-NEXT:   liveins: $bmlh2
  ; STACK-NEXT: {{  $}}
  ; STACK-NEXT:   frame-setup PADDXM_pstm_sp_imm 512, implicit-def $sp, implicit $sp
  ; STACK-NEXT:   $dm1 = IMPLICIT_DEF
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmll1, -512, implicit $sp :: (store (s512) into %stack.0)
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmlh1, -448, implicit $sp :: (store (s512) into %stack.0 + 64)
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmhl1, -384, implicit $sp :: (store (s512) into %stack.0 + 128)
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmhh1, -320, implicit $sp :: (store (s512) into %stack.0 + 192)
  ; STACK-NEXT:   renamable $bmll1 = COPY renamable $bmlh2
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmll1, -256, implicit $sp :: (store (s512) into %stack.1)
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmlh1, -192, implicit $sp :: (store (s512) into %stack.1 + 64)
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmhl1, -128, implicit $sp :: (store (s512) into %stack.1 + 128)
  ; STACK-NEXT:   VST_dmx_sts_bm_spill killed $bmhh1, -64, implicit $sp :: (store (s512) into %stack.1 + 192)
  ; STACK-NEXT: {{  $}}
