# RUN: llc -mtriple=aie2p  \
# RUN:     -run-pass=none -o - %s | FileCheck %s

# RUN: llc -mtriple=aie2p \
# RUN:     -run-pass=none,prologepilog -o - %s | FileCheck %s --check-prefix=STACK

# Bug Fix: Machineverifier rightfully crashes, because we have undefined Registers that we store to memory.
# Solution only store and reload actually live Registers!


---
# Partial liveness check - when only $bmlh1 is defined, only spill bmlh1
# Spilling undef Registers crashes the machine verifier
name:            partial_liveness_check
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 256, alignment: 64 }
  - { id: 1, type: spill-slot, size: 256, alignment: 64 }
body:             |

  bb.0:
  liveins: $bmlh2

    ; CHECK-LABEL: name: partial_liveness_check
    ; CHECK: liveins: $bmlh2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $dm1 = IMPLICIT_DEF
    ; CHECK-NEXT: VST_DM_SPILL killed $dm1, %stack.0, implicit $sp :: (store (s2048) into %stack.0, align 64)
    ; CHECK-NEXT: $dm1 = VLDA_DM_SPILL %stack.0, implicit $sp :: (load (s2048) from %stack.0, align 64)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $dm1
    ;
    ; STACK-LABEL: name: partial_liveness_check
    ; STACK: liveins: $bmlh2
    ; STACK-NEXT: {{  $}}
    ; STACK-NEXT: frame-setup PADDXM_pstm_sp_imm 512, implicit-def $sp, implicit $sp
    ; STACK-NEXT: $dm1 = IMPLICIT_DEF
    ; STACK-NEXT: VST_dmx_sts_bm_spill killed $bmll1, -512, implicit $sp :: (store (s512) into %stack.0)
    ; STACK-NEXT: VST_dmx_sts_bm_spill killed $bmlh1, -448, implicit $sp :: (store (s512) into %stack.0 + 64)
    ; STACK-NEXT: VST_dmx_sts_bm_spill killed $bmhl1, -384, implicit $sp :: (store (s512) into %stack.0 + 128)
    ; STACK-NEXT: VST_dmx_sts_bm_spill killed $bmhh1, -320, implicit $sp :: (store (s512) into %stack.0 + 192)
    ; STACK-NEXT: $bmll1 = VLDA_dmx_lda_bm_spill -512, implicit $sp :: (load (s512) from %stack.0)
    ; STACK-NEXT: $bmlh1 = VLDA_dmx_lda_bm_spill -448, implicit $sp :: (load (s512) from %stack.0 + 64)
    ; STACK-NEXT: $bmhl1 = VLDA_dmx_lda_bm_spill -384, implicit $sp :: (load (s512) from %stack.0 + 128)
    ; STACK-NEXT: $bmhh1 = VLDA_dmx_lda_bm_spill -320, implicit $sp :: (load (s512) from %stack.0 + 192)
    ; STACK-NEXT: frame-destroy PADDXM_pstm_sp_imm -512, implicit-def $sp, implicit $sp
    ; STACK-NEXT: PseudoRET implicit $lr, implicit $dm1
  $dm1 = IMPLICIT_DEF
  VST_DM_SPILL killed $dm1, %stack.0, implicit $sp:: (store (s2048) into %stack.0, align 64)
  $dm1 = VLDA_DM_SPILL %stack.0, implicit $sp :: (load (s2048) from %stack.0, align 64)


  PseudoRET implicit $lr, implicit $dm1

...

---
# Partial liveness check on two separate stackslots
name:            partial_liveness_check_same_offset
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 256, alignment: 64 }
  - { id: 1, type: spill-slot, size: 256, alignment: 64 }
body:             |
  ; CHECK-LABEL: name: partial_liveness_check_same_offset
