# RUN: llc -mtriple=aie2p -run-pass=aie-spill-slot-opt,prologepilog -o - %s \
# RUN:     | FileCheck %s
# XFAIL: *


# This test verifies that AIE Spill Slot Optimization does not crash when a
# stack slot has mixed accesses: both vector (VST_dmx_sts_x_spill) and scalar (ST_R_SPILL).
#
# The fix: if any spill on a slot cannot be decomposed, skip the entire slot.
# This ensures we never partially rewrite a slot.

---
# Test: Mix of vector and scalar spills to same 64-byte slot.
# The all-or-nothing fix ensures we don't decompose this slot at all,
# because VST_dmx_sts_x_spill is not profitable (64 bytes = slot size).
name:            mixed_vector_scalar_spill_crash
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 64, alignment: 64 }
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $x0

    VST_dmx_sts_x_spill killed renamable $x0, %stack.0, implicit $sp :: (store (s512) into %stack.0)

  bb.1:
    successors: %bb.2
    liveins: $r0

    ; 32-bit scalar spill - would be profitable, but slot is skipped
    ST_R_SPILL killed renamable $r0, %stack.0, implicit $sp :: (store (s32) into %stack.0)

  bb.2:
    ; 32-bit scalar reload
    renamable $r6 = LDA_R_SPILL %stack.0, implicit $sp :: (load (s32) from %stack.0)

    ; 512-bit vector reload
    renamable $x2 = VLDA_dmx_lda_x_spill %stack.0, implicit $sp :: (load (s512) from %stack.0)

    $r1 = COPY killed renamable $r6
    PseudoRET implicit $lr, implicit $r1, implicit $x2
...
