# RUN: llc -mtriple=aie2p -run-pass=none -o /dev/null %s

# Test that VirtRegMap fields (assigned-register and stack-slot) can be parsed
# without errors. These fields are typically written by register allocation and
# this test verifies the MIR parser accepts them.

---
name:            test_assigned_register
tracksRegLiveness: true
registers:
  - { id: 0, class: ep, assigned-register: '$p0' }
  - { id: 1, class: ep, assigned-register: '$p1' }
body:             |
  bb.0:
    liveins: $p0, $p1
    %0:ep = COPY $p0
    %1:ep = COPY $p1
    PseudoRET implicit $lr
...

---
name:            test_stack_slot
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
registers:
  - { id: 0, class: ep, stack-slot: 0 }
  - { id: 1, class: ep, assigned-register: '$p1' }
body:             |
  bb.0:
    PseudoRET implicit $lr
...

---
name:            test_mixed_assignments
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
registers:
  - { id: 0, class: ep, assigned-register: '$p0' }
  - { id: 1, class: ep, stack-slot: 0 }
  - { id: 2, class: ep, assigned-register: '$p1' }
body:             |
  bb.0:
    liveins: $p0
    %0:ep = COPY $p0
    PseudoRET implicit $lr
...
