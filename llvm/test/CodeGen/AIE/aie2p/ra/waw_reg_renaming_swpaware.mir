# Basic test for the WAW register renaming pass with swp-aware policy.
# We change the allocation order by estimating the cycle in which
# each instruction runs in the pipelined schedule

# RUN: llc -mtriple=aie2p -verify-machineinstrs \
# RUN:     --aie-reg-rewrite-mode=swpaware-auto \
# RUN:     --start-before=greedy --stop-after=virtregrewriter \
# RUN:     %s -o - | FileCheck %s

---
name:            conv2d_dw_bf16
alignment:       16
tracksRegLiveness: true
