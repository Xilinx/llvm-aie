  ; CHECK-NEXT:   VST_dmx_sts_x_idx_imm killed renamable $x0, killed renamable $p0, 0 :: (store (<32 x s16>))
  ; CHECK-NEXT:   PseudoRET implicit $lr
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $p0, $p1, $p2, $p3, $p4, $p5, $r0, $r1, $r2, $x0

