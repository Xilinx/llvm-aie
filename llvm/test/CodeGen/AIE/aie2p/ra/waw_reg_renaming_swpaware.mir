  ; CHECK-NEXT:   renamable $dj0 = COPY killed renamable $p5
  ; CHECK-NEXT:   renamable $dc4 = COPY renamable $dc0
  ; CHECK-NEXT:   LoopStart killed renamable $r1, 0
  ; CHECK-NEXT:   renamable $dc1 = COPY renamable $dc0
