# RUN: llc -O2 -mtriple=aie2p -verify-machineinstrs \
# RUN:     -start-before=virtregrewriter -stop-after=virtregrewriter -o - %s \
# RUN:    | FileCheck %s

# Test that VirtRegMap correctly handles stack-slot fields for spilled
# virtual registers. This test verifies that:
#   1. VirtRegMap deserializes stack-slot assignments from input MIR
#   2. VirtRegRewriter uses this info to rewrite vregs to physical registers
#   3. Spill/reload instructions are preserved with stack references
#
# Register %2 is a "phantom" vreg - it exists only in the registers section
# with stack-slot: 0 but never appears in the body. This represents the
# original spilled register after InlineSpiller renamed all its uses:
#   1. InlineSpiller assigned original vreg to stack-slot: 0
#   2. All uses were replaced with NEW vregs (%3, %4) via createFrom()
#   3. New vregs got physical register assignments
#   4. Original vreg remains as phantom for LiveInterval tracking
#
# The actual SPILL/RELOAD instructions use vregs with physical registers.

---
name:            test_virtregmap_stackslot
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
registers:
  - { id: 0, class: er, assigned-register: '$r0' }
  - { id: 1, class: er, assigned-register: '$r1' }
  - { id: 2, class: er, stack-slot: 0 }
  - { id: 3, class: er, assigned-register: '$r2' }
  - { id: 4, class: er, assigned-register: '$r3' }
body:             |
  bb.0.entry:
    liveins: $r0, $r1

    ; CHECK-LABEL: name: test_virtregmap_stackslot
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $r2 = COPY killed renamable $r1
    ; CHECK-NEXT: ST_R_SPILL killed renamable $r2, %stack.0, implicit $sp :: (store (s32) into %stack.0)
    ; CHECK-NEXT: renamable $r3 = LDA_R_SPILL %stack.0, implicit $sp :: (load (s32) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $r0, implicit killed renamable $r3
    %0:er = COPY $r0
    %1:er = COPY $r1
    %3:er = COPY %1
    ST_R_SPILL %3, %stack.0, implicit $sp :: (store (s32) into %stack.0)
    %4:er = LDA_R_SPILL %stack.0, implicit $sp :: (load (s32) from %stack.0)
    PseudoRET implicit $lr, implicit %0, implicit %4
...
