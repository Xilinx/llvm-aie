tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 64, alignment: 64,
      stack-id: default, callee-saved-register: '', callee-saved-restored: false }
body: |
  bb.0.entry:
    liveins: $x2

    ; CHECK-LABEL: name: full_materialized_pseudo_instrs
    ; CHECK: liveins: $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: VST_dmx_sts_x_spill $x2, %stack.0, implicit $sp :: (store (s512) into %stack.0)
    ; CHECK-NEXT: renamable $x0 = VLDA_dmx_lda_x_spill %stack.0, implicit $sp :: (load (s512) from %stack.0)
    ; CHECK-NEXT: RET implicit $lr, implicit $x0
    ;
    ; STACK-LABEL: name: full_materialized_pseudo_instrs
    ; STACK: liveins: $x2
    ; STACK-NEXT: {{  $}}
    ; STACK-NEXT: frame-setup PADDXM_pstm_sp_imm 64, implicit-def $sp, implicit $sp
    ; STACK-NEXT: VST_dmx_sts_x_spill $x2, -64, implicit $sp :: (store (s512) into %stack.0)
    ; STACK-NEXT: renamable $x0 = VLDA_dmx_lda_x_spill -64, implicit $sp :: (load (s512) from %stack.0)
    ; STACK-NEXT: RET implicit $lr, implicit $x0
    VST_dmx_sts_x_spill $x2, %stack.0, implicit $sp :: (store (s512) into %stack.0)
    renamable $x0 = VLDA_dmx_lda_x_spill %stack.0, implicit $sp :: (load (s512) from %stack.0)

    RET implicit $lr, implicit $x0
...


