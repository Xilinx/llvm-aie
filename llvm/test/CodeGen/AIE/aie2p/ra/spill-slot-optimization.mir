---
# Test 8: Simple vector spills should preserve stack size
name:            min_vector_spill_preserve_size
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 64, alignment: 64 }
body:             |
  bb.0:
    liveins: $x8

    ; CHECK-LABEL: name: min_vector_spill_preserve_size
    ; CHECK: liveins: $x8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: VST_dmx_sts_x_spill renamable $x8, %stack.0, implicit $sp :: (store (s512) into %stack.0)
    ; CHECK-NEXT: renamable $x8 = VLDA_512_COMPOSED_REG_SPILL %stack.0, implicit $sp :: (load (s512) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $x8
    ;
    ; STACK-LABEL: name: min_vector_spill_preserve_size
    ; STACK: liveins: $x8
    ; STACK-NEXT: {{  $}}
    ; STACK-NEXT: frame-setup PADDXM_pstm_sp_imm 64, implicit-def $sp, implicit $sp
    ; STACK-NEXT: VST_dmx_sts_x_spill renamable $x8, -64, implicit $sp :: (store (s512) into %stack.0)
    ; STACK-NEXT: renamable $x8 = VLDA_512_COMPOSED_REG_SPILL -64, implicit $sp :: (load (s512) from %stack.0)
    ; STACK-NEXT: frame-destroy PADDXM_pstm_sp_imm -64, implicit-def $sp, implicit $sp
    ; STACK-NEXT: PseudoRET implicit $lr, implicit $x8
    VST_dmx_sts_x_spill renamable $x8, %stack.0, implicit $sp :: (store (s512) into %stack.0)
    renamable $x8 = VLDA_512_COMPOSED_REG_SPILL %stack.0, implicit $sp :: (load (s512) from %stack.0)

    PseudoRET implicit $lr, implicit $x8

...

---
# Test 9: Same offset (0), different registers -> share slot
name: min_same_offset_zero_share_slot
alignment: 16
legalized: true
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 16, alignment: 4,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true }
body: |
  bb.0.entry:
    liveins: $l0, $d0

    ; CHECK-LABEL: name: min_same_offset_zero_share_slot
    ; CHECK: liveins: $l0, $d0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: VST_L_SPILL killed $l0, %stack.0, implicit $sp :: (store (s64) into %stack.0, align 4)
    ; CHECK-NEXT: $l0 = VLDA_L_SPILL %stack.0, implicit $sp :: (load (s64) from %stack.0, align 4)
    ; CHECK-NEXT: ST_D_SPILL killed $d0, %stack.0, implicit $sp :: (store (s128) into %stack.0, align 4)
    ; CHECK-NEXT: $d0 = LDA_D_SPILL %stack.0, implicit $sp :: (load (s128) from %stack.0, align 4)
    ; CHECK-NEXT: RET implicit $lr, implicit $l0, implicit $d0
    ;
    ; STACK-LABEL: name: min_same_offset_zero_share_slot
    ; STACK: liveins: $l0, $d0
    ; STACK-NEXT: {{  $}}
    ; STACK-NEXT: frame-setup PADDXM_pstm_sp_imm 64, implicit-def $sp, implicit $sp
    ; STACK-NEXT: ST_dms_sts_spill killed $r0, -64, implicit $sp :: (store (s32) into %stack.0)
    ; STACK-NEXT: ST_dms_sts_spill killed $r1, -60, implicit $sp :: (store (s32) into %stack.0 + 4)
    ; STACK-NEXT: $r0 = LDA_dms_lda_spill -64, implicit $sp :: (load (s32) from %stack.0)
    ; STACK-NEXT: $r1 = LDA_dms_lda_spill -60, implicit $sp :: (load (s32) from %stack.0 + 4)
    ; STACK-NEXT: ST_dms_sts_spill killed $m0, -64, implicit $sp :: (store (s32) into %stack.0)
    ; STACK-NEXT: ST_dms_sts_spill killed $dn0, -60, implicit $sp :: (store (s32) into %stack.0 + 4)
    ; STACK-NEXT: ST_dms_sts_spill killed $dj0, -56, implicit $sp :: (store (s32) into %stack.0 + 8)
    ; STACK-NEXT: ST_dms_sts_spill killed $dc0, -52, implicit $sp :: (store (s32) into %stack.0 + 12)
    ; STACK-NEXT: $m0 = LDA_dms_lda_spill -64, implicit $sp :: (load (s32) from %stack.0)
    ; STACK-NEXT: $dn0 = LDA_dms_lda_spill -60, implicit $sp :: (load (s32) from %stack.0 + 4)
    ; STACK-NEXT: $dj0 = LDA_dms_lda_spill -56, implicit $sp :: (load (s32) from %stack.0 + 8)
    ; STACK-NEXT: $dc0 = LDA_dms_lda_spill -52, implicit $sp :: (load (s32) from %stack.0 + 12)
    ; STACK-NEXT: RET implicit $lr, implicit $l0, implicit $d0
    VST_L_SPILL killed $l0, %stack.0, implicit $sp :: (store (s64) into %stack.0, align 4)
    $l0 = VLDA_L_SPILL %stack.0, implicit $sp :: (load (s64) from %stack.0, align 4)


    ST_D_SPILL killed $d0, %stack.0, implicit $sp :: (store (s128) into %stack.0, align 4)
    $d0 = LDA_D_SPILL %stack.0, implicit $sp :: (load (s128) from %stack.0, align 4)

    RET implicit $lr, implicit $l0, implicit $d0
...

