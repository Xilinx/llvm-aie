#
# This file tests AIE Spill Slot Optimization (aie-spill-slot-opt).
#
# The pass uses a two-phase approach:
#   Phase 1 (Analysis): Collect spill/reload info, compute liveness, and
#                       determine per-subreg decomposition details.
#   Phase 2 (Rewrite):  Emit decomposed instructions with lazily-created
#                       replacement slots, ensuring slots are only allocated
#                       when actually used.
#
# =============================================================================
# Pass Behavior Summary
# =============================================================================
#
# - Analyzes liveness at spill/reload points
# - Decomposes large register spills (DM→CM→BM) to only store/reload live parts
# - Same offset → share replacement slot (StackSlotColoring ensures safety)
# - Undef subregs at spill time don't need storage (skipped during reload)
#
# =============================================================================

# RUN: llc -mtriple=aie2p --verify-machineinstrs \
# RUN:     -run-pass=none -o - %s | FileCheck %s

# RUN: llc -mtriple=aie2p --verify-machineinstrs \
# RUN:     -run-pass=none,prologepilog -o - %s | FileCheck %s --check-prefix=STACK

# =============================================================================
# Section 1: Liveness-based Decomposition Tests
# =============================================================================

---
# Test 1: Only CML live - should decompose DM spill to CM spill, then minimize
name:            decomp_only_cml_live
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 256, alignment: 64 }
body:             |
  ; CHECK-LABEL: name: decomp_only_cml_live
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $cml0 = IMPLICIT_DEF
  ; CHECK-NEXT:   VST_DM_SPILL renamable $dm0, %stack.0, implicit $sp :: (store (s2048) into %stack.0, align 64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $cml0:0x000000000000000C
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $dm0 = VLDA_DM_SPILL %stack.0, implicit $sp :: (load (s2048) from %stack.0, align 64)
  ; CHECK-NEXT:   $r0 = COPY killed renamable $cml0
  ; CHECK-NEXT:   PseudoRET implicit $lr, implicit $r0
  ;
  ; STACK-LABEL: name: decomp_only_cml_live
  ; STACK: bb.0.entry:
  ; STACK-NEXT:   successors: %bb.1(0x80000000)
  ; STACK-NEXT: {{  $}}
  ; STACK-NEXT:   frame-setup PADDXM_pstm_sp_imm 256, implicit-def $sp, implicit $sp
  ; STACK-NEXT:   $cml0 = IMPLICIT_DEF
  ; STACK-NEXT:   VST_dmx_sts_bm_spill $bmll0, -256, implicit $sp :: (store (s512) into %stack.0)
  ; STACK-NEXT:   VST_dmx_sts_bm_spill $bmlh0, -192, implicit $sp :: (store (s512) into %stack.0 + 64)
  ; STACK-NEXT: {{  $}}
  ; STACK-NEXT: bb.1:
  ; STACK-NEXT:   liveins: $cml0:0x000000000000000C
  ; STACK-NEXT: {{  $}}
  ; STACK-NEXT:   $bmll0 = VLDA_dmx_lda_bm_spill -256, implicit $sp :: (load (s512) from %stack.0)
  ; STACK-NEXT:   $bmlh0 = VLDA_dmx_lda_bm_spill -192, implicit $sp :: (load (s512) from %stack.0 + 64)
  ; STACK-NEXT:   $r0 = COPY killed renamable $cml0
  ; STACK-NEXT:   frame-destroy PADDXM_pstm_sp_imm -256, implicit-def $sp, implicit $sp
  ; STACK-NEXT:   PseudoRET implicit $lr, implicit $r0
  bb.0.entry:
    successors: %bb.1

    $cml0 = IMPLICIT_DEF
    VST_DM_SPILL renamable $dm0, %stack.0, implicit $sp :: (store (s2048) into %stack.0, align 64)

  bb.1:
    liveins: $cml0:0x000000000000000C

    renamable $dm0 = VLDA_DM_SPILL %stack.0, implicit $sp :: (load (s2048) from %stack.0, align 64)
    $r0 = COPY killed renamable $cml0
    PseudoRET implicit $lr, implicit $r0
...

