#
# Test for WAW register renaming revert when register classes have overlapping
# physical registers.
#
# This test verifies the fix for a crash in revertAllocation() where:
# 1. A candidate from a failed register class (e.g., eXo) needs to revert to
#    its original register (e.g., $x1)
# 2. A candidate from a successful register class (e.g., VEC512) was newly
#    assigned to the same register ($x1) during reallocation
# 3. Without the fix, reverting caused an "Overlapping insert" assertion in
#    LiveIntervalUnion because $x1 was still occupied
#
# The fix detects when a successful class candidate's new assignment conflicts
# with registers needed for reverting failed classes, and reverts those
# conflicting candidates as well.

# RUN: llc -mtriple=aie2p -verify-machineinstrs \
# RUN:     --start-before=greedy --stop-after=virtregrewriter \
# RUN:     %s -o - | FileCheck %s
# XFAIL: *

---
name:            overlapping_failure_reg_classes
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $r0, $x0, $y2

    %12:er = MOV_RLC_imm11_pseudo 0
    %18:er = MOV_RLC_imm11_pseudo 1
    %37:exe = VBCST_32 %12
    undef %24.sub_512_lo:vec1024 = VBCST_32 %18
    %1:vec1024 = COPY $y2
    %0:er = COPY $r0
    %2:vec512 = COPY $x0
    %21:vec512 = VBCST_16 %12
    %24.sub_512_hi:vec1024 = COPY %24.sub_512_lo
    undef %20.sub_512_hi:vec1024 = COPY %37
    %20.sub_512_lo:vec1024 = COPY %37
    %10:ep = MOV_PD_imm11_pseudo 0
    %33:acc2048 = VCLR

  bb.1:
    successors: %bb.2(0x80000000)

    dead %3:vec512 = IMPLICIT_DEF
    LoopStart %0, -1
    PseudoJ_jump_imm %bb.2

  bb.2:
    successors: %bb.3(0x80000000)

    dead %58:vec256 = VLD_w_idx_imm_pseudo %10, 0 :: (load (<8 x s32>) from `ptr addrspace(5) null`, addrspace 5)
    undef %99.sub_256_lo:exo = VLD_w_idx_imm_pseudo %10, 0 :: (load (<8 x s32>) from `ptr addrspace(5) null`, addrspace 5)
    %95:acc2048 = VMAC_vmul_cm_core_Y_X %33, %1, %2, %18
    %96:acc2048 = VMAC_vmul_cm_core_Y_X %33, %20, %21, %12
    dead %59:vec512 = IMPLICIT_DEF
    %97:acc2048 = VMAC_vmul_cm_core_Y_X %33, %24, %2, %12
    %98:acc2048 = COPY %33
    PseudoJ_jump_imm %bb.3

  bb.3:
    successors: %bb.3(0x7c000000), %bb.4(0x04000000)

    undef %75.sub_512_lo:vec1024 = COPY %37
    %75.sub_512_hi:vec1024 = COPY %99
    %98:acc2048 = VMAC_vmul_cm_core_Y_X %98, %75, %2, %12
    undef %99.sub_256_lo:exo = VLD_w_idx_imm_pseudo %10, 0 :: (load unknown-size from `ptr addrspace(5) null`, align 32, addrspace 5)
    dead %67:vec256 = VLD_w_idx_imm_pseudo %10, 0 :: (load unknown-size from `ptr addrspace(5) null`, align 32, addrspace 5)
    %95:acc2048 = VMAC_vmul_cm_core_Y_X %95, %1, %2, %18
    %96:acc2048 = VMAC_vmul_cm_core_Y_X %96, %20, %21, %12
    dead %82:ewl = IMPLICIT_DEF
    %97:acc2048 = VMAC_vmul_cm_core_Y_X %97, %24, %2, %12
    dead %68:vec512 = IMPLICIT_DEF
    dead %74:vec512 = IMPLICIT_DEF
    PseudoLoopEnd <mcsymbol .L_LEnd0>, %bb.3
