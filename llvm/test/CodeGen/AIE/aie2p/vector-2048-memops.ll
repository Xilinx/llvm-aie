; 2048-bit vectors of 8- and 16-bit elements are loaded and stored as two
; 1024-bit halves.

define void @copy_v128i16(ptr %p, ptr %q) {
; CHECK-LABEL: copy_v128i16:
; CHECK:       // %bb.0:
; CHECK-NEXT:    vldb x0, [p0, #64]; nopxm
; CHECK-NEXT:    vldb x2, [p0, #0]
; CHECK-NEXT:    vldb x4, [p0, #128]
; CHECK-NEXT:    vldb x6, [p0, #192]
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret lr
; CHECK-NEXT:    vst x0, [p1, #64] // Delay Slot 5
; CHECK-NEXT:    vst x2, [p1, #0] // Delay Slot 4
; CHECK-NEXT:    vst x4, [p1, #128] // Delay Slot 3
; CHECK-NEXT:    vst x6, [p1, #192] // Delay Slot 2
; CHECK-NEXT:    nop // Delay Slot 1
  %a = load <128 x i16>, ptr %p, align 64
  store <128 x i16> %a, ptr %q, align 64
  ret void
}

