    br label %for.body

  for.cond.cleanup:                                 ; preds = %for.body
    ret void

  for.body:                                         ; preds = %for.body, %entry
    %put.09 = phi ptr [ %p, %entry ], [ %5, %for.body ]
    %get.08 = phi ptr [ %p, %entry ], [ %10, %for.body ]
    %count2.07 = phi i32 [ 0, %entry ], [ %9, %for.body ]
    %count1.06 = phi i32 [ 0, %entry ], [ %4, %for.body ]
