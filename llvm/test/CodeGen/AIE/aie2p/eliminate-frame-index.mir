# The offsets below are past what each spill's immediate field can encode
# (a 9-bit negative field scaled by the access size), so they must be rewritten
# to the indexed form instead of reaching the MC encoder, which aborts on them.

---
name:            test_scl_bigstack
tracksRegLiveness: true
alignment:       16
frameInfo:
  adjustsStack:    true
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 4000, alignment: 4 }
body:             |
  bb.0 (align 16):
    liveins: $r2
    ; CHECK-LABEL: name: test_scl_bigstack
    ; CHECK: liveins: $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: frame-setup PADDXM_pstm_sp_imm 4032, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: $p0 = MOV_alu_mv_mv_mv_scl $sp
    ; CHECK-NEXT: $dj0 = MOVXM -4032
    ; CHECK-NEXT: $r2 = LDA_dms_lda_idx killed $p0, killed $dj0
    ; CHECK-NEXT: $p0 = MOV_alu_mv_mv_mv_scl $sp
    ; CHECK-NEXT: $dj0 = MOVXM -4032
    ; CHECK-NEXT: ST_dms_sts_idx $r2, killed $p0, killed $dj0
    $r2 = LDA_dms_lda_spill %stack.0, implicit $sp
    ST_dms_sts_spill $r2, %stack.0, implicit $sp
...

