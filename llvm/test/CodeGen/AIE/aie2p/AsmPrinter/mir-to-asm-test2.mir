# RUN: llc -mtriple=aie2p -start-after=aie-machine-alignment --filetype=asm %s -o - | FileCheck %s

# CHECK: ret lr	

---
name:            test_inst_print_ops
body:             |
  bb.0.entry (align 16):
  
    BUNDLE implicit $lr {
      RET implicit $lr
    }
    DelayedSchedBarrier implicit $x0

...
