# RUN: llc -mtriple=aie2p -start-after=aie-machine-alignment --filetype=asm %s -o - | FileCheck %s

# CHECK: ret lr	
# CHECK: event.error

---
name:            test_inst_print_immop
body:             |
  bb.0.entry (align 16):
  
    BUNDLE implicit $lr {
      RET implicit $lr
    }
    BUNDLE {
      EVENT_ERROR
    }
    DelayedSchedBarrier

...
