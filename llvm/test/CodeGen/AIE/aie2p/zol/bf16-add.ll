; We have an admissible float operation in the loop body, and we check
; that a ZOL was created by looking for the hallmark intrinsics

; CHECK-LABEL: fsum
; CHECK: llvm.set.loop.iterations
; CHECK: llvm.loop.decrement

define dso_local bfloat @fsum(i32 noundef %n) local_unnamed_addr {
entry:
  br label %for.body

for.body:                                         ; preds = %entry, %for.body
  %i.05 = phi i32 [ 0, %entry ], [ %inc, %for.body ]
  %a = phi bfloat [ 0xR0000, %entry ], [ %add, %for.body ]
  %add = fadd bfloat %a, 0xR3F80
  %inc = add nuw nsw i32 %i.05, 1
  %exitcond.not = icmp eq i32 %inc, %n
  br i1 %exitcond.not, label %for.cond.cleanup, label %for.body, !llvm.loop !0

for.cond.cleanup:                                 ; preds = %for.body
  ret bfloat %a
}

; CHECK-LABEL: trunc
; CHECK: llvm.set.loop.iterations
; CHECK: llvm.loop.decrement

define dso_local bfloat @trunc(i32 noundef %n, ptr nocapture readonly %p) local_unnamed_addr {
entry:
  br label %for.body

for.body:    
  %i.07 = phi i32 [ 0, %entry ], [ %inc, %for.body ]
  %s.06 = phi bfloat [ 0xR0000, %entry ], [ %conv2, %for.body ]
  %p.addr.05 = phi ptr [ %p, %entry ], [ %incdec.ptr, %for.body ]
  %incdec.ptr = getelementptr inbounds i8, ptr %p.addr.05, i20 4
  %1 = load float, ptr %p.addr.05, align 4
  %conv = fptrunc float %1 to bfloat
  %conv2 = fadd bfloat %s.06, %conv
  %inc = add nuw nsw i32 %i.07, 1
  %exitcond.not = icmp eq i32 %inc, %n
  br i1 %exitcond.not, label %for.cond.cleanup, label %for.body, !llvm.loop !0

for.cond.cleanup:   
  ret bfloat %conv2
}

!0 = distinct !{!0, !1, !2}
!1 = !{!"llvm.loop.mustprogress"}
!2 = !{!"llvm.loop.itercount.range", i64 10}
