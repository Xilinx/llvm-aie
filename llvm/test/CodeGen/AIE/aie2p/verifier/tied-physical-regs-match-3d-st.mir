name:      virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:ep = COPY $p0
    %10:eds = COPY $d0_3d
    %70:ep, %71:edcl, %72:edch = ST_3D_dms_sts $eh0, %0, %10
    %80:ep, %81:edcl, %82:edch = ST_3D_dmv_sts_q $q2, %0, %10
    %90:ep, %91:edcl, %92:edch = ST_3D_s16 $r17, %0, %10, implicit-def $pe2_ads, implicit $pe2_ads
    %100:ep, %101:edcl, %102:edch = ST_3D_s8 $r28, %0, %10, implicit-def $pe2_ads, implicit $pe2_ads
    %120:ep, %121:edcl, %122:edch = ST_TM_3D $r13, %0, %10 :: (store (s32) into custom "TileMemory")

...

