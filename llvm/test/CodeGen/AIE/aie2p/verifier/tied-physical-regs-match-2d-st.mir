    $p5, $dc4 = ST_2D_dms_sts $r12, $p5, $d6
    $p5, $dc2 = ST_2D_dms_sts $r12, $p5, $d6
    $p5, $dc5 = ST_2D_dms_sts $r12, $p5, $d6
    $p1, $dc1 = ST_2D_dmv_sts_q $q2, $p1, $d4
    $p1, $dc5 = ST_2D_dmv_sts_q $q2, $p1, $d4
    $p1, $dc6 = ST_2D_dmv_sts_q $q2, $p1, $d4
    $p1, $dc6 = ST_2D_s16 $r4, $p1, $d7, implicit-def $pe2_ads, implicit $pe2_ads
