name:      virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:ep = COPY $p0
    %10:eds = COPY $d0_3d
    %460:eps, %461:eldfiforeg, %462:erf2 = VLDA_FILL_512 $p1, $lf1, $r25
    %490:mxa, %491:eps, %492:eldfiforeg, %493:erf2 = VLDA_POP_512_fifo_1d_pop $p0, $lf0, $r24, $m6, implicit-def $srfifo_uf
    %500:mxa, %501:eps, %502:eldfiforeg, %503:erf2 = VLDA_POP_512_normal_pop $p0, $lf0, $r24, implicit-def $srfifo_uf
    %530:mexa, %531:eps, %532:eldfiforeg, %533:erf2 = VLDA_POP_544_fifo_1d_pop $p1, $lf1, $r25, $m1, implicit-def $srfifo_uf
    %540:mexa, %541:eps, %542:eldfiforeg, %543:erf2 = VLDA_POP_544_normal_pop $p1, $lf1, $r25, implicit-def $srfifo_uf
    %570:mexa, %571:eps, %572:eldfiforeg, %573:erf2 = VLDA_POP_576_fifo_1d_pop $p0, $lf0, $r24, $m0, implicit-def $srfifo_uf
    %580:mexa, %581:eps, %582:eldfiforeg, %583:erf2 = VLDA_POP_576_normal_pop $p1, $lf1, $r25, implicit-def $srfifo_uf
    %610:mqxsa, %611:eps, %612:eldfiforeg, %613:erf2 = VLDA_POP_640_fifo_1d_pop $p1, $lf1, $r25, $m4, implicit-def $srfifo_uf
    %620:mqxsa, %621:eps, %622:eldfiforeg, %623:erf2 = VLDA_POP_640_normal_pop $p1, $lf1, $r25, implicit-def $srfifo_uf
    %650:mqexsa, %651:eps, %652:eldfiforeg, %653:erf2 = VLDA_POP_704_fifo_1d_pop $p0, $lf0, $r24, $m3, implicit-def $srfifo_uf
    %660:mqexsa, %661:eps, %662:eldfiforeg, %663:erf2 = VLDA_POP_704_normal_pop $p0, $lf0, $r24, implicit-def $srfifo_uf

...

