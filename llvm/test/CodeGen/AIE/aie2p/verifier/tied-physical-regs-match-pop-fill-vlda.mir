# RUN: not --crash llc -mtriple=aie2p -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s
#
# Test file automatically generated using generate_instr_info_test.py
# * Automatically generated file, do not edit! *

# This test ensures that the Machine Verifier detects tied physical registers
# that don't match.

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):

    $p1, $lf1, $r25 = VLDA_FILL_512 $p1, $lf1, $r25
    $x5, $p0, $lf0, $r24 = VLDA_POP_512_fifo_1d_pop $p0, $lf0, $r24, $m6, implicit-def $srfifo_uf
    $x0, $p0, $lf0, $r24 = VLDA_POP_512_normal_pop $p0, $lf0, $r24, implicit-def $srfifo_uf
    $ex4, $p1, $lf1, $r25 = VLDA_POP_544_fifo_1d_pop $p1, $lf1, $r25, $m1, implicit-def $srfifo_uf
    $ex9, $p1, $lf1, $r25 = VLDA_POP_544_normal_pop $p1, $lf1, $r25, implicit-def $srfifo_uf
    $ex1, $p0, $lf0, $r24 = VLDA_POP_576_fifo_1d_pop $p0, $lf0, $r24, $m0, implicit-def $srfifo_uf
    $ex9, $p1, $lf1, $r25 = VLDA_POP_576_normal_pop $p1, $lf1, $r25, implicit-def $srfifo_uf
    $qx2, $p1, $lf1, $r25 = VLDA_POP_640_fifo_1d_pop $p1, $lf1, $r25, $m4, implicit-def $srfifo_uf
    $qx2, $p1, $lf1, $r25 = VLDA_POP_640_normal_pop $p1, $lf1, $r25, implicit-def $srfifo_uf
    $qex1, $p0, $lf0, $r24 = VLDA_POP_704_fifo_1d_pop $p0, $lf0, $r24, $m3, implicit-def $srfifo_uf
    $qex2, $p0, $lf0, $r24 = VLDA_POP_704_normal_pop $p0, $lf0, $r24, implicit-def $srfifo_uf

    ; Below instructions have hasExtraSrcRegAllocReq and hasExtraDefRegAllocReq attributes
    ; which essentially bypass the register flags. The renamable attributes
    ; below should trigger no verification error.
    ; CHECK-NOT: Bad machine code
    renamable $p1, renamable $lf1, renamable $r25 = VLDA_FILL_512 renamable $p1, renamable $lf1, renamable $r25
    renamable $x5, renamable $p0, renamable $lf0, renamable $r24 = VLDA_POP_512_fifo_1d_pop renamable $p0, renamable $lf0, renamable $r24, renamable $m6, implicit-def renamable $srfifo_uf
    renamable $x0, renamable $p0, renamable $lf0, renamable $r24 = VLDA_POP_512_normal_pop renamable $p0, renamable $lf0, renamable $r24, implicit-def renamable $srfifo_uf
    renamable $ex4, renamable $p1, renamable $lf1, renamable $r25 = VLDA_POP_544_fifo_1d_pop renamable $p1, renamable $lf1, renamable $r25, renamable $m1, implicit-def renamable $srfifo_uf
    renamable $ex9, renamable $p1, renamable $lf1, renamable $r25 = VLDA_POP_544_normal_pop renamable $p1, renamable $lf1, renamable $r25, implicit-def renamable $srfifo_uf
    renamable $ex1, renamable $p0, renamable $lf0, renamable $r24 = VLDA_POP_576_fifo_1d_pop renamable $p0, renamable $lf0, renamable $r24, renamable $m0, implicit-def renamable $srfifo_uf
    renamable $ex9, renamable $p1, renamable $lf1, renamable $r25 = VLDA_POP_576_normal_pop renamable $p1, renamable $lf1, renamable $r25, implicit-def renamable $srfifo_uf
    renamable $qx2, renamable $p1, renamable $lf1, renamable $r25 = VLDA_POP_640_fifo_1d_pop renamable $p1, renamable $lf1, renamable $r25, renamable $m4, implicit-def renamable $srfifo_uf
    renamable $qx2, renamable $p1, renamable $lf1, renamable $r25 = VLDA_POP_640_normal_pop renamable $p1, renamable $lf1, renamable $r25, implicit-def renamable $srfifo_uf
    renamable $qex1, renamable $p0, renamable $lf0, renamable $r24 = VLDA_POP_704_fifo_1d_pop renamable $p0, renamable $lf0, renamable $r24, renamable $m3, implicit-def renamable $srfifo_uf
    renamable $qex2, renamable $p0, renamable $lf0, renamable $r24 = VLDA_POP_704_normal_pop renamable $p0, renamable $lf0, renamable $r24, implicit-def renamable $srfifo_uf

...

