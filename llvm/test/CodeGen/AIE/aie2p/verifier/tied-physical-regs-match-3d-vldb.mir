# This test ensures that the Machine Verifier detects tied physical registers
# that don't match.

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):

    $wh6, $p7, $dc2, $dc6 = VLDB_3D_128 $p7, $d2_3d
    $x3, $p5, $dc3, $dc7 = VLDB_3D_UNPACK_dmw_ldb_unpack_unpackSign0 $p5, $d3_3d, implicit $crunpacksize, implicit $unpacksign0
    $x8, $p0, $dc2, $dc6 = VLDB_3D_UNPACK_dmw_ldb_unpack_unpackSign1 $p0, $d2_3d, implicit $crunpacksize, implicit $unpacksign1
    $y5, $p6, $dc1, $dc5 = VLDB_3D_UNPACK_dmx_ldb_unpack_unpackSign0 $p6, $d1_3d, implicit $crunpacksize, implicit $unpacksign0
    $y2, $p4, $dc2, $dc6 = VLDB_3D_UNPACK_dmx_ldb_unpack_unpackSign1 $p4, $d2_3d, implicit $crunpacksize, implicit $unpacksign1
    $wh4, $p5, $dc2, $dc6 = VLDB_3D_dmw_ldb $p5, $d2_3d
    $x8, $p5, $dc0, $dc4 = VLDB_3D_dmx_ldb_x $p5, $d0_3d
    $x1, $p0, $lf0, $r24, $dc1, $dc5 = VLDB_POP_512_3D $plfr0, $d1_3d, implicit-def $srfifo_uf
    $ex0, $p0, $lf0, $r24, $dc1, $dc5 = VLDB_POP_544_3D $plfr0, $d1_3d, implicit-def $srfifo_uf
    $ex2, $p0, $lf0, $r24, $dc1, $dc5 = VLDB_POP_576_3D $plfr0, $d1_3d, implicit-def $srfifo_uf
    $qx0, $p1, $lf1, $r25, $dc1, $dc5 = VLDB_POP_640_3D $plfr1, $d1_3d, implicit-def $srfifo_uf
    $qex2, $p1, $lf1, $r25, $dc0, $dc4 = VLDB_POP_704_3D $plfr1, $d0_3d, implicit-def $srfifo_uf

    ; Below instructions have hasExtraSrcRegAllocReq and hasExtraDefRegAllocReq attributes
    ; which essentially bypass the register flags. The renamable attributes
    ; below should trigger no verification error.
    ; CHECK-NOT: Bad machine code
    renamable $wh6, renamable $p7, renamable $dc2, renamable $dc6 = VLDB_3D_128 renamable $p7, renamable $d2_3d
    renamable $x3, renamable $p5, renamable $dc3, renamable $dc7 = VLDB_3D_UNPACK_dmw_ldb_unpack_unpackSign0 renamable $p5, renamable $d3_3d, implicit renamable $crunpacksize, implicit renamable $unpacksign0
    renamable $x8, renamable $p0, renamable $dc2, renamable $dc6 = VLDB_3D_UNPACK_dmw_ldb_unpack_unpackSign1 renamable $p0, renamable $d2_3d, implicit renamable $crunpacksize, implicit renamable $unpacksign1
    renamable $y5, renamable $p6, renamable $dc1, renamable $dc5 = VLDB_3D_UNPACK_dmx_ldb_unpack_unpackSign0 renamable $p6, renamable $d1_3d, implicit renamable $crunpacksize, implicit renamable $unpacksign0
    renamable $y2, renamable $p4, renamable $dc2, renamable $dc6 = VLDB_3D_UNPACK_dmx_ldb_unpack_unpackSign1 renamable $p4, renamable $d2_3d, implicit renamable $crunpacksize, implicit renamable $unpacksign1
    renamable $wh4, renamable $p5, renamable $dc2, renamable $dc6 = VLDB_3D_dmw_ldb renamable $p5, renamable $d2_3d
    renamable $x8, renamable $p5, renamable $dc0, renamable $dc4 = VLDB_3D_dmx_ldb_x renamable $p5, renamable $d0_3d
    renamable $x1, renamable $p0, renamable $lf0, renamable $r24, renamable $dc1, renamable $dc5 = VLDB_POP_512_3D renamable $plfr0, renamable $d1_3d, implicit-def renamable $srfifo_uf
    renamable $ex0, renamable $p0, renamable $lf0, renamable $r24, renamable $dc1, renamable $dc5 = VLDB_POP_544_3D renamable $plfr0, renamable $d1_3d, implicit-def renamable $srfifo_uf
    renamable $ex2, renamable $p0, renamable $lf0, renamable $r24, renamable $dc1, renamable $dc5 = VLDB_POP_576_3D renamable $plfr0, renamable $d1_3d, implicit-def renamable $srfifo_uf
    renamable $qx0, renamable $p1, renamable $lf1, renamable $r25, renamable $dc1, renamable $dc5 = VLDB_POP_640_3D renamable $plfr1, renamable $d1_3d, implicit-def renamable $srfifo_uf
    renamable $qex2, renamable $p1, renamable $lf1, renamable $r25, renamable $dc0, renamable $dc4 = VLDB_POP_704_3D renamable $plfr1, renamable $d0_3d, implicit-def renamable $srfifo_uf

...

