# RUN: not --crash llc -mtriple=aie2p -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s

# This test ensures that the Machine Verifier detects tied physical registers
# that don't match.

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):

    $wh11, $p7, $dc0, $dc4 = VLD_3D_128_pseudo $p7, $d0_3d
    $wh9, $p3, $dc3, $dc7 = VLD_3D_w_pseudo $p3, $d3_3d
    $x3, $p7, $dc1, $dc5 = VLD_3D_x_pseudo $p7, $d1_3d

    ; Below instructions have hasExtraSrcRegAllocReq and hasExtraDefRegAllocReq attributes
    ; which essentially bypass the register flags. The renamable attributes
    ; below should trigger no verification error.
    ; CHECK-NOT: Bad machine code
    renamable $wh11, renamable $p7, renamable $dc0, renamable $dc4 = VLD_3D_128_pseudo renamable $p7, renamable $d0_3d
    renamable $wh9, renamable $p3, renamable $dc3, renamable $dc7 = VLD_3D_w_pseudo renamable $p3, renamable $d3_3d
    renamable $x3, renamable $p7, renamable $dc1, renamable $dc5 = VLD_3D_x_pseudo renamable $p7, renamable $d1_3d

...

---
name:      virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:ep = COPY $p0
    %10:eds = COPY $d0_3d
    %230:mwa, %231:ep, %232:edcl, %233:edch = VLD_3D_128_pseudo %0, %10
    %340:mwa, %341:ep, %342:edcl, %343:edch = VLD_3D_w_pseudo %0, %10
    %370:mxa, %371:ep, %372:edcl, %373:edch = VLD_3D_x_pseudo %0, %10

...

---
name:      tied_nok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    ; CHECK-COUNT-9: Bad machine code:

    $wh11, $p7, $dc0, $dc6 = VLD_3D_128_pseudo $p7, $d0_3d
    $wh11, $p7, $dc2, $dc7 = VLD_3D_128_pseudo $p7, $d0_3d
    $wh11, $p7, $dc1, $dc4 = VLD_3D_128_pseudo $p7, $d0_3d
    $wh9, $p3, $dc3, $dc4 = VLD_3D_w_pseudo $p3, $d3_3d
    $wh9, $p3, $dc1, $dc7 = VLD_3D_w_pseudo $p3, $d3_3d
    $wh9, $p3, $dc0, $dc5 = VLD_3D_w_pseudo $p3, $d3_3d
    $x3, $p7, $dc3, $dc6 = VLD_3D_x_pseudo $p7, $d1_3d
    $x3, $p7, $dc1, $dc4 = VLD_3D_x_pseudo $p7, $d1_3d
    $x3, $p7, $dc1, $dc6 = VLD_3D_x_pseudo $p7, $d1_3d

...

