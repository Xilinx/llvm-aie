name:      virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:ep = COPY $p0
    %10:ed = COPY $d0
    %70:mwb, %71:ep, %72:edc = VLDB_2D_128 %0, %10
    %80:mxb, %81:ep, %82:edc = VLDB_2D_UNPACK_dmw_ldb_unpack_unpackSign0 %0, %10, implicit $crunpacksize, implicit $unpacksign0
    %90:mxb, %91:ep, %92:edc = VLDB_2D_UNPACK_dmw_ldb_unpack_unpackSign1 %0, %10, implicit $crunpacksize, implicit $unpacksign1
    %100:ey, %101:ep, %102:edc = VLDB_2D_UNPACK_dmx_ldb_unpack_unpackSign0 %0, %10, implicit $crunpacksize, implicit $unpacksign0
    %110:ey, %111:ep, %112:edc = VLDB_2D_UNPACK_dmx_ldb_unpack_unpackSign1 %0, %10, implicit $crunpacksize, implicit $unpacksign1
    %120:mwb, %121:ep, %122:edc = VLDB_2D_dmw_ldb %0, %10
    %130:mxb, %131:ep, %132:edc = VLDB_2D_dmx_ldb_x %0, %10
    %300:mxb, %301:eps, %302:eldfiforeg, %303:erf2, %304:edc = VLDB_POP_512_2D $p1, $lf1, $r25, %10, implicit-def $srfifo_uf
    %340:mexb, %341:eps, %342:eldfiforeg, %343:erf2, %344:edc = VLDB_POP_544_2D  $p0, $lf0, $r24, %10, implicit-def $srfifo_uf
    %380:mexb, %381:eps, %382:eldfiforeg, %383:erf2, %384:edc = VLDB_POP_576_2D  $p1, $lf1, $r25, %10, implicit-def $srfifo_uf
    %420:mqxsb, %421:eps, %422:eldfiforeg, %423:erf2, %424:edc = VLDB_POP_640_2D $p0, $lf0, $r24, %10, implicit-def $srfifo_uf
    %460:mqexsb, %461:eps, %462:eldfiforeg, %463:erf2, %464:edc = VLDB_POP_704_2D  $p1, $lf1, $r25, %10, implicit-def $srfifo_uf

...

