# RUN: not --crash llc -mtriple=aie2p -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s
#
# Test file automatically generated using generate_instr_info_test.py
# * Automatically generated file, do not edit! *

# This test ensures that the Machine Verifier detects tied physical registers
# that don't match.

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):

    $wh4, $p2, $dc7 = VLDB_2D_128 $p2, $d7
    $x3, $p4, $dc1 = VLDB_2D_UNPACK_dmw_ldb_unpack_unpackSign0 $p4, $d1, implicit $crunpacksize, implicit $unpacksign0
    $x10, $p3, $dc0 = VLDB_2D_UNPACK_dmw_ldb_unpack_unpackSign1 $p3, $d0, implicit $crunpacksize, implicit $unpacksign1
    $y5, $p0, $dc4 = VLDB_2D_UNPACK_dmx_ldb_unpack_unpackSign0 $p0, $d4, implicit $crunpacksize, implicit $unpacksign0
    $y2, $p7, $dc2 = VLDB_2D_UNPACK_dmx_ldb_unpack_unpackSign1 $p7, $d2, implicit $crunpacksize, implicit $unpacksign1
    $wh3, $p7, $dc5 = VLDB_2D_dmw_ldb $p7, $d5
    $x1, $p0, $dc4 = VLDB_2D_dmx_ldb_x $p0, $d4
    $x5, $p1, $lf1, $r25, $dc3 = VLDB_POP_512_2D $p1, $lf1, $r25, $d3, implicit-def $srfifo_uf
    $ex6, $p0, $lf0, $r24, $dc6 = VLDB_POP_544_2D $p0, $lf0, $r24, $d6, implicit-def $srfifo_uf
    $ex9, $p1, $lf1, $r25, $dc0 = VLDB_POP_576_2D $p1, $lf1, $r25, $d0, implicit-def $srfifo_uf
    $qx3, $p0, $lf0, $r24, $dc4 = VLDB_POP_640_2D $p0, $lf0, $r24, $d4, implicit-def $srfifo_uf
    $qex1, $p1, $lf1, $r25, $dc2 = VLDB_POP_704_2D $p1, $lf1, $r25, $d2, implicit-def $srfifo_uf

    ; Below instructions have hasExtraSrcRegAllocReq and hasExtraDefRegAllocReq attributes
    ; which essentially bypass the register flags. The renamable attributes
    ; below should trigger no verification error.
    ; CHECK-NOT: Bad machine code
    renamable $wh4, renamable $p2, renamable $dc7 = VLDB_2D_128 renamable $p2, renamable $d7
    renamable $x3, renamable $p4, renamable $dc1 = VLDB_2D_UNPACK_dmw_ldb_unpack_unpackSign0 renamable $p4, renamable $d1, implicit renamable $crunpacksize, implicit renamable $unpacksign0
    renamable $x10, renamable $p3, renamable $dc0 = VLDB_2D_UNPACK_dmw_ldb_unpack_unpackSign1 renamable $p3, renamable $d0, implicit renamable $crunpacksize, implicit renamable $unpacksign1
    renamable $y5, renamable $p0, renamable $dc4 = VLDB_2D_UNPACK_dmx_ldb_unpack_unpackSign0 renamable $p0, renamable $d4, implicit renamable $crunpacksize, implicit renamable $unpacksign0
    renamable $y2, renamable $p7, renamable $dc2 = VLDB_2D_UNPACK_dmx_ldb_unpack_unpackSign1 renamable $p7, renamable $d2, implicit renamable $crunpacksize, implicit renamable $unpacksign1
    renamable $wh3, renamable $p7, renamable $dc5 = VLDB_2D_dmw_ldb renamable $p7, renamable $d5
    renamable $x1, renamable $p0, renamable $dc4 = VLDB_2D_dmx_ldb_x renamable $p0, renamable $d4
    renamable $x5, renamable $p1, renamable $lf1, renamable $r25, renamable $dc3 = VLDB_POP_512_2D renamable $p1, renamable $lf1, renamable $r25, renamable $d3, implicit-def renamable $srfifo_uf
    renamable $ex6, renamable $p0, renamable $lf0, renamable $r24, renamable $dc6 = VLDB_POP_544_2D renamable $p0, renamable $lf0, renamable $r24, renamable $d6, implicit-def renamable $srfifo_uf
    renamable $ex9, renamable $p1, renamable $lf1, renamable $r25, renamable $dc0 = VLDB_POP_576_2D renamable $p1, renamable $lf1, renamable $r25, renamable $d0, implicit-def renamable $srfifo_uf
    renamable $qx3, renamable $p0, renamable $lf0, renamable $r24, renamable $dc4 = VLDB_POP_640_2D renamable $p0, renamable $lf0, renamable $r24, renamable $d4, implicit-def renamable $srfifo_uf
    renamable $qex1, renamable $p1, renamable $lf1, renamable $r25, renamable $dc2 = VLDB_POP_704_2D renamable $p1, renamable $lf1, renamable $r25, renamable $d2, implicit-def renamable $srfifo_uf

...

