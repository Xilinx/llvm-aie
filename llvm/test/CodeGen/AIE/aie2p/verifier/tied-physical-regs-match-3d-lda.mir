# RUN: not --crash llc -mtriple=aie2p -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s
#
# Test file automatically generated using generate_instr_info_test.py
# * Automatically generated file, do not edit! *

# This test ensures that the Machine Verifier detects tied physical registers
# that don't match.

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):

    $m6, $p0, $dc2, $dc6 = LDA_3D_dms_lda $p0, $d2_3d
    $q1, $p1, $dc3, $dc7 = LDA_3D_dmv_lda_q $p1, $d3_3d
    $r19, $p4, $dc0, $dc4 = LDA_3D_s16 $p4, $d0_3d
    $r22, $p0, $dc2, $dc6 = LDA_3D_s8 $p0, $d2_3d
    $r11, $p1, $dc3, $dc7 = LDA_3D_u16 $p1, $d3_3d
    $r16, $p6, $dc2, $dc6 = LDA_3D_u8 $p6, $d2_3d
    $r11, $p6, $dc3, $dc7 = LDA_TM_3D $p6, $d3_3d :: (load (s32) from custom "TileMemory")

    ; Below instructions have hasExtraSrcRegAllocReq and hasExtraDefRegAllocReq attributes
    ; which essentially bypass the register flags. The renamable attributes
    ; below should trigger no verification error.
    ; CHECK-NOT: Bad machine code
    renamable $m6, renamable $p0, renamable $dc2, renamable $dc6 = LDA_3D_dms_lda renamable $p0, renamable $d2_3d
    renamable $q1, renamable $p1, renamable $dc3, renamable $dc7 = LDA_3D_dmv_lda_q renamable $p1, renamable $d3_3d
    renamable $r19, renamable $p4, renamable $dc0, renamable $dc4 = LDA_3D_s16 renamable $p4, renamable $d0_3d
    renamable $r22, renamable $p0, renamable $dc2, renamable $dc6 = LDA_3D_s8 renamable $p0, renamable $d2_3d
    renamable $r11, renamable $p1, renamable $dc3, renamable $dc7 = LDA_3D_u16 renamable $p1, renamable $d3_3d
    renamable $r16, renamable $p6, renamable $dc2, renamable $dc6 = LDA_3D_u8 renamable $p6, renamable $d2_3d
    renamable $r11, renamable $p6, renamable $dc3, renamable $dc7 = LDA_TM_3D renamable $p6, renamable $d3_3d :: (load (s32) from custom "TileMemory")

...

---
name:      virtual_ok
alignment:    16
body:      |
  bb.0 (align 16):
    ; CHECK-NOT: Bad machine code
    %0:ep = COPY $p0
    %10:eds = COPY $d0_3d
    %90:mldascl, %91:ep, %92:edcl, %93:edch = LDA_3D_dms_lda %0, %10
    %100:mqqsa, %101:ep, %102:edcl, %103:edch = LDA_3D_dmv_lda_q %0, %10
    %110:er, %111:ep, %112:edcl, %113:edch = LDA_3D_s16 %0, %10
    %120:er, %121:ep, %122:edcl, %123:edch = LDA_3D_s8 %0, %10
    %130:er, %131:ep, %132:edcl, %133:edch = LDA_3D_u16 %0, %10
    %140:er, %141:ep, %142:edcl, %143:edch = LDA_3D_u8 %0, %10
    %160:er, %161:ep, %162:edcl, %163:edch = LDA_TM_3D %0, %10 :: (load (s32) from custom "TileMemory")

...

