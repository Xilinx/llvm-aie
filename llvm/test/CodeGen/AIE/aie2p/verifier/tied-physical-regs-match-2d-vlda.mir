    $dm1, $p6, $dc5 = VLDA_2D_UPS_4x_dmx_lda_ups_x2d_upsSign1 $s2, $p6, $d5, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign1
    $wh6, $p3, $dc4 = VLDA_2D_dmw_lda_w $p3, $d4
