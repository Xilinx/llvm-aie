# RUN: not --crash llc -mtriple=aie2p -run-pass machineverifier -o /dev/null %s 2>&1 | FileCheck %s
#
# Test file automatically generated using generate_instr_info_test.py
# * Automatically generated file, do not edit! *

# This test ensures that the Machine Verifier detects tied physical registers
# that don't match.

---
name:      tied_ok
alignment:    16
body:      |
  bb.0 (align 16):

    $p1, $lf1, $r25 = VLDB_FILLX_512 $r30, $r30, $plfr1, implicit-def $lfe, implicit $lfe
    $p0, $lf0, $r24 = VLDB_FILL_512 $plfr0
    $x5, $p1, $lf1, $r25 = VLDB_POPX_512 $r30, $r30, $plfr1, implicit-def $lfe, implicit-def $srfifo_uf, implicit $lfe
    $x1, $p0, $lf0, $r24 = VLDB_POP_512_fifo_1d_pop $plfr0, $m7, implicit-def $srfifo_uf
    $x5, $p0, $lf0, $r24 = VLDB_POP_512_normal_pop $plfr0, implicit-def $srfifo_uf
    $ex7, $p1, $lf1, $r25 = VLDB_POP_544_fifo_1d_pop $plfr1, $m1, implicit-def $srfifo_uf
    $ex1, $p0, $lf0, $r24 = VLDB_POP_544_normal_pop $plfr0, implicit-def $srfifo_uf
    $ex1, $p1, $lf1, $r25 = VLDB_POP_576_fifo_1d_pop $plfr1, $m7, implicit-def $srfifo_uf
    $ex4, $p1, $lf1, $r25 = VLDB_POP_576_normal_pop $plfr1, implicit-def $srfifo_uf
    $qx2, $p0, $lf0, $r24 = VLDB_POP_640_fifo_1d_pop $plfr0, $m5, implicit-def $srfifo_uf
    $qx3, $p1, $lf1, $r25 = VLDB_POP_640_normal_pop $plfr1, implicit-def $srfifo_uf
    $qex3, $p1, $lf1, $r25 = VLDB_POP_704_fifo_1d_pop $plfr1, $m6, implicit-def $srfifo_uf
    $qex0, $p1, $lf1, $r25 = VLDB_POP_704_normal_pop $plfr1, implicit-def $srfifo_uf

    ; Below instructions have hasExtraSrcRegAllocReq and hasExtraDefRegAllocReq attributes
    ; which essentially bypass the register flags. The renamable attributes
    ; below should trigger no verification error.
    ; CHECK-NOT: Bad machine code
    renamable $p1, renamable $lf1, renamable $r25 = VLDB_FILLX_512 renamable $r30, renamable $r30, renamable $plfr1, implicit-def renamable $lfe, implicit renamable $lfe
    renamable $p0, renamable $lf0, renamable $r24 = VLDB_FILL_512 renamable $plfr0
    renamable $x5, renamable $p1, renamable $lf1, renamable $r25 = VLDB_POPX_512 renamable $r30, renamable $r30, renamable $plfr1, implicit-def renamable $lfe, implicit-def renamable $srfifo_uf, implicit renamable $lfe
    renamable $x1, renamable $p0, renamable $lf0, renamable $r24 = VLDB_POP_512_fifo_1d_pop renamable $plfr0, renamable $m7, implicit-def renamable $srfifo_uf
    renamable $x5, renamable $p0, renamable $lf0, renamable $r24 = VLDB_POP_512_normal_pop renamable $plfr0, implicit-def renamable $srfifo_uf
    renamable $ex7, renamable $p1, renamable $lf1, renamable $r25 = VLDB_POP_544_fifo_1d_pop renamable $plfr1, renamable $m1, implicit-def renamable $srfifo_uf
    renamable $ex1, renamable $p0, renamable $lf0, renamable $r24 = VLDB_POP_544_normal_pop renamable $plfr0, implicit-def renamable $srfifo_uf
    renamable $ex1, renamable $p1, renamable $lf1, renamable $r25 = VLDB_POP_576_fifo_1d_pop renamable $plfr1, renamable $m7, implicit-def renamable $srfifo_uf
    renamable $ex4, renamable $p1, renamable $lf1, renamable $r25 = VLDB_POP_576_normal_pop renamable $plfr1, implicit-def renamable $srfifo_uf
    renamable $qx2, renamable $p0, renamable $lf0, renamable $r24 = VLDB_POP_640_fifo_1d_pop renamable $plfr0, renamable $m5, implicit-def renamable $srfifo_uf
    renamable $qx3, renamable $p1, renamable $lf1, renamable $r25 = VLDB_POP_640_normal_pop renamable $plfr1, implicit-def renamable $srfifo_uf
    renamable $qex3, renamable $p1, renamable $lf1, renamable $r25 = VLDB_POP_704_fifo_1d_pop renamable $plfr1, renamable $m6, implicit-def renamable $srfifo_uf
    renamable $qex0, renamable $p1, renamable $lf1, renamable $r25 = VLDB_POP_704_normal_pop renamable $plfr1, implicit-def renamable $srfifo_uf

...

