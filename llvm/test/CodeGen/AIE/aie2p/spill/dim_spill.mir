# RUN: llc -verify-machineinstrs --march=aie2p -run-pass=prologepilog %s -o - | FileCheck %s

# Note that the "offset" field in the stack slots does not matter anymore,
# as the FI operands have already been translated to raw offsets.

---
name:            test_d
alignment:       16
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 16, alignment: 4 }
  - { id: 1, name: '', type: spill-slot, offset: 0, size: 16, alignment: 4 }
body:             |
  bb.0 (align 16):
    ; CHECK-LABEL: name: test_d
    ; CHECK: frame-setup PADDXM_pstm_sp_imm 64, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: $m1 = LDA_dms_lda_spill -64, implicit $sp :: (load (s32) from %stack.0)
    ; CHECK-NEXT: $dn1 = LDA_dms_lda_spill -60, implicit $sp :: (load (s32) from %stack.0 + 4)
    ; CHECK-NEXT: $dj1 = LDA_dms_lda_spill -56, implicit $sp :: (load (s32) from %stack.0 + 8)
    ; CHECK-NEXT: $dc1 = LDA_dms_lda_spill -52, implicit $sp :: (load (s32) from %stack.0 + 12)
    ; CHECK-NEXT: ST_dms_sts_spill $m1, -48, implicit $sp :: (store (s32) into %stack.1)
    ; CHECK-NEXT: ST_dms_sts_spill $dn1, -44, implicit $sp :: (store (s32) into %stack.1 + 4)
    ; CHECK-NEXT: ST_dms_sts_spill $dj1, -40, implicit $sp :: (store (s32) into %stack.1 + 8)
    ; CHECK-NEXT: ST_dms_sts_spill $dc1, -36, implicit $sp :: (store (s32) into %stack.1 + 12)
    $d1 = LDA_D_SPILL %stack.0, implicit $sp :: (load (s128) from %stack.0, align 4)
    ST_D_SPILL $d1, %stack.1, implicit $sp :: (store (s128) into %stack.1, align 4)
...

# Only some lanes are liveout/livein when reloading/spilling. Make sure no
# unnecessary instructions are generated.
---
name:            test_d_partial
tracksRegLiveness: true
alignment:       16
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 16, alignment: 4 }
  - { id: 1, name: '', type: spill-slot, offset: 0, size: 16, alignment: 4 }
body:             |
  bb.0 (align 16):
    ; CHECK-LABEL: name: test_d_partial
    ; CHECK: frame-setup PADDXM_pstm_sp_imm 64, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: $dj1 = LDA_dms_lda_spill -56, implicit $sp :: (load (s32) from %stack.0 + 8)
    ; CHECK-NEXT: $dj2 = COPY $dj1
    ; CHECK-NEXT: ST_dms_sts_spill $dj2, -40, implicit $sp :: (store (s32) into %stack.1 + 8)
    $d1 = LDA_D_SPILL %stack.0, implicit $sp :: (load (s128) from %stack.0, align 4)
    $dj2 = COPY $dj1
    ST_D_SPILL $d2, %stack.1, implicit $sp :: (store (s128) into %stack.1, align 4)
...

# No reg liveness is tracked, all spill instructions are generated.
