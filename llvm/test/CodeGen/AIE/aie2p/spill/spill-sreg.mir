# RUN: llc -mtriple=aie2p --verify-machineinstrs -run-pass=greedy -run-pass=virtregrewriter %s -o - | FileCheck %s

# There are 5 mSs (SHIFT) registers in use, one by %20, and 4 by the PseudoRET.
# There are only 4 physical mSs registers, one needs to be spilled and reloaded.
---
name:            spill_to_mem
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $x0, $s0
    ; CHECK-LABEL: name: spill_to_mem
    ; CHECK: liveins: $s0, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $r0 = MOV_alu_mv_mv_mv_scl killed renamable $r0
    ; CHECK-NEXT: ST_R_SPILL killed renamable $r0, %stack.0, implicit $sp :: (store (s32) into %stack.0)
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $s2 = COPY killed renamable $r0
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $s3 = COPY killed renamable $r0
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $s1 = COPY killed renamable $r0
    ; CHECK-NEXT: renamable $cml0 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, $s0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: renamable $r0 = LDA_R_SPILL %stack.0, implicit $sp :: (load (s32) from %stack.0)
    ; CHECK-NEXT: renamable $s0 = MOV_alu_mv_mv_mv_scl killed renamable $r0
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $s0, implicit killed renamable $s2, implicit killed renamable $s3, implicit killed renamable $s1, implicit killed renamable $cml0
    %10:er = MOVA 32
    %0:mss = COPY %10
    %11:er = MOVA 32
    %1:mss = COPY %11
    %12:er = MOVA 32
    %2:mss = COPY %12
    %13:er = MOVA 32
    %3:mss = COPY %13
    %20:acc1024 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, $s0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    PseudoRET implicit $lr, implicit %0, implicit %1, implicit %2, implicit %3, implicit %20
...

# Similar to the test above but with "real" instructions using the S registers.
# Otherwise the regalloc heuristics think it's not worth splitting the live
# ranges and using GPRs to copy back and forth.
---
name:            spill_to_gpr
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $x0, $s0, $p0

    ; CHECK-LABEL: name: spill_to_gpr
    ; CHECK: liveins: $p0, $s0, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $r1 = COPY killed renamable $r0
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $s2 = COPY killed renamable $r0
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $s3 = COPY killed renamable $r0
    ; CHECK-NEXT: renamable $r0 = MOVA 32
    ; CHECK-NEXT: renamable $s1 = COPY killed renamable $r0
    ; CHECK-NEXT: renamable $cml0 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, $s0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: renamable $s0 = COPY killed renamable $r1
    ; CHECK-NEXT: renamable $cml1 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, killed renamable $s0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: renamable $cml2 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, killed renamable $s2, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: renamable $cml3 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, killed renamable $s3, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: renamable $cml4 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, killed renamable $s1, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $cml0, implicit killed renamable $cml1, implicit killed renamable $cml2, implicit killed renamable $cml3, implicit killed renamable $cml4
    %10:er = MOVA 32
    %0:mss = COPY %10
    %11:er = MOVA 32
    %1:mss = COPY %11
    %12:er = MOVA 32
    %2:mss = COPY %12
    %13:er = MOVA 32
    %3:mss = COPY %13
    %20:acc1024 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, $s0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    %21:acc1024 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, %0, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    %22:acc1024 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, %1, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    %23:acc1024 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, %2, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    %24:acc1024 = VUPS_2x_mv_ups_x2c_upsSign0 $x0, %3, implicit-def $srups_of, implicit $crsat, implicit $crupsmode, implicit $upssign0
    PseudoRET implicit $lr, implicit %20, implicit %21, implicit %22, implicit %23, implicit %24
...

