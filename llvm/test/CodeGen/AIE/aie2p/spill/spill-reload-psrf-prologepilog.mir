# RUN: llc -mtriple=aie2p -run-pass=prologepilog --verify-machineinstrs %s -o - | FileCheck %s

# Isolated test for the prologepilog (eliminateFrameIndex) expansion of the
# composite ePSRFLdF (plfr) spill/reload pseudos. The input is already post-RA
# (the VST_PLFR_SPILL / VLDA_PLFR_SPILL pseudos reference physical registers and
# a stack slot); this verifies just the lowering into native store/load
# instructions.
#
# The composite is laid out in the slot as
#   [sub_fifo (128B)] [sub_avail (4B)] [sub_ptr (4B)].
# sub_fifo is stored/reloaded through the FIFO (dmx fifohl) path whose SP offset
# must be a multiple of 64; the scalar halves use the step-4 path.
#
# test_epsrfldf_prologepilog uses a normally (64-byte) aligned slot: every
# sub-spill offset is a multiple of 64/4 and encodable, so the immediate path is
# used.
#
# test_epsrfldf_prologepilog_unaligned spills the composite into a 4-byte
# aligned slot (as happens for a folded spill, issue #1090), so the FIFO offset
# is a multiple of 4 but not of 64 and cannot be encoded as an immediate. Every
# sub-spill must fall back to the move-SP-into-scratch + indexed-addressing path.

---
name:            test_epsrfldf_prologepilog
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
frameInfo:
  maxAlignment:    64
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 136, alignment: 64 }
body:             |
  bb.0.entry:
    liveins: $plfr0
    ; CHECK-LABEL: name: test_epsrfldf_prologepilog
    ; CHECK: liveins: $plfr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: frame-setup PADDXM_pstm_sp_imm 192, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: ST_dms_sts_spill killed $lr, -56, implicit $sp :: (store (s32) into %stack.1)
    ; CHECK-NEXT: VST_dmx_sts_fifohl_spill $lfl0, -192, implicit $sp :: (store (s512) into %stack.0)
    ; CHECK-NEXT: VST_dmx_sts_fifohl_spill $lfh0, -128, implicit $sp :: (store (s512) into %stack.0 + 64)
    ; CHECK-NEXT: ST_dms_sts_spill $r24, -64, implicit $sp :: (store (s32) into %stack.0 + 128, align 64)
    ; CHECK-NEXT: ST_dms_sts_spill $p0, -60, implicit $sp :: (store (s32) into %stack.0 + 132, basealign 64)
    ; CHECK-NEXT: PseudoJL 32, csr_aie2p, implicit-def $lr
    ; CHECK-NEXT: $lfl0 = VLDA_dmx_lda_fifohl_spill -192, implicit $sp :: (load (s512) from %stack.0)
    ; CHECK-NEXT: $lfh0 = VLDA_dmx_lda_fifohl_spill -128, implicit $sp :: (load (s512) from %stack.0 + 64)
    ; CHECK-NEXT: $r24 = LDA_dms_lda_spill -64, implicit $sp :: (load (s32) from %stack.0 + 128, align 64)
    ; CHECK-NEXT: $p0 = LDA_dms_lda_spill -60, implicit $sp :: (load (s32) from %stack.0 + 132, basealign 64)
    ; CHECK-NEXT: $lr = LDA_dms_lda_spill -56, implicit $sp :: (load (s32) from %stack.1)
    ; CHECK-NEXT: frame-destroy PADDXM_pstm_sp_imm -192, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $plfr0
    VST_PLFR_SPILL $plfr0, %stack.0, implicit $sp :: (store (s1088) into %stack.0, align 64)
    PseudoJL 32, csr_aie2p, implicit-def $lr
    renamable $plfr0 = VLDA_PLFR_SPILL %stack.0, implicit $sp :: (load (s1088) from %stack.0, align 64)
    PseudoRET implicit $lr, implicit killed renamable $plfr0
...

---
name:            test_epsrfldf_prologepilog_unaligned
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
fixedStack:
  # A 4-byte aligned slot for the 136-byte composite. Because the slot is not
  # 64-byte aligned, prologepilog resolves the FIFO half to an SP offset that is
  # a multiple of 4 but not of 64 (issue #1090). This models a folded spill.
  - { id: 0, type: spill-slot, offset: -56, size: 136, alignment: 4 }
body:             |
  bb.0.entry:
    liveins: $plfr0
    ; CHECK-LABEL: name: test_epsrfldf_prologepilog_unaligned
    ; CHECK: liveins: $plfr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: frame-setup PADDXM_pstm_sp_imm 128, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: ST_dms_sts_spill killed $lr, -48, implicit $sp :: (store (s32) into %stack.0)
    ; CHECK-NEXT: VST_dmx_sts_fifohl_spill $lfl0, -184, implicit $sp :: (store (s512) into %fixed-stack.0, align 4)
    ; CHECK-NEXT: VST_dmx_sts_fifohl_spill $lfh0, -120, implicit $sp :: (store (s512) into %fixed-stack.0 + 64, align 4)
    ; CHECK-NEXT: ST_dms_sts_spill $r24, -56, implicit $sp :: (store (s32) into %fixed-stack.0 + 128)
    ; CHECK-NEXT: ST_dms_sts_spill $p0, -52, implicit $sp :: (store (s32) into %fixed-stack.0 + 132)
    ; CHECK-NEXT: PseudoJL 32, csr_aie2p, implicit-def $lr
    ; CHECK-NEXT: $lfl0 = VLDA_dmx_lda_fifohl_spill -184, implicit $sp :: (load (s512) from %fixed-stack.0, align 4)
    ; CHECK-NEXT: $lfh0 = VLDA_dmx_lda_fifohl_spill -120, implicit $sp :: (load (s512) from %fixed-stack.0 + 64, align 4)
    ; CHECK-NEXT: $r24 = LDA_dms_lda_spill -56, implicit $sp :: (load (s32) from %fixed-stack.0 + 128)
    ; CHECK-NEXT: $p0 = LDA_dms_lda_spill -52, implicit $sp :: (load (s32) from %fixed-stack.0 + 132)
    ; CHECK-NEXT: $lr = LDA_dms_lda_spill -48, implicit $sp :: (load (s32) from %stack.0)
    ; CHECK-NEXT: frame-destroy PADDXM_pstm_sp_imm -128, implicit-def $sp, implicit $sp
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit killed renamable $plfr0
    VST_PLFR_SPILL $plfr0, %fixed-stack.0, implicit $sp :: (store (s1088) into %fixed-stack.0, align 4)
    PseudoJL 32, csr_aie2p, implicit-def $lr
    renamable $plfr0 = VLDA_PLFR_SPILL %fixed-stack.0, implicit $sp :: (load (s1088) from %fixed-stack.0, align 4)
    PseudoRET implicit $lr, implicit killed renamable $plfr0
...
