; RUN: llc -mtriple=x86_64-linux-gnu -pass-remarks-output=- -pass-remarks-filter=asm-printer %s -o /dev/null | FileCheck %s

; Multi-function fixture: two functions in one file. Verifies that the
; script groups remark CHECK lines per-function rather than spilling all
; remarks under the first function.

define i32 @add(i32 %a, i32 %b) {
; CHECK: --- !Analysis
; CHECK-NEXT: Pass:            asm-printer
; CHECK-NEXT: Name:            InstructionMix
; CHECK-NEXT: Function:        add
; CHECK-NEXT: Args:
; CHECK-NEXT:   - String:          'BasicBlock: '
; CHECK-NEXT:   - BasicBlock:      ''
; CHECK-NEXT:   - String:          "\n"
; CHECK-NEXT:   - String:          'leal	'
; CHECK-NEXT:   - String:          ': '
; CHECK-NEXT:   - INST_leal:       '1'
; CHECK-NEXT:   - String:          "\n"
; CHECK-NEXT:   - String:          retq
; CHECK-NEXT:   - String:          ': '
; CHECK-NEXT:   - INST_retq:       '1'
; CHECK-NEXT:   - String:          "\n"
; CHECK-NEXT: ...
; CHECK: --- !Analysis
; CHECK-NEXT: Pass:            asm-printer
; CHECK-NEXT: Name:            InstructionCount
; CHECK-NEXT: Function:        add
; CHECK-NEXT: Args:
; CHECK-NEXT:   - NumInstructions: '2'
; CHECK-NEXT:   - String:          ' instructions in function'
; CHECK-NEXT: ...
  %c = add i32 %a, %b
  ret i32 %c
}

define i32 @sub(i32 %a, i32 %b) {
; CHECK: --- !Analysis
; CHECK-NEXT: Pass:            asm-printer
; CHECK-NEXT: Name:            InstructionMix
; CHECK-NEXT: Function:        sub
; CHECK-NEXT: Args:
; CHECK-NEXT:   - String:          'BasicBlock: '
; CHECK-NEXT:   - BasicBlock:      ''
; CHECK-NEXT:   - String:          "\n"
; CHECK-NEXT:   - String:          'movl	'
; CHECK-NEXT:   - String:          ': '
; CHECK-NEXT:   - INST_movl:       '1'
; CHECK-NEXT:   - String:          "\n"
; CHECK-NEXT:   - String:          retq
; CHECK-NEXT:   - String:          ': '
; CHECK-NEXT:   - INST_retq:       '1'
; CHECK-NEXT:   - String:          "\n"
; CHECK-NEXT:   - String:          'subl	'
; CHECK-NEXT:   - String:          ': '
; CHECK-NEXT:   - INST_subl:       '1'
; CHECK-NEXT:   - String:          "\n"
; CHECK-NEXT: ...
; CHECK: --- !Analysis
; CHECK-NEXT: Pass:            asm-printer
; CHECK-NEXT: Name:            InstructionCount
; CHECK-NEXT: Function:        sub
; CHECK-NEXT: Args:
; CHECK-NEXT:   - NumInstructions: '3'
; CHECK-NEXT:   - String:          ' instructions in function'
; CHECK-NEXT: ...
  %c = sub i32 %a, %b
  ret i32 %c
}
