# RUN: llc -mtriple=x86_64-linux-gnu -start-after=x86-isel -pass-remarks-output=- -pass-remarks-filter=asm-printer %s -o /dev/null | FileCheck %s

# Single-function .mir fixture: same baseline scenario as x86-ore-basic.ll
# but starting from MIR -- verifies update_ore_test_checks.py emits CHECK
# lines under the function's MIR `body:` block.
--- |
  define i32 @add(i32 %a, i32 %b) {
    %c = add i32 %a, %b
    ret i32 %c
  }
...
---
name: add
tracksRegLiveness: true
body: |
  ; CHECK: --- !Analysis
  ; CHECK-NEXT: Pass:            asm-printer
  ; CHECK-NEXT: Name:            InstructionMix
  ; CHECK-NEXT: Function:        add
  ; CHECK-NEXT: Args:
  ; CHECK-NEXT:   - String:          'BasicBlock: '
  ; CHECK-NEXT:   - BasicBlock:      ''
  ; CHECK-NEXT:   - String:          "\n"
  ; CHECK-NEXT:   - String:          'leal	'
  ; CHECK-NEXT:   - String:          ': '
  ; CHECK-NEXT:   - INST_leal:       '1'
  ; CHECK-NEXT:   - String:          "\n"
  ; CHECK-NEXT:   - String:          retq
  ; CHECK-NEXT:   - String:          ': '
  ; CHECK-NEXT:   - INST_retq:       '1'
  ; CHECK-NEXT:   - String:          "\n"
  ; CHECK-NEXT: ...
  ; CHECK: --- !Analysis
  ; CHECK-NEXT: Pass:            asm-printer
  ; CHECK-NEXT: Name:            InstructionCount
  ; CHECK-NEXT: Function:        add
  ; CHECK-NEXT: Args:
  ; CHECK-NEXT:   - NumInstructions: '2'
  ; CHECK-NEXT:   - String:          ' instructions in function'
  ; CHECK-NEXT: ...
  bb.0:
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    $eax = COPY %2
    RET 0, implicit $eax
...
