; RUN: llc -mtriple=x86_64-linux-gnu %s -o - | FileCheck %s --check-prefix ASM
; RUN: llc -mtriple=x86_64-linux-gnu -pass-remarks-output=- -pass-remarks-filter=asm-printer %s -o /dev/null | FileCheck %s --check-prefix REMARKS

; Chain-update fixture: starts with no CHECK lines at all. Exercises
; --update-llc-checks, which first invokes update_llc_test_checks.py to
; populate ASM CHECK lines, then adds REMARKS CHECK lines on top.

define i32 @add(i32 %a, i32 %b) {
; REMARKS: --- !Analysis
; REMARKS-NEXT: Pass:            asm-printer
; REMARKS-NEXT: Name:            InstructionMix
; REMARKS-NEXT: Function:        add
; REMARKS-NEXT: Args:
; REMARKS-NEXT:   - String:          'BasicBlock: '
; REMARKS-NEXT:   - BasicBlock:      ''
; REMARKS-NEXT:   - String:          "\n"
; REMARKS-NEXT:   - String:          'leal	'
; REMARKS-NEXT:   - String:          ': '
; REMARKS-NEXT:   - INST_leal:       '1'
; REMARKS-NEXT:   - String:          "\n"
; REMARKS-NEXT:   - String:          retq
; REMARKS-NEXT:   - String:          ': '
; REMARKS-NEXT:   - INST_retq:       '1'
; REMARKS-NEXT:   - String:          "\n"
; REMARKS-NEXT: ...
; REMARKS: --- !Analysis
; REMARKS-NEXT: Pass:            asm-printer
; REMARKS-NEXT: Name:            InstructionCount
; REMARKS-NEXT: Function:        add
; REMARKS-NEXT: Args:
; REMARKS-NEXT:   - NumInstructions: '2'
; REMARKS-NEXT:   - String:          ' instructions in function'
; REMARKS-NEXT: ...
; ASM-LABEL: add:
; ASM:       # %bb.0:
; ASM-NEXT:    # kill: def $esi killed $esi def $rsi
; ASM-NEXT:    # kill: def $edi killed $edi def $rdi
; ASM-NEXT:    leal (%rdi,%rsi), %eax
; ASM-NEXT:    retq
  %c = add i32 %a, %b
  ret i32 %c
}
