# Chain-update fixture for MIR: starts with no CHECK lines. Exercises
# --update-mir-checks, which first invokes update_mir_test_checks.py to
# populate ASM CHECK lines, then adds REMARKS CHECK lines on top.
--- |
  define i32 @add(i32 %a, i32 %b) {
    %c = add i32 %a, %b
    ret i32 %c
  }
...
---
name: add
tracksRegLiveness: true
body: |
