# RUN: llc -mtriple=x86_64-linux-gnu -run-pass=none -o - %s | FileCheck %s

# Verify that we do not loose any Persistence Information if we do not run any pass in our pipeline.

---
name:            test_with_registers
tracksRegLiveness: true
registers:
  - { id: 0, class: gr64, assigned-register: '$rax' }
  - { id: 1, class: gr64, assigned-register: '$rbx' }
  - { id: 2, class: gr64, stack-slot: 0 }
body:             |
  bb.0:
    liveins: $rax, $rbx
    ; CHECK-LABEL: name: test_with_registers
    ; CHECK: registers:
    ; CHECK-NEXT:   - { id: 0, class: gr64, preferred-register: '', assigned-register: '$rax',
    ; CHECK-NEXT:       split-from-reg: '', required-register: '', flags: [  ] }
    ; CHECK-NEXT:   - { id: 1, class: gr64, preferred-register: '', assigned-register: '$rbx',
    ; CHECK-NEXT:       split-from-reg: '', required-register: '', flags: [  ] }
    ; CHECK-NEXT:   - { id: 2, class: gr64, preferred-register: '', assigned-register: '',
    ; CHECK-NEXT:       stack-slot: 0, split-from-reg: '', required-register: '', flags: [  ] }
    ; CHECK: liveins: $rax, $rbx
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rax
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rbx
    ; CHECK-NEXT: [[ADD64rr:%[0-9]+]]:gr64 = ADD64rr [[COPY]], [[COPY1]], implicit-def $eflags
    ; CHECK-NEXT: $rax = COPY [[ADD64rr]]
    ; CHECK-NEXT: RET 0, implicit $rax
    %0:gr64 = COPY $rax
    %1:gr64 = COPY $rbx
    %2:gr64 = ADD64rr %0, %1, implicit-def $eflags
    $rax = COPY %2
    RET 0, implicit $rax
...

---
name:            test_without_registers
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $eax
    ; CHECK-LABEL: name: test_without_registers
    ; CHECK: liveins: $eax
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: RET 0, implicit $eax
    RET 0, implicit $eax
...

# Test case: required-register constraint
# This tests that required-register is serialized when a vreg has a required
# physical register constraint
---
name:            test_required_register
tracksRegLiveness: true
registers:
  - { id: 0, class: gr64, assigned-register: '$rax', required-register: '$rax' }
  - { id: 1, class: gr64, assigned-register: '$rbx' }
body:             |
  bb.0:
    liveins: $rax, $rbx
    ; CHECK-LABEL: name: test_required_register
    ; CHECK: registers:
    ; CHECK-NEXT:   - { id: 0, class: gr64, preferred-register: '', assigned-register: '$rax',
    ; CHECK-NEXT:       split-from-reg: '', required-register: '$rax', flags: [  ] }
    ; CHECK-NEXT:   - { id: 1, class: gr64, preferred-register: '', assigned-register: '$rbx',
    ; CHECK-NEXT:       split-from-reg: '', required-register: '', flags: [  ] }
    ; CHECK: liveins: $rax, $rbx
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rax
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rbx
    ; CHECK-NEXT: $rax = COPY [[COPY]]
    ; CHECK-NEXT: RET 0, implicit $rax
    %0:gr64 = COPY $rax
    %1:gr64 = COPY $rbx
    $rax = COPY %0
    RET 0, implicit $rax
...

# Test case: split-from-reg with branching control flow
# This tests that split-from-reg is serialized when a vreg was split from
# another vreg (e.g., during live range splitting in branching control flow)
---
name:            test_split_from_reg_branch
tracksRegLiveness: true
registers:
  - { id: 0, class: gr64, assigned-register: '$rax' }
  - { id: 1, class: gr64, assigned-register: '$rbx', split-from-reg: '%0' }
  - { id: 2, class: gr64, assigned-register: '$rcx', split-from-reg: '%0' }
body:             |
  bb.0:
    liveins: $rax
    successors: %bb.1, %bb.2

    ; CHECK-LABEL: name: test_split_from_reg_branch
    ; CHECK: registers:
    ; CHECK-NEXT:   - { id: 0, class: gr64, preferred-register: '', assigned-register: '$rax',
    ; CHECK-NEXT:       split-from-reg: '', required-register: '', flags: [  ] }
    ; CHECK-NEXT:   - { id: 1, class: gr64, preferred-register: '', assigned-register: '$rbx',
    ; CHECK-NEXT:       split-from-reg: '%0', required-register: '', flags: [  ] }
    ; CHECK-NEXT:   - { id: 2, class: gr64, preferred-register: '', assigned-register: '$rcx',
    ; CHECK-NEXT:       split-from-reg: '%0', required-register: '', flags: [  ] }
    ; CHECK: bb.0:
    ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
    ; CHECK-NEXT:   liveins: $rax
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rax
    ; CHECK-NEXT:   TEST64rr [[COPY]], [[COPY]], implicit-def $eflags
    ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
    ; CHECK-NEXT:   JMP_1 %bb.1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: bb.1:
    ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[COPY]]
    ; CHECK-NEXT:   $rax = COPY [[COPY1]]
    ; CHECK-NEXT:   RET 0, implicit $rax
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: bb.2:
    ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[COPY]]
    ; CHECK-NEXT:   $rax = COPY [[COPY2]]
    ; CHECK-NEXT:   RET 0, implicit $rax
    %0:gr64 = COPY $rax
    TEST64rr %0, %0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    ; Split interval for %0 -> %1 on this path
    %1:gr64 = COPY %0
    $rax = COPY %1
    RET 0, implicit $rax

  bb.2:
    ; Split interval for %0 -> %2 on this path
    %2:gr64 = COPY %0
    $rax = COPY %2
    RET 0, implicit $rax
...
