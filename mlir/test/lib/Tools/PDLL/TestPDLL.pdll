#include "TestOps.td"
#include "mlir/Interfaces/CastInterfaces.td"

/// A simple pattern that matches and replaces an operation.
Pattern TestSimplePattern => replace op<test.simple> with op<test.success>;

// Test the import of interfaces.
Pattern TestInterface => replace _: CastOpInterface with op<test.success>;

// Test equals builtin
Pattern TestEquals {
    let op = op<test.equals> {val = val : Attr};
    val == attr<"4 : i32">;
    replace op with op<test.success>;
}

Pattern TestNotBuiltinDialect {
    let op = op<some_unknown_test.operation>;
    rewrite op with {
        let newOp = op<some_unknown_test.other_operation>()-> (type<"!test.test_type">);
        replace op with op<some_unknown_test.another_operation>(newOp.0);
    };
}
